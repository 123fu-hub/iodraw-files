{"root":{"data":{"id":"dmb0xx0n4js0","created":1792637453044,"text":"缺氧\nHypoxia"},"children":[{"data":{"id":"dmb6zvlqg200","created":1792654533353,"text":"定义","layout":null},"children":[{"data":{"id":"dmb6zxn4ko00","created":1792654537791,"text":"组织细胞供氧不足或用氧障碍\n引起代谢、功能甚至形态结构异常变化的病理过程","layout":null},"children":[]}]},{"data":{"id":"dmb71390uvc0","created":1792654628363,"text":"1.常用血氧指标","layout":null},"children":[{"data":{"id":"dmb71qal06o0","created":1792654678524,"text":"（1）血氧分压PO₂:\n物理溶解于血液中的氧分子所产生的张力","layout":null},"children":[{"data":{"id":"dmb72bl711s0","created":1792654724878,"text":"正常PaO₂约100mmHg:\n主要影响因素：PinO2与外呼吸功能","layout":null},"children":[]},{"data":{"id":"dmb73f5n9ww0","created":1792654811009,"text":"正常PvO₂约为40mmHg\n主要影响因素：组织摄取利用氧的水平（内呼吸状况）","layout":null},"children":[]}]},{"data":{"id":"dmb74eocl9c0","created":1792654888327,"text":"（2）血氧容量CO₂max:\n100ml血液中的血红蛋白被充分氧合后的最大携氧量","layout":null},"children":[{"data":{"id":"dmb75eq8a3k0","created":1792654966805,"text":"影响因素：血红蛋白的量和质","layout":null},"children":[]}]},{"data":{"id":"dmb75krt2ls0","created":1792654979961,"text":"（3）血氧含量CO₂：\n100ml血液中实际含有的氧量，\n包括物理溶解1.5%和化学结合98.5%的氧量","layout":null},"children":[{"data":{"id":"dmb76egqs3k0","created":1792655044595,"text":"主要影响因素：血氧容量和氧分压","layout":null},"children":[]},{"data":{"id":"dmb76oaa51k0","created":1792655065973,"text":"相关概念：动静脉血氧差","layout":null},"children":[{"data":{"id":"dmb771ep4h40","created":1792655094538,"text":"定义：动脉血氧含量19ml/dl减去静脉血氧含量14ml/dl所得","layout":null},"children":[]},{"data":{"id":"dmb77nd17nk0","created":1792655142326,"text":"正常值：5ml/dl","layout":null},"children":[]},{"data":{"id":"dmb77w3a4kg0","created":1792655161328,"text":"意义：反映了组织摄取利用氧的能力","layout":null},"children":[]}]}]},{"data":{"id":"dmb7d8hers00","created":1792655580124,"text":"（4）血红蛋白氧饱和度SO₂：\n血液中氧合Hb占总Hb的百分数","layout":null},"children":[{"data":{"id":"dmb7dw833w80","created":1792655631803,"text":"主要决定因素：血氧分压","layout":null},"children":[]},{"data":{"id":"dmb7fh7wta00","created":1792655755869,"text":"绿色：左移，亲和力增高；红色：右移","image":"https://p.cldisk.com/star4/dd2c3fb57a950a2329c9cb4db2a9b298/origin.png","imageTitle":"","imageSize":{"width":200,"height":88},"layout":null},"children":[]}]}]},{"data":{"id":"dmb719ctrqw0","created":1792654641654,"text":"2.缺氧的分类","layout":null},"children":[{"data":{"id":"dmbfw6u5psw0","created":1792679634340,"text":"（1）乏氧性—摄取","layout":null},"children":[{"data":{"id":"dmbfwz8uh000","created":1792679696178,"text":"定义：乏氧性缺氧Hypoxic hypoxia\n是指由于动脉血氧分压降低导致\n组织供氧不足的缺氧，\n又称低张性缺氧","layout":null},"children":[]},{"data":{"id":"dmbfy3qz60w0","created":1792679784345,"text":"原因","layout":null},"children":[{"data":{"id":"dmbfy4u5mbc0","created":1792679786714,"text":"吸入气体氧分压过低：\n高原、矿井","layout":null},"children":[]},{"data":{"id":"dmbfyb3cimg0","created":1792679800332,"text":"外呼吸功能障碍：\n呼吸道狭窄、胸腔肺部疾病","layout":null},"children":[]},{"data":{"id":"dmbfyh0kqw00","created":1792679813224,"text":"动静脉分流：\n先心病","layout":null},"children":[]}]},{"data":{"id":"dmbfz0jpnvk0","created":1792679855740,"text":"特点：","layout":null},"children":[{"data":{"id":"dmbg12nvrdk0","created":1792680017074,"text":"\t\t\tPaO₂：↓","layout":null},"children":[]},{"data":{"id":"dmbg1guz5gg0","created":1792680047978,"text":"血氧容量：N 或 ↑（慢性缺氧Hb代偿增多）","layout":null},"children":[]},{"data":{"id":"dmbg1niw7480","created":1792680062485,"text":"CaO₂：↓","layout":null},"children":[]},{"data":{"id":"dmbg1q78o680","created":1792680068311,"text":"SaO₂：↓","layout":null},"children":[]},{"data":{"id":"dmbg1s4wn600","created":1792680072523,"text":"A-V血氧差：↓ 或 N","layout":null},"children":[{"data":{"id":"dmbg2wot9vc0","created":1792680160798,"text":"① 轻度缺氧：组织摄取氧基本不变，动静脉差可接近正常（N）","layout":null},"children":[]},{"data":{"id":"dmbg31csglc0","created":1792680170955,"text":"② 严重缺氧：组织供氧太少，组织利用氧变少，差值↓","layout":null},"children":[]}]},{"data":{"id":"dmbg1uhyfnk0","created":1792680077666,"text":"特征：发绀","layout":null},"children":[{"data":{"id":"dmbg3e64hwo0","created":1792680198850,"text":"定义：毛细血管中脱氧/还原血红蛋白HHb达到5g/dl以上时\n（正常值2.6g/dl），皮肤、黏膜呈现青紫色","layout":null},"children":[]},{"data":{"id":"dmbg481skgw0","created":1792680263892,"text":"缺氧≠发绀","layout":null},"children":[{"data":{"id":"dmbg4elz3pk0","created":1792680278173,"text":"Hb含量正常的人：发绀和缺氧同时存在，可通过|\n发绀程度估计缺氧程度","layout":null},"children":[]},{"data":{"id":"dmbg5dm33oo0","created":1792680354367,"text":"贫血：严重缺氧但不会发绀","layout":null},"children":[]},{"data":{"id":"dmbg6dgb9o80","created":1792680432382,"text":"红细胞增多症：明显发绀但不会缺氧","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dmbfwh8schk0","created":1792679656992,"text":"（2）血液性—携带","layout":null},"children":[{"data":{"id":"dmbg6y2krgo0","created":1792680477264,"text":"定义：由于血红蛋白含量减少或性质改变导致的\n血液携带的氧减少/血红蛋白结合的氧不易释出\n从而造成缺氧","layout":null},"children":[]},{"data":{"id":"dmbg7vmlp3k0","created":1792680550308,"text":"原因","layout":null},"children":[{"data":{"id":"dmbg80pfxg00","created":1792680561364,"text":"血红蛋白含量减少","layout":null},"children":[{"data":{"id":"dmbg869ab140","created":1792680573448,"text":"各种原因引起的贫血，单位体积血液中红细胞\n和Hb减少，虽然PaO2正常，但是氧容量降低，\n氧含量随之减少","note":"贫","layout":null},"children":[]},{"data":{"id":"dmbg9aeks340","created":1792680660839,"text":"贫血的判定:\n成年男性Hb＜12.0g/dl，\n成年女性Hb＜11.0g/dl","layout":null},"children":[]}]},{"data":{"id":"dmbga13phi80","created":1792680718955,"text":"一氧化碳中毒","layout":null},"children":[{"data":{"id":"dmbga6eon6o0","created":1792680730502,"text":"CO与Hb的亲和力是O2的210倍，形成HbCO但不能结合氧","layout":null},"children":[]},{"data":{"id":"dmbgarjks000","created":1792680776511,"text":"CO与Hb一个血红素结合后，\n将增加其余3个血红素对样的亲和力，\n使结合氧不易释放","layout":null},"children":[]},{"data":{"id":"dmbgbl9poo80","created":1792680841218,"text":"CO抑制糖酵解，2,3-DPG和H+生成减少，结合氧不宜释放","layout":null},"children":[]}]},{"data":{"id":"dmbgc88b57c0","created":1792680891199,"text":"高铁血红蛋白血症","layout":null},"children":[{"data":{"id":"dmbgee7eqe80","created":1792681060933,"text":"机制","layout":null},"children":[{"data":{"id":"dmbgcdy10940","created":1792680903638,"text":"Fe3+与羟基牢固结合，而不能结合氧","layout":null},"children":[]},{"data":{"id":"dmbgcryy2q00","created":1792680934168,"text":"剩余的Fe2+与O2亲和力增强，使得结合氧不易释放","layout":null},"children":[]}]},{"data":{"id":"dmbgek9akqg0","created":1792681074108,"text":"常见原因：\n食用大量含硝酸盐的腌菜（肠源性发绀）","layout":null},"children":[{"data":{"id":"dmbgemksyn40","created":1792681079158,"text":"皮肤、粘膜颜色：咖啡色（HbFe3+＞1.5g/dl）","layout":null},"children":[]},{"data":{"id":"dmbgg89l8ew0","created":1792681204733,"text":"乏氧性缺氧－青紫色","layout":null},"children":[]},{"data":{"id":"dmbggczap280","created":1792681214995,"text":"CO中毒－樱桃红色","layout":null},"children":[]},{"data":{"id":"dmbggeykx080","created":1792681219305,"text":"严重贫血—苍白","layout":null},"children":[]}]}]},{"data":{"id":"dmbggosm33s0","created":1792681240712,"text":"血红蛋白与氧的亲和力异常增高","layout":null},"children":[{"data":{"id":"dmbgh4a2pao0","created":1792681274419,"text":"情形","layout":null},"children":[{"data":{"id":"dmbghfat3u80","created":1792681298408,"text":"输入大量库存血（2,3-DPG↓）","layout":null},"children":[{"data":{"id":"dmc0kne4tzs0","created":1792737973314,"text":"尽量优先输注新鲜血；必须大量输库存血时，警惕隐匿性组织缺氧，不要只看 SpO₂、PaO₂；","layout":null},"children":[]},{"data":{"id":"dmc0kne500w0","created":1792737973315,"text":"大量输血后可适当监测乳酸（组织缺氧标志物）；","layout":null},"children":[]},{"data":{"id":"dmc0kne574g0","created":1792737973315,"text":"输注后数小时红细胞可重新合成 2,3-DPG，该效应可自行缓解","layout":null},"children":[]}]},{"data":{"id":"dmbghsr6kbk0","created":1792681327697,"text":"碱性液体（H+↓）","layout":null},"children":[{"data":{"id":"dmc0kxwzzxk0","created":1792737996223,"text":"休克、缺氧患者不要急于、过度补碱；","layout":null},"children":[]},{"data":{"id":"dmc0kxwzwyo0","created":1792737996223,"text":"纠正酸中毒以改善通气、改善循环、去除病因为首要，补碱指征严格，避免过度碱中毒；","layout":null},"children":[]},{"data":{"id":"dmc0kxx0x0g0","created":1792737996224,"text":"已经碱中毒的患者，组织供氧效率下降，即使氧合指标正常，组织依旧摄氧不足。","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dmc0ljrw4ow0","created":1792738043803,"text":"特点","layout":null},"children":[{"data":{"id":"dmbg12nvrdk0","created":1792680017074,"text":"\t\t\tPaO₂：N/N","layout":null},"children":[]},{"data":{"id":"dmbg1guz5gg0","created":1792680047978,"text":"血氧容量：⬇（贫血）/N（库存血）","layout":null},"children":[]},{"data":{"id":"dmbg1niw7480","created":1792680062485,"text":"CaO₂：↓","layout":null},"children":[]},{"data":{"id":"dmbg1q78o680","created":1792680068311,"text":"SaO₂：N","layout":null},"children":[]},{"data":{"id":"dmbg1s4wn600","created":1792680072523,"text":"A-V血氧差：↓ ","layout":null},"children":[]}]}]},{"data":{"id":"dmbfwnfbdjc0","created":1792679670448,"text":"（3）循环性—运输","layout":null},"children":[{"data":{"id":"dmc0na3wjjk0","created":1792738179490,"text":"定义：由于血液循环障碍导致组织灌流减少，\n从而造成缺氧","layout":null},"children":[{"data":{"id":"dmc0pnsw3zs0","created":1792738366027,"text":"缺血性缺氧：动脉血灌流不足","layout":null},"children":[{"data":{"id":"dmc1cvj42000","created":1792740185226,"text":"原因","layout":null},"children":[{"data":{"id":"dmc1czogt1s0","created":1792740194257,"text":"休克、心衰","layout":null},"children":[]},{"data":{"id":"dmc1i47dadc0","created":1792740595928,"text":"动脉血栓、动脉粥样硬化","layout":null},"children":[]}]},{"data":{"id":"dmc1iq6tvp40","created":1792740643785,"text":"毛细血管供血不足，皮肤苍白","layout":null},"children":[]}]},{"data":{"id":"dmc0q2i8va80","created":1792738398035,"text":"淤血性缺氧：静脉血回流受阻","layout":null},"children":[{"data":{"id":"dmc1ib0tumg0","created":1792740610770,"text":"原因","layout":null},"children":[{"data":{"id":"dmc1icbtp9c0","created":1792740613612,"text":"右心衰竭","layout":null},"children":[]},{"data":{"id":"dmc1iewqaso0","created":1792740619229,"text":"静脉栓塞","layout":null},"children":[]}]},{"data":{"id":"dmc1j0750i00","created":1792740665571,"text":"毛细血管内瘀血，皮肤发绀","layout":null},"children":[]}]}]},{"data":{"id":"dmc1jbbtrfk0","created":1792740689799,"text":"特点","layout":null},"children":[{"data":{"id":"dmbg12nvrdk0","created":1792680017074,"text":"\t\t\tPaO₂：N","layout":null},"children":[]},{"data":{"id":"dmbg1guz5gg0","created":1792680047978,"text":"血氧容量：N ","layout":null},"children":[]},{"data":{"id":"dmbg1niw7480","created":1792680062485,"text":"CaO₂：N","layout":null},"children":[]},{"data":{"id":"dmbg1q78o680","created":1792680068311,"text":"SaO₂：N","layout":null},"children":[]},{"data":{"id":"dmbg1s4wn600","created":1792680072523,"text":"A-V血氧差：⬆","layout":null},"children":[]}]}]},{"data":{"id":"dmbfwrtnq8w0","created":1792679680022,"text":"（4）组织性—使用","layout":null},"children":[{"data":{"id":"dmc1jz9pv6o0","created":1792740741914,"text":"定义：供氧正常情况下，组织、细胞\n利用氧发生障碍，ATP产生减少","layout":null},"children":[]},{"data":{"id":"dmc1kwhdnns0","created":1792740814211,"text":"病因：细胞线粒体生物氧化功能障碍"},"children":[{"data":{"id":"dmc1nfdlmfc0","created":1792741012070,"text":"1.氰化物中毒：使cyt aa3形成氰化高铁细胞色素氧化酶cyt aa3（FeCN3），0.06gHCN可使人死亡"},"children":[]}]}]}]},{"data":{"id":"dmb71c0w0600","created":1792654647462,"text":"3.缺氧对机体的影响","layout":null},"children":[]},{"data":{"id":"dmb71hy77i80","created":1792654660360,"text":"4.缺氧的治疗原则‘","layout":null},"children":[]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}