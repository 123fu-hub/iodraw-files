{"root":{"data":{"id":"dmb0xx0n4js0","created":1792637453044,"text":"缺氧\nHypoxia"},"children":[{"data":{"id":"dmb6zvlqg200","created":1792654533353,"text":"定义","layout":null},"children":[{"data":{"id":"dmb6zxn4ko00","created":1792654537791,"text":"组织细胞供氧不足或用氧障碍\n引起代谢、功能甚至形态结构异常变化的病理过程","layout":null},"children":[]}]},{"data":{"id":"dmb71390uvc0","created":1792654628363,"text":"1.常用血氧指标","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dmb71qal06o0","created":1792654678524,"text":"（1）血氧分压PO₂:\n物理溶解于血液中的氧分子所产生的张力","layout":null},"children":[{"data":{"id":"dmb72bl711s0","created":1792654724878,"text":"正常PaO₂约100mmHg:\n主要影响因素：PinO2与外呼吸功能","layout":null},"children":[]},{"data":{"id":"dmb73f5n9ww0","created":1792654811009,"text":"正常PvO₂约为40mmHg\n主要影响因素：组织摄取利用氧的水平（内呼吸状况）","layout":null},"children":[]}]},{"data":{"id":"dmb74eocl9c0","created":1792654888327,"text":"（2）血氧容量CO₂max:\n100ml血液中的血红蛋白被充分氧合后的最大携氧量","layout":null},"children":[{"data":{"id":"dmb75eq8a3k0","created":1792654966805,"text":"影响因素：血红蛋白的量和质","layout":null},"children":[]}]},{"data":{"id":"dmb75krt2ls0","created":1792654979961,"text":"（3）血氧含量CO₂：\n100ml血液中实际含有的氧量，\n包括物理溶解1.5%和化学结合98.5%的氧量","layout":null},"children":[{"data":{"id":"dmb76egqs3k0","created":1792655044595,"text":"主要影响因素：血氧容量和氧分压","layout":null},"children":[]},{"data":{"id":"dmb76oaa51k0","created":1792655065973,"text":"相关概念：动静脉血氧差","layout":null},"children":[{"data":{"id":"dmb771ep4h40","created":1792655094538,"text":"定义：动脉血氧含量19ml/dl减去静脉血氧含量14ml/dl所得","layout":null},"children":[]},{"data":{"id":"dmb77nd17nk0","created":1792655142326,"text":"正常值：5ml/dl","layout":null},"children":[]},{"data":{"id":"dmb77w3a4kg0","created":1792655161328,"text":"意义：反映了组织摄取利用氧的能力","layout":null},"children":[]}]}]},{"data":{"id":"dmb7d8hers00","created":1792655580124,"text":"（4）血红蛋白氧饱和度SO₂：\n血液中氧合Hb占总Hb的百分数","layout":null},"children":[{"data":{"id":"dmb7dw833w80","created":1792655631803,"text":"主要决定因素：血氧分压","layout":null},"children":[]},{"data":{"id":"dmb7fh7wta00","created":1792655755869,"text":"绿色：左移，亲和力增高；红色：右移","image":"https://p.cldisk.com/star4/dd2c3fb57a950a2329c9cb4db2a9b298/origin.png","imageTitle":"","imageSize":{"width":200,"height":88},"layout":null},"children":[]}]}]},{"data":{"id":"dmb719ctrqw0","created":1792654641654,"text":"2.缺氧的分类","layout":null,"image":"https://p.cldisk.com/star4/95d1432bde535af4f61fcf749a05b68f/origin.png","imageTitle":"","imageSize":{"width":200,"height":113},"expandState":"collapse"},"children":[{"data":{"id":"dmbfw6u5psw0","created":1792679634340,"text":"（1）乏氧性—摄取","layout":null},"children":[{"data":{"id":"dmbfwz8uh000","created":1792679696178,"text":"定义：乏氧性缺氧Hypoxic hypoxia\n是指由于动脉血氧分压降低导致\n组织供氧不足的缺氧，\n又称低张性缺氧","layout":null},"children":[]},{"data":{"id":"dmbfy3qz60w0","created":1792679784345,"text":"原因","layout":null},"children":[{"data":{"id":"dmbfy4u5mbc0","created":1792679786714,"text":"吸入气体氧分压过低：\n高原、矿井","layout":null},"children":[]},{"data":{"id":"dmbfyb3cimg0","created":1792679800332,"text":"外呼吸功能障碍：\n呼吸道狭窄、胸腔肺部疾病","layout":null},"children":[]},{"data":{"id":"dmbfyh0kqw00","created":1792679813224,"text":"动静脉分流：\n先心病","layout":null},"children":[]}]},{"data":{"id":"dmbfz0jpnvk0","created":1792679855740,"text":"特点：","layout":null},"children":[{"data":{"id":"dmbg12nvrdk0","created":1792680017074,"text":"\t\t\tPaO₂：↓","layout":null},"children":[]},{"data":{"id":"dmbg1guz5gg0","created":1792680047978,"text":"血氧容量：N 或 ↑（慢性缺氧Hb代偿增多）","layout":null},"children":[]},{"data":{"id":"dmbg1niw7480","created":1792680062485,"text":"CaO₂：↓","layout":null},"children":[]},{"data":{"id":"dmbg1q78o680","created":1792680068311,"text":"SaO₂：↓","layout":null},"children":[]},{"data":{"id":"dmbg1s4wn600","created":1792680072523,"text":"A-V血氧差：↓ 或 N","layout":null},"children":[{"data":{"id":"dmbg2wot9vc0","created":1792680160798,"text":"① 轻度缺氧：组织摄取氧基本不变，动静脉差可接近正常（N）","layout":null},"children":[]},{"data":{"id":"dmbg31csglc0","created":1792680170955,"text":"② 严重缺氧：组织供氧太少，组织利用氧变少，差值↓","layout":null},"children":[]}]},{"data":{"id":"dmbg1uhyfnk0","created":1792680077666,"text":"特征：发绀","layout":null},"children":[{"data":{"id":"dmbg3e64hwo0","created":1792680198850,"text":"定义：毛细血管中脱氧/还原血红蛋白HHb达到5g/dl以上时\n（正常值2.6g/dl），皮肤、黏膜呈现青紫色","layout":null},"children":[]},{"data":{"id":"dmbg481skgw0","created":1792680263892,"text":"缺氧≠发绀","layout":null},"children":[{"data":{"id":"dmbg4elz3pk0","created":1792680278173,"text":"Hb含量正常的人：发绀和缺氧同时存在，可通过|\n发绀程度估计缺氧程度","layout":null},"children":[]},{"data":{"id":"dmbg5dm33oo0","created":1792680354367,"text":"贫血：严重缺氧但不会发绀","layout":null},"children":[]},{"data":{"id":"dmbg6dgb9o80","created":1792680432382,"text":"红细胞增多症：明显发绀但不会缺氧","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dmbfwh8schk0","created":1792679656992,"text":"（2）血液性—携带","layout":null},"children":[{"data":{"id":"dmbg6y2krgo0","created":1792680477264,"text":"定义：由于血红蛋白含量减少或性质改变导致的\n血液携带的氧减少/血红蛋白结合的氧不易释出\n从而造成缺氧","layout":null},"children":[]},{"data":{"id":"dmbg7vmlp3k0","created":1792680550308,"text":"原因","layout":null},"children":[{"data":{"id":"dmbg80pfxg00","created":1792680561364,"text":"血红蛋白含量减少","layout":null},"children":[{"data":{"id":"dmbg869ab140","created":1792680573448,"text":"各种原因引起的贫血，单位体积血液中红细胞\n和Hb减少，虽然PaO2正常，但是氧容量降低，\n氧含量随之减少","note":"贫","layout":null},"children":[]},{"data":{"id":"dmbg9aeks340","created":1792680660839,"text":"贫血的判定:\n成年男性Hb＜12.0g/dl，\n成年女性Hb＜11.0g/dl","layout":null},"children":[]}]},{"data":{"id":"dmbga13phi80","created":1792680718955,"text":"一氧化碳中毒","layout":null},"children":[{"data":{"id":"dmbga6eon6o0","created":1792680730502,"text":"CO与Hb的亲和力是O2的210倍，形成HbCO但不能结合氧","layout":null},"children":[]},{"data":{"id":"dmbgarjks000","created":1792680776511,"text":"CO与Hb一个血红素结合后，\n将增加其余3个血红素对样的亲和力，\n使结合氧不易释放","layout":null},"children":[]},{"data":{"id":"dmbgbl9poo80","created":1792680841218,"text":"CO抑制糖酵解，2,3-DPG和H+生成减少，结合氧不宜释放","layout":null},"children":[]}]},{"data":{"id":"dmbgc88b57c0","created":1792680891199,"text":"高铁血红蛋白血症","layout":null},"children":[{"data":{"id":"dmbgee7eqe80","created":1792681060933,"text":"机制","layout":null},"children":[{"data":{"id":"dmbgcdy10940","created":1792680903638,"text":"Fe3+与羟基牢固结合，而不能结合氧","layout":null},"children":[]},{"data":{"id":"dmbgcryy2q00","created":1792680934168,"text":"剩余的Fe2+与O2亲和力增强，使得结合氧不易释放","layout":null},"children":[]}]},{"data":{"id":"dmbgek9akqg0","created":1792681074108,"text":"常见原因：\n食用大量含硝酸盐的腌菜（肠源性发绀）","layout":null},"children":[{"data":{"id":"dmbgemksyn40","created":1792681079158,"text":"皮肤、粘膜颜色：咖啡色（HbFe3+＞1.5g/dl）","layout":null},"children":[]},{"data":{"id":"dmbgg89l8ew0","created":1792681204733,"text":"乏氧性缺氧－青紫色","layout":null},"children":[]},{"data":{"id":"dmbggczap280","created":1792681214995,"text":"CO中毒－樱桃红色","layout":null},"children":[]},{"data":{"id":"dmbggeykx080","created":1792681219305,"text":"严重贫血—苍白","layout":null},"children":[]}]}]},{"data":{"id":"dmbggosm33s0","created":1792681240712,"text":"血红蛋白与氧的亲和力异常增高","layout":null},"children":[{"data":{"id":"dmbgh4a2pao0","created":1792681274419,"text":"情形","layout":null},"children":[{"data":{"id":"dmbghfat3u80","created":1792681298408,"text":"输入大量库存血（2,3-DPG↓）","layout":null},"children":[{"data":{"id":"dmc0kne4tzs0","created":1792737973314,"text":"尽量优先输注新鲜血；必须大量输库存血时，警惕隐匿性组织缺氧，不要只看 SpO₂、PaO₂；","layout":null},"children":[]},{"data":{"id":"dmc0kne500w0","created":1792737973315,"text":"大量输血后可适当监测乳酸（组织缺氧标志物）；","layout":null},"children":[]},{"data":{"id":"dmc0kne574g0","created":1792737973315,"text":"输注后数小时红细胞可重新合成 2,3-DPG，该效应可自行缓解","layout":null},"children":[]}]},{"data":{"id":"dmbghsr6kbk0","created":1792681327697,"text":"碱性液体（H+↓）","layout":null},"children":[{"data":{"id":"dmc0kxwzzxk0","created":1792737996223,"text":"休克、缺氧患者不要急于、过度补碱；","layout":null},"children":[]},{"data":{"id":"dmc0kxwzwyo0","created":1792737996223,"text":"纠正酸中毒以改善通气、改善循环、去除病因为首要，补碱指征严格，避免过度碱中毒；","layout":null},"children":[]},{"data":{"id":"dmc0kxx0x0g0","created":1792737996224,"text":"已经碱中毒的患者，组织供氧效率下降，即使氧合指标正常，组织依旧摄氧不足。","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dmc0ljrw4ow0","created":1792738043803,"text":"特点","layout":null},"children":[{"data":{"id":"dmbg12nvrdk0","created":1792680017074,"text":"\t\t\tPaO₂：N/N","layout":null},"children":[]},{"data":{"id":"dmbg1guz5gg0","created":1792680047978,"text":"血氧容量：⬇（贫血）/N（库存血）","layout":null},"children":[]},{"data":{"id":"dmbg1niw7480","created":1792680062485,"text":"CaO₂：↓","layout":null},"children":[]},{"data":{"id":"dmbg1q78o680","created":1792680068311,"text":"SaO₂：N","layout":null},"children":[]},{"data":{"id":"dmbg1s4wn600","created":1792680072523,"text":"A-V血氧差：↓ ","layout":null},"children":[]}]}]},{"data":{"id":"dmbfwnfbdjc0","created":1792679670448,"text":"（3）循环性—运输","layout":null},"children":[{"data":{"id":"dmc0na3wjjk0","created":1792738179490,"text":"定义：由于血液循环障碍导致组织灌流减少，\n从而造成缺氧","layout":null},"children":[{"data":{"id":"dmc0pnsw3zs0","created":1792738366027,"text":"缺血性缺氧：动脉血灌流不足","layout":null},"children":[{"data":{"id":"dmc1cvj42000","created":1792740185226,"text":"原因","layout":null},"children":[{"data":{"id":"dmc1czogt1s0","created":1792740194257,"text":"休克、心衰","layout":null},"children":[]},{"data":{"id":"dmc1i47dadc0","created":1792740595928,"text":"动脉血栓、动脉粥样硬化","layout":null},"children":[]}]},{"data":{"id":"dmc1iq6tvp40","created":1792740643785,"text":"毛细血管供血不足，皮肤苍白","layout":null},"children":[]}]},{"data":{"id":"dmc0q2i8va80","created":1792738398035,"text":"淤血性缺氧：静脉血回流受阻","layout":null},"children":[{"data":{"id":"dmc1ib0tumg0","created":1792740610770,"text":"原因","layout":null},"children":[{"data":{"id":"dmc1icbtp9c0","created":1792740613612,"text":"右心衰竭","layout":null},"children":[]},{"data":{"id":"dmc1iewqaso0","created":1792740619229,"text":"静脉栓塞","layout":null},"children":[]}]},{"data":{"id":"dmc1j0750i00","created":1792740665571,"text":"毛细血管内瘀血，皮肤发绀","layout":null},"children":[]}]}]},{"data":{"id":"dmc1jbbtrfk0","created":1792740689799,"text":"特点","layout":null},"children":[{"data":{"id":"dmbg12nvrdk0","created":1792680017074,"text":"\t\t\tPaO₂：N","layout":null},"children":[]},{"data":{"id":"dmbg1guz5gg0","created":1792680047978,"text":"血氧容量：N ","layout":null},"children":[]},{"data":{"id":"dmbg1niw7480","created":1792680062485,"text":"CaO₂：N","layout":null},"children":[]},{"data":{"id":"dmbg1q78o680","created":1792680068311,"text":"SaO₂：N","layout":null},"children":[]},{"data":{"id":"dmbg1s4wn600","created":1792680072523,"text":"A-V血氧差：⬆","layout":null},"children":[]}]}]},{"data":{"id":"dmbfwrtnq8w0","created":1792679680022,"text":"（4）组织性—使用","layout":null},"children":[{"data":{"id":"dmc1jz9pv6o0","created":1792740741914,"text":"定义：供氧正常情况下，组织、细胞\n利用氧发生障碍，ATP产生减少","layout":null},"children":[]},{"data":{"id":"dmc1kwhdnns0","created":1792740814211,"text":"病因：细胞线粒体生物氧化功能障碍","layout":null},"children":[{"data":{"id":"dmc1nfdlmfc0","created":1792741012070,"text":"1.氰化物中毒：使cyt aa3形成氰化高铁细胞色素\n氧化酶cyt aa3（FeCN3），0.06gHCN可使人死亡","layout":null},"children":[]},{"data":{"id":"dmc1oykrw080","created":1792741132227,"text":"2.维生素缺乏抑制呼吸酶活性","layout":null},"children":[{"data":{"id":"dmc1qvevlyw0","created":1792741282068,"text":"VitB1 （丙酮酸脱氢酶辅酶）","layout":null},"children":[]},{"data":{"id":"dmc1r7e0c680","created":1792741308137,"text":"VitB2 （黄素酶辅酶）","layout":null},"children":[]},{"data":{"id":"dmc1r7e078g0","created":1792741308137,"text":"VitPP（辅酶I与辅酶II的组成成分）","layout":null},"children":[]}]},{"data":{"id":"dmc1ranqoo80","created":1792741315256,"text":"3.线粒体损伤","layout":null},"children":[{"data":{"id":"dmc1sib4tfk0","created":1792741410272,"text":"损伤","layout":null},"children":[]},{"data":{"id":"dmc1sk9q5ns0","created":1792741414541,"text":"高温","layout":null},"children":[]},{"data":{"id":"dmc1sm5iva80","created":1792741418640,"text":"放射线辐射","layout":null},"children":[]},{"data":{"id":"dmc1ssux9jk0","created":1792741433237,"text":"细菌毒素","layout":null},"children":[]}]}]},{"data":{"id":"dmc1t4t19q80","created":1792741459244,"text":"特点","layout":null},"children":[{"data":{"id":"dmbg12nvrdk0","created":1792680017074,"text":"\t\t\tPaO₂：N","layout":null},"children":[]},{"data":{"id":"dmbg1guz5gg0","created":1792680047978,"text":"血氧容量：N ","layout":null},"children":[]},{"data":{"id":"dmbg1niw7480","created":1792680062485,"text":"CaO₂：N","layout":null},"children":[]},{"data":{"id":"dmbg1q78o680","created":1792680068311,"text":"SaO₂：N","layout":null},"children":[]},{"data":{"id":"dmbg1s4wn600","created":1792680072523,"text":"A-V血氧差：↓ ","layout":null},"children":[]},{"data":{"id":"dmc1tw8ncq00","created":1792741518961,"text":"由于氧合Hb含量高，皮肤粘膜呈现鲜红色或玫瑰红色","layout":null},"children":[]}]}]},{"data":{"id":"dmc1uladtio0","created":1792741573486,"text":"临床上混合型缺氧更常见，\n如：车祸→失血性休克","layout":null},"children":[{"data":{"id":"dmc1vejyn4g0","created":1792741637191,"text":"失血——血液型休克","layout":null},"children":[]},{"data":{"id":"dmc1vnk79s80","created":1792741656797,"text":"循环障碍——循环性缺氧","layout":null},"children":[]},{"data":{"id":"dmc1vvpkqu80","created":1792741674536,"text":"肺功能衰竭——低张性缺氧","layout":null},"children":[]},{"data":{"id":"dmc1w24y06w0","created":1792741688526,"text":"炎症反应/继发感染——组织性缺氧","layout":null},"children":[]}]}]},{"data":{"id":"dmb71c0w0600","created":1792654647462,"text":"3.缺氧对机体的影响","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dmc1xm06shk0","created":1792741810138,"text":"决定因素","layout":null},"children":[{"data":{"id":"dmc1xospp8w0","created":1792741816217,"text":"外因：程度、速度、时间","layout":null},"children":[]},{"data":{"id":"dmc1xu8l2ow0","created":1792741828060,"text":"内因：部位、机体代谢状态","layout":null},"children":[]}]},{"data":{"id":"dmc1y2ner2o0","created":1792741846371,"text":"后果","layout":null},"children":[{"data":{"id":"dmc1y54g3ow0","created":1792741851756,"text":"轻度——代偿反应","layout":null},"children":[]},{"data":{"id":"dmc1y9gdwo80","created":1792741861184,"text":"重度——代谢功能紊乱","layout":null},"children":[]}]},{"data":{"id":"dmc1yid0orc0","created":1792741880571,"text":"以乏氧性缺氧为例","layout":null},"children":[{"data":{"id":"dmc27x7j98g0","created":1792742618169,"text":"1.呼吸系统","layout":null},"children":[{"data":{"id":"dmc28dfsly80","created":1792742653497,"text":"（1）代偿性反应\n——肺通气量增大","layout":null},"children":[{"data":{"id":"dmc28qmvfc00","created":1792742682223,"text":"早期：PaO2↓ → 外周化学感受器 → 呼吸中枢↑ → 呼吸深快","layout":null},"children":[{"data":{"id":"dmc29v8zo3k0","created":1792742770632,"text":"意义","layout":null},"children":[{"data":{"id":"dmc29v90p9s0","created":1792742770633,"text":"✓ 增大呼吸面积，提高氧的弥散","layout":null},"children":[]},{"data":{"id":"dmc29v90tk80","created":1792742770633,"text":"✓ 促进静脉回流","layout":null},"children":[]}]}]},{"data":{"id":"dmc2a5afik00","created":1792742792486,"text":"后期：外周化学感受器敏感性↓ → 低氧通气反应↓","note":"当动脉血氧分压下降（PaO₂↓）时，机体通过外周化学感受器（颈动脉体、主动脉体）触发呼吸加深加快、通气量增加的代偿反应，这个整体反应就叫低氧通气反应。\n低氧通气反应↓ = 缺氧的时候，通气增加的代偿能力变弱了。","layout":null},"children":[{"data":{"id":"dmc2ah8dv1c0","created":1792742818484,"text":"意义","layout":null},"children":[{"data":{"id":"dmc2ah8e7e80","created":1792742818485,"text":"✓ 降低耗氧量","layout":null},"children":[]}]}]}]},{"data":{"id":"dmc2bfowc8o0","created":1792742893493,"text":"（2）损伤性反应\n—高原性水肿","layout":null},"children":[{"data":{"id":"dmc2ceawj7s0","created":1792742968834,"text":"从平原快速进入 2500m 以上高原时，\n因低压缺氧而发生的一种高原特发性疾病，","layout":null},"children":[]},{"data":{"id":"dmc2cipmz000","created":1792742978432,"text":"临床表现","layout":null},"children":[{"data":{"id":"dmc2d2b0t1c0","created":1792743021084,"text":"呼吸困难","layout":null},"children":[]},{"data":{"id":"dmc2d2b0ee00","created":1792743021084,"text":"严重发绀","layout":null},"children":[]},{"data":{"id":"dmc2d2b0gr40","created":1792743021084,"text":"咳粉红色泡沫痰或白色泡沫痰","layout":null},"children":[]},{"data":{"id":"dmc2d2b12dc0","created":1792743021085,"text":"肺部有湿啰音等。","layout":null},"children":[]}]},{"data":{"id":"dmc2kjd4okg0","created":1792743606766,"text":"发病机制","layout":null},"children":[{"data":{"id":"dmc2kjd4k6g0","created":1792743606766,"text":"✓ 肺血管收缩，肺动脉压↑，肺毛细血管内压↑","layout":null},"children":[]},{"data":{"id":"dmc2kjd4yco0","created":1792743606767,"text":"✓ 外周血管收缩，肺血流量增多","layout":null},"children":[]}]}]},{"data":{"id":"dmc2l8gdd940","created":1792743661382,"text":"中枢性呼吸衰竭","layout":null},"children":[{"data":{"id":"dmc2lcm5f940","created":1792743670438,"text":"当PaO2＜30mmHg→抑制呼吸中枢，","layout":null},"children":[]},{"data":{"id":"dmc2mnu5mrk0","created":1792743773232,"text":"出现周期性呼吸、呼吸减弱甚至停止，\n介绍两种周期性呼吸","layout":null},"children":[{"data":{"id":"dmc2mz5f4340","created":1792743797857,"text":"-陈 - 施呼吸（潮式呼吸）：","layout":null},"children":[{"data":{"id":"dmc2nc5xko80","created":1792743826186,"text":"呼吸由浅慢→逐渐加深加快→再逐渐变浅慢→呼吸暂停，循环往复。","layout":null},"children":[]},{"data":{"id":"dmc2mz5fkh40","created":1792743797858,"text":"机制：呼吸中枢对 CO₂的反馈延迟，多见于脑损伤、心衰、严重缺氧。","layout":null},"children":[]}]},{"data":{"id":"dmc2mz5fytk0","created":1792743797858,"text":"-Biot 呼吸（间停呼吸）：","layout":null},"children":[{"data":{"id":"dmc2np4icao0","created":1792743854398,"text":"规律呼吸几次后，突然停止一段时间，之后又开始呼吸；\n节律更不规则，预后更差，提示呼吸中枢抑制更重。","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dmc280um4ds0","created":1792742626095,"text":"2.血液系统","layout":null},"children":[{"data":{"id":"dmc2ohdsng80","created":1792743915910,"text":"（1）代偿性反应：","layout":null},"children":[{"data":{"id":"dmc2ovzlhcg0","created":1792743947704,"text":"红细胞和血红蛋白增多","layout":null},"children":[{"data":{"id":"dmc2qaz7tog0","created":1792744058696,"text":"慢性缺氧\n→促红细胞生成素⬆\n→骨髓造血⬆\n→携氧⬆","layout":null},"children":[]}]},{"data":{"id":"dmc2pbms8b40","created":1792743981757,"text":"红细胞内2,3-DPG增多，\n红细胞释氧能力增强","layout":null},"children":[{"data":{"id":"dmc2r2nrwyg0","created":1792744118954,"text":"缺氧\n→糖酵解⬆\n→2,3-DPG⬆，H+⬆\n→氧离曲线右移","layout":null},"children":[]}]}]},{"data":{"id":"dmc2q0mcdxc0","created":1792744036150,"text":"（2）损伤性反应","layout":null},"children":[{"data":{"id":"dmc2q496g000","created":1792744044061,"text":"RBC生成过度增多\n→血液粘滞度⬆\n→外周阻力⬆\n→心脏后负荷⬆","layout":null},"children":[]}]}]},{"data":{"id":"dmc282yhgns0","created":1792742630682,"text":"3.循环系统","layout":null},"children":[{"data":{"id":"dmc2so61anc0","created":1792744244135,"text":"（1）代偿性反应：","layout":null},"children":[{"data":{"id":"dmc2svzzts00","created":1792744261184,"text":"心脏射血功能增强","layout":null},"children":[{"data":{"id":"dmc2t96g02g0","created":1792744289872,"text":"缺氧\n→①交感神经兴奋➡心率⬆，心收缩力⬆\n   ②呼吸⬆➡静脉回流⬆\n→心输出量⬆","layout":null},"children":[]}]},{"data":{"id":"dmc2t2rapbs0","created":1792744275895,"text":"缺氧性肺血管收缩","layout":null},"children":[{"data":{"id":"dmc2upsswe00","created":1792744404417,"text":"缺氧\n→交感神经兴奋，血管活性物质不平衡（EDCF＞EDRF）\n→肺血管收缩\n→维持V/Q正常","layout":null},"children":[]}]},{"data":{"id":"dmc3gusitl40","created":1792746139295,"text":"血流重新分布","layout":null},"children":[{"data":{"id":"dmc3gywv0m80","created":1792746148264,"text":"缺氧\n→①交感兴奋⬆→皮肤内脏血管收缩、心脑血管扩张\n   ②代谢产物⬆（乳酸、腺苷等）→心脑血管扩张","layout":null},"children":[]},{"data":{"id":"dmcml3a8izc0","created":1792800072325,"text":"解释“高反时为何食欲不振、头痛欲裂”：\n高原低氧是根本原因","layout":null},"children":[{"data":{"id":"dmcmn8p2sgg0","created":1792800240835,"text":"1. 头痛：低氧使脑血管扩张，脑血流量增加、\n颅内压升高，引发胀痛；\n代谢产物堆积加重头痛。严重时提示高原脑水肿。","layout":null},"children":[]},{"data":{"id":"dmcmn8p33l40","created":1792800240835,"text":"2. 食欲减退：机体血流重分配，胃肠道供血减少；\n交感兴奋抑制胃肠蠕动与消化液分泌；\n低氧刺激延髓呕吐中枢，出现恶心、食欲下降。","layout":null},"children":[]}]}]},{"data":{"id":"dmcmo3chuz40","created":1792800307554,"text":"组织毛细血管增生","layout":null},"children":[{"data":{"id":"dmcmofyo8lc0","created":1792800335017,"text":"慢性缺氧\n→①HIF-1⬆→VEGF⬆\n   ②ATP⬇→腺苷⬆\n→毛细血管增生\n→缩短氧弥散距离","layout":null},"children":[]}]}]},{"data":{"id":"dmcmpztbrqo0","created":1792800456593,"text":"（2）损伤性反应\n——肺源性心脏病","layout":null},"children":[{"data":{"id":"dmcmqaddewg0","created":1792800479573,"text":"缺氧\n→①交感神经兴奋；\n   ②血管活性物质\n→肺血管收缩/重构\n→右心肥厚\n→肺心病","layout":null},"children":[]}]}]},{"data":{"id":"dmc285bcez40","created":1792742635813,"text":"4.组织细胞","layout":null},"children":[{"data":{"id":"dmcmrj6ag680","created":1792800577101,"text":"（1）代偿性反应","layout":null},"children":[{"data":{"id":"dmcmroistd40","created":1792800588740,"text":"利用氧的能力⬆","layout":null},"children":[]},{"data":{"id":"dmcmryh4a3k0","created":1792800610406,"text":"糖酵解⬆（尽可能多产生ATP）","layout":null},"children":[]},{"data":{"id":"dmcms8u3j340","created":1792800632959,"text":"低代谢状态","layout":null},"children":[]},{"data":{"id":"dmcmsewaixc0","created":1792800646152,"text":"肌/脑/胞红蛋白（尽可能多储备氧）","layout":null},"children":[]}]},{"data":{"id":"dmcmzoh5d1s0","created":1792801215554,"text":"（2）损伤性反应","layout":null},"children":[{"data":{"id":"dmcmztnx3uw0","created":1792801226847,"text":"ATP⬇\n→①钠钾泵⬇→Na+内流→细胞水肿\n   ②钙泵⬇→Ca2+超载→组织损伤","layout":null},"children":[]},{"data":{"id":"dmcn172yo6w0","created":1792801334419,"text":"线粒体损伤——严重缺氧造成线粒体结构破坏","layout":null},"children":[]}]}]},{"data":{"id":"dmc2872c6w80","created":1792742639622,"text":"5.中枢神经系统","layout":null},"children":[{"data":{"id":"dmcn2l47xuo0","created":1792801443334,"text":"- 中枢神经系统耗氧量大，对缺氧不耐受，\n尤以灰质更敏感","layout":null},"children":[]},{"data":{"id":"dmcn2l483rs0","created":1792801443334,"text":"- 缺氧对中枢神经系统的作用\n基本上表现为损伤反应","layout":null},"children":[{"data":{"id":"dmcn2l489t40","created":1792801443335,"text":"✓ 急性：头痛、激动、记忆力下降等","layout":null},"children":[]},{"data":{"id":"dmcn2l487xs0","created":1792801443335,"text":"✓ 慢性：疲劳、嗜睡、注意力不集中等","layout":null},"children":[]},{"data":{"id":"dmcn2l48kf40","created":1792801443335,"text":"✓ 严重：烦躁、惊厥、昏迷、死亡","layout":null},"children":[]}]},{"data":{"id":"dmcn31ma4xs0","created":1792801479255,"text":"机制","layout":null},"children":[{"data":{"id":"dmcn31matiw0","created":1792801479256,"text":"**脑细胞损伤、脑水肿**","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dmb71hy77i80","created":1792654660360,"text":"4.缺氧的治疗原则","layout":null},"children":[{"data":{"id":"dmcn3j7q6740","created":1792801517557,"text":"（1）消除病因：\n脱离低氧环境，\n治疗原发疾病","layout":null},"children":[]},{"data":{"id":"dmcn3yrqw2w0","created":1792801551419,"text":"（2）纠正缺氧：\n吸氧治疗\n防止氧中毒","layout":null},"children":[{"data":{"id":"dmcn4n9zgko0","created":1792801604765,"text":"吸氧","layout":null},"children":[{"data":{"id":"dmcn55defww0","created":1792801644153,"text":"对吸入气氧分压过低与外呼吸功能障碍引起的乏氧性缺氧最有效"},"children":[]},{"data":{"id":"dmcn55dewmo0","created":1792801644154,"text":"对动静脉分流患者治疗效果甚微"},"children":[]},{"data":{"id":"dmcn55df1yw0","created":1792801644154,"text":"组织性缺氧治疗关键是解除呼吸链酶的抑制"},"children":[]}]},{"data":{"id":"dmcn5c3m2s00","created":1792801658799,"text":"高压氧"},"children":[{"data":{"id":"dmcn5ekqwgo0","created":1792801664189,"text":"对CO中毒患者疗效显著"},"children":[]},{"data":{"id":"dmcn5p9bups0","created":1792801687443,"text":"原因：高压氧能极大提高血液里 O₂浓度，\n大量O2与CO竞争性结合Hb，加速CO与Hb解离"},"children":[]}]},{"data":{"id":"dmcn8nyw0cg0","created":1792801919727,"text":"氧中毒"},"children":[{"data":{"id":"dmcn8vpiwpc0","created":1792801936575,"text":"损伤机制：自由基形成过多对组织细胞产生氧化损伤"},"children":[]}]}]}]},{"data":{"id":"dmcn9kclpag0","created":1792801990213,"text":"5.关于缺氧时的皮肤粘膜颜色"},"children":[{"data":{"id":"dmcnaez62n40","created":1792802056881,"text":"A. 苍白色 —— 贫血、缺血性缺氧"},"children":[]},{"data":{"id":"dmcnakfxkv40","created":1792802068779,"text":"B. 青紫色（发绀） —— 乏氧性缺氧、淤血性缺氧"},"children":[]},{"data":{"id":"dmcnanpqwwg0","created":1792802075903,"text":"C. 樱桃红色 —— CO 中毒"},"children":[]},{"data":{"id":"dmcnar9n33c0","created":1792802083636,"text":"D. 咖啡色（棕褐色） —— **高铁血红蛋白血症（亚硝酸盐中毒）**"},"children":[]},{"data":{"id":"dmcnaukthf40","created":1792802090842,"text":"E. 鲜红色 —— **组织性缺氧**（氰化物中毒）、库存血、碱性液体"},"children":[]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}