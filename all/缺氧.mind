{"root":{"data":{"id":"dmb0xx0n4js0","created":1792637453044,"text":"缺氧\nHypoxia"},"children":[{"data":{"id":"dmb6zvlqg200","created":1792654533353,"text":"定义"},"children":[{"data":{"id":"dmb6zxn4ko00","created":1792654537791,"text":"组织细胞供氧不足或用氧障碍\n引起代谢、功能甚至形态结构异常变化的病理过程"},"children":[]}]},{"data":{"id":"dmb71390uvc0","created":1792654628363,"text":"1.常用血氧指标"},"children":[{"data":{"id":"dmb71qal06o0","created":1792654678524,"text":"（1）血氧分压PO₂:\n物理溶解于血液中的氧分子所产生的张力"},"children":[{"data":{"id":"dmb72bl711s0","created":1792654724878,"text":"正常PaO₂约100mmHg:\n主要影响因素：PinO2与外呼吸功能"},"children":[]},{"data":{"id":"dmb73f5n9ww0","created":1792654811009,"text":"分支主题"},"children":[]}]}]},{"data":{"id":"dmb719ctrqw0","created":1792654641654,"text":"2.缺氧的分类"},"children":[]},{"data":{"id":"dmb71c0w0600","created":1792654647462,"text":"3.缺氧对机体的影响"},"children":[]},{"data":{"id":"dmb71hy77i80","created":1792654660360,"text":"4.缺氧的治疗原则‘"},"children":[]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}