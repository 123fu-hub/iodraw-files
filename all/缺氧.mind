{"root":{"data":{"id":"dmb0xx0n4js0","created":1792637453044,"text":"缺氧\nHypoxia"},"children":[{"data":{"id":"dmb6zvlqg200","created":1792654533353,"text":"定义"},"children":[{"data":{"id":"dmb6zxn4ko00","created":1792654537791,"text":"组织细胞供氧不足或用氧障碍\n引起代谢、功能甚至形态结构异常变化的病理过程"},"children":[]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}