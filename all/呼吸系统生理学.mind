"layout":null},"children":[]},{"data":{"id":"dm2hq2n765c0","created":1791770757637,"text":"ΔP：压力梯度（分压差）\nA：扩散面积\nT：温度\nd：扩散距离\nS：气体在液体中的溶解度\nMr：相对分子质量\nS/√Mr：扩散系数","layout":null},"children":[]},{"data":{"id":"dm2hs914quo0","created":1791770928268,"text":"二氧化碳的扩散系数时氧气的20倍","layout":null},"children":[]}]}]},{"data":{"id":"dm2hsnr9xso0","created":1791770960324,"text":"过程","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dm2hsu0sorc0","created":1791770973960,"text":"肺泡气与血液通过呼吸膜的扩散","layout":null},"children":[{"data":{"id":"dm2htba5ppc0","created":1791771011532,"text":"呼吸膜","layout":null},"children":[{"data":{"id":"dm2htiibfcw0","created":1791771027263,"text":"结构：","layout":null},"children":[{"data":{"id":"dm2hwo8urag0","created":1791771274844,"text":"1.含表面活性物质的液体分子层","layout":null},"children":[]},{"data":{"id":"dm2hwo8uww80","created":1791771274844,"text":"2.肺泡上皮细胞","layout":null},"children":[]},{"data":{"id":"dm2hwo8vhls0","created":1791771274845,"text":"3.肺泡上皮基膜","layout":null},"children":[]},{"data":{"id":"dm2hwo8vwxc0","created":1791771274845,"text":"4.组织间隙","layout":null},"children":[]},{"data":{"id":"dm2hwo8vojc0","created":1791771274845,"text":"5.毛细血管基膜","layout":null},"children":[]},{"data":{"id":"dm2hwo8vnco0","created":1791771274845,"text":"6.毛细血管内皮细胞","layout":null},"children":[]}]},{"data":{"id":"dm2hwzw41200","created":1791771300194,"text":"特点","layout":null},"children":[{"data":{"id":"dm2hx137mw80","created":1791771302801,"text":"总厚度0.6μm，总面积70m²","layout":null},"children":[]}]}]},{"data":{"id":"dm2i035wr8w0","created":1791771542410,"text":"交换需时：0.3s\n血流时间：0.7s","layout":null},"children":[]},{"data":{"id":"dm2i0na9l0g0","created":1791771586209,"text":"影响肺气体交换的因素","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dm2i1frq2o80","created":1791771648214,"text":"1.气体分压差","layout":null},"children":[]},{"data":{"id":"dm2i1jz900g0","created":1791771657376,"text":"2.气体扩散系数","layout":null},"children":[{"data":{"id":"dm2i1zvpigo0","cr