children":[]},{"data":{"id":"dm2ggm6cekw0","created":1791767195402,"text":"≥93%","layout":null},"children":[]}]},{"data":{"id":"dm2gl85ykdk0","created":1791767556724,"text":"无效腔","layout":null,"image":"https://p.cldisk.com/star4/880d5914bdfb005176bcbb96c986533f/origin.png","imageTitle":"","imageSize":{"width":200,"height":108}},"children":[{"data":{"id":"dm2glcu4kk00","created":1791767566893,"text":"解剖无效腔","layout":null},"children":[{"data":{"id":"dm2glqr52z40","created":1791767597187,"text":"从鼻 / 口 → 气管 → 各级支气管，\n直到终末细支气管之前的传导气道","layout":null},"children":[]},{"data":{"id":"dm2glxh8he00","created":1791767611826,"text":"这一段管道没有肺泡，不能进行气体交换","layout":null},"children":[]},{"data":{"id":"dm2gvmn1k8w0","created":1791768371874,"text":"150mL","layout":null},"children":[]}]},{"data":{"id":"dm2gn2g0ym00","created":1791767701001,"text":"肺泡无效腔","layout":null},"children":[{"data":{"id":"dm2gn6g499c0","created":1791767709713,"text":"肺泡虽然通气（有气体进入），\n但肺泡周围没有足够毛细血管血流灌注，\n气体无法和血液交换，这部分肺泡容积叫肺泡无效腔","layout":null},"children":[]},{"data":{"id":"dm2go0pz7z40","created":1791767775613,"text":"健康人：几乎为 0；\n✅病理情况增大：肺动脉栓塞、休克、肺血管受压，部分肺泡有气无血","layout":null},"children":[]}]},{"data":{"id":"dm2gocs3id40","created":1791767801862,"text":"生理无效腔","layout":null},"children":[{"data":{"id":"dm2gokeic3k0","created":1791767818455,"text":"= 解剖无效腔 + 肺泡无效腔","layout":null},"children":[]}]}]},{"data":{"id":"dm2gwoor1js0","created":1791768454695,"text":"肺泡通气量alveolar ventilation","layout":null},"children":[{"data":{"id":"dm2gwy4tba80","created":1791768475257,"text":"=（潮气量-无效腔气量）×呼吸频率","layout":null},"children":[]},{"data":{"id":"dm2h91zr4vc0","created":1791769424029,"text":"不同情况的影响","layout":null},"children":[{"data":{"id":"dm2h9k4e4i80","created":1791769463491,"text":"平静呼吸","layout":null},"children":[{"data":{"id":"dm2haohtga80","created":1791769551374,"text":"每分通气量=16x500=8000","layout":null},"children":[]},{"data":{"id":"dm2ha3imn0w0","created":1791769505711,"text":"肺泡通气量=16×（500-150）=5600","layout":null},"ch