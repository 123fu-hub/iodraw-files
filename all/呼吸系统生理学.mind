1790072393,"text":"后果：呼吸膜面积下降","layout":null},"children":[]}]}]}]},{"data":{"id":"dm2u37rs8so0","created":1791805640851,"text":"5.通气/血流比值","layout":null},"children":[{"data":{"id":"dm2u3h3kg6w0","created":1791805661154,"text":"每分肺泡通气量VA / 每分肺血流量Q","layout":null},"children":[]},{"data":{"id":"dm2u4ojnjq00","created":1791805755729,"text":"安静时VA/Q = 4.2L / 5L = 0.84\n此时气体交换效率最高","layout":null},"children":[]},{"data":{"id":"dm2u6gr2z200","created":1791805895492,"text":"该比值的变化提示什么","layout":null},"children":[{"data":{"id":"dm2u6m4f6hs0","created":1791805907182,"text":"直立体位","layout":null},"children":[{"data":{"id":"dm2u78ltuwg0","created":1791805956124,"text":"肺尖VA/Q高于正常值","layout":null},"children":[]},{"data":{"id":"dm2u7ne0n1k0","created":1791805988304,"text":"肺底VA/Q低于正常值","layout":null},"children":[]}]},{"data":{"id":"dm2ul873c000","created":1791807052331,"text":"正常情况下的不同","layout":null},"children":[{"data":{"id":"dm2u882ul2g0","created":1791806033341,"text":"正常情况下存在着肺泡通气和血流的不均匀分布，\n但从总体上说，由于呼吸膜面积远远超过气体交换的实际需要，\n所以并未明显影响O2的摄取和CO2的排出","layout":null},"children":[]}]},{"data":{"id":"dm2ul4m3luo0","created":1791807044532,"text":"病变时","layout":null},"children":[{"data":{"id":"dm2ulij1bmw0","created":1791807074822,"text":"血流不足，比值增加","layout":null},"children":[{"data":{"id":"dm2utrzz25s0","created":1791807722350,"text":"肺泡无效腔增大","layout":null},"children":[]},{"data":{"id":"dm2uv9veh9s0","created":1791807839620,"text":"如肺血管栓塞","layout":null},"children":[]}]},{"data":{"id":"dm2uu4gxapk0","created":1791807749496,"text":"通气不足，比值降低","layout":null},"children":[{"data":{"id":"dm2uuatrmmo0","created":1791807763334,"text":"功能性动-静脉短路\n（静脉血未经充分氧合就流入动脉）","layout":null},"children":[]},{"data":{"id":"dm2uvesc0o00","created":1791807850318,"text":"如支气管痉挛","layout":null},"children":[]}]}]}]}]}]}]},{"data":{"id":"dm2ux7ez9uw0","created":1791807991002,"text":"组织换气（液-液交换）","layout":null},"children":[{"data":{"id":"dm2uym3o6800","created":1791808101334,"text":"机制","layout":null},"children":[{"data":{"id":"dm2uyu0q0tc0","created":1791808118570,"text":"类似于肺泡与血液","layout":null},"children":[]},{"data":{"id":"dm2uyyjuwgw0","created":1791808128434,"text":"不同之处","layout":null},"children":[{"data":{"id":"dm2uz05p4mw0","created":1791808131931,"text":"液相之间","layout":null},"children":[]},{"data":{"id":"dm2uz395isg0","created":1791808138670,"text":"扩散膜两侧O2和CO2的分压差\n随细胞内氧化代谢的强度和组织血流量而异","layout":null},"children":[]},{"data":{"id":"dm2uzn4cai80","created":1791808181915,"text":"如果血流量不变时，代谢增强、耗O2多，\n则组织液中PO2降低，PCO2升高；\n如果代谢率不变，血流量增大，\n则组织液中PO2升高，PCO2降低","layout":null},"children":[]}]}]},{"data":{"id":"dm2uzuq24wg0","created":1791808198466,"text":"影响因素","layout":null},"children":[{"data":{"id":"dm2uzwmzwuw0","created":1791808202634,"text":"组织活动","layout":null},"children":[]},{"data":{"id":"dm2uzy9ld3k0","created":1791808206177,"text":"组织血流量","layout":null},"children":[]}]}]}]},{"data":{"id":"dm2v0gh4m6g0","created":1791808245815,"text":"影响因素","layout":null},"children":[{"data":{"id":"dm2v0i6xacg0","created":1791808249552,"text":"各种气体的分压差","layout":null},"children":[{"data":{"id":"dm2v0os1vc00","created":1791808263890,"text":"分压差大，扩散与换气快，\n在同样分压下， CO2的扩散系数是 O2的20倍","layout":null},"children":[]}]},{"data":{"id":"dm2v0xau6yg0","created":1791808282440,"text":"呼吸膜的厚度和面积","layout":null},"children":[{"data":{"id":"dm2v105cxcg0","created":1791808288639,"text":"肺纤维化使呼吸膜增厚，\n肺气肿使呼吸面积减小均使换气减少。","layout":null},"children":[]}]},{"data":{"id":"dm2v19taexs0","created":1791808309677,"text":"通气／血流比值","layout":null},"children":[{"data":{"id":"dm2v1ey75uo0","created":1791808320858,"text":"比值增大","layout":null},"children":[{"data":{"id":"dm2v1hgdhh40","created":1791808326310,"text":"可能通气过多或血流不足，\n部分肺泡气未能与血液气充分交换，\n肺泡无效腔增大；","layout":null},"children":[]}]},{"data":{"id":"dm2v1kp8wb40","created":1791808333377,"text":"比值减小","layout":null},"children":[{"data":{"id":"dm2v1muwpvs0","created":1791808338073,"text":"表明肺通气不足或血流过多，\n部分血流经通气不良的肺泡，\n混合静脉血中的气体未充分更新，尤似发生动静脉短路，\n均能影响有效的气体交换，\n造成缺 O2或 CO2潴留。","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dm1ncn4h7ao0","created":1791685071822,"text":"气体运输\ngas transportation","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dm2v3h977jk0","created":1791808482605,"text":"氧气和二氧化碳在\n血液中存在形式","layout":null},"children":[{"data":{"id":"dm2v3xe1psg0","created":1791808517727,"text":"物理溶解：少","layout":null},"children":[]},{"data":{"id":"dm2v47nzq740","created":1791808540096,"text":"化学结合：多","layout":null},"children":[]}]},{"data":{"id":"dm2v2fa9mz40","created":1791808399952,"text":"O₂的运输","layout":null},"children":[{"data":{"id":"dm2v4mp7i1c0","created":1791808572821,"text":"血液中的运输形式","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dm2v4q06ut40","created":1791808580015,"text":"物理溶解：1.5%","layout":null},"children":[]},{"data":{"id":"dm2v4uzed1c0","created":1791808590851,"text":"化学结合：98.5%\n氧合血红蛋白HbO₂","layout":null},"children":[]}]},{"data":{"id":"dm2val3ikbk0","created":1791809039517,"text":"O₂与HbO₂的可逆性结合","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dm2vba2ykv40","created":1791809093904,"text":"结合特征","layout":null},"children":[{"data":{"id":"dm2vbn03um00","created":1791809122029,"text":"快速、可逆","layout":null},"children":[]},{"data":{"id":"dm2vbqd61ds0","created":1791809129349,"text":"不需要酶催化","layout":null},"children":[]},{"data":{"id":"dm2vbv1wh6w0","created":1791809139552,"text":"受PO₂影响","layout":null},"children":[]},{"data":{"id":"dm2vc0wpne00","created":1791809152299,"text":"Fe²⁺与O₂的结合是氧合而不是氧化","layout":null},"children":[]},{"data":{"id":"dm2vdbo22m00","created":1791809254084,"text":"1分子Hb可结合4分子O₂","layout":null},"children":[]},{"data":{"id":"dm2vdlfupso0","created":1791809275356,"text":"Hb有变构效应","layout":null},"children":[]}]},{"data":{"id":"dm2w1k2ce0o0","created":1791811153102,"text":"几个名词","layout":null},"children":[{"data":{"id":"dm2w0dxctzs0","created":1791811061376,"text":"Hb氧容量","layout":null},"children":[{"data":{"id":"dm2w0n0zfsw0","created":1791811081186,"text":"100mL血中所能结合的最大O₂量","layout":null},"children":[]}]},{"data":{"id":"dm2w0vc05qw0","created":1791811099267,"text":"Hb氧含量","layout":null},"children":[{"data":{"id":"dm2w1caxfm00","created":1791811136207,"text":"100mL血中Hb实际结合的O₂量","layout":null},"children":[]}]},{"data":{"id":"dm2w1t4j1gg0","created":1791811172825,"text":"Hb氧饱和度","layout":null},"children":[{"data":{"id":"dm2w1vnf4i80","created":1791811178321,"text":"Hb氧含量和Hb氧容量的百分比","layout":null},"children":[]}]}]},{"data":{"id":"dm2w2r0v4yo0","created":1791811246614,"text":"颜色","layout":null},"children":[{"data":{"id":"dm2w28bcez40","created":1791811205889,"text":"HbO₂鲜红色\n脱氧Hb呈紫蓝色","layout":null},"children":[]},{"data":{"id":"dm2w2uxbvbk0","created":1791811255108,"text":"紫绀/发绀：脱氧Hb＞5g/100mL","layout":null},"children":[{"data":{"id":"dm2w3dhe56g0","created":1791811295503,"text":"珠蛋白基因缺陷导致的贫血，\n脱氧Hb没有超过5g/100mL，就有紫绀","layout":null},"children":[]},{"data":{"id":"dm2w3mqr2l40","created":1791811315660,"text":"高原红细胞生成增多是虽然脱氧Hb ＞5g/100mL，\n但也不发绀，高原特殊面容，高原红","layout":null},"children":[]},{"data":{"id":"dm2w3rn6ly80","created":1791811326328,"text":"特殊的CO中毒，脱氧Hb ＞5g/100mL，\n也不发绀，而是樱桃红色。","layout":null},"children":[]}]}]}]},{"data":{"id":"dm2w448lo9s0","created":1791811353745,"text":"氧离曲线","expandState":"collapse","layout":null,"image":"https://p.cldisk.com/star4/7a0b4ca024c4951c7d264d47edde21d4/origin.png","imageTitle":"","imageSize":{"width":200,"height":138}},"children":[{"data":{"id":"dm2w4dwtjsw0","created":1791811374800,"text":"表示O₂分压与Hb氧结合量\n或Hb氧饱和度关系的曲线\n呈s形","layout":null},"children":[]},{"data":{"id":"dm2w5pbkek80","created":1791811478001,"text":"特征及生理意义","layout":null},"children":[{"data":{"id":"dm2w5sxaf2w0","created":1791811485844,"text":"上段：PO₂60~100mmHg","layout":null},"children":[{"data":{"id":"dm2w64w7q0g0","created":1791811511901,"text":"曲线较平坦","layout":null},"children":[]},{"data":{"id":"dm2w67wnze00","created":1791811518458,"text":"Hb与O₂结合","layout":null},"children":[]},{"data":{"id":"dm2w6g0siao0","created":1791811536122,"text":"PO₂降低对氧饱和度没有显著的影响","layout":null},"children":[]},{"data":{"id":"dm2w6on3mqo0","created":1791811554885,"text":"有利于高原、高空或轻度呼吸系统疾病时供氧","font-weight":"bold","color":"#ff0000","layout":null},"children":[]}]},{"data":{"id":"dm2w7e5yj5s0","created":1791811610445,"text":"中段：PO₂40~60mmHg","layout":null},"children":[{"data":{"id":"dm2w7kh98io0","created":1791811624189,"text":"坡度较陡","layout":null},"children":[]},{"data":{"id":"dm2w7nymejs0","created":1791811631769,"text":"HbO₂释放O₂的部分","layout":null},"children":[]},{"data":{"id":"dm2w7usjhy00","created":1791811646639,"text":"PO₂O₂变化对Hb氧饱和度有影响","layout":null},"children":[]},{"data":{"id":"dm2w83kgjq80","created":1791811665742,"text":"维持正常时组织的氧供","color":"#ff0000","font-weight":"bold","layout":null},"children":[]}]},{"data":{"id":"dm4jthyuhbc0","created":1791979788218,"text":"下段：PO₂10~40mmHg","layout":null},"children":[{"data":{"id":"dm4jtrtzro00","created":1791979809693,"text":"坡度最陡","layout":null},"children":[]},{"data":{"id":"dm4jtzlj0tc0","created":1791979826595,"text":"HbO₂与O₂解离的部分","layout":null},"children":[]},{"data":{"id":"dm4ju8eksyo0","created":1791979845766,"text":"PO₂变化对Hb氧饱和度有显著影响","layout":null},"children":[]},{"data":{"id":"dm4jukpe8lc0","created":1791979872541,"text":"有利于组织活动加强时供氧","color":"#ff0000","font-weight":"bold","layout":null},"children":[]}]}]}]},{"data":{"id":"dm4jvdxzbmo0","created":1791979936187,"text":"影响氧离曲线的因素","layout":null},"children":[{"data":{"id":"dm4jvhg50lc0","created":1791979943816,"text":"关键值","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dm4jvlxe9s80","created":1791979953566,"text":"P₅₀:表示Hb对O₂的亲和力\n即Hb氧饱和度达50%时的PO₂","layout":null},"children":[]},{"data":{"id":"dm4jxtivx9k0","created":1791980126831,"text":"P₅₀增大，表明亲和力下降，曲线右移","layout":null},"children":[]}]},{"data":{"id":"dm4jy6xchmo0","created":1791980156004,"text":"PH对PCO₂的影响","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dm4jzhhv55s0","created":1791980257377,"text":"PH⬇或PCO₂⬆，\n则Hb对O₂的亲和力下降，\n曲线右移","image":"https://p.cldisk.com/star4/10957600564de609531dc1d391851533/origin.png","imageTitle":"","imageSize":{"width":200,"height":81},"layout":null},"children":[]},{"data":{"id":"dm4k06w6sbk0","created":1791980312662,"text":"波尔效应","layout":null},"children":[{"data":{"id":"dm4k1bkwzds0","created":1791980401229,"text":"流经组织时：\nCO₂扩散入血，PCO₂和[H⁺]升高，曲线右移\n亲和力降低，促使HbO₂解离向组织释放更多的O₂","layout":null},"children":[]},{"data":{"id":"dm4k2kwrgow0","created":1791980499900,"text":"流经肺时：\nCO₂扩散入肺泡，PCO₂和[H⁺]降低，曲线左移\n亲和力增加，促使HbO₂与O₂的结合","layout":null},"children":[]},{"data":{"id":"dm4k3nq6cow0","created":1791980584396,"text":"总结：\n既可促进肺毛细血管的氧合，\n又有利于组织毛细血管的氧离","layout":null},"children":[]}]}]},{"data":{"id":"dm4k49lix2o0","created":1791980632004,"text":"温度的影响","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dm4k4ei0h7k0","created":1791980642676,"text":"升高\n➡Hb对O₂的亲和力降低\n➡曲线右移","layout":null},"children":[]},{"data":{"id":"dm4k5aembvs0","created":1791980712128,"text":"降低则左移","layout":null},"children":[]},{"data":{"id":"dm4k5tpdb800","created":1791980754137,"text":"组织代谢增强时产热增加，\n温度升高，曲线右移，有利于Hb与氧气解离，\n增加组织供氧以适应代谢的需要","layout":null},"children":[]}]},{"data":{"id":"dm4k65ym9kw0","created":1791980780817,"text":"2，3-二磷酸甘油酸（2，3-DPG）的影响","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dm4k6c3r0og0","created":1791980794188,"text":"2,3-DPG升高\n➡Hb对O₂的亲和力降低\n➡曲线右移","layout":null},"children":[]},{"data":{"id":"dm4l9j8wqlc0","created":1791983865940,"text":"临床意义","layout":null},"children":[{"data":{"id":"dm4l9uvq2rc0","created":1791983891264,"text":"存放时间过长的血液，红细胞无氧酵解停止，\n2,3-DPG生成减少，亲和力增加，曲线左移\n所以输入存放时间过长的血液时要考虑到缺氧的问题(Hb不易释放氧)","layout":null},"children":[]},{"data":{"id":"dm4lgomr0480","created":1791984426210,"text":"DPG是红细胞无氧酵解的产物，能降低Hb与氧气的亲和力，使曲线右移。\n低氧时红细胞内DPG增加，有利于Hb向组织释放氧气，这可能是机体对缺氧的适应机制之一。\n但DPG也妨碍了Hb在肺部与氧气结合，不利于氧气运输","layout":null},"children":[]}]}]},{"data":{"id":"dm4lh6goohk0","created":1791984465025,"text":"总结：曲线右移（亲和力降低）的因素——\n三高一低","layout":null},"children":[{"data":{"id":"dm4lhjvgzu80","created":1791984494219,"text":"pH降低","layout":null},"children":[]},{"data":{"id":"dm4lhoyqiew0","created":1791984505299,"text":"2,3-DPG增高","layout":null},"children":[]},{"data":{"id":"dm4lhs9h70g0","created":1791984512479,"text":"温度升高","layout":null},"children":[]},{"data":{"id":"dm4lhuy2btc0","created":1791984518319,"text":"CO₂分压升高","layout":null},"children":[]}]},{"data":{"id":"dm4li9gkvu80","created":1791984549914,"text":"其他因素","layout":null},"children":[{"data":{"id":"dm4lie9s8g00","created":1791984560387,"text":"Hb本身的性质：质和量","layout":null},"children":[]},{"data":{"id":"dm4linnj88w0","created":1791984580809,"text":"CO的影响","layout":null},"children":[{"data":{"id":"dm4lit8yvc00","created":1791984592989,"text":"与Hb的亲和力远高于O₂，\n既妨碍Hb与O₂结合\n又妨碍Hb与O₂解离\n使得曲线左移","layout":null,"color":"#ff0000","font-weight":"bold"},"children":[]},{"data":{"id":"dm4lvco0pe80","created":1791985575628,"text":"解救：\n微高压吸氧","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dm2v2tjnwm00","created":1791808430995,"text":"CO₂的运输","layout":null},"children":[{"data":{"id":"dm4lvq5o1uo0","created":1791985604993,"text":"运输方式","layout":null},"children":[{"data":{"id":"dm4lvt62bzs0","created":1791985611548,"text":"物理溶解5%","layout":null},"children":[]},{"data":{"id":"dm4lvuwezzc0","created":1791985615318,"text":"化学结合95%","layout":null},"children":[{"data":{"id":"dm4lw1w1yz40","created":1791985630533,"text":"碳酸氢盐","layout":null},"children":[{"data":{"id":"dm4lwghxszk0","created":1791985662332,"text":"反应特征","layout":null},"children":[{"data":{"id":"dm4lwldifk00","created":1791985672948,"text":"1.反应快且可逆，受PCO₂影响","layout":null},"children":[]},{"data":{"id":"dm4lwtyclpc0","created":1791985691622,"text":"2.RBC膜上有Cl⁻-HCO₃⁻特异转运载体","layout":null},"children":[]},{"data":{"id":"dm4lxorebjc0","created":1791985758682,"text":"3.需要酶催化：碳酸酐酶","layout":null},"children":[]},{"data":{"id":"dm4lxt2s7fs0","created":1791985768078,"text":"4.RBC内反应，在血浆内运输","layout":null},"children":[]}]}]},{"data":{"id":"dm4lw3red540","created":1791985634605,"text":"氨基甲酰血红蛋白","layout":null},"children":[{"data":{"id":"dm4ly9kvj4w0","created":1791985804000,"text":"反应特征","layout":null},"children":[{"data":{"id":"dm4lyce9ht40","created":1791985810131,"text":"1.反应迅速、可逆，无需酶催化","layout":null},"children":[]},{"data":{"id":"dm4lyj7zy800","created":1791985824989,"text":"2.CO₂与Hb的结合较为松散","layout":null},"children":[]},{"data":{"id":"dm4lypd21w80","created":1791985838356,"text":"3.反应方向主要受到氧合作用的调节","color":"#ff0000","font-weight":"bold","layout":null},"children":[{"data":{"id":"dm4lzph54js0","created":1791985916967,"text":"氧合血红蛋白与CO2的结合能力小于还原血红蛋白","layout":null},"children":[]},{"data":{"id":"dm4lzt3x90g0","created":1791985924875,"text":"所以在组织处，还原血红蛋白的增多促进了氨基甲酰血红蛋白的生成，\n一部分CO2就以HHbNHCOOH的形式运输到肺部。","layout":null},"children":[]},{"data":{"id":"dm4lzwdjfuo0","created":1791985931987,"text":"在肺部，氧合血红蛋白的生成增加，促使HHbNHCOOH释放出CO2.","layout":null},"children":[]}]}]}]}]}]},{"data":{"id":"dm4lvs4zrfc0","created":1791985609306,"text":"CO₂解离曲线","layout":null,"image":"https://p.cldisk.com/star4/beb26178568121a5f287ee7f0a011db1/origin.png","imageTitle":"","imageSize":{"width":200,"height":116}},"children":[{"data":{"id":"dm4m0a3i9o80","created":1791985961855,"text":"表明血液中CO₂含量与CO₂分压之间关系的曲线","layout":null},"children":[]},{"data":{"id":"dm4m1eg0c880","created":1791986049682,"text":"血液中二氧化碳的含量随二氧化碳分压的上升而上升，\n几乎呈线性关系","layout":null},"children":[]},{"data":{"id":"dm4m1mxazkw0","created":1791986068142,"text":"外周组织中二氧化碳分压较高，\n血液流经外周组织后二氧化碳分压及其含量升高","layout":null},"children":[]},{"data":{"id":"dm4m1ro48480","created":1791986078471,"text":"肺泡气二氧化碳分压较低，\n血液流经肺泡后二氧化碳分压及二氧化碳含量亦降低","layout":null},"children":[]}]},{"data":{"id":"dm4m1yl7xr40","created":1791986093533,"text":"何尔登效应","image":"https://p.cldisk.com/star4/6f993e8c8b2aef7f1cbc2ebc587fa574/origin.png","imageTitle":"","imageSize":{"width":200,"height":81},"layout":null},"children":[{"data":{"id":"dm4m28ap6u80","created":1791986114665,"text":"O₂与Hb结合可促使CO₂释放，\n而脱氧Hb则容易与CO₂结合的现象","layout":null},"children":[]},{"data":{"id":"dm4m2uhbdnk0","created":1791986162954,"text":"与波尔效应的联系","layout":null},"children":[{"data":{"id":"dm4np7dl5jc0","created":1791990736148,"text":"组织处","layout":null},"children":[{"data":{"id":"dm4nrulfn6o0","created":1791990943417,"text":"波尔效应：CO₂⬆，促进HbO₂释放，\n何尔登效应： → 去氧 Hb 结合更多 CO₂，把 CO₂运回肺","layout":null},"children":[]}]},{"data":{"id":"dm4nrqs91i80","created":1791990935122,"text":"肺部","layout":null},"children":[{"data":{"id":"dm4nrulfn6o0","created":1791990943417,"text":"何尔登效应：O₂⬆，促进CO₂释放，\n波尔效应： →HbO₂ 结合更多 O₂","layout":null},"children":[]}]},{"data":{"id":"dm4nuhmosug0","created":1791991150287,"text":"CO2通过波尔效应影响O2与Hb的结合与解离，\nO2又通过何尔登效应影响CO2与Hb的结合与解离","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dm1ncp487z40","created":1791685076160,"text":"呼吸调节","layout":null},"children":[{"data":{"id":"dm4wyqzllug0","created":1792016874106,"text":"神经基础","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dm4nvqig3t40","created":1791991247986,"text":"呼吸中枢","layout":null},"children":[{"data":{"id":"dm4nvvj07080","created":1791991258903,"text":"大脑皮层、下丘脑、脑桥、\n延髓、脊髓等部位","layout":null},"children":[]}]},{"data":{"id":"dm4wwsrl1pc0","created":1792016721245,"text":"呼吸神经元","layout":null},"children":[{"data":{"id":"dm4wwvzkw1c0","created":1792016728259,"text":"吸气神经元","layout":null},"children":[{"data":{"id":"dm4wx64gsyg0","created":1792016750322,"text":"延髓背侧呼吸组DRG","layout":null},"children":[]}]},{"data":{"id":"dm4wxcuak5k0","created":1792016764945,"text":"吸气、呼气神经元","layout":null},"children":[{"data":{"id":"dm4wxj8j2ao0","created":1792016778866,"text":"延髓腹外侧呼吸组VRG","layout":null},"children":[]}]},{"data":{"id":"dm4wxqsel2g0","created":1792016795305,"text":"呼气神经元","layout":null},"children":[{"data":{"id":"dm4wxwqbhx40","created":1792016808240,"text":"脑桥呼吸组PRG","layout":null},"children":[]}]}]},{"data":{"id":"dm4x0fzg4cw0","created":1792017006879,"text":"脑干横断实验","image":"","imageTitle":"","imageSize":"","expandState":"expand","layout":null},"children":[{"data":{"id":"dm4x9nwsxi80","created":1792017729411,"text":"迷走神经完整","image":"https://p.cldisk.com/star4/9c3e637e6b01963907482af68fcd808d/origin.png","imageTitle":"","imageSize":{"width":200,"height":90},"layout":null},"children":[{"data":{"id":"dm4x0o6p61k0","created":1792017024732,"text":"1.脊髓与延髓之间横断","layout":null},"children":[{"data":{"id":"dm4x14i4r280","created":1792017060252,"text":"呼吸立即停止","layout":null},"children":[]},{"data":{"id":"dm4x19qw6ow0","created":1792017071665,"text":"表明：脊髓只是初级中枢","layout":null},"children":[]}]},{"data":{"id":"dm4x1i6z7ig0","created":1792017090052,"text":"2.延髓与脑桥之间横断","layout":null},"children":[{"data":{"id":"dm4x1q54zag0","created":1792017107355,"text":"有基本节律呼吸，但呼吸节律不规则、\n喘息样呼吸","layout":null},"children":[]},{"data":{"id":"dm4x3mcn48w0","created":1792017255830,"text":"表明：延髓时产生呼吸节律的基本中枢","layout":null},"children":[]}]},{"data":{"id":"dm4x40qsv7k0","created":1792017287161,"text":"3.脑桥上部横断","layout":null},"children":[{"data":{"id":"dm4x46f0psw0","created":1792017299510,"text":"可抑制吸气，促使吸气向呼气转换\n防止吸气过长过深","layout":null},"children":[]},{"data":{"id":"dm4x5yitqwo0","created":1792017439054,"text":"表明：脑桥是呼吸调整中枢","layout":null},"children":[]}]},{"data":{"id":"dm4x5s3usww0","created":1792017425088,"text":"4.脑桥中下部横断","layout":null},"children":[{"data":{"id":"dm4x7wb381k0","created":1792017590961,"text":"截断后，呼吸变成长吸式呼吸","layout":null},"children":[]},{"data":{"id":"dm4x8dsbzm00","created":1792017629010,"text":"表明失去了脑桥上部呼吸调整中枢的作用，\n提示该作用是抑制吸气","layout":null},"children":[]}]}]},{"data":{"id":"dm4xaycpgsg0","created":1792017830505,"text":"切断迷走神经","image":"https://p.cldisk.com/star4/40811ecf30443ef9da20a4d93192d678/origin.png","imageTitle":"","imageSize":{"width":200,"height":111},"layout":null},"children":[{"data":{"id":"dm57acersk80","created":1792045993839,"text":"迷走神经是肺牵张反射的传入神经。","layout":null},"children":[{"data":{"id":"dm57afmn8bc0","created":1792046000846,"text":"迷走神经兴奋，会提前终止吸气，使呼吸浅快；","layout":null},"children":[]},{"data":{"id":"dm57ak4uq080","created":1792046010654,"text":"切断迷走神经，吸气不能及时中断，呼吸变得深慢。","layout":null},"children":[]}]},{"data":{"id":"dm57an8becw0","created":1792046017394,"text":"迷走神经还负责主动脉体化学感受器的传入：","layout":null},"children":[{"data":{"id":"dm57aqv4c6g0","created":1792046025303,"text":"主动脉体感受缺氧 / 高 CO₂，\n冲动经迷走神经传入，兴奋呼吸。","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dm57biwew6g0","created":1792046086331,"text":"呼吸中枢"},"children":[{"data":{"id":"dm57bl0pybs0","created":1792046090945,"text":"中继站：脊髓"},"children":[{"data":{"id":"dm57bser5hc0","created":1792046107031,"text":"不产生节律性呼吸运动"},"children":[]},{"data":{"id":"dm57bxueh080","created":1792046118861,"text":"脊髓前角：含支配呼吸肌的运动神经元，\nC3~C5段为膈肌，T段为肋间肌和腹肌"},"children":[]},{"data":{"id":"dm57cjp1zm80","created":1792046166427,"text":"是联系高位呼吸中枢和呼吸肌的中继站","color":"#ff0000","font-weight":"bold"},"children":[]}]},{"data":{"id":"dm57cwe69m00","created":1792046194067,"text":"基本呼吸中枢：延髓"},"children":[{"data":{"id":"dm57d0c6p9s0","created":1792046202654,"text":"管理呼吸活动的基本中枢"},"children":[]},{"data":{"id":"dm57d46nv080","created":1792046211027,"text":"节律不规则、喘息样呼吸"},"children":[{"data":{"id":"dm57dfditvk0","created":1792046235387,"text":"背侧呼吸组DRG"},"children":[{"data":{"id":"dm57dkfsc5k0","created":1792046246407,"text":"主要含吸气神经元"},"children":[]}]},{"data":{"id":"dm57dooajio0","created":1792046255629,"text":"腹侧呼吸组VRG"},"children":[{"data":{"id":"dm57ds7to9s0","created":1792046263340,"text":"可能是呼吸节律起源的关键部位"},"children":[]}]}]}]},{"data":{"id":"dm57e0ud7340","created":1792046282118,"text":"呼吸调整中枢：脑桥"},"children":[{"data":{"id":"dm57ec29e000","created":1792046306539,"text":"脑桥横断"},"children":[{"data":{"id":"dm57eei5mqo0","created":1792046311854,"text":"截断中上1/3"},"children":[]}]}]}]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}