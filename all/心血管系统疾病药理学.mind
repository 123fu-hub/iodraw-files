pandState":"expand"},"children":[{"data":{"id":"dlpxkqyna3k0","created":1790495198709,"text":"Ⅰa类：适度阻滞钠通道","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpxl3pg28w0","created":1790495226450,"text":"奎尼丁","layout":null},"children":[]},{"data":{"id":"dlpxl8zf2kg0","created":1790495237937,"text":"普鲁卡因胺","layout":null},"children":[]}]},{"data":{"id":"dlpxldm7puw0","created":1790495248023,"text":"Ⅰb类：轻度阻滞钠通道","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpxlmnymkw0","created":1790495267719,"text":"利多卡因","layout":null},"children":[]},{"data":{"id":"dlpxlpdze1k0","created":1790495273646,"text":"苯妥英钠","layout":null},"children":[]}]},{"data":{"id":"dlpxlsbkff40","created":1790495280031,"text":"Ⅰc类：重度阻滞钠通道","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpxlv91h540","created":1790495286408,"text":"普罗帕酮","layout":null},"children":[]},{"data":{"id":"dlpxlzcnbhc0","created":1790495295334,"text":"氟卡尼","layout":null},"children":[]}]}]},{"data":{"id":"dlpxkf2balc0","created":1790495172809,"text":"Ⅱ类—β肾上腺素受体阻断药","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpxmqyz9i80","created":1790495355457,"text":"普萘洛尔","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"dlpxkineqmg0","created":1790495180615,"text":"Ⅲ类—延长动作电位时程药","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpxn8jji4o0","created":1790495393706,"text":"胺碘酮","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"dlpxkmsxtnk0","created":1790495189656,"text":"Ⅳ类—钙通道阻滞药","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpxnlgabfs0","created":1790495421807,"text":"维拉帕米","layout":null,"expandState":"expand"},"children":[]}]}]}]},{"data":{"id":"dlptzwoel400","created":1790485102173,"text":"代表药物","layout":null,"expandState":"expand","image":"https://p.cldisk.com/star4/57649d2cff8ba323acbad90d349467ee/origin.png","imageTitle":"","imageSize":{"width":200,"height":100}},"children":[{"data":{"id":"dlpxnxugjfs0","created":1790495448785,"text":"Ⅰ类","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpxochtgo00","created":1790495480673,"text":"Ⅰa类—奎尼丁","hyperlink":null,"hyperlinkTitle":null,"layout":null,"image":"","imageTitle":"","imageSize":"","expandState":"expand"},"children":[{"data":{"id":"dlpxq2shtrs0","created":1790495616279,"text":"机制","layout":null,"image":"https://p.cldisk.com/star4/0208a8f97e7cb45a71c012f66529b35e/origin.png","imageTitle":"","imageSize":{"width":200,"height":171},"expandState":"expand"},"children":[{"data":{"id":"dlpxq60rs140","created":1790495623310,"text":"与心肌细胞钠通道蛋白结合，阻滞Na+内流","layout":null},"children":[]},{"data":{"id":"dlpxoorihgg0","created":1790495507380,"text":"低浓度：阻滞 INa、Ikr","layout":null},"children":[]},{"data":{"id":"dlpxpcjs5mw0","created":1790495559156,"text":"高浓度：阻滞Ik1、L-Ica、Iks、Ito","layout":null},"children":[]}]},{"data":{"id":"dlpxoj4d5ps0","created":1790495495097,"text":"药理作用","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpxz09gu6g0","created":1790496316052,"text":"自律性","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dlpxz8g8e0o0","created":1790496333876,"text":"降低4相斜率、提高兴奋阈值\n浦肯野纤维、工作细胞的异常自律性降低，\n对窦房结影响较小","layout":null},"children":[]}]},{"data":{"id":"dlpxz2cyh0g0","created":1790496320617,"text":"传导性","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dlpy043e5ko0","created":1790496402756,"text":"降低快反应细胞（心房、心室、浦氏纤维）\n动作电位0相去极化速度和幅度","layout":null},"children":[]}]},{"data":{"id":"dlpxz4ac3dc0","created":1790496324812,"text":"不应期","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dlpy0dl8qr40","created":1790496423427,"text":"延长有效不应期及动作电位时程，\n有助于消除折返","layout":null},"children":[]}]},{"data":{"id":"dlpxz60dbdk0","created":1790496328563,"text":"其他","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dlpy0lv5le80","created":1790496441440,"text":"抗M胆碱和α受体作用；抑制Ca2+\n内流，负性肌力作用","layout":null},"children":[]}]}]},{"data":{"id":"dlpy1j2divc0","created":1790496513711,"text":"临床应用：广谱抗心律失常药","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpy1rx43o80","created":1790496532983,"text":"各种快速型心律失常","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dlpy21ne0ow0","created":1790496554163,"text":"房颤、房扑、室上性和室性心律失常","layout":null},"children":[]}]},{"data":{"id":"dlpy1y6xsps0","created":1790496546638,"text":"电复律","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dlpy2koyr4g0","created":1790496595617,"text":"电复律术前的准备和复律后窦性心律的维持","layout":null},"children":[]}]}]},{"data":{"id":"dlpy2w698540","created":1790496620608,"text":"不良反应","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpy30kc6pc0","created":1790496630166,"text":"胃肠道反应","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpy3fgeng80","created":1790496662580,"text":"腹泻为最常见的副作用，\n\n发生率30-50%","layout":null},"children":[]}]},{"data":{"id":"dlpy331bq1c0","created":1790496635547,"text":"金鸡纳反应","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpy3i644tc0","created":1790496668488,"text":"表现为头痛、头晕、\n耳鸣、视力模糊等","layout":null},"children":[]}]},{"data":{"id":"dlpy35vthgg0","created":1790496641744,"text":"过敏反应","color":"#ff0000","background":"#ffff00","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpy3n9bvco0","created":1790496679566,"text":"药热、血小板减少等","layout":null},"children":[]}]},{"data":{"id":"dlpy38psm400","created":1790496647910,"text":"心血管系统反应","note":"# 奎尼丁引起心脏毒性的机制（考试简答版，结合前面折返图）\n奎尼丁属于**Ⅰa类抗心律失常药**，**同时阻滞Na⁺通道 + K⁺通道**，是心脏毒性的根本原因。\n\n## 一、致心律失常（重点：奎尼丁晕厥）\n1. **阻滞钾通道（快速延迟整流钾电流 IKr）**\n    抑制心室肌复极K⁺外流 → **动作电位时程APD延长、QT间期延长**。\n    不同心室肌细胞延长程度不一样 → **复极离散度增大**（部分心肌复极快、部分复极慢），心肌电活动不均一，**形成功能性折返环路**，诱发**尖端扭转型室速（TdP）**。\n    > 严重时尖端扭转型室速进展为室颤 → 奎尼丁晕厥、猝死。\n    > ✔关键点：**治疗剂量就可发生，不是只有中毒剂量**。\n\n2. **阻滞钠通道（INa）**\n    抑制Na⁺内流：\n    - 减慢0相除极，**减慢传导**，可造成房室阻滞、室内传导阻滞；\n    - 浦肯野纤维自律性升高，诱发异位室性早搏、室速。\n\n> 简单逻辑：钠阻滞→传导变慢；钾阻滞→QT延长、复极不均→折返（尖端扭转型室速）。\n\n## 二、负性肌力作用\n抑制心肌Na⁺内流，减少钙内流（Na⁺-Ca²⁺交换）→心肌收缩力减弱，心输出量下降。\n\n## 三、低血压（心血管毒性，常和心脏毒性并列考点）\n奎尼丁**阻断血管α肾上腺素受体**，使外周血管扩张，外周阻力降低；叠加负性肌力，共同造成血压下降，静脉给药更显著。\n\n## 四、附加：抗胆碱作用带来的间接心脏风险\n奎尼丁有M受体阻断效应：加快房室结传导。\n> 房颤/房扑单独用奎尼丁：心房率减慢，但房室结传导变快，大量心房冲动下传心室 → **心室率急剧加快，加重心衰、诱发心律失常**。\n> 考点：房扑房颤使用奎尼丁前，先用强心苷抑制房室结。\n\n---\n# 精简背诵版（直接写卷子）\n奎尼丁为Ⅰa类抗心律失常药，可**同时阻滞钠通道和钾通道**：\n1. 阻滞钾通道，抑制复极期K⁺外流，**延长APD、QT间期，增大心室肌复极离散度，形成功能性折返，诱发尖端扭转型室速，严重者发生奎尼丁晕厥甚至猝死**；\n2. 阻滞钠通道，抑制Na⁺内流，**减慢心肌传导，可引起房室、室内传导阻滞，浦肯野纤维自律性升高，诱发异位心律失常**；\n3. 抑制钠内流间接减少钙内流，**产生负性肌力作用，减弱心肌收缩力**；\n4. 阻断血管α受体扩张外周血管，加上负性肌力，**引发低血压**；\n5. 抗胆碱作用加快房室结传导，房颤房扑时可导致心室率骤增。\n\n## 选择题易错点\n- 奎尼丁晕厥本质：**尖端扭转型室速**，由QT延长、复极离散、功能性折返导致\n- 不是单纯药物过量：**治疗剂量即可出现**\n\n","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpy3q25gso0","created":1790496685663,"text":"心脏毒性：致心律失常的发生，\n严重者奎尼丁晕厥或猝死","color":"#ff0000","background":"#ffff00","layout":null},"children":[]},{"data":{"id":"dlpy42j4p7k0","created":1790496712811,"text":"低血压：拮抗α受体","layout":null},"children":[{"data":{"id":"dlpydgcvp5s0","created":1790497448185,"text":"阻断血管 α 受体，血管扩张；\n叠加负性肌力作用，外周阻力下降，血压降低","layout":null},"children":[]},{"data":{"id":"dlpydnn1ars0","created":1790497464037,"text":"静脉给药更明显，口服相对缓和；\n所以奎尼丁一般不推荐静推","layout":null},"children":[]}]}]}]},{"data":{"id":"dlpykzvkz8g0","created":1790498039224,"text":"注意事项","note":"## 1. 用奎尼丁治疗房颤、房扑前，应先用地高辛 / 钙拮抗剂 / β 受体阻断剂\n\n> \n> 核心：**奎尼丁有抗胆碱（M 阻断）作用**\n\n- 房颤 / 房扑：心房大量快速电冲动，**房室结天然起到 “闸门” 作用，过滤大部分冲动，不让全部下传到心室**。\n- 奎尼丁：① 抑制心房钠通道，减慢心房率；② **阻断 M 胆碱受体 → 解除迷走神经对房室结的抑制 → 房室结传导速度加快、不应期缩短**。\n👉 风险：心房率减慢后，更多心房激动能快速通过房室结下传心室，**心室率突然急剧飙升**，诱发心衰、严重室性心律失常。\n- 预处理目的：**地高辛、维拉帕米（钙拮抗剂）、β 受体阻滞剂**都能**抑制房室结传导、延长房室结不应期**，先把房室结闸门守住，**阻止大量心房冲动下传心室**，之后再用奎尼丁转复心律。\n\n> \n> 一句话背：奎尼丁抗胆碱，会加速房室传导；先用房室结抑制剂，锁住房室结，防止心室率暴增。\n\n## 2. 苯巴比妥（肝药酶诱导剂）可减弱奎尼丁作用\n\n奎尼丁**主要经肝脏 CYP450 代谢清除**。\n\n- 苯巴比妥：**肝药酶诱导剂**，上调肝脏 CYP 酶活性，**加速奎尼丁在肝脏的代谢分解**，血药浓度下降。\n- 药效结果：体内有效药量变少，抗心律失常作用**减弱**。\n\n> \n> 反向考点：肝药酶抑制剂（如西咪替丁）会升高奎尼丁血药浓度，**增强毒性**。\n\n## 3. 奎尼丁与其他血管舒张药合用可致 BP↓↓↓\n\n奎尼丁本身就有两个降压机制：\n\n1. 阻断血管**α 肾上腺素受体 → 外周血管扩张，外周阻力下降**\n2. 轻度**负性肌力作用，心肌收缩力减弱，心输出量减少**\n\n如果再加其他扩血管药（硝酸酯类、哌唑嗪等），**血管扩张效应叠加**，外周阻力进一步大幅下降，血压显著降低，出现严重低血压。\n\n---\n\n# 浓缩简答版（直接写试卷）\n\n1. **房颤房扑预处理**：奎尼丁具有抗胆碱作用，可加快房室结传导；房颤房扑时单用奎尼丁，心房冲动易大量下传心室，造成心室率骤增。地高辛、钙拮抗剂、β 受体阻滞剂可抑制房室结传导，预先控制心室率，避免该危险。\n2. **苯巴比妥**：苯巴比妥为肝药酶诱导剂，加速肝脏对奎尼丁的代谢，降低奎尼丁血药浓度，使其药效减弱。\n3. **合用扩血管药**：奎尼丁可阻断 α 受体扩张血管，并有负性肌力、降压作用；与其他血管舒张药合用，扩血管作用叠加，引起血压显著下降。\n\n### 选择题坑点\n\n- 为什么不能直接奎尼丁上房颤房扑：**不是奎尼丁对心室有作用，是抗胆碱→房室结传导加快**\n- 苯巴比妥：**诱导酶，减弱药效；抑制剂升高浓度，增加奎尼丁晕厥风险**","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpyl2q0aqw0","created":1790498045417,"text":"用奎尼丁治疗房颤、房扑前，\n应先使用地高辛、钙拮抗剂或β受体阻断剂","color":"#ff0000","background":"#ffff00","layout":null},"children":[]},{"data":{"id":"dlpylogz4b40","created":1790498092761,"text":"苯巴比妥（肝药酶诱导剂）可见若奎尼丁作用","layout":null},"children":[]},{"data":{"id":"dlpylwi25ts0","created":1790498110240,"text":"奎尼丁与其他血管舒张药合用可致血压急剧下降","layout":null},"children":[]}]}]},{"data":{"id":"dlpypbx8a3k0","created":1790498378902,"text":"Ⅰb类：利多卡因","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpypjkmvqg0","created":1790498395555,"text":"机制","hyperlink":null,"hyperlinkTitle":null,"layout":null,"image":"https://p.cldisk.com/star4/d5d190ba0d679a000ba73500b26c29ea/origin.png","imageTitle":"","imageSize":{"width":200,"height":161},"expandState":"expand"},"children":[{"data":{"id":"dlpyplkeqog0","created":1790498399894,"text":"阻滞激活态和失活态的钠通道，\n通道恢复至静息态时，阻滞作用迅速接触","layout":null},"children":[]},{"data":{"id":"dlpyyvvk5gg0","created":1790499127614,"text":"特点","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpyyxpisuw0","created":1790499131602,"text":"对除极化组织的钠通道阻滞作用强，\n对心肌缺血等除极化型心律失常有较强抑制作用","layout":null},"children":[]},{"data":{"id":"dlpyzal4cgw0","created":1790499159635,"text":"对正常心肌组织电生理特性影响小，对心房肌作用弱","layout":null},"children":[]}]}]},{"data":{"id":"dlpyzgbp2fk0","created":1790499172125,"text":"药理作用","layout":null,"image":"https://p.cldisk.com/star4/c7fb2e6eb405e930e1299c605c4fdcb2/origin.png","imageTitle":"","imageSize":{"width":190,"height":200},"expandState":"expand"},"children":[{"data":{"id":"dlpyzkitk4w0","created":1790499181263,"text":"降低浦肯野纤维自律性","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpz05efo0w0","created":1790499226711,"text":"抑制 Na⁺内流（↓Na⁺内流）\n4 相 Na⁺内流减少 → 4 相去极斜率↓；同时阈电位↑（阈电位往 0 方向上移）\n→ 膜电位爬升更慢、离阈电位更远 → 自律性下降","layout":null},"children":[]},{"data":{"id":"dlpz2pjr8cw0","created":1790499427296,"text":"促进 K⁺外流（↑K⁺外流）【Ⅰb 特征！重点】\nK⁺外流增加 → 最大舒张电位↑（负值变大，膜更超极化，更负）\n膜电位离阈电位更远，更难达到阈电位 → 自律性进一步下降","layout":null},"children":[]}]},{"data":{"id":"dlpyzrp7x740","created":1790499196888,"text":"相对延长有效不应期","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlpz3kryrz40","created":1790499495273,"text":"促进K+外流 → 复极过程加快 →APD↓","layout":null},"children":[]},{"data":{"id":"dlpz43m92u80","created":1790499536286,"text":"缩短PF、心室肌细胞VM的APD和ERP","layout":null},"children":[]},{"data":{"id":"dlpz4sa78ao0","created":1790499589977,"text":"缩短APD更显著，相对延长ERP","layout":null},"children":[]},{"data":{"id":"dlpz4vqn82o0","created":1790499597502,"text":"ERP/APD比值↑ → 折返激动↓","layout":null},"children":[]}]}]},{"data":{"id":"dlqi7mrwq8o0","created":1790553414168,"text":"临床应用：窄谱抗心律失常药\n治疗各种室性快速型心律失常","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqi8eh5csg0","created":1790553474468,"text":"急性心肌梗死或强心苷中毒所致的室性心动过速、室颤","layout":null},"children":[]},{"data":{"id":"dlqi8oa54680","created":1790553495811,"text":" 心梗急性期，预发室颤发生","layout":null},"children":[]},{"data":{"id":"dlqi8r563ls0","created":1790553502041,"text":"对室上性心律失常效果差","layout":null},"children":[]},{"data":{"id":"dlqi8wsfcbk0","created":1790553514331,"text":"特点：窄谱 速效 高效 安全","layout":null},"children":[]},{"data":{"id":"dlqi94scc1k0","created":1790553531740,"text":" 短效、不宜口服，需静脉给药","layout":null},"children":[]}]},{"data":{"id":"dlqib4m2d400","created":1790553688089,"text":"不良反应","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqib926peg0","created":1790553697771,"text":"中枢神经系统症状","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqibewpdqw0","created":1790553710500,"text":"嗜睡、眩晕","layout":null},"children":[]},{"data":{"id":"dlqibitiy3k0","created":1790553719015,"text":"大剂量引起语言障碍、惊厥","layout":null},"children":[]},{"data":{"id":"dlqibogva280","created":1790553731311,"text":"呼吸抑制 ","layout":null},"children":[]}]},{"data":{"id":"dlqibrt60tc0","created":1790553738585,"text":"心血管系统症状","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqibv1t5kw0","created":1790553745638,"text":"偶见窦性过缓、房室传导阻滞等","layout":null},"children":[]}]},{"data":{"id":"dlqic4asseg0","created":1790553765772,"text":"禁用：Ⅱ、Ⅲ度房室传导阻滞","layout":null},"children":[]}]}]},{"data":{"id":"dlqicj8f18g0","created":1790553798280,"text":"Ⅰc类：普罗帕酮","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqicrx4bso0","created":1790553817188,"text":"药理作用：\n明显阻滞Na+通道的激活态和失活态，\n阻滞K+通道","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqicvw71rc0","created":1790553825839,"text":"自律性","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqidngqypc0","created":1790553885855,"text":"降低浦肯野纤维的自律性","layout":null},"children":[]}]},{"data":{"id":"dlqidk1dg4w0","created":1790553878395,"text":"传导性","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqids8xe1s0","created":1790553896266,"text":"减慢快反应细胞（心房、心室、浦肯野纤维）的传导","layout":null},"children":[]}]},{"data":{"id":"dlqidlfwko00","created":1790553881450,"text":"不应期","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqied12k0o0","created":1790553941503,"text":"延长APD和ERP，对对复极过程的影像高于奎尼丁","layout":null},"children":[]}]}]},{"data":{"id":"dlqiezm0e600","created":1790553990659,"text":"临床应用","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqif236ovc0","created":1790553996051,"text":"广谱性：室上性早搏、心动过速、心房颤动；\n室性早搏、心动过速","layout":null},"children":[]}]},{"data":{"id":"dlqifnga8lk0","created":1790554042555,"text":"不良反应","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqifpup11k0","created":1790554047780,"text":"消化道","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqifxahajk0","created":1790554063972,"text":"恶心、呕吐、味觉改变","layout":null},"children":[]}]},{"data":{"id":"dlqifrp9tmg0","created":1790554051806,"text":"心血管系统","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqigibq09s0","created":1790554109760,"text":"房室传导阻滞","layout":null},"children":[]},{"data":{"id":"dlqign40kx40","created":1790554120177,"text":"加重心衰","layout":null},"children":[]},{"data":{"id":"dlqigr7z0800","created":1790554129124,"text":"体位性低血压","layout":null},"children":[]}]},{"data":{"id":"dlqiftnjln40","created":1790554056055,"text":"致心律失常","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqigukz0ig0","created":1790554136440,"text":"减慢传导程度超过延长ERP程度，容易导致折返","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dlqihhk3jnc0","created":1790554186453,"text":"Ⅱ类：β受体阻断药\n普萘洛尔（主）\n美托洛尔","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqijir4cjk0","created":1790554345783,"text":"机制","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqijk6eotk0","created":1790554348884,"text":"生理状态下：\n交感激动 β₁→cAMP↑→PKA 激活→钙通道磷酸化，钙内流增多，窦房结自律性↑、房室结传导加快、心肌收缩力增强","layout":null,"expandState":"expand"},"children":[]},{"data":{"id":"dlqiks0iugw0","created":1790554444307,"text":"药理效应：\nβ 受体阻断药阻断此通路，减少 cAMP、减少钙内流，降低自律性、减慢房室传导。","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"dlqilrmekyo0","created":1790554521817,"text":"药理作用：\n竞争性阻断β1受体，抑制Na+、Ca2+内流","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqimnhqgd40","created":1790554591192,"text":"自律性","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqims3pg400","created":1790554601228,"text":"降低窦房结、心房传导纤维及浦肯野纤维的自律性\n也降低儿茶酚胺所致的迟后除极","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"dlqimorghgw0","created":1790554593957,"text":"传导性","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqinij8xcg0","created":1790554658764,"text":"高浓度减慢传导","layout":null},"children":[]}]},{"data":{"id":"dlqimq7socw0","created":1790554597121,"text":"不应期","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqinpfh6g80","created":1790554673773,"text":"延长房室结ERP","layout":null},"children":[]}]}]},{"data":{"id":"dlqiudfc2ig0","created":1790555196192,"text":"临床应用：各种室上性心律失常","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqiumukik00","created":1790555216705,"text":"交感神经功能亢进引起的窦性心动过速—甲亢、嗜铬细胞瘤等","layout":null,"expandState":"expand"},"children":[]},{"data":{"id":"dlqiv2f8do00","created":1790555250606,"text":"与强心苷、地尔硫䓬合用，控制房扑、房颤和阵发性室上性心动过速时的室性频率过快","layout":null,"expandState":"expand"},"children":[]},{"data":{"id":"dlqiwzchcu80","created":1790555400637,"text":"心肌梗塞：减少心律失常发生率，缩小心肌梗塞的范围，降低死亡率","layout":null,"expandState":"expand"},"children":[]}]},{"data":{"id":"dlqixhamqz40","created":1790555439708,"text":"不良反应","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqixmvavls0","created":1790555451841,"text":"窦性心动过缓、房室传导阻滞","layout":null,"expandState":"expand"},"children":[]},{"data":{"id":"dlqiy1g2e1s0","created":1790555483572,"text":"低血压、精神压抑、记忆力减退","layout":null,"expandState":"expand"},"children":[]},{"data":{"id":"dlqiygmj2mo0","created":1790555516614,"text":"诱发心衰和哮喘","layout":null,"expandState":"expand"},"children":[]},{"data":{"id":"dlqiyjtmwe00","created":1790555523574,"text":"长期应用可使脂质代谢和糖代谢异常","layout":null,"expandState":"expand"},"children":[]},{"data":{"id":"dlqiylwv8ow0","created":1790555528123,"text":"反跳现象","layout":null,"expandState":"expand"},"children":[]}]}]},{"data":{"id":"dlqiyto1dg00","created":1790555545004,"text":"Ⅲ类：延长动作电位时程药\n胺碘酮","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dlqiz746zqg0","created":1790555574279,"text":"药理作用：\n抑制多种钾离子通道，\n轻度抑制钠、钙通道","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dl