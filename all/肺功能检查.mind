00）","layout":null},"children":[]},{"data":{"id":"dm7k9vf9ri00","created":1792285751206,"text":"  * 降低：呼吸肌功能不全","layout":null},"children":[]}]}]},{"data":{"id":"dm7k3rf1c680","created":1792285272300,"text":"补呼气量（expiratory reserve volume，ERV) ","layout":null},"children":[{"data":{"id":"dm7kanfzeko0","created":1792285812199,"text":"定义：","layout":null},"children":[{"data":{"id":"dm7kanfziag0","created":1792285812199,"text":"  平静呼气末，再尽最大      力量所呼出的气量","layout":null},"children":[]}]},{"data":{"id":"dm7kanfzku80","created":1792285812200,"text":"  临床意义：","layout":null},"children":[{"data":{"id":"dm7kanfzsbc0","created":1792285812200,"text":"  正常成人约1609ml（1126）","layout":null},"children":[]},{"data":{"id":"dm7kanfzri00","created":1792285812200,"text":"  * 降低：呼吸肌功能不全","layout":null},"children":[]}]}]},{"data":{"id":"dm7k3rf13ds0","created":1792285272300,"text":"残气量（residual volume，RV) ","layout":null},"children":[{"data":{"id":"dm7kav1zvsw0","created":1792285828768,"text":"定义：","layout":null},"children":[{"data":{"id":"dm7kav20gqw0","created":1792285828769,"text":"  用力呼气末，肺内所含的气量","layout":null},"children":[]}]},{"data":{"id":"dm7kav20na80","created":1792285828769,"text":"  临床意义：","layout":null},"children":[{"data":{"id":"dm7kav210cw0","created":1792285828770,"text":"  正常成人约1615ml（1245）","layout":null},"children":[]},{"data":{"id":"dm7kav20z6w0","created":1792285828770,"text":"  与肺总量比值约25％","layout":null},"children":[{"data":{"id":"dm7kav218ow0","created":1792285828770,"text":" * 升高：老年人，慢阻肺","layout":null},"children":[]},{"data":{"id":"dm7kav215js0","created":1792285828770,"text":" * 降低：间质性肺疾病","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dm7kb6p7vhc0","created":1792285854117,"text":"基础肺容量：\n≥2个的基础肺容积组成","layout":null},"children":[{"data":{"id":"dm7kbseyhk00","created":1792285901385,"text":"深吸气量（inspiratory capacity，IC)","layout":null},"children":[{"data":{"id":"dm7kc4wnauw0","created":1792285928576,"text":"定义：","layout":null},"children":[{"data":{"id":"dm7kc4wn1io0","created":1792285928576,"text":"平静呼气末，再尽最大力量吸气的最大吸气量","layout":null},"children":[]}]},{"data":{"id":"dm7kc4wnc3c0","created":1792285928576,"text":"  临床意义：","layout":null},"children":[{"data":{"id":"dm7kc4wmtxk0","created":1792285928576,"text":"正常成人约2617ml（1970）","layout":null},"children":[]},{"data":{"id":"dm7kc4wmzlc0","created":1792285928576,"text":"* 降低：","layout":null},"children":[{"data":{"id":"dm7kc4wnrsw0","created":1792285928577,"text":"   限制性通气功能障碍肺病","layout":null},"children":[]},{"data":{"id":"dm7kc4wnulk0","created":1792285928577,"text":"   阻塞性通气功能障碍肺病","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7kbsez3a80","created":1792285901386,"text":"功能残气量（functional residual capacity, FRC)","layout":null},"children":[{"data":{"id":"dm7kfbma4f40","created":1792286178280,"text":"定义","layout":null},"children":[{"data":{"id":"dm7kfdz4el40","created":1792286183410,"text":"平静呼气末，肺内所含的气量","layout":null},"children":[]}]},{"data":{"id":"dm7kfrno8yw0","created":1792286213192,"text":"测定方法","layout":null},"children":[{"data":{"id":"dm7kfu4muzs0","created":1792286218571,"text":"1.氮气稀释法","layout":null},"children":[]},{"data":{"id":"dm7kfy5puhc0","created":1792286227344,"text":"2.氦气稀释法","layout":null},"children":[]}]},{"data":{"id":"dm7kg1w240o0","created":1792286235467,"text":"临床意义","layout":null},"children":[{"data":{"id":"dm7kg4wudi80","created":1792286242045,"text":"正常成人约3112ml（2348）\n约为肺总量的40%","layout":null},"children":[]},{"data":{"id":"dm7kgte8rqw0","created":1792286295340,"text":"升高：阻塞（肺气肿）","layout":null},"children":[]},{"data":{"id":"dm7kgyfkj280","created":1792286306304,"text":"降低：限制（纤维化、ARDS、胸廓畸形）","layout":null},"children":[]}]}]},{"data":{"id":"dm7kbseyseg0","created":1792285901386,"text":"肺活量（vital capacity，VC)","layout":null},"children":[{"data":{"id":"dm7khry5c1c0","created":1792286370554,"text":"定义：","layout":null},"children":[{"data":{"id":"dm7ki4dunw00","created":1792286397625,"text":"尽力吸气后，缓慢而完全地\n呼出的最大呼气量（右肺占55%）","layout":null},"children":[]}]},{"data":{"id":"dm7ki063hcg0","created":1792286388449,"text":"临床意义：","layout":null},"children":[{"data":{"id":"dm7ki8swgpk0","created":1792286407242,"text":"正常成人约4217ml（3105）","layout":null},"children":[]},{"data":{"id":"dm7ki8sws480","created":1792286407243,"text":"* 降低：","layout":null},"children":[{"data":{"id":"dm7kihru5w00","created":1792286426769,"text":"限制性通气功能障碍肺病、严重阻塞性肺病","layout":null},"children":[]},{"data":{"id":"dm7kijpwbj40","created":1792286431005,"text":"* 实测值<预计值80％为降低","layout":null},"children":[]},{"data":{"id":"dm7ki8sx9340","created":1792286407243,"text":"轻（60～79％）","layout":null},"children":[]},{"data":{"id":"dm7ki8sx3h40","created":1792286407243,"text":"中（40～59％）","layout":null},"children":[]},{"data":{"id":"dm7ki8sx5ko0","created":1792286407243,"text":"重（<40％）","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7kbsez3ow0","created":1792285901386,"text":"肺总量（total lung capacity，TLC) ","layout":null},"children":[{"data":{"id":"dm7lvl74a8w0","created":1792290274067,"text":"定义：","layout":null},"children":[{"data":{"id":"dm7lvl74o4g0","created":1792290274068,"text":"最大限度吸气后肺内所含气量","layout":null},"children":[]}]},{"data":{"id":"dm7lvl74xxk0","created":1792290274068,"text":" 临床意义：","layout":null},"children":[{"data":{"id":"dm7lvl74yo80","created":1792290274068,"text":"正常成人约5020ml（3460）","layout":null},"children":[]},{"data":{"id":"dm7lvl74u9c0","created":1792290274068,"text":"* 降低：限制性肺病","layout":null},"children":[]},{"data":{"id":"dm7lvl74ql40","created":1792290274068,"text":"* 肺气肿可正常或增高","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dm7jy6n6vko0","created":1792284835260,"text":"通气功能","layout":null},"children":[{"data":{"id":"dm7lw6uve540","created":1792290321216,"text":"动态肺容积：\n单位时间内随呼吸运动进出肺的气量和流速（流量）","layout":null},"children":[{"data":{"id":"dm7lwvq5s5k0","created":1792290375350,"text":"肺通气量（Pulmonary ventilation volume，PVV）","layout":null},"children":[{"data":{"id":"dm7lyabwwq00","created":1792290485505,"text":"每分钟静息通气量（VE）：\n静息状态时每分钟呼出的气量，\n即潮气量与呼吸频率的乘积（VE=VT × RR）","layout":null},"children":[{"data":{"id":"dm7lyabxiew0","created":1792290485506,"text":"评价指标：","layout":null},"children":[{"data":{"id":"dm7lyabxivk0","created":1792290485506,"text":" 正常值为 5-8 L/min","layout":null},"children":[]},{"data":{"id":"dm7lyabxkhc0","created":1792290485506,"text":" >10L提示通气过度：呼吸性碱中毒","layout":null},"children":[]},{"data":{"id":"dm7lyabxknk0","created":1792290485506,"text":" <  3L提示通气不足：呼吸性酸中毒","layout":null},"children":[]}]}]},{"data":{"id":"dm7lzammofs0","created":1792290564517,"text":"最大自主通气量MVV:\n一分钟内以“最深、最快”的呼吸所得到的通气量，\n一般测12或15秒","layout":null},"children":[{"data":{"id":"dm7lzsb0v1c0","created":1792290602997,"text":"评价指标：正常人≥预计值的80%","layout":null},"children":[]},{"data":{"id":"dm7lzvfr2u80","created":1792290609814,"text":"降低","layout":null},"children":[{"data":{"id":"dm7lzsb0iiw0","created":1792290602997,"text":"轻度降低 ：60-79%","layout":null},"children":[]},{"data":{"id":"dm7lzsb0xuw0","created":1792290602997,"text":"中度降低 ：40-59%","layout":null},"children":[]},{"data":{"id":"dm7lzsb1dgg0","created":1792290602998,"text":"重度降低 ：<40%","layout":null},"children":[]}]}]},{"data":{"id":"dm7m0j21p540","created":1792290661228,"text":"临床意义","layout":null},"children":[{"data":{"id":"dm7m0m6sjz40","created":1792290668045,"text":"降低","layout":null},"children":[{"data":{"id":"dm7m0ykczfk0","created":1792290694987,"text":"与肺容量、气道阻力、胸肺顺应性以及呼吸肌力都有关，\n见于阻塞性或限制性通气功能障碍","layout":null},"children":[]}]},{"data":{"id":"dm7m0oxwjr40","created":1792290674038,"text":"通气储备能力的考核指标","layout":null},"children":[{"data":{"id":"dm7m1d734c80","created":1792290726836,"text":"\t通气储量%  =（MVV - 每分钟静息通气量）/MVV                                                     ×100%"},"children":[]},{"data":{"id":"dm7m1xa3mmw0","created":1792290770554,"text":"正常值为95%以上，\n＜86％提示通气功能储备不佳（肺部手术应慎重），\n＜70％通气功能严重损害","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7lwvq6bq00","created":1792290375351,"text":"用力肺活量（forced vital capacity, FVC) ","layout":null},"c