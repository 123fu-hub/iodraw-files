00）","layout":null},"children":[]},{"data":{"id":"dm7k9vf9ri00","created":1792285751206,"text":"  * 降低：呼吸肌功能不全","layout":null},"children":[]}]}]},{"data":{"id":"dm7k3rf1c680","created":1792285272300,"text":"补呼气量（expiratory reserve volume，ERV) ","layout":null},"children":[{"data":{"id":"dm7kanfzeko0","created":1792285812199,"text":"定义：","layout":null},"children":[{"data":{"id":"dm7kanfziag0","created":1792285812199,"text":"  平静呼气末，再尽最大      力量所呼出的气量","layout":null},"children":[]}]},{"data":{"id":"dm7kanfzku80","created":1792285812200,"text":"  临床意义：","layout":null},"children":[{"data":{"id":"dm7kanfzsbc0","created":1792285812200,"text":"  正常成人约1609ml（1126）","layout":null},"children":[]},{"data":{"id":"dm7kanfzri00","created":1792285812200,"text":"  * 降低：呼吸肌功能不全","layout":null},"children":[]}]}]},{"data":{"id":"dm7k3rf13ds0","created":1792285272300,"text":"残气量（residual volume，RV) ","layout":null},"children":[{"data":{"id":"dm7kav1zvsw0","created":1792285828768,"text":"定义：","layout":null},"children":[{"data":{"id":"dm7kav20gqw0","created":1792285828769,"text":"  用力呼气末，肺内所含的气量","layout":null},"children":[]}]},{"data":{"id":"dm7kav20na80","created":1792285828769,"text":"  临床意义：","layout":null},"children":[{"data":{"id":"dm7kav210cw0","created":1792285828770,"text":"  正常成人约1615ml（1245）","layout":null},"children":[]},{"data":{"id":"dm7kav20z6w0","created":1792285828770,"text":"  与肺总量比值约25％","layout":null},"children":[{"data":{"id":"dm7kav218ow0","created":1792285828770,"text":" * 升高：老年人，慢阻肺","layout":null},"children":[]},{"data":{"id":"dm7kav215js0","created":1792285828770,"text":" * 降低：间质性肺疾病","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dm7kb6p7vhc0","created":1792285854117,"text":"基础肺容量：\n≥2个的基础肺容积组成","layout":null},"children":[{"data":{"id":"dm7kbseyhk00","created":1792285901385,"text":"深吸气量（inspiratory capacity，IC)","layout":null},"children":[{"data":{"id":"dm7kc4wnauw0","created":1792285928576,"text":"定义：","layout":null},"children":[{"data":{"id":"dm7kc4wn1io0","created":1792285928576,"text":"平静呼气末，再尽最大力量吸气的最大吸气量","layout":null},"children":[]}]},{"data":{"id":"dm7kc4wnc3c0","created":1792285928576,"text":"  临床意义：","layout":null},"children":[{"data":{"id":"dm7kc4wmtxk0","created":1792285928576,"text":"正常成人约2617ml（1970）","layout":null},"children":[]},{"data":{"id":"dm7kc4wmzlc0","created":1792285928576,"text":"* 降低：","layout":null},"children":[{"data":{"id":"dm7kc4wnrsw0","created":1792285928577,"text":"   限制性通气功能障碍肺病","layout":null},"children":[]},{"data":{"id":"dm7kc4wnulk0","created":1792285928577,"text":"   阻塞性通气功能障碍肺病","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7kbsez3a80","created":1792285901386,"text":"功能残气量（functional residual capacity, FRC)","layout":null},"children":[{"data":{"id":"dm7kfbma4f40","created":1792286178280,"text":"定义","layout":null},"children":[{"data":{"id":"dm7kfdz4el40","created":1792286183410,"text":"平静呼气末，肺内所含的气量","layout":null},"children":[]}]},{"data":{"id":"dm7kfrno8yw0","created":1792286213192,"text":"测定方法","layout":null},"children":[{"data":{"id":"dm7kfu4muzs0","created":1792286218571,"text":"1.氮气稀释法","layout":null},"children":[]},{"data":{"id":"dm7kfy5puhc0","created":1792286227344,"text":"2.氦气稀释法","layout":null},"children":[]}]},{"data":{"id":"dm7kg1w240o0","created":1792286235467,"text":"临床意义","layout":null},"children":[{"data":{"id":"dm7kg4wudi80","created":1792286242045,"text":"正常成人约3112ml（2348）\n约为肺总量的40%","layout":null},"children":[]},{"data":{"id":"dm7kgte8rqw0","created":1792286295340,"text":"升高：阻塞（肺气肿）","layout":null},"children":[]},{"data":{"id":"dm7kgyfkj280","created":1792286306304,"text":"降低：限制（纤维化、ARDS、胸廓畸形）","layout":null},"children":[]}]}]},{"data":{"id":"dm7kbseyseg0","created":1792285901386,"text":"肺活量（vital capacity，VC)","layout":null},"children":[{"data":{"id":"dm7khry5c1c0","created":1792286370554,"text":"定义：","layout":null},"children":[{"data":{"id":"dm7ki4dunw00","created":1792286397625,"text":"尽力吸气后，缓慢而完全地\n呼出的最大呼气量（右肺占55%）","layout":null},"children":[]}]},{"data":{"id":"dm7ki063hcg0","created":1792286388449,"text":"临床意义：","layout":null},"children":[{"data":{"id":"dm7ki8swgpk0","created":1792286407242,"text":"正常成人约4217ml（3105）","layout":null},"children":[]},{"data":{"id":"dm7ki8sws480","created":1792286407243,"text":"* 降低：","layout":null},"children":[{"data":{"id":"dm7kihru5w00","created":1792286426769,"text":"限制性通气功能障碍肺病、严重阻塞性肺病","layout":null},"children":[]},{"data":{"id":"dm7kijpwbj40","created":1792286431005,"text":"* 实测值<预计值80％为降低","layout":null},"children":[]},{"data":{"id":"dm7ki8sx9340","created":1792286407243,"text":"轻（60～79％）","layout":null},"children":[]},{"data":{"id":"dm7ki8sx3h40","created":1792286407243,"text":"中（40～59％）","layout":null},"children":[]},{"data":{"id":"dm7ki8sx5ko0","created":1792286407243,"text":"重（<40％）","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7kbsez3ow0","created":1792285901386,"text":"肺总量（total lung capacity，TLC) ","layout":null},"children":[{"data":{"id":"dm7lvl74a8w0","created":1792290274067,"text":"定义：","layout":null},"children":[{"data":{"id":"dm7lvl74o4g0","created":1792290274068,"text":"最大限度吸气后肺内所含气量","layout":null},"children":[]}]},{"data":{"id":"dm7lvl74xxk0","created":1792290274068,"text":" 临床意义：","layout":null},"children":[{"data":{"id":"dm7lvl74yo80","created":1792290274068,"text":"正常成人约5020ml（3460）","layout":null},"children":[]},{"data":{"id":"dm7lvl74u9c0","created":1792290274068,"text":"* 降低：限制性肺病","layout":null},"children":[]},{"data":{"id":"dm7lvl74ql40","created":1792290274068,"text":"* 肺气肿可正常或增高","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dm7jy6n6vko0","created":1792284835260,"text":"通气功能","layout":null},"children":[{"data":{"id":"dm7lw6uve540","created":1792290321216,"text":"动态肺容积：\n单位时间内随呼吸运动进出肺的气量和流速（流量）","layout":null},"children":[{"data":{"id":"dm7lwvq5s5k0","created":1792290375350,"text":"肺通气量（Pulmonary ventilation volume，PVV）","layout":null},"children":[{"data":{"id":"dm7lyabwwq00","created":1792290485505,"text":"每分钟静息通气量（VE）：\n静息状态时每分钟呼出的气量，\n即潮气量与呼吸频率的乘积（VE=VT × RR）","layout":null},"children":[{"data":{"id":"dm7lyabxiew0","created":1792290485506,"text":"评价指标：","layout":null},"children":[{"data":{"id":"dm7lyabxivk0","created":1792290485506,"text":" 正常值为 5-8 L/min","layout":null},"children":[]},{"data":{"id":"dm7lyabxkhc0","created":1792290485506,"text":" >10L提示通气过度：呼吸性碱中毒","layout":null},"children":[]},{"data":{"id":"dm7lyabxknk0","created":1792290485506,"text":" <  3L提示通气不足：呼吸性酸中毒","layout":null},"children":[]}]}]},{"data":{"id":"dm7lzammofs0","created":1792290564517,"text":"最大自主通气量MVV:\n一分钟内以“最深、最快”的呼吸所得到的通气量，\n一般测12或15秒","layout":null},"children":[{"data":{"id":"dm7lzsb0v1c0","created":1792290602997,"text":"评价指标：正常人≥预计值的80%","layout":null},"children":[]},{"data":{"id":"dm7lzvfr2u80","created":1792290609814,"text":"降低","layout":null},"children":[{"data":{"id":"dm7lzsb0iiw0","created":1792290602997,"text":"轻度降低 ：60-79%","layout":null},"children":[]},{"data":{"id":"dm7lzsb0xuw0","created":1792290602997,"text":"中度降低 ：40-59%","layout":null},"children":[]},{"data":{"id":"dm7lzsb1dgg0","created":1792290602998,"text":"重度降低 ：<40%","layout":null},"children":[]}]}]},{"data":{"id":"dm7m0j21p540","created":1792290661228,"text":"临床意义","layout":null},"children":[{"data":{"id":"dm7m0m6sjz40","created":1792290668045,"text":"降低","layout":null},"children":[{"data":{"id":"dm7m0ykczfk0","created":1792290694987,"text":"与肺容量、气道阻力、胸肺顺应性以及呼吸肌力都有关，\n见于阻塞性或限制性通气功能障碍","layout":null},"children":[]}]},{"data":{"id":"dm7m0oxwjr40","created":1792290674038,"text":"通气储备能力的考核指标","layout":null},"children":[{"data":{"id":"dm7m1d734c80","created":1792290726836,"text":"\t通气储量%  =（MVV - 每分钟静息通气量）/MVV                                                     ×100%","layout":null},"children":[]},{"data":{"id":"dm7m1xa3mmw0","created":1792290770554,"text":"正常值为95%以上，\n＜86％提示通气功能储备不佳（肺部手术应慎重），\n＜70％通气功能严重损害","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7lwvq6bq00","created":1792290375351,"text":"用力肺活量（forced vital capacity, FVC) ","layout":null},"children":[{"data":{"id":"dm7m2lq3ag80","created":1792290823763,"text":"深吸气至肺总量位后，用 最大力量、最快速度 呼出的全部气量","layout":null},"children":[]},{"data":{"id":"dm7m2ughdkg0","created":1792290842773,"text":"按单位时间考察”时间肺活量“","layout":null},"children":[{"data":{"id":"dm7m38ubk8w0","created":1792290874085,"text":"FEV1 ：第一秒用力呼气容积占FVC  83％ ","layout":null,"color":"#ff0000","background":"#73a1bf","font-weight":"bold"},"children":[]},{"data":{"id":"dm7m3d38wgw0","created":1792290883332,"text":"FEV2 ： 96％","layout":null},"children":[]},{"data":{"id":"dm7m3fngnqw0","created":1792290888908,"text":"FEV3： 99％","layout":null},"children":[]},{"data":{"id":"dm7m3jica1k0","created":1792290897305,"text":"FEV1/FVC ：第一秒用力呼气率，一秒率","layout":null,"color":"#ff0000","font-weight":"bold","background":"#73a1bf"},"children":[]}]},{"data":{"id":"dm7m3vbrccw0","created":1792290923029,"text":"正常值范围","layout":null},"children":[{"data":{"id":"dm7m56z9vi80","created":1792291026759,"text":"FVC：约3179ml（2314）","layout":null},"children":[]},{"data":{"id":"dm7m56z9ro80","created":1792291026759,"text":"FVC% Pred    ≥80%","layout":null},"children":[]},{"data":{"id":"dm7m56z9v800","created":1792291026759,"text":"FEV1% Pred   ≥80% ","layout":null},"children":[]},{"data":{"id":"dm7m56zaayg0","created":1792291026760,"text":"FEV1/FVC%   ≥83%","layout":null},"children":[]}]},{"data":{"id":"dm7m693v9lc0","created":1792291109755,"text":"临床意义","layout":null},"children":[{"data":{"id":"dm7m6d0jxi80","created":1792291118262,"text":"测定呼吸道有无阻力的重要指标","layout":null},"children":[]},{"data":{"id":"dm7m6k7iv7c0","created":1792291133921,"text":"评价通气功能障碍","layout":null},"children":[{"data":{"id":"dm7m737yycg0","created":1792291175306,"text":"① 阻塞性疾病：FEV1、FEV1/FVC % 减少","note":"正常人FVC与VC接近。阻塞性肺疾病患者用力呼气时由于胸腔内压增高，小气道提早闭合，可导致FVC小于VC","layout":null},"children":[]},{"data":{"id":"dm7m737zy3k0","created":1792291175308,"text":"② 限制性病变：FEV1/FVC%正常或增高                   （甚至高达100 ％","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7lwvq66og0","created":1792290375351,"text":"最大呼气中段流量（Maximum mid-expiratory flow，MMEF）","layout":null},"children":[{"data":{"id":"dm7mn4irnmo0","created":1792292431963,"text":"由FVC曲线计算得到的用力呼出25%~75%FVC的平均流量","layout":null},"children":[]},{"data":{"id":"dm7mnkfka3s0","created":1792292466597,"text":"临床意义：","layout":null},"children":[{"data":{"id":"dm7mno5ao1c0","created":1792292474684,"text":"正常3452ml/s（2836）","layout":null},"children":[]},{"data":{"id":"dm7mnulpf4o0","created":1792292488737,"text":"评价早期小气道阻塞的指标","image":"https://p.cldisk.com/star4/f3141654478791e6ced54d2cf0fd8ee2/origin.png","imageTitle":"","imageSize":{"width":200,"height":182},"layout":null},"children":[{"data":{"id":"dm7r7la327s0","created":1792305320166,"text":"MMEF摒弃呼气初始与用力有关的部分\n及呼气终末呼气速度明显减低部分的肺容量，\n故比一秒率能够更敏感地反映小气道阻塞情况。","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7lwvq5vfc0","created":1792290375351,"text":"肺泡通气量（alveolar ventilation，VA）","layout":null},"children":[{"data":{"id":"dm7r82xgagw0","created":1792305358584,"text":"静息状态下每分钟吸入气量中能到达“呼吸性细支气管、 肺泡”\n进行有效气体交换的有效通气量","layout":null},"children":[]},{"data":{"id":"dm7r8ckdk6g0","created":1792305379561,"text":"生理无效腔=解剖无效腔+肺泡无效腔","layout":null},"children":[{"data":{"id":"dm7r8r2sc8g0","created":1792305411150,"text":"解剖无效腔：停留在传导气道，\n如口腔、鼻腔、气管、支气管                       等的气量","layout":null},"children":[]},{"data":{"id":"dm7r96rjrtk0","created":1792305445299,"text":"肺泡无效腔：进入血流不足的肺泡中不能进行有效的气体交换                       的气量（可忽略不计）","layout":null},"children":[]},{"data":{"id":"dm7r9qkfgo00","created":1792305488404,"text":"生理无效腔（VD）：正常人VD/VT为25%～33%","layout":null},"children":[]}]},{"data":{"id":"dm7r9w0qrug0","created":1792305500274,"text":"计算：肺泡通气量=每分钟通气量-生理无效腔通气量\n\t        VA =（VT -VD）* RR","layout":null},"children":[]}]}]},{"data":{"id":"dm7rbbxisls0","created":1792305613272,"text":"应用","layout":null},"children":[{"data":{"id":"dm7s7rc7o480","created":1792308154465,"text":"障碍分型","layout":null},"children":[{"data":{"id":"dm7rcughl3s0","created":1792305731965,"text":"","image":"https://p.cldisk.com/star4/96bed6b28196274ae70d27d07fabdfb6/origin.png","imageTitle":"","imageSize":{"width":200,"height":168},"layout":null},"children":[]},{"data":{"id":"dm7rd1gmfkg0","created":1792305747211,"text":" ","image":"https://p.cldisk.com/star4/4838a2e93290bdc7798d681bc3cff8d6/origin.png","imageTitle":"","imageSize":{"width":200,"height":103},"layout":null},"children":[]},{"data":{"id":"dm7rdn506qg0","created":1792305794397,"text":"慢阻肺患者根据FEV1占预计值%\n（FEV1/pred %）","layout":null},"children":[{"data":{"id":"dm7rdujvc7c0","created":1792305810534,"text":"GLOD 1级：≥80%","layout":null},"children":[]},{"data":{"id":"dm7rdujw1i00","created":1792305810535,"text":"GOLD 2级：50%~79%","layout":null},"children":[]},{"data":{"id":"dm7rdujw4o00","created":1792305810535,"text":"GOLD 3级：30%~49%","layout":null},"children":[]},{"data":{"id":"dm7rdujw1oo0","created":1792305810535,"text":"GOLD 4级：<30%","layout":null},"children":[]},{"data":{"id":"dm7rqpyyhfs0","created":1792306819296,"text":"举例：中重度阻塞性通气障碍","image":"https://p.cldisk.com/star4/e96032fe53bce48ebc4f28eb0d264591/origin.png","imageTitle":"","imageSize":{"width":200,"height":123},"layout":null},"children":[]}]}]},{"data":{"id":"dm7sb4rn0f40","created":1792308418789,"text":"气道阻塞可逆性判断","layout":null},"children":[{"data":{"id":"dm7sbads02w0","created":1792308431011,"text":"支气管舒张试验","layout":null},"children":[{"data":{"id":"dm7sbh9k24g0","created":1792308445993,"text":"测定FEV1或FEV1/FVC降低时吸入沙丁胺醇0.2mg，\n\t                       15-20分钟后重复测定FEV1及FEV1/FVC。","note":"注意：测定前24小时停用支气管舒张药","layout":null},"children":[]},{"data":{"id":"dm7sbzcbdk00","created":1792308485342,"text":"评价指标：FEV1改善率","layout":null},"children":[{"data":{"id":"dm7scd4dzkw0","created":1792308515338,"text":"FEV1改善率 = （用药后FEV1 - 用药前FEV1）/用药前FEV1×100% ","layout":null},"children":[]},{"data":{"id":"dm7scu5t0uo0","created":1792308552429,"text":"阳性标准：改善率＞12%且FEV增加＞200mL","layout":null},"children":[]},{"data":{"id":"dm7se613up40","created":1792308656630,"text":"15％－24％：轻度可逆\n\t                25%－40％：中度可逆\n\t                        ＞40% ：高度可逆","layout":null},"children":[]},{"data":{"id":"dm7sfcbp10g0","created":1792308748695,"text":" ","image":"https://p.cldisk.com/star4/34db608171e15552a62a569839eef182/origin.png","imageTitle":"","imageSize":{"width":200,"height":111},"layout":null},"children":[]},{"data":{"id":"dm7shyndp8o0","created":1792308954020,"text":"举例","layout":null},"children":[{"data":{"id":"dm7sidklu400","created":1792308986504,"text":"","image":"https://p.cldisk.com/star4/d02c4d11d7fd231730af3b5295ff79bf/origin.png","imageTitle":"","imageSize":{"width":200,"height":24},"layout":null},"children":[]}]}]}]},{"data":{"id":"dm7sipm7lcw0","created":1792309012722,"text":"支气管激发试验","layout":null},"children":[{"data":{"id":"dm7six6fhts0","created":1792309029182,"text":"用某种刺激使这个平滑肌收缩，再行肺功能检查，\n\t                       判断支气管狭窄的程度。","layout":null},"children":[]},{"data":{"id":"dm7sml5pg3c0","created":1792309316474,"text":"观察指标","layout":null},"children":[{"data":{"id":"dm7smqrkzjc0","created":1792309328680,"text":"PD₂₀FEV1： FEV1 降低20％所需的药物累积量。","layout":null},"children":[]},{"data":{"id":"dm7snbvh0kg0","created":1792309374628,"text":"计算公式","layout":null},"children":[{"data":{"id":"dm7snjvmzao0","created":1792309392052,"text":" PD20FEV1（mol）= （FEV1对照值－吸药后FEV1最高值）/FEV1对照值×100% ","layout":null},"children":[]}]},{"data":{"id":"dm7stjirlo80","created":1792309861459,"text":"阳性标准","layout":null},"children":[{"data":{"id":"dm7stzguaco0","created":1792309896171,"text":"乙酰甲胆酰＜12.8μmol","layout":null},"children":[]},{"data":{"id":"dm7sugjqsdc0","created":1792309933352,"text":"组织胺＜7.8μmol","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7suu2c9k00","created":1792309962774,"text":"最大呼气流量PEF","layout":null},"children":[{"data":{"id":"dm7sv040uo00","created":1792309975937,"text":"用力呼气过程中最大的瞬时流速，反映气道阻力","layout":null},"children":[]},{"data":{"id":"dm7svcpxluo0","created":1792310003384,"text":"PEF日变异率=（                                  PEFmax – PEFmin）/（PEFmax + PEFmin）×100%","layout":null},"children":[]},{"data":{"id":"dm7svx0hp680","created":1792310047557,"text":"变异率阳性","layout":null},"children":[{"data":{"id":"dm7sw4l9neg0","created":1792310064051,"text":"≥ 20％对诊断、监测支气管哮喘的治疗效果有实际意义","layout":null},"children":[]}]}]}]}]}]},{"data":{"id":"dm7jya8k3hc0","created":1792284843082,"text":"小气道及换气功能","layout":null},"children":[{"data":{"id":"dm7swqlkl000","created":1792310111959,"text":"小气道功能","layout":null},"children":[{"data":{"id":"dm7swb7sqrk0","created":1792310078474,"text":"小气道：指内径≤2mm的细支气管，\n包括全部细支气管、终末细支气管","layout":null},"children":[]},{"data":{"id":"dm7swxpz9880","created":1792310127462,"text":"检测方法","layout":null},"children":[{"data":{"id":"dm7sx38a7f40","created":1792310139453,"text":"①闭合容积","layout":null},"children":[]},{"data":{"id":"dm7sx389zi00","created":1792310139453,"text":"②最大呼气流量—容积曲线","layout":null},"children":[]},{"data":{"id":"dm7sx389yxs0","created":1792310139453,"text":"③频率依赖性肺顺应性","layout":null},"children":[]}]}]},{"data":{"id":"dm7sx88rhhc0","created":1792310150366,"text":"闭合容积CV与闭合容量CC ","layout":null},"children":[{"data":{"id":"dm7sxnfl7hs0","created":1792310183430,"text":"概念","layout":null},"children":[{"data":{"id":"dm7sxpjh21s0","created":1792310188019,"text":"CV：深吸气后缓慢深呼气，\n肺低垂部位小气道开始陷闭时\n尚能继续呼出的气量","layout":null},"children":[]},{"data":{"id":"dm7sy24jlgw0","created":1792310215414,"text":"CC：小气道开始陷闭时肺内留存的气量\n（CV＋RV）","layout":null},"children":[]}]},{"data":{"id":"dm7sydwf1800","created":1792310241044,"text":"测定方法","layout":null},"children":[{"data":{"id":"dm7syhz58j40","created":1792310249916,"text":"氮气法/氦气法","layout":null},"children":[]}]},{"data":{"id":"dm7syoedclc0","created":1792310263898,"text":"原理","layout":null},"children":[{"data":{"id":"dm7syu0ptpk0","created":1792310276133,"text":"根据上、下肺标记的气体非同步排空\n作为判定点来测量，直至呼气结束。","layout":null},"children":[]}]},{"data":{"id":"dm7syzyklio0","created":1792310289064,"text":"参考值","layout":null},"children":[{"data":{"id":"dm7szdwbfo00","created":1792310319402,"text":"CV=0.40L，\nCC=1.90L，\nCC/TLC=32%","layout":null},"children":[]}]},{"data":{"id":"dm7szl5ry000","created":1792310335212,"text":"闭合容积增高","layout":null},"children":[{"data":{"id":"dm7szudx3dk0","created":1792310355295,"text":"年龄大、肺小气道阻塞的早期征象。","layout":null},"children":[]}]},{"data":{"id":"dm7t0omhrxk0","created":1792310421117,"text":"","image":"https://p.cldisk.com/star4/14420d5e16e3813786dde035cf3e8b88/origin.png","imageTitle":"","imageSize":{"width":200,"height":119}},"children":[{"data":{"id":"dm7t0yzoxcg0","created":1792310443683,"text":"第Ⅰ相来自解剖死腔的呼出气，不含指标气体，氮为零。"},"children":[]},{"data":{"id":"dm7t0yzold40","created":1792310443683,"text":"第Ⅱ相为肺泡与死腔的混合气，指示气体浓度急剧上升，曲线斜行向上。"},"children":[]},{"data":{"id":"dm7t0yzp2r40","created":1792310443683,"text":"第Ⅲ相为各区域肺铴呼出气，由于各区域气体同步呼出，呼出气中的指示气体浓度大致相同，曲线呈高浓度上的水平线，有肺泡坪之称（alveolar plateau）。"},"children":[]},{"data":{"id":"dm7t0yzoucw0","created":1792310443683,"text":"第Ⅳ相下肺小气道开始闭合，从上肺呼出含较高浓度的指示气体，曲线徒然上升成上扬型。"},"children":[]},{"data":{"id":"dm7t0yzp19k0","created":1792310443683,"text":"第Ⅲ相与第Ⅳ相相连结点是下肺小气道开始关闭的标记，该点至呼气终点的肺容量称闭合容积（CV），闭合容量与残气之和称闭合容量（closing capacity，CC）一般用闭合容积/肺活量百分比（CV/VC%）及闭合容量/肺总量百分比（CC/TLC%）方法来表示，以实测占正常预计值加以判断。正常值CV=0.40L，CC=1.90L，CC/TLC=32%。"},"children":[]}]}]}]},{"data":{"id":"dm7jypjgjnk0","created":1792284876393,"text":"动脉血气分析","layout":null},"children":[]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}