00）","layout":null},"children":[]},{"data":{"id":"dm7k9vf9ri00","created":1792285751206,"text":"  * 降低：呼吸肌功能不全","layout":null},"children":[]}]}]},{"data":{"id":"dm7k3rf1c680","created":1792285272300,"text":"补呼气量（expiratory reserve volume，ERV) ","layout":null},"children":[{"data":{"id":"dm7kanfzeko0","created":1792285812199,"text":"定义：","layout":null},"children":[{"data":{"id":"dm7kanfziag0","created":1792285812199,"text":"  平静呼气末，再尽最大      力量所呼出的气量","layout":null},"children":[]}]},{"data":{"id":"dm7kanfzku80","created":1792285812200,"text":"  临床意义：","layout":null},"children":[{"data":{"id":"dm7kanfzsbc0","created":1792285812200,"text":"  正常成人约1609ml（1126）","layout":null},"children":[]},{"data":{"id":"dm7kanfzri00","created":1792285812200,"text":"  * 降低：呼吸肌功能不全","layout":null},"children":[]}]}]},{"data":{"id":"dm7k3rf13ds0","created":1792285272300,"text":"残气量（residual volume，RV) ","layout":null},"children":[{"data":{"id":"dm7kav1zvsw0","created":1792285828768,"text":"定义：","layout":null},"children":[{"data":{"id":"dm7kav20gqw0","created":1792285828769,"text":"  用力呼气末，肺内所含的气量","layout":null},"children":[]}]},{"data":{"id":"dm7kav20na80","created":1792285828769,"text":"  临床意义：","layout":null},"children":[{"data":{"id":"dm7kav210cw0","created":1792285828770,"text":"  正常成人约1615ml（1245）","layout":null},"children":[]},{"data":{"id":"dm7kav20z6w0","created":1792285828770,"text":"  与肺总量比值约25％","layout":null},"children":[{"data":{"id":"dm7kav218ow0","created":1792285828770,"text":" * 升高：老年人，慢阻肺","layout":null},"children":[]},{"data":{"id":"dm7kav215js0","created":1792285828770,"text":" * 降低：间质性肺疾病","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dm7kb6p7vhc0","created":1792285854117,"text":"基础肺容量：\n≥2个的基础肺容积组成","layout":null},"children":[{"data":{"id":"dm7kbseyhk00","created":1792285901385,"text":"深吸气量（inspiratory capacity，IC)","layout":null},"children":[{"data":{"id":"dm7kc4wnauw0","created":1792285928576,"text":"定义：","layout":null},"children":[{"data":{"id":"dm7kc4wn1io0","created":1792285928576,"text":"平静呼气末，再尽最大力量吸气的最大吸气量","layout":null},"children":[]}]},{"data":{"id":"dm7kc4wnc3c0","created":1792285928576,"text":"  临床意义：","layout":null},"children":[{"data":{"id":"dm7kc4wmtxk0","created":1792285928576,"text":"正常成人约2617ml（1970）","layout":null},"children":[]},{"data":{"id":"dm7kc4wmzlc0","created":1792285928576,"text":"* 降低：","layout":null},"children":[{"data":{"id":"dm7kc4wnrsw0","created":1792285928577,"text":"   限制性通气功能障碍肺病","layout":null},"children":[]},{"data":{"id":"dm7kc4wnulk0","created":1792285928577,"text":"   阻塞性通气功能障碍肺病","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7kbsez3a80","created":1792285901386,"text":"功能残气量（functional residual capacity, FRC)","layout":null},"children":[{"data":{"id":"dm7kfbma4f40","created":1792286178280,"text":"定义","layout":null},"children":[{"data":{"id":"dm7kfdz4el40","created":1792286183410,"text":"平静呼气末，肺内所含的气量","layout":null},"children":[]}]},{"data":{"id":"dm7kfrno8yw0","created":1792286213192,"text":"测定方法","layout":null},"children":[{"data":{"id":"dm7kfu4muzs0","created":1792286218571,"text":"1.氮气稀释法","layout":null},"children":[]},{"data":{"id":"dm7kfy5puhc0","created":1792286227344,"text":"2.氦气稀释法","layout":null},"children":[]}]},{"data":{"id":"dm7kg1w240o0","created":1792286235467,"text":"临床意义","layout":null},"children":[{"data":{"id":"dm7kg4wudi80","created":1792286242045,"text":"正常成人约3112ml（2348）\n约为肺总量的40%","layout":null},"children":[]},{"data":{"id":"dm7kgte8rqw0","created":1792286295340,"text":"升高：阻塞（肺气肿）","layout":null},"children":[]},{"data":{"id":"dm7kgyfkj280","created":1792286306304,"text":"降低：限制（纤维化、ARDS、胸廓畸形）","layout":null},"children":[]}]}]},{"data":{"id":"dm7kbseyseg0","created":1792285901386,"text":"肺活量（vital capacity，VC)","layout":null},"children":[{"data":{"id":"dm7khry5c1c0","created":1792286370554,"text":"定义：","layout":null},"children":[{"data":{"id":"dm7ki4dunw00","created":1792286397625,"text":"尽力吸气后，缓慢而完全地\n呼出的最大呼气量（右肺占55%）","layout":null},"children":[]}]},{"data":{"id":"dm7ki063hcg0","created":1792286388449,"text":"临床意义：","layout":null},"children":[{"data":{"id":"dm7ki8swgpk0","created":1792286407242,"text":"正常成人约4217ml（3105）","layout":null},"children":[]},{"data":{"id":"dm7ki8sws480","created":1792286407243,"text":"* 降低：","layout":null},"children":[{"data":{"id":"dm7kihru5w00","created":1792286426769,"text":"限制性通气功能障碍肺病、严重阻塞性肺病","layout":null},"children":[]},{"data":{"id":"dm7kijpwbj40","created":1792286431005,"text":"* 实测值<预计值80％为降低","layout":null},"children":[]},{"data":{"id":"dm7ki8sx9340","created":1792286407243,"text":"轻（60～79％）","layout":null},"children":[]},{"data":{"id":"dm7ki8sx3h40","created":1792286407243,"text":"中（40～59％）","layout":null},"children":[]},{"data":{"id":"dm7ki8sx5ko0","created":1792286407243,"text":"重（<40％）","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7kbsez3ow0","created":1792285901386,"text":"肺总量（total lung capacity，TLC) ","layout":null},"children":[{"data":{"id":"dm7lvl74a8w0","created":1792290274067,"text":"定义：","layout":null},"children":[{"data":{"id":"dm7lvl74o4g0","created":1792290274068,"text":"最大限度吸气后肺内所含气量","layout":null},"children":[]}]},{"data":{"id":"dm7lvl74xxk0","created":1792290274068,"text":" 临床意义：","layout":null},"children":[{"data":{"id":"dm7lvl74yo80","created":1792290274068,"text":"正常成人约5020ml（3460）","layout":null},"children":[]},{"data":{"id":"dm7lvl74u9c0","created":1792290274068,"text":"* 降低：限制性肺病","layout":null},"children":[]},{"data":{"id":"dm7lvl74ql40","created":1792290274068,"text":"* 肺气肿可正常或增高","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dm7jy6n6vko0","created":1792284835260,"text":"通气功能","layout":null},"children":[{"data":{"id":"dm7lw6uve540","created":1792290321216,"text":"动态肺容积：\n单位时间内随呼吸运动进出肺的气量和流速（流量）","layout":null},"children":[{"data":{"id":"dm7lwvq5s5k0","created":1792290375350,"text":"肺通气量（Pulmonary ventilation volume，PVV）","layout":null},"children":[{"data":{"id":"dm7lyabwwq00","created":1792290485505,"text":"每分钟静息通气量（VE）：\n静息状态时每分钟呼出的气量，\n即潮气量与呼吸频率的乘积（VE=VT × RR）","layout":null},"children":[{"data":{"id":"dm7lyabxiew0","created":1792290485506,"text":"评价指标：","layout":null},"children":[{"data":{"id":"dm7lyabxivk0","created":1792290485506,"text":" 正常值为 5-8 L/min","layout":null},"children":[]},{"data":{"id":"dm7lyabxkhc0","created":1792290485506,"text":" >10L提示通气过度：呼吸性碱中毒","layout":null},"children":[]},{"data":{"id":"dm7lyabxknk0","created":1792290485506,"text":" <  3L提示通气不足：呼吸性酸中毒","layout":null},"children":[]}]}]},{"data":{"id":"dm7lzammofs0","created":1792290564517,"text":"最大自主通气量MVV:\n一分钟内以“最深、最快”的呼吸所得到的通气量，\n一般测12或15秒","layout":null},"children":[{"data":{"id":"dm7lzsb0v1c0","created":1792290602997,"text":"评价指标：正常人≥预计值的80%","layout":null},"children":[]},{"data":{"id":"dm7lzvfr2u80","created":1792290609814,"text":"降低","layout":null},"children":[{"data":{"id":"dm7lzsb0iiw0","created":1792290602997,"text":"轻度降低 ：60-79%","layout":null},"children":[]},{"data":{"id":"dm7lzsb0xuw0","created":1792290602997,"text":"中度降低 ：40-59%","layout":null},"children":[]},{"data":{"id":"dm7lzsb1dgg0","created":1792290602998,"text":"重度降低 ：<40%","layout":null},"children":[]}]}]},{"data":{"id":"dm7m0j21p540","created":1792290661228,"text":"临床意义","layout":null},"children":[{"data":{"id":"dm7m0m6sjz40","created":1792290668045,"text":"降低","layout":null},"children":[{"data":{"id":"dm7m0ykczfk0","created":1792290694987,"text":"与肺容量、气道阻力、胸肺顺应性以及呼吸肌力都有关，\n见于阻塞性或限制性通气功能障碍","layout":null},"children":[]}]},{"data":{"id":"dm7m0oxwjr40","created":1792290674038,"text":"通气储备能力的考核指标","layout":null},"children":[{"data":{"id":"dm7m1d734c80","created":1792290726836,"text":"\t通气储量%  =（MVV - 每分钟静息通气量）/MVV                                                     ×100%","layout":null},"children":[]},{"data":{"id":"dm7m1xa3mmw0","created":1792290770554,"text":"正常值为95%以上，\n＜86％提示通气功能储备不佳（肺部手术应慎重），\n＜70％通气功能严重损害","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7lwvq6bq00","created":1792290375351,"text":"用力肺活量（forced vital capacity, FVC) ","layout":null},"children":[{"data":{"id":"dm7m2lq3ag80","created":1792290823763,"text":"深吸气至肺总量位后，用 最大力量、最快速度 呼出的全部气量","layout":null},"children":[]},{"data":{"id":"dm7m2ughdkg0","created":1792290842773,"text":"按单位时间考察”时间肺活量“","layout":null},"children":[{"data":{"id":"dm7m38ubk8w0","created":1792290874085,"text":"FEV1 ：第一秒用力呼气容积占FVC  83％ ","layout":null,"color":"#ff0000","background":"#73a1bf","font-weight":"bold"},"children":[]},{"data":{"id":"dm7m3d38wgw0","created":1792290883332,"text":"FEV2 ： 96％","layout":null},"children":[]},{"data":{"id":"dm7m3fngnqw0","created":1792290888908,"text":"FEV3： 99％","layout":null},"children":[]},{"data":{"id":"dm7m3jica1k0","created":1792290897305,"text":"FEV1/FVC ：第一秒用力呼气率，一秒率","layout":null,"color":"#ff0000","font-weight":"bold","background":"#73a1bf"},"children":[]}]},{"data":{"id":"dm7m3vbrccw0","created":1792290923029,"text":"正常值范围","layout":null},"children":[{"data":{"id":"dm7m56z9vi80","created":1792291026759,"text":"FVC：约3179ml（2314）","layout":null},"children":[]},{"data":{"id":"dm7m56z9ro80","created":1792291026759,"text":"FVC% Pred    ≥80%","layout":null},"children":[]},{"data":{"id":"dm7m56z9v800","created":1792291026759,"text":"FEV1% Pred   ≥80% ","layout":null},"children":[]},{"data":{"id":"dm7m56zaayg0","created":1792291026760,"text":"FEV1/FVC%   ≥83%","layout":null},"children":[]}]},{"data":{"id":"dm7m693v9lc0","created":1792291109755,"text":"临床意义","layout":null},"children":[{"data":{"id":"dm7m6d0jxi80","created":1792291118262,"text":"测定呼吸道有无阻力的重要指标","layout":null},"children":[]},{"data":{"id":"dm7m6k7iv7c0","created":1792291133921,"text":"评价通气功能障碍","layout":null},"children":[{"data":{"id":"dm7m737yycg0","created":1792291175306,"text":"① 阻塞性疾病：FEV1、FEV1/FVC % 减少","note":"正常人FVC与VC接近。阻塞性肺疾病患者用力呼气时由于胸腔内压增高，小气道提早闭合，可导致FVC小于VC","layout":null},"children":[]},{"data":{"id":"dm7m737zy3k0","created":1792291175308,"text":"② 限制性病变：FEV1/FVC%正常或增高                   （甚至高达100 ％","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7lwvq66og0","created":1792290375351,"text":"最大呼气中段流量（Maximum mid-expiratory flow，MMEF）","layout":null},"children":[{"data":{"id":"dm7mn4irnmo0","created":1792292431963,"text":"由FVC曲线计算得到的用力呼出25%~75%FVC的平均流量","layout":null},"children":[]},{"data":{"id":"dm7mnkfka3s0","created":1792292466597,"text":"临床意义：","layout":null},"children":[{"data":{"id":"dm7mno5ao1c0","created":1792292474684,"text":"正常3452ml/s（2836）","layout":null},"children":[]},{"data":{"id":"dm7mnulpf4o0","created":1792292488737,"text":"评价早期小气道阻塞的指标","image":"https://p.cldisk.com/star4/f3141654478791e6ced54d2cf0fd8ee2/origin.png","imageTitle":"","imageSize":{"width":200,"height":182},"layout":null},"children":[{"data":{"id":"dm7r7la327s0","created":1792305320166,"text":"MMEF摒弃呼气初始与用力有关的部分\n及呼气终末呼气速度明显减低部分的肺容量，\n故比一秒率能够更敏感地反映小气道阻塞情况。","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7lwvq5vfc0","created":1792290375351,"text":"肺泡通气量（alveolar ventilation，VA）","layout":null},"children":[{"data":{"id":"dm7r82xgagw0","created":1792305358584,"text":"静息状态下每分钟吸入气量中能到达“呼吸性细支气管、 肺泡”\n进行有效气体交换的有效通气量","layout":null},"children":[]},{"data":{"id":"dm7r8ckdk6g0","created":1792305379561,"text":"生理无效腔=解剖无效腔+肺泡无效腔","layout":null},"children":[{"data":{"id":"dm7r8r2sc8g0","created":1792305411150,"text":"解剖无效腔：停留在传导气道，\n如口腔、鼻腔、气管、支气管                       等的气量","layout":null},"children":[]},{"data":{"id":"dm7r96rjrtk0","created":1792305445299,"text":"肺泡无效腔：进入血流不足的肺泡中不能进行有效的气体交换                       的气量（可忽略不计）","layout":null},"children":[]},{"data":{"id":"dm7r9qkfgo00","created":1792305488404,"text":"生理无效腔（VD）：正常人VD/VT为25%～33%","layout":null},"children":[]}]},{"data":{"id":"dm7r9w0qrug0","created":1792305500274,"text":"计算：肺泡通气量=每分钟通气量-生理无效腔通气量\n\t        VA =（VT -VD）* RR","layout":null},"children":[]}]}]},{"data":{"id":"dm7rbbxisls0","created":1792305613272,"text":"应用","layout":null},"children":[{"data":{"id":"dm7s7rc7o480","created":1792308154465,"text":"障碍分型","layout":null},"children":[{"data":{"id":"dm7rcughl3s0","created":1792305731965,"text":"","image":"https://p.cldisk.com/star4/96bed6b28196274ae70d27d07fabdfb6/origin.png","imageTitle":"","imageSize":{"width":200,"height":168},"layout":null},"children":[]},{"data":{"id":"dm7rd1gmfkg0","created":1792305747211,"text":" ","image":"https://p.cldisk.com/star4/4838a2e93290bdc7798d681bc3cff8d6/origin.png","imageTitle":"","imageSize":{"width":200,"height":103},"layout":null},"children":[]},{"data":{"id":"dm7rdn506qg0","created":1792305794397,"text":"慢阻肺患者根据FEV1占预计值%\n（FEV1/pred %）","layout":null},"children":[{"data":{"id":"dm7rdujvc7c0","created":1792305810534,"text":"GLOD 1级：≥80%","layout":null},"children":[]},{"data":{"id":"dm7rdujw1i00","created":1792305810535,"text":"GOLD 2级：50%~79%","layout":null},"children":[]},{"data":{"id":"dm7rdujw4o00","created":1792305810535,"text":"GOLD 3级：30%~49%","layout":null},"children":[]},{"data":{"id":"dm7rdujw1oo0","created":1792305810535,"text":"GOLD 4级：<30%","layout":null},"children":[]},{"data":{"id":"dm7rqpyyhfs0","created":1792306819296,"text":"举例：中重度阻塞性通气障碍","image":"https://p.cldisk.com/star4/e96032fe53bce48ebc4f28eb0d264591/origin.png","imageTitle":"","imageSize":{"width":200,"height":123},"layout":null},"children":[]}]}]},{"data":{"id":"dm7sb4rn0f40","created":1792308418789,"text":"气道阻塞可逆性判断","layout":null},"children":[{"data":{"id":"dm7sbads02w0","created":1792308431011,"text":"支气管舒张试验","layout":null},"children":[{"data":{"id":"dm7sbh9k24g0","created":1792308445993,"text":"测定FEV1或FEV1/FVC降低时吸入沙丁胺醇0.2mg，\n\t                       15-20分钟后重复测定FEV1及FEV1/FVC。","note":"注意：测定前24小时停用支气管舒张药","layout":null},"children":[]},{"data":{"id":"dm7sbzcbdk00","created":1792308485342,"text":"评价指标：FEV1改善率","layout":null},"children":[{"data":{"id":"dm7scd4dzkw0","created":1792308515338,"text":"FEV1改善率 = （用药后FEV1 - 用药前FEV1）/用药前FEV1×100% ","layout":null},"children":[]},{"data":{"id":"dm7scu5t0uo0","created":1792308552429,"text":"阳性标准：改善率＞12%且FEV增加＞200mL","layout":null},"children":[]},{"data":{"id":"dm7se613up40","created":1792308656630,"text":"15％－24％：轻度可逆\n\t                25%－40％：中度可逆\n\t                        ＞40% ：高度可逆","layout":null},"children":[]},{"data":{"id":"dm7sfcbp10g0","created":1792308748695,"text":" ","image":"https://p.cldisk.com/star4/34db608171e15552a62a569839eef182/origin.png","imageTitle":"","imageSize":{"width":200,"height":111},"layout":null},"children":[]},{"data":{"id":"dm7shyndp8o0","created":1792308954020,"text":"举例","layout":null},"children":[{"data":{"id":"dm7sidklu400","created":1792308986504,"text":"","image":"https://p.cldisk.com/star4/d02c4d11d7fd231730af3b5295ff79bf/origin.png","imageTitle":"","imageSize":{"width":200,"height":24},"layout":null},"children":[]}]}]}]},{"data":{"id":"dm7sipm7lcw0","created":1792309012722,"text":"支气管激发试验","layout":null},"children":[{"data":{"id":"dm7six6fhts0","created":1792309029182,"text":"用某种刺激使这个平滑肌收缩，再行肺功能检查，\n\t                       判断支气管狭窄的程度。","layout":null},"children":[]},{"data":{"id":"dm7sml5pg3c0","created":1792309316474,"text":"观察指标","layout":null},"children":[{"data":{"id":"dm7smqrkzjc0","created":1792309328680,"text":"PD₂₀FEV1： FEV1 降低20％所需的药物累积量。","layout":null},"children":[]},{"data":{"id":"dm7snbvh0kg0","created":1792309374628,"text":"计算公式","layout":null},"children":[{"data":{"id":"dm7snjvmzao0","created":1792309392052,"text":" PD20FEV1（mol）= （FEV1对照值－吸药后FEV1最高值）/FEV1对照值×100% ","layout":null},"children":[]}]},{"data":{"id":"dm7stjirlo80","created":1792309861459,"text":"阳性标准","layout":null},"children":[{"data":{"id":"dm7stzguaco0","created":1792309896171,"text":"乙酰甲胆酰＜12.8μmol","layout":null},"children":[]},{"data":{"id":"dm7sugjqsdc0","created":1792309933352,"text":"组织胺＜7.8μmol","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7suu2c9k00","created":1792309962774,"text":"最大呼气流量PEF","layout":null},"children":[{"data":{"id":"dm7sv040uo00","created":1792309975937,"text":"用力呼气过程中最大的瞬时流速，反映气道阻力","layout":null},"children":[]},{"data":{"id":"dm7svcpxluo0","created":1792310003384,"text":"PEF日变异率=（                                  PEFmax – PEFmin）/（PEFmax + PEFmin）×100%","layout":null},"children":[]},{"data":{"id":"dm7svx0hp680","created":1792310047557,"text":"变异率阳性","layout":null},"children":[{"data":{"id":"dm7sw4l9neg0","created":1792310064051,"text":"≥ 20％对诊断、监测支气管哮喘的治疗效果有实际意义","layout":null},"children":[]}]}]}]}]}]},{"data":{"id":"dm7jya8k3hc0","created":1792284843082,"text":"小气道及换气功能","layout":null,"image":"https://p.cldisk.com/star4/994a8bc44be7a420f0846987f0b1561d/origin.png","imageTitle":"","imageSize":{"width":200,"height":115}},"children":[{"data":{"id":"dm7swqlkl000","created":1792310111959,"text":"小气道功能","layout":null},"children":[{"data":{"id":"dm7swb7sqrk0","created":1792310078474,"text":"小气道：指内径≤2mm的细支气管，\n包括全部细支气管、终末细支气管","layout":null},"children":[]},{"data":{"id":"dm7swxpz9880","created":1792310127462,"text":"检测方法","layout":null},"children":[{"data":{"id":"dm7sx38a7f40","created":1792310139453,"text":"①闭合容积","layout":null},"children":[]},{"data":{"id":"dm7sx389zi00","created":1792310139453,"text":"②最大呼气流量—容积曲线","layout":null},"children":[]},{"data":{"id":"dm7sx389yxs0","created":1792310139453,"text":"③频率依赖性肺顺应性","layout":null},"children":[]}]},{"data":{"id":"dm7sx88rhhc0","created":1792310150366,"text":"闭合容积CV与闭合容量CC ","layout":null},"children":[{"data":{"id":"dm7sxnfl7hs0","created":1792310183430,"text":"概念","layout":null},"children":[{"data":{"id":"dm7sxpjh21s0","created":1792310188019,"text":"CV：深吸气后缓慢深呼气，\n肺低垂部位小气道开始陷闭时\n尚能继续呼出的气量","layout":null},"children":[]},{"data":{"id":"dm7sy24jlgw0","created":1792310215414,"text":"CC：小气道开始陷闭时肺内留存的气量\n（CV＋RV）","layout":null},"children":[]}]},{"data":{"id":"dm7sydwf1800","created":1792310241044,"text":"测定方法","layout":null},"children":[{"data":{"id":"dm7syhz58j40","created":1792310249916,"text":"氮气法/氦气法","layout":null},"children":[]}]},{"data":{"id":"dm7syoedclc0","created":1792310263898,"text":"原理","layout":null},"children":[{"data":{"id":"dm7syu0ptpk0","created":1792310276133,"text":"根据上、下肺标记的气体非同步排空\n作为判定点来测量，直至呼气结束。","layout":null},"children":[]}]},{"data":{"id":"dm7syzyklio0","created":1792310289064,"text":"参考值","layout":null},"children":[{"data":{"id":"dm7szdwbfo00","created":1792310319402,"text":"CV=0.40L，\nCC=1.90L，\nCC/TLC=32%","layout":null},"children":[]}]},{"data":{"id":"dm7szl5ry000","created":1792310335212,"text":"闭合容积增高","layout":null},"children":[{"data":{"id":"dm7szudx3dk0","created":1792310355295,"text":"年龄大、肺小气道阻塞的早期征象。","layout":null},"children":[]}]},{"data":{"id":"dm7t0omhrxk0","created":1792310421117,"text":"","image":"https://p.cldisk.com/star4/14420d5e16e3813786dde035cf3e8b88/origin.png","imageTitle":"","imageSize":{"width":200,"height":119},"layout":null},"children":[{"data":{"id":"dm7t0yzoxcg0","created":1792310443683,"text":"第Ⅰ相来自解剖死腔的呼出气，不含指标气体，氮为零。","layout":null},"children":[]},{"data":{"id":"dm7t0yzold40","created":1792310443683,"text":"第Ⅱ相为肺泡与死腔的混合气，\n指示气体浓度急剧上升，曲线斜行向上。","layout":null},"children":[]},{"data":{"id":"dm7t0yzp2r40","created":1792310443683,"text":"第Ⅲ相为各区域肺区呼出气，\n由于各区域气体同步呼出，\n呼出气中的指示气体浓度大致相同，\n曲线呈高浓度上的水平线，\n有肺泡坪之称（alveolar plateau）。","layout":null},"children":[]},{"data":{"id":"dm7t0yzoucw0","created":1792310443683,"text":"第Ⅳ相下肺小气道开始闭合，\n从上肺呼出含较高浓度的指示气体，\n曲线徒然上升成上扬型。","layout":null},"children":[]},{"data":{"id":"dm7t0yzp19k0","created":1792310443683,"text":"第Ⅲ相与第Ⅳ相相连结点是下肺小气道开始关闭的标记，\n该点至呼气终点的肺容量称闭合容积（CV），\n闭合容量与残气之和称闭合容量（closing capacity，CC）\n一般用闭合容积/肺活量百分比（CV/VC%）\n及闭合容量/肺总量百分比（CC/TLC%）方法来表示，\n以实测占正常预计值加以判断。\n正常值CV=0.40L，CC=1.90L，CC/TLC=32%。","layout":null},"children":[]}]}]},{"data":{"id":"dm7uut5zpr40","created":1792315603038,"text":"最大呼气流量——容积曲线","layout":null},"children":[{"data":{"id":"dm7uveqc8tc0","created":1792315649982,"text":"容量-时间曲线：右图是左图的最后两步\n单独拉出来，再把曲线上下翻转而成 \n 重点描述\n一秒量（FEV1）、\n用力肺活量（FVC）、\n峰流速（PEF）","layout":null},"children":[]},{"data":{"id":"dm7uyg4ox8o0","created":1792315888118,"text":"流量L/S—容积L曲线","layout":null,"image":"https://p.cldisk.com/star4/e495765674b660d7b9b7873f08d4a5c7/origin.png","imageTitle":"","imageSize":{"width":200,"height":85}},"children":[{"data":{"id":"dm7uyt5y02g0","created":1792315916492,"text":"*大于75%用力肺活量时，\n随着呼气肌用力而呼气流量增加，\n属于“用力依赖性”部分。","layout":null},"children":[]},{"data":{"id":"dm7uyt5y7j40","created":1792315916492,"text":"*小于50%肺活量时，\n即使增加呼气用力程度，呼气流量也不再增多，\n属“非用力依赖”部分。","layout":null},"children":[]},{"data":{"id":"dm7uyt5xqzk0","created":1792315916492,"text":"* PEF-Vmax75(FEF25%)反映大气道阻力和呼吸肌力，\nVmax75-Vmax25 (FEF25%-FEF75%)反映小气道阻力。","layout":null},"children":[]},{"data":{"id":"dm7v32pikx40","created":1792316250723,"text":"不同情况下该曲线的变化","layout":null},"children":[{"data":{"id":"dm7v3ux4bvk0","created":1792316312134,"text":"","image":"https://p.cldisk.com/star4/e8b7cb99a8209b6502ada31f0d52c215/origin.png","imageTitle":"","imageSize":{"width":200,"height":161},"layout":null},"children":[]}]}]}]},{"data":{"id":"dm7v4zzz25c0","created":1792316401553,"text":"频率依赖肺顺应性","layout":null},"children":[{"data":{"id":"dm7v5rehnvc0","created":1792316461204,"text":"肺顺应性：容积变化/单位压力","layout":null},"children":[]},{"data":{"id":"dm7v5rehnnk0","created":1792316461204,"text":"基本分类：","layout":null},"children":[{"data":{"id":"dm7v5rehrlk0","created":1792316461204,"text":"静态肺顺应性：反映肺的弹性张力","layout":null},"children":[]},{"data":{"id":"dm7v5rehdqo0","created":1792316461204,"text":"动态肺顺应性（频率依赖性肺顺应性）：\n除弹性张力外，也受气道阻力的影响","layout":null},"children":[]}]},{"data":{"id":"dm7v5rehlko0","created":1792316461204,"text":"临床意义：一般静态、动态顺应性\n及不同频率动态顺应性接近","layout":null},"children":[{"data":{"id":"dm7v5rehdug0","created":1792316461204,"text":"小气道病变:  动态顺应性降低","layout":null},"children":[]},{"data":{"id":"dm7v5rei4so0","created":1792316461205,"text":"肺   气   肿：静态顺应性增加","layout":null},"children":[]},{"data":{"id":"dm7v5rei9w00","created":1792316461205,"text":"肺 纤 维 化：静态顺应性降低","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7xzecv4dc0","created":1792324425953,"text":"换气功能","layout":null},"children":[{"data":{"id":"dm7xzmgcv8o0","created":1792324443578,"text":"弥散功能","layout":null},"children":[{"data":{"id":"dm7xzoq2jq80","created":1792324448519,"text":"概念：指肺泡和肺毛细血管中气体\n通过肺泡壁毛细血管膜，遵循高分压\n向低分压移动的原则进行气体交换的过程","layout":null},"children":[]},{"data":{"id":"dm7y018r7ts0","created":1792324475770,"text":"影响因素","layout":null},"children":[{"data":{"id":"dm7y25wvawo0","created":1792324642664,"text":"分子量、溶解度、\n肺泡毛细血管膜两侧气体分压差、\n弥散面积、弥散距离等","layout":null},"children":[]},{"data":{"id":"dm7y2fyn8l40","created":1792324664539,"text":"注意：弥散障碍主要指O2，\n临床一般不存在CO2的弥散功能障碍","layout":null},"children":[]}]},{"data":{"id":"dm7y2ljo1u80","created":1792324676694,"text":"测定方法","layout":null},"children":[{"data":{"id":"dm7y3amelo80","created":1792324731279,"text":"CO吸入法或单次呼吸法","layout":null},"children":[]},{"data":{"id":"dm7y3ameuhs0","created":1792324731279,"text":"（CO与血红蛋白的结合力比O2大210倍，不受O2干扰；\n正常人血浆中CO含量几乎为零；\nCO在转运过程中极少溶解在血浆中）","layout":null},"children":[]}]},{"data":{"id":"dm7y46eau8g0","created":1792324800446,"text":"弥散量减低的临床意义","layout":null},"children":[{"data":{"id":"dm7y4hr2srk0","created":1792324825163,"text":"肺间质纤维化、\n肺部感染、\n肺水肿、\nARDS等","layout":null},"children":[]}]},{"data":{"id":"dm7y4yjtr9s0","created":1792324861730,"text":"弥散功能的评价指标","layout":null,"note":"DLCO（一氧化碳弥散量）"},"children":[{"data":{"id":"dm7y5ak6aq00","created":1792324887872,"text":"正常：DLCO占预计值%≥80%或LLN； ","layout":null},"children":[]},{"data":{"id":"dm7y5dm8byo0","created":1792324894527,"text":"轻度：60%≤DLCO占预计值%<80%或LLN；","layout":null},"children":[]},{"data":{"id":"dm7y5ak6qo00","created":1792324887873,"text":"   中度：40%≤DLCO占预计值%<60%； ","layout":null},"children":[]},{"data":{"id":"dm7y5h5olsw0","created":1792324902234,"text":"重度：DLCO占预计值%<40%","layout":null},"children":[]},{"data":{"id":"dm7y95631v40","created":1792325189593,"text":"举例：弥散功能降低（中度）","image":"https://p.cldisk.com/star4/a32febd0d141e21476b1786304326725/origin.png","imageTitle":"","imageSize":{"width":200,"height":19},"layout":null},"children":[]}]}]},{"data":{"id":"dm7yazs6ijk0","created":1792325334597,"text":"肺泡气体分布","layout":null},"children":[{"data":{"id":"dm7yb4k9yc00","created":1792325345003,"text":"生理情况下，直立位时，\n从肺尖断面至肺底部断面，通气量逐渐增大","layout":null},"children":[{"data":{"id":"dm7yke32y280","created":1792326071008,"text":"上肺区 — 快肺泡：早开始早结束","layout":null},"children":[]},{"data":{"id":"dm7yke32rhc0","created":1792326071008,"text":"下肺区 — 慢肺泡：晚开始晚结束","layout":null},"children":[]}]},{"data":{"id":"dm7yki2zork0","created":1792326079710,"text":"病理性气体分布不均","layout":null},"children":[{"data":{"id":"dm7ykmz5ca80","created":1792326090362,"text":"不均匀的气道阻力：支气管痉挛、局部气道受压","layout":null},"children":[]},{"data":{"id":"dm7ykwmnbi00","created":1792326111374,"text":"顺应性下降：间质性肺炎、肺气肿","layout":null},"children":[]}]},{"data":{"id":"dm7ylfzkbrk0","created":1792326153514,"text":"测定方法","layout":null,"note":"1. **残气位（RV）**：肺内残留气体，含有氮气。不同肺泡通气好坏不同：通气差的肺泡，氮气滞留更多、N₂浓度更高；通气好的肺泡 N₂少。\n2. **吸入纯氧至肺总量 TLC**：吸入 100% O₂，无 N₂。纯氧进入肺泡，稀释肺泡内原有氮气。\n通气好的肺泡：被纯氧充分稀释 → N₂浓度低\n通气差（小气道狭窄）的肺泡：进气少，原有氮气稀释有限 → N₂浓度高\n3. **缓慢匀速呼气，同步记录呼出气容积与 N₂浓度，绘制曲线**\n   - 先呼出解剖无效腔：只有刚吸入的纯氧，几乎无氮气（Ⅰ 相）\n   - 接着无效腔 + 肺泡气体混合排出，N₂快速上升（Ⅱ 相）\n   - **Ⅲ 相（肺泡平台段，呼气 750～1250ml 区间）**：大量肺泡气体同时呼出。\n   ✅ 正常人：肺泡通气均匀，各肺泡 N₂浓度接近，这段曲线平缓，**750～1250ml 之间 N₂浓度差＜1.5%**\n   ❌ 小气道病变 / 慢阻肺：通气差肺泡 N₂高，通气好肺泡 N₂低；随着呼气，两类肺泡气体先后出来，N₂浓度持续爬升，浓度差≥1.5%，Ⅲ 相斜率增大。\n   - Ⅳ 相：下肺小气道提前关闭，上肺高氮气体排出，N₂浓度陡然升高。"},"children":[{"data":{"id":"dm7ylm31zz40","created":1792326166785,"text":"吸入纯氧后呼出气的氮浓度，描绘曲线进行间接测定","layout":null},"children":[]},{"data":{"id":"dm7ylrjcew00","created":1792326178654,"text":"正常值：健康人肺内气体分布相对均匀，\n呼气至750 ~ 1250ml的瞬时氮浓度差<1.5%","layout":null},"children":[]}]}]},{"data":{"id":"dm7yp43v76w0","created":1792326441109,"text":"通气血流比例V/Q","layout":null,"image":"https://p.cldisk.com/star4/0cb8cde2b20aa72143cbb3f670117c11/origin.png","imageTitle":"","imageSize":{"width":200,"height":131}},"children":[{"data":{"id":"dm7yq18kqps0","created":1792326513228,"text":"正常成人在静息状态下，\n每分钟肺泡通气量约4L，肺血流量约5L，\nV/Q为0.8","color":"#ff0000","font-weight":"bold","background":"#73a1bf","layout":null},"children":[]},{"data":{"id":"dm7z2g8k4v40","created":1792327486248,"text":"受重力、体位等的影响，V/Q存在区域性差异，\n从肺底向肺尖进行性增高","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7jypjgjnk0","created":1792284876393,"text":"动脉血气分析","layout":null},"children":[{"data":{"id":"dm7z55yanug0","created":1792327698952,"text":"血气分析","layout":null},"children":[{"data":{"id":"dm7z57m982w0","created":1792327702578,"text":"定义：采用微电极等电子技术快速测定\n血液中氧分压、二氧化碳分压、[H+]，\n判断呼吸功能和体液酸碱平衡的一种临床技术","layout":null},"children":[]},{"data":{"id":"dm7z5o9e4lk0","created":1792327738805,"text":"测定和评价内容：\n氧合、通气、酸碱平衡","layout":null},"children":[]}]},{"data":{"id":"dm7z60iduf40","created":1792327765470,"text":"机体酸碱平衡的调节机制","layout":null},"children":[{"data":{"id":"dm7z6afx3gw0","created":1792327787089,"text":"1.体液缓冲系统调节","layout":null},"children":[]},{"data":{"id":"dm7z6afwun40","created":1792327787089,"text":"2.肺调节：\n快速，但调节范围有限","layout":null},"children":[]},{"data":{"id":"dm7z6afwuqw0","created":1792327787089,"text":"3.肾调节：\n主要是排除H⁺和重吸收HCO₃⁻","layout":null},"children":[{"data":{"id":"dm7z8c39yns0","created":1792327947407,"text":"HCO3-的重吸收：","layout":null},"children":[{"data":{"id":"dm7z8c3a1pc0","created":1792327947407,"text":"几乎全部被重吸收","layout":null},"children":[]},{"data":{"id":"dm7z8c3a7ts0","created":1792327947407,"text":"90%由近端小管重吸收","layout":null},"children":[]},{"data":{"id":"dm7z8c3ac4o0","created":1792327947407,"text":"受碳酸酐酶、 PaCO2影响","layout":null},"children":[]}]},{"data":{"id":"dm7z8lk3heo0","created":1792327968015,"text":"尿液的酸化","layout":null},"children":[{"data":{"id":"dm7z8lk4hsw0","created":1792327968016,"text":"使肾小球滤过液中NaH2PO4变成Na2HPO4","layout":null},"children":[]},{"data":{"id":"dm7z8lk402o0","created":1792327968016,"text":"使原尿PH由7.4降为终尿PH 4.4-6","layout":null},"children":[]},{"data":{"id":"dm7z8lk42n40","created":1792327968016,"text":"有Na+-H+交换和泌氢细胞两种方式","layout":null},"children":[]}]},{"data":{"id":"dm7z8v8skmw0","created":1792327989099,"text":"远端小管泌氨与NH4+生成","layout":null},"children":[{"data":{"id":"dm7z8v8tb740","created":1792327989100,"text":"呈PH依赖性，酸中毒越重，\n尿排出NH4+越多，\n实际为一强酸排泄过程","layout":null},"children":[]}]},{"data":{"id":"dm7z9lm890g0","created":1792328046508,"text":"特点","layout":null},"children":[{"data":{"id":"dm7z9qr4v7s0","created":1792328057688,"text":"①慢而完善","layout":null},"children":[{"data":{"id":"dm7z9qr4f9c0","created":1792328057688,"text":"常需72小时才能逐渐完善，\n|因此临床常以代偿时间3天\n作为分急慢性呼酸的依据；","layout":null},"children":[]}]},{"data":{"id":"dm7z9qr59og0","created":1792328057689,"text":"②调节能力强","layout":null},"children":[{"data":{"id":"dm7z9qr54lk0","created":1792328057689,"text":"肾调节酸的能力大于调节碱的能力；","layout":null},"children":[]}]},{"data":{"id":"dm7z9qr5izc0","created":1792328057689,"text":"③远曲小管H+-Na+\n与K+-Na+交换机制","layout":null},"children":[{"data":{"id":"dm7z9qr5fc80","created":1792328057689,"text":"两者存在竞争机制，\n导致低钾碱中毒，高钾酸中毒","layout":null},"children":[]}]},{"data":{"id":"dm7z9qr58aw0","created":1792328057689,"text":"④碳酸酐酶作用","layout":null},"children":[{"data":{"id":"dm7z9qr57ds0","created":1792328057689,"text":"碳酸酐酶活性降低时，\n肾小管泌H+过程减弱","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7z6afwu8g0","created":1792327787089,"text":"4.离子交换调节","layout":null},"children":[]}]},{"data":{"id":"dm7zbaf736o0","created":1792328178866,"text":"血气分析的常用指标","layout":null},"children":[{"data":{"id":"dm7zfcyghrs0","created":1792328497841,"text":"❶  常用的考核酸碱失衡的指标","layout":null},"children":[{"data":{"id":"dm7zfcyga080","created":1792328497841,"text":"PH","layout":null,"image":"https://p.cldisk.com/star4/4f0f38447da5f9626e36aa54376fc4e3/origin.png","imageTitle":"","imageSize":{"width":200,"height":23}},"children":[{"data":{"id":"dm7zgfww0000","created":1792328582641,"text":"定义：表示体液氢离子浓度的指标或酸碱度","layout":null},"children":[]},{"data":{"id":"dm7zgfwwnzk0","created":1792328582642,"text":"正常值：7.35-7.45，平均值7.40，\n即使正常也可能存在酸碱失衡","layout":null},"children":[{"data":{"id":"dm7zgfwwyg00","created":1792328582642,"text":"pH>7.45为碱血症，即失代偿性碱中毒","layout":null},"children":[]},{"data":{"id":"dm7zgfwwvqw0","created":1792328582642,"text":"pH<7.35为酸血症，即失代偿性酸中毒","layout":null},"children":[]}]}]},{"data":{"id":"dm7zfcyg6xs0","created":1792328497841,"text":"动脉血二氧化碳分压（PaCO2）","layout":null},"children":[{"data":{"id":"dm7zidh4uw00","created":1792328734063,"text":"定义：动脉血浆中物理溶解的CO2所产生的压力。","layout":null},"children":[]},{"data":{"id":"dm7zidh4sgg0","created":1792328734063,"text":"正常值：35-45mmHg，平均值40mmHg；","layout":null},"children":[]},{"data":{"id":"dm7zidh4vls0","created":1792328734063,"text":"临床意义：","layout":null},"children":[{"data":{"id":"dm7zidh536o0","created":1792328734063,"text":"判断呼吸衰竭类型和程度的指标","layout":null},"children":[]},{"data":{"id":"dm7zidh54pk0","created":1792328734063,"text":"判断呼吸型酸碱平衡失调的指标：\nPaCO2 代表肺泡通气功能，如通气不足则酸中毒；\n通气过度则碱中毒。","layout":null},"children":[]},{"data":{"id":"dm7zidh4mf40","created":1792328734063,"text":"判断代谢性酸碱失调的代偿反应","layout":null},"children":[]}]},{"data":{"id":"dm7zj2cgr9c0","created":1792328788200,"text":"注：静脉血PCO2较动脉血高5-7mmHg，\n二氧化碳分压是酸碱平衡呼吸因素的唯一指标","color":"#ff0000","font-weight":"bold","background":"#92d050","layout":null},"children":[]}]},{"data":{"id":"dm7zpim3f1k0","created":1792329293796,"text":"碳酸氢盐","layout":null},"children":[{"data":{"id":"dm7zfcygueg0","created":1792328497842,"text":"实际碳酸氢盐\n（ actual bicarbonate，AB ）","layout":null},"children":[{"data":{"id":"dm7zq0buxp40","created":1792329332359,"text":"是指在实际PaCO2和血氧饱和度条件下\n所测得的血浆HCO3-含量","layout":null},"children":[]},{"data":{"id":"dm8004mnd2g0","created":1792330125360,"text":"正常值：22-27mmol/L，平均值24mmol/L；","layout":null},"children":[]},{"data":{"id":"dm8007j958w0","created":1792330131685,"text":"临床意义：","layout":null},"children":[{"data":{"id":"dm8007j96d40","created":1792330131685,"text":"AB反映酸碱平衡中的代谢因素，\n一定程度上受呼吸因素影响","layout":null},"children":[]},{"data":{"id":"dm8007j90jc0","created":1792330131685,"text":"AB增高可见于代碱，亦可见于呼酸时肾脏代偿反应，\n降低见于代酸，亦可见于呼碱时的肾脏代偿","layout":null,"color":"#ff0000","background":"#ffff00","font-weight":"bold"},"children":[]}]}]},{"data":{"id":"dm7zfcygvdc0","created":1792328497842,"text":"标准碳酸氢盐\n（standard bicarbonate，SB）","layout":null},"children":[{"data":{"id":"dm8014hclew0","created":1792330203404,"text":"定义：•是指在37℃，血红蛋白完全饱和，\nPaCO2为40mmHg的气体平衡后的标准状态下\n所测得的血浆HCO3-含量。","layout":null},"children":[]},{"data":{"id":"dm801cus26o0","created":1792330221630,"text":"正常值：22-27mmol/L，平均值24mmol/L；","layout":null},"children":[]},{"data":{"id":"dm801fos4k80","created":1792330227798,"text":"临床意义：","layout":null},"children":[{"data":{"id":"dm801fosb540","created":1792330227798,"text":"准确反映代谢性酸碱平衡的指标","layout":null},"children":[]},{"data":{"id":"dm801fos1280","created":1792330227798,"text":"一般不受呼吸的影响","layout":null},"children":[]}]},{"data":{"id":"dm8028fn12o0","created":1792330290372,"text":"不同病理情况下的碳酸氢盐值","layout":null},"children":[{"data":{"id":"dm803mva9hk0","created":1792330400157,"text":"呼酸，AB＞SB","layout":null},"children":[]},{"data":{"id":"dm803mva8200","created":1792330400157,"text":"呼碱，AB＜SB","layout":null},"children":[]},{"data":{"id":"dm803mvagc80","created":1792330400157,"text":"代酸，AB=SB＜正常值","layout":null},"children":[]},{"data":{"id":"dm803mva66o0","created":1792330400157,"text":"代碱，AB=SB＞正常值","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7zfcyh9cw0","created":1792328497842,"text":"缓冲碱（buffer base，BB）","layout":null},"children":[{"data":{"id":"dm80420ciu80","created":1792330433115,"text":"定义：是全血具有缓冲作用的碱（负离子）的总和。\n包括：血浆HCO3-（占50％）、Pr -、HPO4- 等。","layout":null},"children":[]},{"data":{"id":"dm8dfzar18o0","created":1792368042012,"text":"正常值：45~55mmol/L，平均50mmol/L","layout":null},"children":[]},{"data":{"id":"dm8dg7w6za80","created":1792368060723,"text":"意义：\n反映机体对酸碱平衡紊乱时总的\n缓冲能力，不受呼吸的影响。","layout":null},"children":[{"data":{"id":"dm8dgo2w9lk0","created":1792368095957,"text":"代酸时BB减少，","layout":null},"children":[]},{"data":{"id":"dm8dgqorz680","created":1792368101634,"text":"代碱时BB增加","layout":null},"children":[]}]}]},{"data":{"id":"dm7zfcygrhs0","created":1792328497842,"text":"碱剩余（base excess，BE）","layout":null},"children":[{"data":{"id":"dm8dh1ui1400","created":1792368125924,"text":"定义：在血液偏酸或偏碱时，\n在标准状态下\n（37℃，一个大气压，PCO2分压40mmHg，Hb完全氧合）\n用碱或酸将一升血液pH调至7.4所需加入的酸碱量。","layout":null},"children":[]},{"data":{"id":"dm8dhqiwyw00","created":1792368179643,"text":"参考值：-3~+3mmol/L","layout":null},"children":[]},{"data":{"id":"dm8dhxzedeo0","created":1792368195878,"text":"临床意义","layout":null},"children":[{"data":{"id":"dm8did9mqwg0","created":1792368229148,"text":"“-”为碱不足，","layout":null},"children":[]},{"data":{"id":"dm8dijplay00","created":1792368243174,"text":"“+”为碱过剩","layout":null},"children":[]}]}]}]},{"data":{"id":"dm7zfrpyrz40","created":1792328529979,"text":"❷  常用判断低氧血症的参数","layout":null},"children":[{"data":{"id":"dm7zfrpy8u80","created":1792328529979,"text":"氧分压（PaO2）","layout":null},"children":[{"data":{"id":"dm8dm0hsgug0","created":1792368514800,"text":"定义：是指血液中物理溶解的氧分子所产生的压力","layout":null},"children":[]},{"data":{"id":"dm8dm80ajy80","created":1792368531156,"text":"•正常值：95-100mmHg；\n年龄预计公式：PaO2=100-（年龄×0.33）±5mmHg","layout":null},"children":[]},{"data":{"id":"dm8dmh8rtew0","created":1792368551260,"text":"临床意义","layout":null},"children":[{"data":{"id":"dm8dmljooi00","created":1792368560627,"text":"判断有无低氧血症和低氧血症程度","layout":null},"children":[]},{"data":{"id":"dm8dmljon4w0","created":1792368560627,"text":"判断有无呼吸衰竭的指标","layout":null},"children":[]}]}]},{"data":{"id":"dm7zfrpypxk0","created":1792328529979,"text":"血氧饱和度（SaO2）","layout":null},"children":[{"data":{"id":"dm8dmystaps0","created":1792368589477,"text":"定义：•动脉血氧与血红蛋白(Hb)结合的程度，\n即SaO2 =HbO2/总Hb×100%","layout":null},"children":[]},{"data":{"id":"dm8dn5n3ajk0","created":1792368604368,"text":"正常值：95-98%","layout":null},"children":[]},{"data":{"id":"dm8dn78tgfs0","created":1792368607859,"text":"临床意义","layout":null},"children":[{"data":{"id":"dm8dnbzxrew0","created":1792368618206,"text":"判断是否缺氧，但敏感度较差","layout":null},"children":[]},{"data":{"id":"dm8dnbzybf40","created":1792368618207,"text":"由于氧离曲线的S型特点特点， \nPaO2在60mmHg以下时，两者才更相关","layout":null,"image":"https://p.cldisk.com/star4/d499e2fdfeccddd19a568a2c8aa1e565/origin.png","imageTitle":"","imageSize":{"width":200,"height":196}},"children":[]}]}]},{"data":{"id":"dm7zfrpync80","created":1792328529979,"text":"动脉血氧含量（CaO2）","layout":null},"children":[{"data":{"id":"dm8dofpzry00","created":1792368704676,"text":"定义：•单位容积动脉血中所含氧的总量，\n包括与血红蛋白结合的氧和物理溶解氧","layout":null},"children":[]},{"data":{"id":"dm8drzmg7c80","created":1792368983090,"text":"计算公式","layout":null},"children":[{"data":{"id":"dm8ds5ziw6g0","created":1792368996941,"text":"CaO2 = Hb(g/dl)×1.34 × SaO2 + PaO2(mmHg)×0.0031","layout":null},"children":[]}]},{"data":{"id":"dm8drf5qg1c0","created":1792368938543,"text":"正常值：19-21ml/dl","layout":null},"children":[]},{"data":{"id":"dm8drirgugg0","created":1792368946388,"text":"临床意义","layout":null},"children":[{"data":{"id":"dm8drnuwpdc0","created":1792368957480,"text":"反应动脉血携氧量的综合性指标","layout":null},"children":[]},{"data":{"id":"dm8drnuxhpc0","created":1792368957481,"text":"CaO2—CvO2可估测组织代谢状况","layout":null},"children":[]},{"data":{"id":"dm8drnuxi280","created":1792368957481,"text":"可计算分流量对ARDS进行预后判断","layout":null},"children":[]}]}]},{"data":{"id":"dm7zfrpycu80","created":1792328529979,"text":"肺泡-动脉氧分压差[P(A-a)O₂]","layout":null},"children":[{"data":{"id":"dm8ew9bcmg00","created":1792372138753,"text":"指肺泡氧分压(PAO2)与动脉血氧分压(PaO2)之差，","layout":null},"children":[]},{"data":{"id":"dm8ewew2zp40","created":1792372150891,"text":"计算公式","layout":null},"children":[{"data":{"id":"dm8ewhf5r280","created":1792372156398,"text":" [P(A-a)O2]= PAO2 - PaO2；","layout":null},"children":[]}]},{"data":{"id":"dm8ewmwxbxc0","created":1792372168356,"text":"正常值：15~20mmHg","layout":null},"children":[]},{"data":{"id":"dm8ewspq8rk0","created":1792372180981,"text":"临床意义","layout":null},"children":[{"data":{"id":"dm8ewxgjxns0","created":1792372191310,"text":"P(A-a)O2增大伴有PaO2降低，\n提示肺本身受累所致氧合障碍","layout":null},"children":[{"data":{"id":"dm8ewxgk4og0","created":1792372191311,"text":"左右分流或肺血管病变是肺内动-静脉解剖分流增加致静脉血掺杂；","layout":null},"children":[]},{"data":{"id":"dm8ewxgk7vk0","created":1792372191311,"text":"弥漫性间质性肺病、肺水肿、ARDS等所致的弥散障碍；","layout":null},"children":[]},{"data":{"id":"dm8ewxgkv8g0","created":1792372191312,"text":"V/Q比例严重失调，如阻塞性肺气肿、肺不张或肺栓塞；","layout":null},"children":[]}]},{"data":{"id":"dm8ewxgky7c0","created":1792372191312,"text":"P(A-a)O2增大无PaO2降低","layout":null},"children":[{"data":{"id":"dm8ewxgkwcg0","created":1792372191312,"text":"见于肺泡通气量明显增加，\n而大气压、吸入气氧浓度与机体耗氧量不变时；","layout":null},"children":[]}]}]}]}]}]},{"data":{"id":"dm7zbek8cvc0","created":1792328187878,"text":"酸碱失衡的判断方法","layout":null},"children":[{"data":{"id":"dm8f1c6fyxc0","created":1792372536807,"text":"类型"},"children":[{"data":{"id":"dm8eyc0rsrc0","created":1792372301372,"text":"- 单纯酸碱失衡","layout":null},"children":[{"data":{"id":"dm8eyc0sml40","created":1792372301373,"text":"  - 呼吸性酸中毒（呼酸）","layout":null},"children":[]},{"data":{"id":"dm8eyc0s2ew0","created":1792372301373,"text":"  - 呼吸性碱中毒（呼碱）","layout":null},"children":[]},{"data":{"id":"dm8eyc0sit40","created":1792372301373,"text":"  - 代谢性酸中毒（代酸）","layout":null},"children":[]},{"data":{"id":"dm8eyc0s41k0","created":1792372301373,"text":"  - 代谢性碱中毒（代碱）","layout":null},"children":[]}]},{"data":{"id":"dm8eyc0s8xs0","created":1792372301373,"text":"- 混合型酸碱失衡","layout":null},"children":[{"data":{"id":"dm8eyc0se200","created":1792372301373,"text":"  - 传统四型","layout":null},"children":[{"data":{"id":"dm8eyc0s50g0","created":1792372301373,"text":"- 呼酸并代酸","layout":null},"children":[]},{"data":{"id":"dm8eyc0s3c80","created":1792372301373,"text":"- 呼酸并代碱","layout":null},"children":[]},{"data":{"id":"dm8eyc0sas00","created":1792372301373,"text":"- 呼碱并代酸","layout":null},"children":[]},{"data":{"id":"dm8eyc0scuw0","created":1792372301373,"text":"- 呼碱并代碱","layout":null},"children":[]}]},{"data":{"id":"dm8eyc0t8l40","created":1792372301374,"text":"  - 新的酸碱失衡","layout":null},"children":[{"data":{"id":"dm8eyc0sy000","created":1792372301374,"text":"- 混合性代酸\n（高 AG 代酸 + 高 Cl⁻性代酸）","layout":null,"note":"血浆阴阳离子总量相等。我们常规只测Na+（主要阳离子）、Cl−、\nHCO3−（主要阴离子），剩下没测的阴离子就是 AG"},"children":[]},{"data":{"id":"dm8eyc0syk80","created":1792372301374,"text":"- 代碱并代酸包括","layout":null},"children":[]},{"data":{"id":"dm8eyc0soko0","created":1792372301374,"text":"  - 代碱并高 AG 代酸","layout":null},"children":[]},{"data":{"id":"dm8eyc0t7qo0","created":1792372301374,"text":"  - 代碱并高 Cl⁻性代酸","layout":null},"children":[]},{"data":{"id":"dm8eyc0syn40","created":1792372301374,"text":"- 三重酸碱失衡包括","layout":null},"children":[]},{"data":{"id":"dm8eyc0t6fc0","created":1792372301374,"text":"  - 呼酸型三重酸碱失衡（呼酸 + 代碱 + 高 AG 代酸）","layout":null},"children":[]},{"data":{"id":"dm8eyc0st0o0","created":1792372301374,"text":"  - 呼碱型三重酸碱失衡（呼碱 + 代碱 + 高 AG 代酸）","layout":null},"children":[]}]}]}]},{"data":{"id":"dm8f1h2o2fk0","created":1792372547463,"text":"初步判断方式"},"children":[{"data":{"id":"dm8f2u4v7y80","created":1792372654258,"text":"1. 看酸碱：判定酸血症或碱血症（酸或碱中毒）"},"children":[]},{"data":{"id":"dm8f2u4v9sw0","created":1792372654259,"text":"   - 观察 pH，判断酸血症 / 碱血症"},"children":[]},{"data":{"id":"dm8f2u4vbj40","created":1792372654259,"text":"2. 定原发：确定原发因素，区分原发改变、继发（代偿）改变"},"children":[]},{"data":{"id":"dm8f2u4vky00","created":1792372654259,"text":"   - 对比 PaCO₂和 HCO₃⁻变化与 pH 变化是否一致"},"children":[]},{"data":{"id":"dm8f2u4vk7s0","created":1792372654259,"text":"3. 算代偿：代入代偿公式，判断继发改变是否落在代偿范围"},"children":[]},{"data":{"id":"dm8f2u4vcfc0","created":1792372654259,"text":"   - 代偿之内 → 单纯型酸碱平衡紊乱"},"children":[]},{"data":{"id":"dm8f2u4vmlc0","created":1792372654259,"text":"   - 超出代偿 → 复合型酸碱平衡紊乱"},"children":[]},{"data":{"id":"dm8f2u4vz340","created":1792372654260,"text":"4. 算间隙（阴离子间隙 AG）：排查复杂酸碱平衡紊乱"},"children":[]},{"data":{"id":"dm8f2u4wd400","created":1792372654260,"text":"   - AG＞16mmol/L，提示存在代酸"},"children":[]},{"data":{"id":"dm8f2u4w71k0","created":1792372654260,"text":"5. 算潜在 HCO₃⁻："},"children":[]},{"data":{"id":"dm8f2u4waq80","created":1792372654260,"text":"   - ΔAG = 测得 AG − 正常 AG"},"children":[]},{"data":{"id":"dm8f2u4w14g0","created":1792372654260,"text":"   - 预计 [HCO₃⁻]（潜在 HCO₃⁻）= ΔAG + 测得 [HCO₃⁻]"},"children":[]},{"data":{"id":"dm8f2u4w6ts0","created":1792372654260,"text":"   - 对比预计 HCO₃⁻与参考值："},"children":[{"data":{"id":"dm8f2u4wfy00","created":1792372654260,"text":" - ＜22：合并代酸"},"children":[]},{"data":{"id":"dm8f2u4w35c0","created":1792372654260,"text":" - ＞26：合并代碱"},"children":[]},{"data":{"id":"dm8f2u4wx5k0","created":1792372654261,"text":" - 22～26：单纯性酸碱紊乱"},"children":[]}]}]}]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}