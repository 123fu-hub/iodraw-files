{"root":{"data":{"id":"dmcnbvx4ms00","created":1792802172127,"text":"呼吸功能不全\nrespiratory insufficiency"},"children":[{"data":{"id":"dmcnd623xxk0","created":1792802272561,"text":"1.概念","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dmcne0nu0wg0","created":1792802339178,"text":"（1）呼吸功能不全","layout":null},"children":[{"data":{"id":"dmcne7zlirc0","created":1792802355126,"text":"在影响外呼吸功能的疾病发展过程中，当呼吸负荷加重时\nPaO2⬇或伴有PaCO2⬆，并出现相应的体征和症状","layout":null},"children":[]}]},{"data":{"id":"dmcnfnjfcu80","created":1792802467342,"text":"（2）呼吸衰竭","layout":null},"children":[{"data":{"id":"dmcnft1bpcw0","created":1792802479308,"text":"机体在海平面静息时吸入空气的条件下，\n由于外呼吸功能严重障碍\n导致PaO2＜60mmHg，或伴有PaCO2＞50mmHg，\n同时有呼吸困难表现","layout":null,"font-weight":"bold","background":"#ffff00","color":"#ff0000"},"children":[]},{"data":{"id":"dmcnhpwvc9c0","created":1792802629236,"text":"标准制定：氧离曲线、二氧化碳解离曲线","layout":null},"children":[{"data":{"id":"dmcnji21kcg0","created":1792802768863,"text":"氧离曲线","image":"https://p.cldisk.com/star4/c7f925ba27a593f329671bd5465adf61/origin.png","imageTitle":"","imageSize":{"width":200,"height":154},"layout":null},"children":[]},{"data":{"id":"dmcnjmaoe0g0","created":1792802778092,"text":"二氧化碳解离曲线","image":"https://p.cldisk.com/star4/00839b66a4fc83520f880dab422db20f/origin.png","imageTitle":"","imageSize":{"width":200,"height":138},"layout":null},"children":[]}]},{"data":{"id":"dmcnkhab2t40","created":1792802845550,"text":"标准数值：RFI呼吸衰竭指数","layout":null},"children":[{"data":{"id":"dmcnky7gnm00","created":1792802882383,"text":"计算：RFI=PaO2/FiO2(氧分压/氧浓度)","layout":null},"children":[]},{"data":{"id":"dmcnlc6154o0","created":1792802912772,"text":"正常值：500mmHg，呼衰时RFI≤300mmHg","layout":null},"children":[]}]},{"data":{"id":"dmcnm3qra000","created":1792802972798,"text":"分类：","layout":null},"children":[{"data":{"id":"dmcnno5sbs00","created":1792803095607,"text":"按发病机制和血气变化","layout":null},"children":[{"data":{"id":"dmcnmevpibk0","created":1792802997043,"text":"①换气功能障碍型\n（低氧血症型，Ⅰ型呼衰）","layout":null},"children":[{"data":{"id":"dmcno0f386o0","created":1792803122291,"text":"PaO2⬇，PaCO2正常 /↓","layout":null},"children":[]},{"data":{"id":"dmcnrixyr7c0","created":1792803397707,"text":"O₂难进入血液 → 动脉氧分压PaO2下降\nCO₂弥散能力远强于 O₂，只要还有通气，CO₂很容易排出去；\n机体还会代偿性呼吸加快，把 CO₂更多吹出去，所以PaCO2不高，甚至偏低","layout":null},"children":[]}]},{"data":{"id":"dmcnn0wjxw80","created":1792803044982,"text":"②通气功能障碍型\n（高碳酸血症型，Ⅱ型呼衰）","layout":null},"children":[{"data":{"id":"dmcno7biuq80","created":1792803137312,"text":"PaO2⬇+PaCO2⬆","layout":null},"children":[]},{"data":{"id":"dmcnsgttxmo0","created":1792803471467,"text":"进气少 → O₂摄入不足，PaO2下降\n出气少 → CO₂排不出去，在体内蓄积，PaCO2升高","layout":null},"children":[]}]}]},{"data":{"id":"dmco0y3n6cw0","created":1792804135979,"text":"按发病缓急","layout":null},"children":[{"data":{"id":"dmco19qymrk0","created":1792804161334,"text":"急性","layout":null},"children":[]},{"data":{"id":"dmco1bp8bb40","created":1792804165583,"text":"缓性","layout":null},"children":[]}]},{"data":{"id":"dmco16b4cqg0","created":1792804153845,"text":"按病变部位","layout":null},"children":[{"data":{"id":"dmco1i9vcuw0","created":1792804179891,"text":"中枢性","layout":null},"children":[]},{"data":{"id":"dmco1k6pq540","created":1792804184054,"text":"外周性","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dmco2cycj340","created":1792804246675,"text":"2.呼衰是如何发生的","layout":null},"children":[{"data":{"id":"dmco2sn7lh40","created":1792804280830,"text":"外呼吸功能障碍","layout":null},"children":[{"data":{"id":"dmco2xeys6g0","created":1792804291215,"text":"肺通气功能障碍（气道-肺泡）","layout":null},"children":[{"data":{"id":"dmco38z6pzk0","created":1792804316383,"text":"限制性通气不足","layout":null},"children":[]},{"data":{"id":"dmco3cta6ig0","created":1792804324733,"text":"阻塞性通气不足","layout":null},"children":[]}]},{"data":{"id":"dmco3p3bhwg0","created":1792804351461,"text":"肺换气功能障碍（肺泡-血管）","layout":null},"children":[{"data":{"id":"dmco3zh66d40","created":1792804374066,"text":"弥散障碍","layout":null},"children":[]},{"data":{"id":"dmco41l215s0","created":1792804378655,"text":"通气与血流比失调","layout":null},"children":[]},{"data":{"id":"dmco47f6p0w0","created":1792804391361,"text":"解剖分流增加","layout":null},"children":[]}]}]},{"data":{"id":"dmco4gmwdg00","created":1792804411418,"text":"（1）肺通气功能障碍（Ⅱ型呼衰）","layout":null},"children":[{"data":{"id":"dmcoe0mojb40","created":1792805160218,"text":"调节机制概述","layout":null},"children":[{"data":{"id":"dmcof78pm6o0","created":1792805252975,"text":"限制性通气不足","layout":null},"children":[{"data":{"id":"dmcoe6wybgw0","created":1792805173900,"text":"肺通气动力：\n神经系统调控\n呼吸机的呼吸运动⬇","layout":null},"children":[]},{"data":{"id":"dmcoekyzoyo0","created":1792805204498,"text":"肺通气阻力：\n肺弹性阻力、胸廓弹性阻力⬆","layout":null},"children":[]}]},{"data":{"id":"dmcofdt2ee00","created":1792805267266,"text":"阻塞性通气不足","layout":null},"children":[{"data":{"id":"dmcofhdnp5k0","created":1792805275042,"text":"气道阻力⬆","layout":null},"children":[]}]}]},{"data":{"id":"dmcofs0s6000","created":1792805298208,"text":"（一）限制性通气不足：\n吸气时肺泡的扩张受限引起的\n肺泡通气不足","layout":null},"children":[{"data":{"id":"dmcogj6b10g0","created":1792805357315,"text":"肺通气动力⬇","layout":null},"children":[{"data":{"id":"dmcogrjmis80","created":1792805375535,"text":"呼吸中枢抑制呼吸肌收缩⬇,\n从而引起呼吸肌活动障碍","layout":null},"children":[]}]},{"data":{"id":"dmcoh9fp5gg0","created":1792805414479,"text":"肺通气阻力⬆","layout":null},"children":[{"data":{"id":"dmcohf3nlps0","created":1792805426812,"text":"胸廓及胸膜疾患→顺应性⬇","layout":null},"children":[{"data":{"id":"dmcohyttbbk0","created":1792805469752,"text":"弹性阻力增加，\n如：肺纤维化","layout":null},"children":[]},{"data":{"id":"dmcoi7g80fc0","created":1792805488522,"text":"肺泡表面活性物质减少\n（该物质作用是降低表面张力，\n防止肺水肿）","layout":null},"children":[{"data":{"id":"dmcokro0ppc0","created":1792805689257,"text":"合成分泌减少","layout":null},"children":[]},{"data":{"id":"dmcokvb5r1s0","created":1792805697186,"text":"消耗破坏过多","layout":null},"children":[]}]}]},{"data":{"id":"dmcol452g9k0","created":1792805716409,"text":"胸腔积液、气胸→压迫肺","layout":null},"children":[]}]}]},{"data":{"id":"dmcom01z9tk0","created":1792805785879,"text":"（二）阻塞性通气不足：\n呼吸道阻塞或狭窄，气道\n阻力增加引起的通气障碍","layout":null},"children":[{"data":{"id":"dmcompoor540","created":1792805841673,"text":"气道阻力","layout":null},"children":[{"data":{"id":"dmcomrg1ouw0","created":1792805845503,"text":"泊肃叶定律:R=8ηL/（Πr⁴）","layout":null},"children":[]},{"data":{"id":"dmcop9hzfeg0","created":1792806041531,"text":"气道：80%为直径＞2mm的气道，20%直径＜2mm","layout":null},"children":[]},{"data":{"id":"dmcopnwlo7s0","created":1792806072890,"text":"层流和湍流的气道阻力不同：层流4次方，湍流则为5次方","layout":null},"children":[]}]},{"data":{"id":"dmcoqdahoyo0","created":1792806128149,"text":"气道阻塞","layout":null},"children":[{"data":{"id":"dmcoqg06o680","created":1792806134056,"text":"中央性：\n气管分叉处以上的气道阻塞","layout":null},"children":[{"data":{"id":"dmcoqs0ai6g0","created":1792806160184,"text":"可变型胸外阻塞","layout":null},"children":[{"data":{"id":"dmcorzxqtaw0","created":1792806255808,"text":"表现为吸气性呼吸困难","image":"https://p.cldisk.com/star4/83d895c1fe099d54bdac22405ae315e1/origin.png","imageTitle":"","imageSize":{"width":200,"height":157},"layout":null},"children":[]},{"data":{"id":"dmcoth8rgsw0","created":1792806371844,"text":"临床表现：胸骨上窝、锁骨上窝\n和肋间隙明显凹陷，称为三凹征","layout":null},"children":[]}]},{"data":{"id":"dmcoqxvou4o0","created":1792806172966,"text":"可变型胸内阻塞","layout":null},"children":[{"data":{"id":"dmcouc15z540","created":1792806438865,"text":"表现为呼气性呼吸困难","image":"https://p.cldisk.com/star4/9025982b4487c2fba531b7bb2597b158/origin.png","imageTitle":"","imageSize":{"width":200,"height":147},"layout":null},"children":[]}]},{"data":{"id":"dmcor5a0ne80","created":1792806189070,"text":"固定型上气道阻塞","layout":null},"children":[{"data":{"id":"dmcowt6f4hc0","created":1792806632916,"text":"表现为呼气、吸气都受限","image":"https://p.cldisk.com/star4/8231ce89feffcfa5c2bdfaae6b8f7ab0/origin.png","imageTitle":"","imageSize":{"width":200,"height":150},"layout":null},"children":[]}]}]},{"data":{"id":"dmcord5r2og0","created":1792806206227,"text":"外周性：\n直径小于2mm的小气道阻塞","layout":null},"children":[{"data":{"id":"dmcoz37q2ds0","created":1792806811491,"text":"①呼气时小气道狭窄加重","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dmcozeq8bog0","created":1792806836555,"text":"②呼气时等压点移向小气道，肺泡回缩，\n与肺泡相连的小气道变狭窄而阻力大大增加，\n表现为呼气性呼吸困难","layout":null,"image":"https://p.cldisk.com/star4/4af821a80495e73bb0d38aee695574aa/origin.png","imageTitle":"","imageSize":{"width":200,"height":138},"note":"**等压点**：用力呼气时，气道上**气道内压 = 胸内压**的位置；等压点向口鼻一侧（下游）：气道内压＜胸内压，气道有被压闭趋势。\n\n1. **正常人**\n等压点位于**有软骨支撑的中央气道**。即使下游气道内压＜胸内压，软骨支撑，气道不会塌陷，呼气通畅丁香园。\n2. **肺气肿（慢阻肺）**\n肺泡弹性回缩力下降、小气道阻力增大；呼气时气道压力下降更快，**等压点移向肺泡端（小气道，无软骨的膜性气道）**河北医科大...。\n\n> \n> 小气道没有软骨支撑，等压点落到此处，下游小气道气道内压＜胸内压 → **小气道受压、闭合，气体难以呼出** → **呼气性呼吸困难**。"},"children":[]}]},{"data":{"id":"dmcpdz0ck1c0","created":1792807977801,"text":"肺气肿时肺泡弹性回缩减弱、小气道阻力增高，\n用力呼气时等压点移向无软骨支撑的小气道；\n该部位气道内压低于胸内压，小气道受压闭合，\n气体呼出受阻，发生呼气性呼吸困难","layout":null},"children":[]}]}]}]},{"data":{"id":"dmcpfbn4ijk0","created":1792808083663,"text":"血气变化","layout":null},"children":[{"data":{"id":"dmcpfeyes1s0","created":1792808090876,"text":"PaO2⬇,+PaCO2⬆","layout":null},"children":[{"data":{"id":"dmcpfsmu9ns0","created":1792808120652,"text":"气体进出均受阻","layout":null},"children":[]},{"data":{"id":"dmcpfxs3s680","created":1792808131854,"text":"克服阻力，呼吸肌做功增强，\n氧耗⬆、CO2⬆","layout":null},"children":[]}]}]}]},{"data":{"id":"dmcpf06jba00","created":1792808058716,"text":"（2）肺换气功能障碍（肺泡-血管）","layout":null},"children":[{"data":{"id":"dmcpvxg1ouw0","created":1792809384951,"text":"弥散障碍","layout":null},"children":[{"data":{"id":"dmcpwwr6py00","created":1792809461812,"text":"弥散速度取决于","layout":null},"children":[{"data":{"id":"dmcpwzcgvuo0","created":1792809467453,"text":"呼吸膜两侧气体压力差","layout":null},"children":[]},{"data":{"id":"dmcpx46den40","created":1792809477968,"text":"气体弥散能力","layout":null},"children":[]},{"data":{"id":"dmcpx7xc02o0","created":1792809486128,"text":"呼吸膜面积和厚度","layout":null},"children":[]},{"data":{"id":"dmcpxad8l4g0","created":1792809491444,"text":"血液和肺泡接触时间","layout":null},"children":[]}]},{"data":{"id":"dmcpxo4lxtc0","created":1792809521397,"text":"弥散障碍：呼吸膜面积减少或厚度增加，\n或者弥散时间缩短所引起的气体交换障碍","layout":null},"children":[{"data":{"id":"dmcpy53mo2g0","created":1792809558343,"text":"①呼吸膜面积减少","layout":null},"children":[{"data":{"id":"dmcpy98c1n40","created":1792809567335,"text":"成人呼吸膜总面积80㎡，\n平静呼吸时35~40㎡","layout":null},"children":[]}]},{"data":{"id":"dmcpyyv0jts0","created":1792809623126,"text":"②呼吸膜厚度增加","layout":null},"children":[{"data":{"id":"dmcpz3qnffk0","created":1792809633746,"text":"正常呼吸膜薄部＜1μm，是气体交换的主要部位","layout":null},"children":[]},{"data":{"id":"dmcpzem73qg0","created":1792809657421,"text":"弥散距离增宽，减慢弥散速度","layout":null},"children":[]}]},{"data":{"id":"dmcq5djm0t40","created":1792810125273,"text":"③血液与肺泡接触时间过短","layout":null},"children":[{"data":{"id":"dmcq5or3qiw0","created":1792810149670,"text":"正常：弥散时间0.25s，血液流经时间0.75s","layout":null},"children":[]},{"data":{"id":"dmcq61ixw2g0","created":1792810177475,"text":"面积⬇厚度⬆：弥散时间0.6s(增加)，血液流经时间0.75s(不变)","layout":null},"children":[]},{"data":{"id":"dmcq6sd5mcg0","created":1792810235898,"text":"体力负荷⬆：弥散时间0.6s，血液流经时间0.34s","note":"体力负荷增加时，交感神经兴奋，心输出量增加，肺毛细血管血流速度加快；肺泡毛细血管长度固定，血流流速升高，红细胞流经肺泡毛细血管的时间缩短。\n","layout":null},"children":[]}]}]}]},{"data":{"id":"dmcpw08cbfk0","created":1792809391016,"text":"通气与血流比失调","layout":null},"children":[{"data":{"id":"dmcw3pmligo0","created":1792826921506,"text":"肺泡通气量（VA）与流经肺泡的肺毛细血管\n血流量（Q）的比值偏离正常范围，造成\n气体交换效率下降，进而引起缺氧、二氧化碳潴留的病理状态","layout":null},"children":[]},{"data":{"id":"dmcq8xyokrk0","created":1792810404812,"text":"正常VA/Q=0.8","layout":null},"children":[]},{"data":{"id":"dmcw4ohglio0","created":1792826997383,"text":"①部分肺泡通气不足—VA/Q⬇","layout":null},"children":[{"data":{"id":"dmcw4z6zvao0","created":1792827020694,"text":"静脉血掺杂/功能性分流","layout":null},"children":[]},{"data":{"id":"dmcw8i2p74g0","created":1792827296886,"text":"如：支气管痉挛","layout":null},"children":[]},{"data":{"id":"dmcw55t35aw0","created":1792827035091,"text":"患者VA/Q下降时的表现","layout":null},"children":[{"data":{"id":"dmcw85llg0o0","created":1792827269730,"text":"低氧血症","layout":null},"children":[]},{"data":{"id":"dmcw88o6hl40","created":1792827276417,"text":"氧分压降低","layout":null},"children":[]},{"data":{"id":"dmcw8brg0y80","created":1792827283145,"text":"CO2分压视情况而定","layout":null},"children":[]}]}]},{"data":{"id":"dmcw8pakzds0","created":1792827312600,"text":"②部分肺泡血流不足—VA/Q⬆","layout":null},"children":[{"data":{"id":"dmcwaj63drs0","created":1792827455996,"text":"无效腔样通气","layout":null},"children":[{"data":{"id":"dmcwaq1r8io0","created":1792827470972,"text":"如：肺血管栓塞，一侧血流不足，一侧血流增多则对应会出现低氧血症","image":"https://p.cldisk.com/star4/f48a318d1043735a147907823f57e633/origin.png","imageTitle":"","imageSize":{"width":186,"height":200},"layout":null},"children":[]},{"data":{"id":"dmcwbp5xpko0","created":1792827547412,"text":"生理无效腔：占潮气量的30%，\n疾病时的无效腔：高达60%~70%","layout":null},"children":[]}]}]},{"data":{"id":"dmcweihssko0","created":1792827767984,"text":"血气变化","layout":null},"children":[{"data":{"id":"dmcwekolycw0","created":1792827772749,"text":"PaO2⬇，\nPaCO2正常、\n降低（代偿性过度通气，CO2呼出过多）\n或升高（气管堵塞过多，无法将产生的CO2大量排出）","image":"","imageTitle":"","imageSize":"","layout":null},"children":[]},{"data":{"id":"dmcwfq05c280","created":1792827862695,"text":" ","image":"https://p.cldisk.com/star4/87f56578788d6d38f58d36c447619a3d/origin.png","imageTitle":"","imageSize":{"width":200,"height":121},"layout":null},"children":[]}]}]},{"data":{"id":"dmcpw6vo68g0","created":1792809405487,"text":"解剖分流增加","layout":null},"children":[{"data":{"id":"dmcwkhk9x5c0","created":1792828236142,"text":"肺内解剖性动 - 静脉吻合支开放或数量增多，\n部分静脉血未经肺泡气体交换，\n直接经异常通道流入肺静脉，\n造成静脉血掺杂的病理改变。","layout":null},"children":[]}]},{"data":{"id":"dmcwm0x09f40","created":1792828356635,"text":"小结","image":"https://p.cldisk.com/star4/3c5d45b5208f87f3ffc52e53d597b8fe/origin.png","imageTitle":"","imageSize":{"width":200,"height":152},"layout":null},"children":[]}]}]},{"data":{"id":"dmcwmpt1rgw0","created":1792828410815,"text":"3.呼吸衰竭对机体的影响","layout":null},"children":[{"data":{"id":"dmcwmy0alaw0","created":1792828428667,"text":"酸碱平衡紊乱","layout":null},"children":[{"data":{"id":"dmcwnd0823c0","created":1792828461315,"text":"代谢性酸中毒","layout":null},"children":[{"data":{"id":"dmcwnh8ita00","created":1792828470524,"text":"呼吸衰竭必有，乳酸等酸性代谢产物增多","layout":null},"children":[]}]},{"data":{"id":"dmcwnp3m8o80","created":1792828487642,"text":"呼吸性酸中毒","layout":null},"children":[{"data":{"id":"dmcwnryxbfc0","created":1792828493888,"text":"Ⅱ型呼吸衰竭（高碳酸血症）","layout":null},"children":[]}]},{"data":{"id":"dmcwos1eoao0","created":1792828572402,"text":"呼吸性碱中毒","layout":null},"children":[{"data":{"id":"dmcwoujxm880","created":1792828577876,"text":"Ⅰ型呼衰，过度通气，\nCO2排出过多，PaCO2⬇","layout":null},"children":[]}]},{"data":{"id":"dmcwpgdfq9s0","created":1792828625373,"text":"代谢性碱中毒","layout":null},"children":[{"data":{"id":"dmcwpj7noeg0","created":1792828631553,"text":"人工呼吸机过快派出大量CO2，\n血浆中碳酸浓度迅速纠正，\n体内代偿性增加的HCO3-来不及排出","layout":null},"children":[]},{"data":{"id":"dmcwsdeago80","created":1792828853986,"text":"解释：慢性呼吸性酸中毒患者机械通气时，\n若过快过度排出 CO₂，代偿性升高的HCO3-\n来不及经肾脏排出，血浆HCO3-浓度相对过高，\n继发代谢性碱中毒","layout":null},"children":[]}]},{"data":{"id":"dmcx6vqehs00","created":1792829990999,"text":"混合型酸碱平衡紊乱","layout":null},"children":[{"data":{"id":"dmcx709m6aw0","created":1792830000868,"text":"Ⅰ型呼衰→呼碱+代酸","layout":null},"children":[]},{"data":{"id":"dmcx7f9rvgw0","created":1792830033529,"text":"Ⅱ型呼衰→呼酸+代碱","layout":null},"children":[]}]}]},{"data":{"id":"dmcwn12utcw0","created":1792828435353,"text":"呼吸系统","layout":null},"children":[{"data":{"id":"dmcxao63ywo0","created":1792830287991,"text":"呼吸系统变化","layout":null},"children":[{"data":{"id":"dmcx8cu4z2w0","created":1792830106594,"text":"PaO2⬇＜60mmHg，反射性兴奋呼吸中枢","layout":null},"children":[]},{"data":{"id":"dmcx8uzmc3s0","created":1792830146108,"text":"PaO2⬇＜30mmHg，直接抑制呼吸中枢","layout":null},"children":[]},{"data":{"id":"dmcx95djzj40","created":1792830168718,"text":"PaCO2⬆＞50mmHg，兴奋呼吸中枢","layout":null},"children":[]},{"data":{"id":"dmcx9fyhhqo0","created":1792830191752,"text":"PaCO2⬆＞80mmHg，抑制呼吸中枢\n（此时呼吸运动主要依靠PaO2对\n外周化学感受器的刺激得以维持）","layout":null},"children":[]}]},{"data":{"id":"dmcxaz7vqlc0","created":1792830312043,"text":"呼吸节律变化","layout":null},"children":[{"data":{"id":"dmcxb275vso0","created":1792830318530,"text":"限制性通气障碍—通气变浅变快","layout":null},"children":[{"data":{"id":"dmcxegfv1ao0","created":1792830584623,"text":"病变：肺扩张受限\n（肺纤维化、胸廓畸形、胸腔积液、气胸等）","layout":null},"children":[]},{"data":{"id":"dmcxegfvkxs0","created":1792830584624,"text":"特点：肺不容易拉开 → 每次潮气量小，\n机体代偿浅快呼吸，靠增加呼吸频率弥补通气不足","layout":null},"children":[]}]},{"data":{"id":"dmcxbaki53k0","created":1792830336751,"text":"阻塞性通气障碍—吸气或呼气性呼吸困难","layout":null},"children":[]},{"data":{"id":"dmcxewntr280","created":1792830619933,"text":"一种特殊的呼吸节律\n——陈施呼吸/潮式呼吸","layout":null},"children":[{"data":{"id":"dmcxhdozyio0","created":1792830813738,"text":"本质：呼吸中枢对 CO₂的反馈调节迟钝、\n存在时间延迟，多见于中枢神经系统受损。","layout":null},"children":[{"data":{"id":"dmcxhdozvlk0","created":1792830813738,"text":"呼吸中枢兴奋性↓，对血里 CO₂变化反应慢；","layout":null},"children":[]},{"data":{"id":"dmcxhdozwdc0","created":1792830813738,"text":"呼吸浅慢 / 暂停 → CO₂慢慢蓄积升高；","layout":null},"children":[]},{"data":{"id":"dmcxhdp053s0","created":1792830813738,"text":"升高的 CO₂终于刺激到迟钝的呼吸中枢 → 呼吸加深加快，大量排出 CO₂；","layout":null},"children":[]},{"data":{"id":"dmcxhdp0agg0","created":1792830813738,"text":"CO₂被排低了，刺激消失 → 呼吸又慢慢减弱、直至暂停；","layout":null},"children":[]},{"data":{"id":"dmcxhdp0kog0","created":1792830813739,"text":"暂停期间 CO₂再次堆积，开启下一个循环。","layout":null},"children":[]}]},{"data":{"id":"dmcxhdp0pvk0","created":1792830813739,"text":"补充：严重低氧PaO2<30mmHg会加重中枢抑制，\n更容易诱发陈施呼吸","layout":null},"children":[]}]}]}]},{"data":{"id":"dmcwn2grou00","created":1792828438371,"text":"循环系统","layout":null},"children":[{"data":{"id":"dmcxiiltc4g0","created":1792830902793,"text":"急性缺氧"},"children":[{"data":{"id":"dmcximom55s0","created":1792830911670,"text":"交感神经兴奋⬆\n→心率⬆；心收缩率⬆","layout":null},"children":[]},{"data":{"id":"dmcxj8n8nig0","created":1792830959476,"text":"呼吸⬆→静脉回流⬆"},"children":[]},{"data":{"id":"dmcxjjptn740","created":1792830983577,"text":"代谢产物⬆→心、脑血管扩张","layout":null},"children":[]}]},{"data":{"id":"dmcxk8z09y80","created":1792831038552,"text":"慢性缺氧"},"children":[{"data":{"id":"dmcxke67k4g0","created":1792831049871,"text":"分支主题"},"children":[]}]}]},{"data":{"id":"dmcwn3qt3c00","created":1792828441155,"text":"中枢神经系统","layout":null},"children":[]},{"data":{"id":"dmcwn5vfs9k0","created":1792828445788,"text":"肾功能变化","layout":null},"children":[]},{"data":{"id":"dmcwn88m4nk0","created":1792828450938,"text":"胃肠道变化","layout":null},"children":[]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}