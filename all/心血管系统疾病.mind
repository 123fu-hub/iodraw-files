1793197023999,"text":"一般不用服降压药","layout":null},"children":[]}]},{"data":{"id":"dmgj7oysj3s0","created":1793196798921,"text":"动脉病变期","layout":null},"children":[{"data":{"id":"dmgjao921ds0","created":1793197032457,"text":"血压升高，失去波动性，需服药","layout":null},"children":[]},{"data":{"id":"dmgjar3cmf40","created":1793197038643,"text":"动脉病变","layout":null},"children":[{"data":{"id":"dmgjar3cyd40","created":1793197038643,"text":"细动脉硬化\n（Arteriolosclerosis）","layout":null},"children":[]},{"data":{"id":"dmgjar3cjko0","created":1793197038643,"text":"肌型小动脉硬化","layout":null},"children":[]},{"data":{"id":"dmgjar3cmk80","created":1793197038643,"text":"大动脉","layout":null},"children":[]}]},{"data":{"id":"dmgjbcsrpt40","created":1793197085892,"text":"病理生理基础","layout":null},"children":[{"data":{"id":"dmgjbk41hsg0","created":1793197101811,"text":"细动脉长期痉挛、血管内皮细胞|长期高压刺激\n→内皮细胞受损，内皮细胞间隙扩大，通透性增强\n→血浆蛋白渗入血管中\n→血管壁硬化","layout":null},"children":[]},{"data":{"id":"dmgjcr2hhts0","created":1793197195319,"text":"肌型小动脉、平滑肌细胞变性、坏死\n→血管壁硬化","layout":null},"children":[]}]},{"data":{"id":"dmgjduphxwg0","created":1793197281605,"text":"与AS的硬化有什么不同？","layout":null},"children":[{"data":{"id":"dmgje0fkhns0","created":1793197294065,"text":"HTN","layout":null},"children":[{"data":{"id":"dmgje1zj01k0","created":1793197297449,"text":"细小动脉为主","layout":null},"children":[]},{"data":{"id":"dmgje5mnr9c0","created":1793197305378,"text":"血浆蛋白渗入管壁","layout":null},"children":[]},{"data":{"id":"dmgjebdb5mw0","created":1793197317873,"text":"导致玻璃样（透明）变性","layout":null},"children":[]}]},{"data":{"id":"dmgjet4k7qo0","created":1793197356526,"text":"AS","layout":null},"children":[{"data":{"id":"dmgjevkulls0","created":1793197361865,"text":"大中动脉为主","layout":null},"children":[]},{"data":{"id":"dmgjf0cc9uo0","created":1793197372234,"text":"血脂进入内皮下层","layout":null},"children":[]},{"data":{"id":"dmgjf53dhbk0","created":1793197382576,"text":"泡沫细胞形成","layout":null},"children":[]}]}]}]},{"data":{"id":"dmgj7t1j99c0","created":179319680779