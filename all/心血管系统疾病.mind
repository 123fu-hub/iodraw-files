{"root":{"data":{"id":"dmedla9j35k0","created":1792977817444,"text":"心血管系统疾病"},"children":[{"data":{"id":"dmg3tkt12bk0","created":1793153376118,"text":"  动脉粥样硬化\nAtherosclerosis","layout":null},"children":[{"data":{"id":"dmg3uf2lqbk0","created":1793153442001,"text":"概念","layout":null},"children":[{"data":{"id":"dmg3v6h2unc0","created":1793153501649,"text":"是一种与血脂异常及血管壁成分改变有关\n的动脉疾病，主要累及大中动脉。","layout":null},"children":[]},{"data":{"id":"dmg3y2h00oo0","created":1793153728030,"text":"基本病变是动脉内膜脂质沉积，内膜灶状纤维化，\n粥样斑块形成，致管壁变硬，管腔狭窄，\n并引起一系列继发性病变","layout":null},"children":[]},{"data":{"id":"dmg3ya4untc0","created":1793153744710,"text":"分开理解：粥样和硬化两个症状","layout":null},"children":[{"data":{"id":"dmg3yjr45i80","created":1793153765647,"text":"动脉硬化\nArteriosclerosis","layout":null},"children":[{"data":{"id":"dmg3yun65vs0","created":1793153789353,"text":"指动脉壁增厚、失去弹性、硬化性的一类疾病。","layout":null},"children":[]}]}]}]},{"data":{"id":"dmg3ugh1gz40","created":1793153445051,"text":"病因","layout":null},"children":[{"data":{"id":"dmg3zfr46eo0","created":1793153835304,"text":"确切病因不清楚","layout":null},"children":[]},{"data":{"id":"dmg3zkoszqg0","created":1793153846048,"text":"危险因素","layout":null},"children":[{"data":{"id":"dmg3zq1e8ao0","created":1793153857693,"text":"不可控因素","layout":null},"children":[{"data":{"id":"dmg4000460o0","created":1793153879384,"text":"年龄：中老年\n性别：男＞女\n遗传因素","layout":null},"children":[]}]},{"data":{"id":"dmg4097cco00","created":1793153899412,"text":"可控因素","layout":null},"children":[{"data":{"id":"dmg40e1xk600","created":1793153909968,"text":"高血压\n吸烟\n糖尿病\n代谢综合征","layout":null},"children":[]},{"data":{"id":"dmg410ntcds0","created":1793153959181,"text":"高脂血症","layout":null},"children":[{"data":{"id":"dmgffobbjsw0","created":1793186139975,"text":"指血浆中甘油三酯和（或）总胆固醇、低密度脂蛋白胆\n固醇升高，以及高密度脂蛋白胆固醇降低。","layout":null},"children":[]},{"data":{"id":"dmgfg12fy5c0","created":1793186167737,"text":"LDL","layout":null},"children":[{"data":{"id":"dmgfgk5ptf40","created":1793186209294,"text":"肝脏→组织、细胞","layout":null},"children":[]},{"data":{"id":"dmgfgqh9xi00","created":1793186223053,"text":"高风险因子","layout":null},"children":[]},{"data":{"id":"dmgfgwjdnwg0","created":1793186236241,"text":"氧化LDL(ox-LDL)是最重要的致粥样硬化因子","layout":null},"children":[]},{"data":{"id":"dmgfgzzq9140","created":1793186243760,"text":"促进巨噬细胞形成泡沫细胞","layout":null},"children":[]}]},{"data":{"id":"dmgfh1p2cwg0","created":1793186247469,"text":"HDL","layout":null},"children":[{"data":{"id":"dmgfh5q8ysg0","created":1793186256249,"text":"组织、细胞→肝脏","layout":null},"children":[]},{"data":{"id":"dmgfh5q9ygg0","created":1793186256249,"text":"胆固醇逆向转运机制","layout":null},"children":[]},{"data":{"id":"dmgfh5q9obs0","created":1793186256249,"text":"抗氧化作用","layout":null},"children":[]}]}]}]}]}]},{"data":{"id":"dmg3ui4saeo0","created":1793153448663,"text":"发病机制","layout":null},"children":[{"data":{"id":"dmgfhfqiprc0","created":1793186278032,"text":"损伤应答学说","layout":null},"children":[{"data":{"id":"dmgfhk87mfk0","created":1793186287809,"text":"损伤因素","layout":null},"children":[{"data":{"id":"dmgfhnv3ai80","created":1793186295722,"text":"高脂血症","layout":null},"children":[]}]},{"data":{"id":"dmgfhrdljds0","created":1793186303372,"text":"机体应答","layout":null},"children":[{"data":{"id":"dmgfhug89140","created":1793186310061,"text":"单核-巨噬细胞","layout":null},"children":[]},{"data":{"id":"dmgfhx6tjy00","created":1793186316023,"text":"平滑肌细胞","layout":null},"children":[]}]},{"data":{"id":"dmgfqtg0l9s0","created":1793187013149,"text":"过程","layout":null},"children":[{"data":{"id":"dmgfqyx5ixc0","created":1793187025069,"text":"内皮损伤起始","layout":null},"children":[]},{"data":{"id":"dmgfr2jv4m80","created":1793187032973,"text":"**单核细胞招募**：受损内皮释放趋化因子，吸\n引血液里的**单核细胞**黏附、穿越内皮，迁移到内皮下","layout":null},"children":[]},{"data":{"id":"dmgfr940cj40","created":1793187047252,"text":"单核→巨噬细胞","layout":null},"children":[]},{"data":{"id":"dmgfrbhcz1c0","created":1793187052412,"text":"吞噬脂质，形成泡沫细胞","layout":null},"children":[]},{"data":{"id":"dmgfrdsl3yo0","created":1793187057445,"text":"平滑肌细胞（SMC）来源泡沫细胞","layout":null},"children":[]},{"data":{"id":"dmgfrh9tpww0","created":1793187065018,"text":"大量泡沫细胞聚集，就是早期**脂纹**","layout":null},"children":[]}]},{"data":{"id":"dmgfrlcr8hc0","created":1793187073902,"text":"泡沫细胞","layout":null},"children":[{"data":{"id":"dmgfrq4v84o0","created":1793187084309,"text":"是吞噬了脂质的巨噬细胞","layout":null},"children":[]},{"data":{"id":"dmgfrwupa5s0","created":1793187098932,"text":"是AS病理改变的基础","layout":null},"children":[]}]}]}]},{"data":{"id":"dmg3ujidnc00","created":1793153451662,"text":"病理变化","layout":null,"font-weight":"bold","background":"#73a1bf","color":"#ff0000","image":"https://p.cldisk.com/star4/72f148c19d19b8402c38584b54ad8198/origin.png","imageTitle":"","imageSize":{"width":131,"height":200}},"children":[{"data":{"id":"dmgfsb7wajk0","created":1793187130204,"text":"    脂纹\nFatty Streak","layout":null},"children":[{"data":{"id":"dmgfsqsojcw0","created":1793187164113,"text":"大体观","layout":null},"children":[{"data":{"id":"dmgfsybkzm80","created":1793187180493,"text":"早期病变","layout":null},"children":[]},{"data":{"id":"dmgft0fxjzc0","created":1793187185110,"text":"斑点或条纹样","layout":null},"children":[]},{"data":{"id":"dmgft685xzs0","created":1793187197701,"text":"平坦或隆起","layout":null},"children":[]}]},{"data":{"id":"dmgftjlatuw0","created":1793187226793,"text":"镜下观","layout":null},"children":[{"data":{"id":"dmgftmxbv540","created":1793187234051,"text":"内皮下层出现泡沫细胞","note":"泡沫细胞：就是巨噬细胞吞噬了脂质，但这些脂类物质在病理的制片过程中，二甲苯、酒精等有机溶剂溶解，所以在切片上皮呈现出空泡样的外观。正常人也会出现少量的脂质沉积，但巨噬细胞可以将其清除，处于动态平衡中。\n","layout":null},"children":[]}]},{"data":{"id":"dmgfuewhhso0","created":1793187294950,"text":"脂纹期是可逆性病变","layout":null},"children":[{"data":{"id":"dmgfuk20r9k0","created":1793187306168,"text":"AS的早期病变","layout":null},"children":[]},{"data":{"id":"dmgfunw21zs0","created":1793187314515,"text":"可逆性病变","layout":null},"children":[]}]}]},{"data":{"id":"dmgfuuzlzsg0","created":1793187329967,"text":"纤维斑块","layout":null},"children":[{"data":{"id":"dmgfv0xdsy80","created":1793187342893,"text":"大体观","layout":null},"children":[{"data":{"id":"dmgfv373o540","created":1793187347835,"text":"不规则隆起","layout":null},"children":[]},{"data":{"id":"dmgfv5abgp40","created":1793187352383,"text":"淡黄色—瓷白色","layout":null},"children":[]},{"data":{"id":"dmgfv9q6fk80","created":1793187362049,"text":"斑块可融合","layout":null},"children":[]}]},{"data":{"id":"dmgfvg77qco0","created":1793187376140,"text":"镜下观","layout":null},"children":[{"data":{"id":"dmgfwayyvtk0","created":1793187443121,"text":"表层为大量胶原纤维、散在的平滑肌细胞、\n少数弹性纤维及蛋白聚糖等形成的纤维帽","layout":null},"children":[]},{"data":{"id":"dmgfx711gs80","created":1793187512903,"text":"纤维帽下方：泡沫细胞、SMC、ECM、炎细胞","layout":null},"children":[]}]}]},{"data":{"id":"dmgfxpeps6w0","created":1793187552912,"text":"                 粥样斑块/粥瘤\nAtheromatous Plaque/Atheroma","font-weight":"bold","color":"#ff0000","background":"#73a1bf","layout":null},"children":[{"data":{"id":"dmgfyk3x8kw0","created":1793187619740,"text":"AS的典型病变"},"children":[]},{"data":{"id":"dmgfyqfzgdc0","created":1793187633530,"text":"大体观"},"children":[{"data":{"id":"dmgfyuvtqrk0","created":1793187643195,"text":"大小不等"},"children":[]},{"data":{"id":"dmgfywrouyg0","created":1793187647299,"text":"灰黄色斑块"},"children":[]},{"data":{"id":"dmgfz0uld0o0","created":1793187656181,"text":"切面间黄色粥糜样物质"},"children":[]}]},{"data":{"id":"dmgg1uwwurk0","created":1793187878353,"text":"镜下观"},"children":[{"data":{"id":"dmgg2d7bvt40","created":1793187918165,"text":"玻璃样变的纤维帽"},"children":[]},{"data":{"id":"dmgg2lg4f400","created":1793187936111,"text":"分支主题"},"children":[]}]},{"data":{"id":"dmgfzgt9wfs0","created":1793187690930,"text":"他汀类药物不仅可以降脂，最重要可以稳定斑块"},"children":[]}]}]},{"data":{"id":"dmg3ukzc51s0","created":1793153454864,"text":"重要器官的变化","layout":null},"children":[]}]},{"data":{"id":"dmg3tnec9y80","created":1793153381761,"text":"高血压病","layout":null},"children":[]},{"data":{"id":"dmg3tr0bdnk0","created":1793153389620,"text":"风湿病","layout"