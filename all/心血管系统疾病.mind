{"root":{"data":{"id":"dmedla9j35k0","created":1792977817444,"text":"心血管系统疾病"},"children":[{"data":{"id":"dmg3tkt12bk0","created":1793153376118,"text":"  动脉粥样硬化\nAtherosclerosis","layout":null},"children":[{"data":{"id":"dmg3uf2lqbk0","created":1793153442001,"text":"概念","layout":null},"children":[{"data":{"id":"dmg3v6h2unc0","created":1793153501649,"text":"是一种与血脂异常及血管壁成分改变有关\n的动脉疾病，主要累及大中动脉。","layout":null},"children":[]},{"data":{"id":"dmg3y2h00oo0","created":1793153728030,"text":"基本病变是动脉内膜脂质沉积，内膜灶状纤维化，\n粥样斑块形成，致管壁变硬，管腔狭窄，\n并引起一系列继发性病变","layout":null},"children":[]},{"data":{"id":"dmg3ya4untc0","created":1793153744710,"text":"分开理解：粥样和硬化两个症状","layout":null},"children":[{"data":{"id":"dmg3yjr45i80","created":1793153765647,"text":"动脉硬化\nArteriosclerosis","layout":null},"children":[{"data":{"id":"dmg3yun65vs0","created":1793153789353,"text":"指动脉壁增厚、失去弹性、硬化性的一类疾病。","layout":null},"children":[]}]}]}]},{"data":{"id":"dmg3ugh1gz40","created":1793153445051,"text":"病因","layout":null},"children":[{"data":{"id":"dmg3zfr46eo0","created":1793153835304,"text":"确切病因不清楚","layout":null},"children":[]},{"data":{"id":"dmg3zkoszqg0","created":1793153846048,"text":"危险因素","layout":null},"children":[{"data":{"id":"dmg3zq1e8ao0","created":1793153857693,"text":"不可控因素","layout":null},"children":[{"data":{"id":"dmg4000460o0","created":1793153879384,"text":"年龄：中老年\n性别：男＞女\n遗传因素","layout":null},"children":[]}]},{"data":{"id":"dmg4097cco00","created":1793153899412,"text":"可控因素","layout":null},"children":[{"data":{"id":"dmg40e1xk600","created":1793153909968,"text":"高血压\n吸烟\n糖尿病\n代谢综合征","layout":null},"children":[]},{"data":{"id":"dmg410ntcds0","created":1793153959181,"text":"高脂血症","layout":null},"children":[{"data":{"id":"dmgffobbjsw0","created":1793186139975,"text":"指血浆中甘油三酯和（或）总胆固醇、低密度脂蛋白胆\n固醇升高，以及高密度脂蛋白胆固醇降低。","layout":null},"children":[]},{"data":{"id":"dmgfg12fy5c0","created":1793186167737,"text":"LDL","layout":null},"children":[{"data":{"id":"dmgfgk5ptf40","created":1793186209294,"text":"肝脏→组织、细胞","layout":null},"children":[]},{"data":{"id":"dmgfgqh9xi00","created":1793186223053,"text":"高风险因子","layout":null},"children":[]},{"data":{"id":"dmgfgwjdnwg0","created":1793186236241,"text":"氧化LDL(ox-LDL)是最重要的致粥样硬化因子","layout":null},"children":[]},{"data":{"id":"dmgfgzzq9140","created":1793186243760,"text":"促进巨噬细胞形成泡沫细胞","layout":null},"children":[]}]},{"data":{"id":"dmgfh1p2cwg0","created":1793186247469,"text":"HDL","layout":null},"children":[{"data":{"id":"dmgfh5q8ysg0","created":1793186256249,"text":"组织、细胞→肝脏","layout":null},"children":[]},{"data":{"id":"dmgfh5q9ygg0","created":1793186256249,"text":"胆固醇逆向转运机制","layout":null},"children":[]},{"data":{"id":"dmgfh5q9obs0","created":1793186256249,"text":"抗氧化作用","layout":null},"children":[]}]}]}]}]}]},{"data":{"id":"dmg3ui4saeo0","created":1793153448663,"text":"发病机制","layout":null},"children":[{"data":{"id":"dmgfhfqiprc0","created":1793186278032,"text":"损伤应答学说","layout":null},"children":[{"data":{"id":"dmgfhk87mfk0","created":1793186287809,"text":"损伤因素","layout":null},"children":[{"data":{"id":"dmgfhnv3ai80","created":1793186295722,"text":"高脂血症","layout":null},"children":[]}]},{"data":{"id":"dmgfhrdljds0","created":1793186303372,"text":"机体应答","layout":null},"children":[{"data":{"id":"dmgfhug89140","created":1793186310061,"text":"单核-巨噬细胞","layout":null},"children":[]},{"data":{"id":"dmgfhx6tjy00","created":1793186316023,"text":"平滑肌细胞","layout":null},"children":[]}]},{"data":{"id":"dmgfqtg0l9s0","created":1793187013149,"text":"过程","layout":null},"children":[{"data":{"id":"dmgfqyx5ixc0","created":1793187025069,"text":"内皮损伤起始","layout":null},"children":[]},{"data":{"id":"dmgfr2jv4m80","created":1793187032973,"text":"**单核细胞招募**：受损内皮释放趋化因子，吸\n引血液里的**单核细胞**黏附、穿越内皮，迁移到内皮下","layout":null},"children":[]},{"data":{"id":"dmgfr940cj40","created":1793187047252,"text":"单核→巨噬细胞","layout":null},"children":[]},{"data":{"id":"dmgfrbhcz1c0","created":1793187052412,"text":"吞噬脂质，形成泡沫细胞","layout":null},"children":[]},{"data":{"id":"dmgfrdsl3yo0","created":1793187057445,"text":"平滑肌细胞（SMC）来源泡沫细胞","layout":null},"children":[]},{"data":{"id":"dmgfrh9tpww0","created":1793187065018,"text":"大量泡沫细胞聚集，就是早期**脂纹**","layout":null},"children":[]}]},{"data":{"id":"dmgfrlcr8hc0","created":1793187073902,"text":"泡沫细胞","layout":null},"children":[{"data":{"id":"dmgfrq4v84o0","created":1793187084309,"text":"是吞噬了脂质的巨噬细胞","layout":null},"children":[]},{"data":{"id":"dmgfrwupa5s0","created":1793187098932,"text":"是AS病理改变的基础","layout":null},"children":[]}]}]}]},{"data":{"id":"dmg3ujidnc00","created":1793153451662,"text":"病理变化","layout":null,"font-weight":"bold","background":"#73a1bf","color":"#ff0000","image":"https://p.cldisk.com/star4/72f148c19d19b8402c38584b54ad8198/origin.png","imageTitle":"","imageSize":{"width":131,"height":200}},"children":[{"data":{"id":"dmgfsb7wajk0","created":1793187130204,"text":"    脂纹\nFatty Streak","layout":null},"children":[{"data":{"id":"dmgfsqsojcw0","created":1793187164113,"text":"大体观","layout":null},"children":[{"data":{"id":"dmgfsybkzm80","created":1793187180493,"text":"早期病变","layout":null},"children":[]},{"data":{"id":"dmgft0fxjzc0","created":1793187185110,"text":"斑点或条纹样","layout":null},"children":[]},{"data":{"id":"dmgft685xzs0","created":1793187197701,"text":"平坦或隆起","layout":null},"children":[]}]},{"data":{"id":"dmgftjlatuw0","created":1793187226793,"text":"镜下观","layout":null},"children":[{"data":{"id":"dmgftmxbv540","created":1793187234051,"text":"内皮下层出现泡沫细胞","note":"泡沫细胞：就是巨噬细胞吞噬了脂质，但这些脂类物质在病理的制片过程中，二甲苯、酒精等有机溶剂溶解，所以在切片上皮呈现出空泡样的外观。正常人也会出现少量的脂质沉积，但巨噬细胞可以将其清除，处于动态平衡中。\n","layout":null},"children":[]}]},{"data":{"id":"dmgfuewhhso0","created":1793187294950,"text":"脂纹期是可逆性病变","layout":null},"children":[{"data":{"id":"dmgfuk20r9k0","created":1793187306168,"text":"AS的早期病变","layout":null},"children":[]},{"data":{"id":"dmgfunw21zs0","created":1793187314515,"text":"可逆性病变","layout":null},"children":[]}]}]},{"data":{"id":"dmgfuuzlzsg0","created":1793187329967,"text":"纤维斑块","layout":null},"children":[{"data":{"id":"dmgfv0xdsy80","created":1793187342893,"text":"大体观","layout":null},"children":[{"data":{"id":"dmgfv373o540","created":1793187347835,"text":"不规则隆起","layout":null},"children":[]},{"data":{"id":"dmgfv5abgp40","created":1793187352383,"text":"淡黄色—瓷白色","layout":null},"children":[]},{"data":{"id":"dmgfv9q6fk80","created":1793187362049,"text":"斑块可融合","layout":null},"children":[]}]},{"data":{"id":"dmgfvg77qco0","created":1793187376140,"text":"镜下观","layout":null},"children":[{"data":{"id":"dmgfwayyvtk0","created":1793187443121,"text":"表层为大量胶原纤维、散在的平滑肌细胞、\n少数弹性纤维及蛋白聚糖等形成的纤维帽","layout":null},"children":[]},{"data":{"id":"dmgfx711gs80","created":1793187512903,"text":"纤维帽下方：泡沫细胞、SMC、ECM、炎细胞","layout":null},"children":[]}]}]},{"data":{"id":"dmgfxpeps6w0","created":1793187552912,"text":"                 粥样斑块/粥瘤\nAtheromatous Plaque/Atheroma","font-weight":"bold","color":"#ff0000","background":"#73a1bf","layout":null},"children":[{"data":{"id":"dmgfyk3x8kw0","created":1793187619740,"text":"AS的典型病变","layout":null},"children":[]},{"data":{"id":"dmgfyqfzgdc0","created":1793187633530,"text":"大体观","layout":null},"children":[{"data":{"id":"dmgfyuvtqrk0","created":1793187643195,"text":"大小不等","layout":null},"children":[]},{"data":{"id":"dmgfywrouyg0","created":1793187647299,"text":"灰黄色斑块","layout":null},"children":[]},{"data":{"id":"dmgfz0uld0o0","created":1793187656181,"text":"切面间黄色粥糜样物质","layout":null},"children":[]}]},{"data":{"id":"dmgg1uwwurk0","created":1793187878353,"text":"镜下观","layout":null},"children":[{"data":{"id":"dmgg2d7bvt40","created":1793187918165,"text":"玻璃样变的纤维帽","layout":null},"children":[]},{"data":{"id":"dmgg2lg4f400","created":1793187936111,"text":"纤维帽深部：大量无定形物质—脂质及\n坏死物，可见胆固醇结晶，有时见钙化","layout":null},"children":[]},{"data":{"id":"dmgg3thb3dc0","created":1793188031961,"text":"底部及周边部：可见肉芽组织、少量泡沫细胞、淋巴细胞浸润","layout":null},"children":[]},{"data":{"id":"dmgg4bdkq200","created":1793188070918,"text":"粥瘤处中膜平滑肌受压萎缩变薄，弹性纤维破坏，血管硬化","layout":null},"children":[]}]},{"data":{"id":"dmggheg2xc00","created":1793189096334,"text":"分为稳定斑块和不稳定斑块","layout":null},"children":[{"data":{"id":"dmgghth8oxc0","created":1793189129056,"text":"稳定斑块：纤维帽后而脂质池较小","layout":null},"children":[]},{"data":{"id":"dmggi6w43nc0","created":1793189158253,"text":"不稳定斑块：纤维帽薄而脂质池较大，易破裂而导致\n继发血栓形成或斑块内出血，使血管急性闭塞而导致急性心肌梗死","layout":null},"children":[]},{"data":{"id":"dmgfzgt9wfs0","created":1793187690930,"text":"他汀类药物不仅可以降脂，最重要可以稳定斑块","layout":null},"children":[]}]}]},{"data":{"id":"dmgg6hrsvg00","created":1793188241567,"text":"三期比较","layout":null},"children":[{"data":{"id":"dmgg6neuen40","created":1793188253844,"text":"脂纹期","layout":null},"children":[{"data":{"id":"dmgg6z7eam80","created":1793188279515,"text":"形态特征","layout":null},"children":[{"data":{"id":"dmgg7mk4l4g0","created":1793188330351,"text":"平坦或微隆起于内膜的黄色点状/条纹状病变，肉眼可见","layout":null},"children":[]}]},{"data":{"id":"dmgg725ow280","created":1793188285942,"text":"组成成分","layout":null},"children":[{"data":{"id":"dmgg7rmxslk0","created":1793188341405,"text":"平坦或微隆起于内膜的黄色点状/条纹状病变，肉眼可见","layout":null},"children":[]}]},{"data":{"id":"dmgg73txsk00","created":1793188289585,"text":"病理变化","layout":null},"children":[{"data":{"id":"dmgg7vuam680","created":1793188350557,"text":"内皮损伤，脂质浸润内膜下，巨噬细胞吞噬脂质形成泡沫细胞","layout":null},"children":[]}]},{"data":{"id":"dmgg758ely80","created":1793188292637,"text":"临床意义","layout":null},"children":[{"data":{"id":"dmgg807clvc0","created":1793188360053,"text":"可逆性病变，无症状，需干预防止进展","layout":null},"children":[]}]},{"data":{"id":"dmgg76p7yhk0","created":1793188295830,"text":"转归","layout":null},"children":[{"data":{"id":"dmgg83a19kw0","created":1793188366746,"text":"通过控制危险因素（如血脂、血压）可消退","layout":null},"children":[]}]}]},{"data":{"id":"dmgg6ot9i740","created":1793188256893,"text":"纤维斑块期","layout":null},"children":[{"data":{"id":"dmgg6z7eam80","created":1793188279515,"text":"形态特征","layout":null},"children":[{"data":{"id":"dmgg86bnstc0","created":1793188373375,"text":"灰黄色或瓷白色隆起斑块，边界清晰，表面覆盖纤维帽","layout":null},"children":[]}]},{"data":{"id":"dmgg725ow280","created":1793188285942,"text":"组成成分","layout":null},"children":[{"data":{"id":"dmgg8aoxih40","created":1793188382884,"text":"纤维帽（胶原纤维、平滑肌细胞）、脂质核心、少量炎性细胞","layout":null},"children":[]}]},{"data":{"id":"dmgg73txsk00","created":1793188289585,"text":"病理变化","layout":null},"children":[{"data":{"id":"dmgg8dz87mg0","created":1793188390037,"text":"平滑肌细胞增生并分泌胶原，形成纤维帽覆盖脂质核心，中膜受压变薄","layout":null},"children":[]}]},{"data":{"id":"dmgg758ely80","created":1793188292637,"text":"临床意义","layout":null},"children":[{"data":{"id":"dmgg8ify99k0","created":1793188399756,"text":"血管狭窄（＜50%），可能引起缺血症状（如心绞痛）","layout":null},"children":[]}]},{"data":{"id":"dmgg76p7yhk0","created":1793188295830,"text":"转归","layout":null},"children":[{"data":{"id":"dmgg8lkmrw00","created":1793188406569,"text":"持续进展或稳定，需药物（如他汀）延缓斑块发展","layout":null},"children":[]}]}]},{"data":{"id":"dmgg6s5c5tk0","created":1793188264153,"text":"粥样斑块期","layout":null},"children":[{"data":{"id":"dmgg6z7eam80","created":1793188279515,"text":"形态特征","layout":null},"children":[{"data":{"id":"dmgg8r3pgo00","created":1793188418606,"text":"明显隆起的灰黄色斑块，纤维帽下含脂质核心，表面可钙化或溃疡","layout":null},"children":[]}]},{"data":{"id":"dmgg725ow280","created":1793188285942,"text":"组成成分","layout":null},"children":[{"data":{"id":"dmgg8uoq46o0","created":1793188426407,"text":"纤维帽变薄或破裂，脂质核心扩大，含坏死崩解物、胆固醇结晶","layout":null},"children":[]}]},{"data":{"id":"dmgg73txsk00","created":1793188289585,"text":"病理变化","layout":null},"children":[{"data":{"id":"dmgg8y3csm80","created":1793188433822,"text":"斑块内出血、钙化、溃疡，可合并血栓形成，中膜萎缩甚至断裂","layout":null},"children":[]}]},{"data":{"id":"dmgg758ely80","created":1793188292637,"text":"临床意义","layout":null},"children":[{"data":{"id":"dmgg90v4ndc0","created":1793188439855,"text":"易损斑块，纤维帽破裂后诱发急性血栓（心肌梗死、脑卒中）","layout":null},"children":[]}]},{"data":{"id":"dmgg76p7yhk0","created":1793188295830,"text":"转归","layout":null},"children":[{"data":{"id":"dmgg93u0l1c0","created":1793188446318,"text":"不可逆，需抗血小板治疗（如阿司匹林）或介入手术（支架）","layout":null},"children":[]}]}]}]},{"data":{"id":"dmggjnd97kw0","created":1793189272482,"text":"继发性病变","layout":null},"children":[{"data":{"id":"dmggnhu21ag0","created":1793189573894,"text":"斑块内出血","layout":null},"children":[]},{"data":{"id":"dmggnk2nvpc0","created":1793189578768,"text":"破裂、栓塞、血栓形成\n（斑块破裂，粥样物质进入血管腔，\n导致血栓的形成，引起血管腔的狭\n窄甚至闭塞）","layout":null},"children":[{"data":{"id":"dmggoeugbt40","created":1793189645752,"text":"斑块破裂后为什么容易引起血栓形成？\n结合魏尔啸三要素：血管内皮损伤、\n血流状态异常（血流动力学异常）、\n血液凝固性增高","layout":null},"children":[{"data":{"id":"dmggpcpvnxk0","created":1793189719486,"text":"1. 内膜（内皮）损伤","layout":null},"children":[{"data":{"id":"dmggpcpwjts0","created":1793189719487,"text":"斑块纤维帽破裂，斑块里面的脂质、胶原、组织因子暴露；\n胶原直接激活血小板，组织因子启动外源性凝血通路，\n是血栓形成最重要始动因素。","layout":null},"children":[]}]},{"data":{"id":"dmggpcpwlgw0","created":1793189719487,"text":"2. 血流动力学异常","layout":null},"children":[{"data":{"id":"dmggpcpw69s0","created":1793189719487,"text":"斑块本身造成血管狭窄；\n斑块破裂后局部形成凹凸不平破损面，产生涡流、血流变慢；\n涡流会让血小板更容易和破损内膜黏附聚集。","layout":null},"children":[]}]},{"data":{"id":"dmggpcpwjrs0","created":1793189719487,"text":"3. 血液凝固性增高","layout":null},"children":[{"data":{"id":"dmggpcpwbk80","created":1793189719487,"text":"斑块内大量促凝物质释放，激活血小板与凝血系统；\n血小板活化、凝血因子激活，血液处于高凝状态，快速形成血栓。","layout":null},"children":[]}]}]}]},{"data":{"id":"dmggqdbh6080","created":1793189799156,"text":"动脉瘤","layout":null},"children":[{"data":{"id":"dmggql5xz9k0","created":1793189816236,"text":"斑块的长期存在，可以出现钙化；\n而长期压迫导致动脉壁变薄，弹性下降，\n在持续血流的冲击下，可以导致动脉瘤的形成","layout":null},"children":[]}]}]}]},{"data":{"id":"dmgikrfylcg0","created":1793195001937,"text":"重要器官的动脉粥样硬化","layout":null},"children":[{"data":{"id":"dmgil2g44jk0","created":1793195025891,"text":"颈动脉斑块——头晕、头痛","layout":null},"children":[]},{"data":{"id":"dmgilc0c52o0","created":1793195046705,"text":"动脉粥样硬化性固缩肾：腹主动脉斑块","layout":null},"children":[]},{"data":{"id":"dmgilr2pfpk0","created":1793195079500,"text":"四肢动脉及肠系膜动脉","layout":null},"children":[{"data":{"id":"dmgilvoau1k0","created":1793195089512,"text":"下肢动脉斑块：引起间歇性跛行、溃疡、坏疽","layout":null},"children":[]},{"data":{"id":"dmgim41sqco0","created":1793195107743,"text":"肠系膜动脉斑块引起肠梗死","layout":null},"children":[]}]}]}]},{"data":{"id":"dmggsjn36m80","created":1793189969647,"text":"冠状动脉粥样硬化","layout":null},"children":[{"data":{"id":"dmggt5d0yow0","created":1793190016928,"text":"•特点：","layout":null},"children":[{"data":{"id":"dmggtrcbvsg0","created":1793190064775,"text":"左侧>右侧","layout":null},"children":[]},{"data":{"id":"dmggtrccbnk0","created":1793190064776,"text":"大支>小支","layout":null},"children":[]},{"data":{"id":"dmggtrccj340","created":1793190064776,"text":"近端>远端","layout":null},"children":[]}]},{"data":{"id":"dmggtu328mg0","created":1793190070745,"text":"分级：根据狭窄程度","layout":null},"children":[{"data":{"id":"dmggu5enrtc0","created":1793190095391,"text":"I 级\t    ≦25%","layout":null},"children":[]},{"data":{"id":"dmggu5enk9k0","created":1793190095391,"text":"II级\t    26%-50%","layout":null},"children":[]},{"data":{"id":"dmggu5enofc0","created":1793190095391,"text":"III级     51%-75%","layout":null},"children":[]},{"data":{"id":"dmggu5enzl40","created":1793190095391,"text":"IV级     ≥76%","layout":null},"children":[]}]}]},{"data":{"id":"dmggsmbv3s00","created":1793189975499,"text":"冠状动脉粥样硬化性心脏病（冠心病CHD）","layout":null},"children":[{"data":{"id":"dmgguvjrebs0","created":1793190152296,"text":"冠状动脉狭窄、供血不足引起的心肌功能障碍，又称缺血性心脏病","layout":null},"children":[]},{"data":{"id":"dmgguy7zc340","created":1793190158114,"text":"病因","layout":null},"children":[{"data":{"id":"dmggv0f3xe00","created":1793190162898,"text":"冠状动脉供血不足","layout":null},"children":[{"data":{"id":"dmggvgzj3ts0","created":1793190198962,"text":"AS所致管腔狭窄","layout":null},"children":[]},{"data":{"id":"dmggvjbnjw80","created":1793190204048,"text":"AS继发病变","layout":null},"children":[]},{"data":{"id":"dmggvloniyg0","created":1793190209188,"text":"冠脉痉挛","layout":null},"children":[]}]},{"data":{"id":"dmggvdwwjq80","created":1793190192272,"text":"心肌耗氧量剧增","layout":null},"children":[{"data":{"id":"dmggvqeour40","created":1793190219469,"text":"情绪激动\n血压骤升\n劳累…","layout":null},"children":[]}]}]},{"data":{"id":"dmggvz7w6000","created":1793190238649,"text":"临床表现","layout":null},"children":[{"data":{"id":"dmggwemstm00","created":1793190272202,"text":"心绞痛  Angina pectoris  ","layout":null},"children":[{"data":{"id":"dmggwn5s5uw0","created":1793190290764,"text":"心肌急剧的、暂时性缺血缺氧表现：阵发性胸骨后疼痛","layout":null},"children":[]},{"data":{"id":"dmggwn5ro8w0","created":1793190290764,"text":"疼痛类型：钳夹样、压迫样、放散样","layout":null},"children":[]},{"data":{"id":"dmggxbp4wmg0","created":1793190344177,"text":"心绞痛类型","layout":null},"children":[{"data":{"id":"dmggxes8bkw0","created":1793190350895,"text":"稳定性心绞痛","layout":null},"children":[{"data":{"id":"dmggxhk22ao0","created":1793190356931,"text":"最常见，常发生于AS，心功能需求增高时","layout":null},"children":[]}]},{"data":{"id":"dmggxue70200","created":1793190384875,"text":"不稳定性心绞痛","layout":null},"children":[{"data":{"id":"dmggxzn53a80","created":1793190396300,"text":"非阻塞性血栓，休息和劳累时均可出现","layout":null},"children":[]}]},{"data":{"id":"dmggybcg48g0","created":1793190421774,"text":"变异性心绞痛","layout":null},"children":[{"data":{"id":"dmggye8fvg80","created":1793190428062,"text":"冠脉痉挛，常在休息时出现","layout":null},"children":[]}]}]}]},{"data":{"id":"dmggwemshts0","created":1793190272202,"text":"心肌梗死  Myocardial infarction, MI","layout":null,"image":"https://p.cldisk.com/star4/d35f73e38b2fe47d65543c9093c38dd9/origin.png","imageTitle":"","imageSize":{"width":200,"height":94}},"children":[{"data":{"id":"dmggyo4al940","created":1793190449580,"text":"严重而持续性缺血所致的心肌坏死","layout":null},"children":[]},{"data":{"id":"dmggyyfvn000","created":1793190472048,"text":"心脏冠脉造影显示：冠状动脉梗阻","layout":null},"children":[]},{"data":{"id":"dmggzfr0jkg0","created":1793190509727,"text":"病因：冠状动脉闭锁或狭窄","layout":null},"children":[{"data":{"id":"dmggzo0hpco0","created":1793190527714,"text":"冠脉粥样硬化（最常见）","layout":null},"children":[]},{"data":{"id":"dmggztvn8ag0","created":1793190540481,"text":"冠脉痉挛","layout":null},"children":[]},{"data":{"id":"dmggzvpyogw0","created":1793190544491,"text":"栓子（血栓、异物等）","layout":null},"children":[]}]},{"data":{"id":"dmgh042f28g0","created":1793190562659,"text":"部位：梗死部位与冠脉供血区相关","layout":null},"children":[{"data":{"id":"dmgh0ba9zps0","created":1793190578372,"text":"左前降支—左室前壁","layout":null},"children":[]},{"data":{"id":"dmgh0k6903k0","created":1793190597719,"text":"左回旋支—左室cebi","layout":null},"children":[]},{"data":{"id":"dmgh0qcxwzk0","created":1793190611184,"text":"右冠状动脉—下壁或后壁","layout":null},"children":[]}]},{"data":{"id":"dmgh17btgrk0","created":1793190648122,"text":"类型","layout":null},"children":[{"data":{"id":"dmgh18u6q6g0","created":1793190651409,"text":"心内膜下MI","layout":null},"children":[{"data":{"id":"dmgh1e54ads0","created":1793190662954,"text":"主要累及心室壁内层1/3","layout":null},"children":[]},{"data":{"id":"dmgh1e54gdc0","created":1793190662954,"text":"常为多发性、小灶性坏死","layout":null},"children":[]},{"data":{"id":"dmgh1e546so0","created":1793190662954,"text":"病变范围不规则","layout":null},"children":[]},{"data":{"id":"dmgh1e542hc0","created":1793190662954,"text":"严重时累及整个心内膜下心肌，引起环状梗死","layout":null},"children":[]}]},{"data":{"id":"dmgh1g0pzq80","created":1793190667042,"text":"透壁性/区域性MI（典型）","image":"https://p.cldisk.com/star4/ceadc71db0c57682d45e9c32dd651551/origin.png","imageTitle":"","imageSize":{"width":200,"height":169},"layout":null},"children":[{"data":{"id":"dmgh1uh72w00","created":1793190698513,"text":"病灶较大，累及心室壁全层或深达室壁2/3","layout":null},"children":[]},{"data":{"id":"dmgh1uh6w800","created":1793190698513,"text":"MI部位与冠脉供血区一致","layout":null},"children":[]},{"data":{"id":"dmgh1uh7whc0","created":1793190698514,"text":"多发生于左冠脉前降支供血区域","layout":null},"children":[]}]}]},{"data":{"id":"dmgh4hfzih40","created":1793190905234,"text":"不同器官缺血性梗死灶的形状不同？","layout":null},"children":[{"data":{"id":"dmgh4szxeyg0","created":1793190930384,"text":"血管走形不一，梗死形状不同","layout":null},"children":[]}]},{"data":{"id":"dmgh55ajj9k0","created":1793190957148,"text":"病理变化——形态学动态演变过程\n（参考ppt）","layout":null},"children":[{"data":{"id":"dmghxudnleo0","created":1793193205952,"text":"4h（镜下）：心肌纤维呈波浪状，肉眼无明显改变","layout":null},"children":[]},{"data":{"id":"dmghxudo9og0","created":1793193205953,"text":"- 6h 左右（肉眼）：梗死灶变为苍白色","layout":null},"children":[]},{"data":{"id":"dmghxudo36o0","created":1793193205953,"text":"8h～1 天：肉眼：土黄色；镜下：凝固性坏死","layout":null},"children":[]},{"data":{"id":"dmghzf937iw0","created":1793193329753,"text":"4d后大体颜色发黄，梗死灶周围出现充血出血带","layout":null},"children":[]},{"data":{"id":"dmghxudo3hs0","created":1793193205953,"text":"1 周左右：镜下：坏死灶内大量中性粒细胞浸润，清除坏死组织","layout":null},"children":[]},{"data":{"id":"dmghxudo1uo0","created":1793193205953,"text":"- 之后：肉芽组织长入、机化\n肉芽组织：新生毛细血管+成纤维细胞+炎细胞","layout":null},"children":[{"data":{"id":"dmgiep2hxqo0","created":1793194526584,"text":"肉芽组织出现的意义和作用何在？","layout":null},"children":[{"data":{"id":"dmgieu9g6940","created":1793194537889,"text":"1. **抗感染、保护创面**：里面的炎细胞（巨噬细胞等）吞噬病原体、坏死碎片，\n隔绝损伤区域，防止进一步感染。","layout":null},"children":[]},{"data":{"id":"dmgieu9g7a80","created":1793194537889,"text":"2. **填补缺损**：心梗后心肌细胞不能再生，\n肉芽组织长入坏死灶，填补坏死造成的组织缺损。","layout":null},"children":[]},{"data":{"id":"dmgieu9gurk0","created":1793194537890,"text":"3. **机化、包裹坏死组织**：把梗死的坏死心肌、血栓\n等无活性物质机化，逐步替代，之后成熟转化为\n瘢痕组织。","layout":null},"children":[]}]}]},{"data":{"id":"dmghxudoff40","created":1793193205953,"text":"- 3 周左右：肉芽组织逐步成熟，最终形成白色瘢痕，\n永久修复（心肌细胞不可再生）","layout":null},"children":[{"data":{"id":"dmgiff6vdn40","created":1793194583445,"text":"心肌属于永久细胞，**肉芽组织不能再生心肌**，\n最终只能变成瘢痕，形成没有收缩功能的纤维瘢痕，\n也就是图里的白色瘢痕，会影响心脏收缩、有室壁瘤风险","layout":null},"children":[]}]},{"data":{"id":"dmgig8q6ieo0","created":1793194647739,"text":"临床意义","layout":null},"children":[{"data":{"id":"dmgigaebyk80","created":1793194651376,"text":"外周血中心肌酶水平升高","layout":null},"children":[{"data":{"id":"dmgiglvjjko0","created":1793194676362,"text":"心肌细胞梗死，心肌酶通过\n损伤的细胞膜释放入血","layout":null},"children":[]},{"data":{"id":"dmgihv8s51k0","created":1793194775117,"text":"心肌酶谱升高的时间和心肌发生凝固性坏死的时间一致","layout":null},"children":[]}]}]}]},{"data":{"id":"dmgihyx15jk0","created":1793194783114,"text":"并发症","layout":null},"children":[{"data":{"id":"dmgii1jxrig0","created":1793194788853,"text":"心力衰竭、心脏破裂、室壁瘤、附壁血栓形成、心源性休克、心包炎、心律失常","layout":null},"children":[]}]}]},{"data":{"id":"dmggwemt4w00","created":1793190272203,"text":"心肌纤维化 Myocardial Fibrosis","layout":null},"children":[{"data":{"id":"dmgijqewkns0","created":1793194921332,"text":"心肌持续性和（或）反复加重的缺血、缺氧","layout":null},"children":[]},{"data":{"id":"dmgijsgdhm00","created":1793194925775,"text":"心肌肥大，间质纤维化","layout":null},"children":[]}]},{"data":{"id":"dmggwemt8co0","created":1793190272203,"text":"冠状动脉性猝死 Sudden coronary death","layout":null},"children":[{"data":{"id":"dmgijy7ftgg0","created":1793194938295,"text":"心源性猝死最常见的一种","layout":null},"children":[]},{"data":{"id":"dmgijy7gdoo0","created":1793194938296,"text":"立即死亡或1至数小时内死亡","layout":null},"children":[]},{"data":{"id":"dmgijy7g6ww0","created":1793194938296,"text":"80%有冠状动脉疾病引起","layout":null},"children":[]},{"data":{"id":"dmgijy7ga000","created":1793194938296,"text":"心电图表现为心律失常，室颤等","layout":null},"children":[]}]}]}]},{"data":{"id":"dmg3tnec9y80","created":1793153381761,"text":"高血压病","layout":null},"children":[{"data":{"id":"dmgj2i7cwgw0","created":1793196392381,"text":"概念","layout":null},"children":[{"data":{"id":"dmgj2k8vhqg0","created":1793196396826,"text":"体循环动脉压持续升高，可导致心、脑、肾和血管改变的临床综合征","layout":null},"children":[]},{"data":{"id":"dmgj2yhwklk0","created":1793196427847,"text":"诊断标准","layout":null},"children":[{"data":{"id":"dmgj3nl0f4w0","created":1793196482454,"text":"正常血压＜120/80","layout":null},"children":[]},{"data":{"id":"dmgj3uwmngg0","created":1793196498394,"text":"正常高值＜140/90","layout":null},"children":[]},{"data":{"id":"dmgj4bcjzj40","created":1793196534186,"text":"高血压≥140/90","layout":null},"children":[{"data":{"id":"dmgj4hmqdvk0","created":1793196547862,"