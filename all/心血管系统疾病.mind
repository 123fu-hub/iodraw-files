,"layout":null},"children":[]}]},{"data":{"id":"dmgjfvknn0g0","created":1793197440217,"text":"心脏","layout":null},"children":[{"data":{"id":"dmgjgp3e28g0","created":1793197504476,"text":"心肌梗死","layout":null},"children":[]},{"data":{"id":"dmgjgrobg740","created":1793197510095,"text":"高血压性心肌病","layout":null},"children":[]},{"data":{"id":"dmgjgv63k4w0","created":1793197517701,"text":"心力衰竭","layout":null},"children":[]},{"data":{"id":"dmgjiv5ezwg0","created":1793197674388,"text":"高血压心脏病变","layout":null},"children":[{"data":{"id":"dmgjhrqvmds0","created":1793197588614,"text":"病理生理基础","layout":null},"children":[{"data":{"id":"dmgjhtraxr40","created":1793197592994,"text":"左心室负荷增加，发生代偿性肥大","layout":null},"children":[]},{"data":{"id":"dmgji1qph0g0","created":1793197610372,"text":"血压持续升高，外周阻力增加","layout":null},"children":[]},{"data":{"id":"dmgjifigka80","created":1793197640348,"text":"心脏体积增大原因：心肌细胞肥大（心肌细胞是永久细胞）","layout":null},"children":[]}]},{"data":{"id":"dmgjiy2uhnk0","created":1793197680763,"text":"代偿期","layout":null},"children":[{"data":{"id":"dmgjj23bbm80","created":1793197689498,"text":"向心性肥大","layout":null},"children":[]},{"data":{"id":"dmgjjc6h4f40","created":1793197711457,"text":"左室壁增厚，但心腔不扩张，\n向心性肥大能完全代偿其功能，临床症状不明显","layout":null},"children":[]}]},{"data":{"id":"dmgjjqvxwhk0","created":1793197743472,"text":"失代偿期","layout":null},"children":[{"data":{"id":"dmgjjs8wp000","created":1793197746433,"text":"离心性肥大","layout":null},"children":[]},{"data":{"id":"dmgjjusr7eg0","created":1793197751987,"text":"心肌过度肥大\n→心肌供血不足、收缩功能下降\n→心肌失代偿，心脏扩扩张","layout":null},"children":[]}]}]}]},{"data":{"id":"dmgjfwvch2o0","created":1793197443040,"text":"肾脏","layout":null},"children":[{"data":{"id":"dmgjgxz02mg0","created":1793197523802,"text":"高血压性肾病，颗粒型固缩肾","layout":null},"children":[]},{"data":{"id":"dmgjh1wwbe00","created":1793197532382,"text":"慢性肾衰","layout":null},"children":[]},{"data":{"id":"dmgjkkvq6o00","created":1793197808763,"text":"高血压性肾脏病变","layout":null},"children":[{"data":{"id":"dmgjkqhl5gw0","created":1793197820968,"text":"肾小球小动脉玻璃样变\n→肾小球纤维化，体积缩小，肾小球及肾小管萎缩\n→周围肾小球及肾小管代偿肥大","layout":null},"children":[]},{"data":{"id":"dmgjlt238xs0","created":1793197904926,"text":"颗粒型固缩肾","layout":null},"children":[{"data":{"id":"dmgjm9nplns0","created":1793197941062,"text":"病变区萎缩——凹陷\n病变周围肥大——凸起","layout":null},"children":[]}]}]}]},{"data":{"id":"dmgjfze3p400","created":1793197448528,"text":"外周血管病变","layout":null},"children":[{"data":{"id":"dmgjhavyxmo0","created":1793197551917,"text":"主动脉夹层","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dmgjpgz92cg0","created":1793198192089,"text":"恶性","layout":null},"children":[{"data":{"id":"dmgjqdnlbo80","created":1793198263218,"text":"特点","layout":null},"children":[{"data":{"id":"dmgjpk5dmxs0","created":1793198198990,"text":"急进型HTN","layout":null},"children":[]},{"data":{"id":"dmgjprbd89s0","created":1793198214590,"text":"青壮年好发","layout":null},"children":[]},{"data":{"id":"dmgjqa8c65s0","created":1793198255766,"text":"血压显著升高>230/130mmHg","layout":null},"children":[]},{"data":{"id":"dmgjqa8ccrs0","created":1793198255766,"text":"舒张压升高明显","layout":null},"children":[]}]},{"data":{"id":"dmgjqipf0000","created":1793198274212,"text":"形态学改变","layout":null},"children":[{"data":{"id":"dmgjql698io0","created":1793198279584,"text":"增生性小动脉硬化","layout":null},"children":[{"data":{"id":"dmgjqpdesag0","created":1793198288724,"text":"洋葱皮样","layout":null},"children":[]}]},{"data":{"id":"dmgjqv4noag0","created":1793198301255,"text":"坏死性细动脉炎","layout":null},"children":[{"data":{"id":"dmgjr0t2ie00","created":1793198313615,"text":"血管壁的纤维素样坏死","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dmgj6mye7q80","created":1793196716179,"text":"继发性","layout":null},"children":[]}]}]}]},{"data":{"id":"dmg3tr0bdnk0","created":1793153389620,"text":"     风湿病\nRheumatism","layout":null},"children":[{"data":{"id":"dmgjrq9zgpk0","created":1793198369058,"text":"一种与A组乙型溶血性链球菌感染有关的\n变态反应性-自身免疫性疾病，\n主要累及全身结缔组织及血管。","layout":null},"children":[]},{"data":{"id":"dmgjryjq8m00","created":1793198387061,"text":"风湿病患者的结缔组织及血管病变中\n往往检检测不出链球菌","layout":null},"children":[]},{"data":{"id":"dmgjs3yweyw0","created":1793198398863,"text":"发病机制（4不）","layout":null},"children":[{"data":{"id":"dmgjs8vzrj40","created":1793198409571,"text":"不是链球菌直接引起的感染性疾病","layout":null},"children":[]},{"data":{"id":"dmgjs8vzs4w0","created":1793198409571,"text":"发病不在链球菌感染时期","layout":null},"children":[]},{"data":{"id":"dmgjs8w03mo0","created":1793198409571,"text":"典型病变不在感染的原发部位，而在远离感染灶的心脏、关节等处","layout":null},"children":[]},{"data":{"id":"dmgjs8w0oyo0","created":1793198409572,"text":"典型病变区不能检测到链球菌","layout":null},"children":[]}]},{"data":{"id":"dmgjspurxhc0","created":1793198446502,"text":"基本病理变化","layout":null},"children":[{"data":{"id":"dmgjstbedqo0","created":1793198454038,"text":"变质渗出期","layout":null},"children":[{"data":{"id":"dmgjthvnuy00","created":1793198507506,"text":"变态反应性病变：常见纤维素性坏死","layout":null},"children":[]},{"data":{"id":"dmgjthvo3xc0","created":1793198507506,"text":"早期改变，好发于心脏、浆膜、关节等处","layout":null},"children":[]},{"data":{"id":"dmgjthvns9c0","created":1793198507506,"text":"该期约持续一个月","layout":null},"children":[]},{"data":{"id":"dmgjthvo1k00","created":1793198507506,"text":"完全吸收或进入肉芽肿期","layout":null},"children":[]},{"data":{"id":"dmgjtpuh7fs0","created":1793198524848,"text":"风湿早期可见小灶纤维素样坏死、\n胶原纤维沉积、淋巴细胞浸润","layout":null},"children":[]}]},{"data":{"id":"dmgjt03rtfs0","created":1793198468814,"text":"增生期或肉芽肿期","layout":null},"children":[{"data":{"id":"dmgjtysmw0w0","created":1793198544328,"text":"1.变质渗出","layout":null},"children":[]},{"data":{"id":"dmgju59bbxs0","created":1793198558397,"text":"2.特征性的肉芽肿","layout":null},"children":[]},{"data":{"id":"dmgju8jxzs80","created":1793198565570,"text":"3.巨噬细胞增生形成的境界清楚的结节状病灶","layout":null},"children":[]},{"data":{"id":"dmgjulnzvio0","created":1793198594114,"text":"形成肉芽肿的细胞——风湿细胞/Aschoff细胞","color":"#ff0000","background":"#ffff00","font-weight":"bold","image":"https://p.cldisk.com/star4/75fd34409522a7aa45016d77916e19b8/origin.png","imageTitle":"","imageSize":{"width":102,"height":200},"layout":null},"children":[{"data":{"id":"dmgjv75ryds0","created":1793198640901,"text":"本质为巨噬细胞","layout":null},"children":[]},{"data":{"id":"dmgjvcahiy00","created":1793198652070,"text":"形态学特征","layout":null},"children":[{"data":{"id":"dmgjvhsucv40","created":1793198664064,"text":"体积大，圆形，胞浆丰富","layout":null},"children":[]},{"data":{"id":"dmgjvhsuwj40","created":1793198664065,"text":"核大，核膜清晰，染色质集中于核中央","layout":null},"children":[]}]},{"data":{"id":"dmgx9bapvd40","created":1793236421434,"text":"风湿小体/阿绍夫小体","layout":null},"children":[{"data":{"id":"dmgxasq94io0","created":1793236537743,"text":"由成群的风湿细胞+纤维素样坏死灶+少量深处的淋巴细胞和浆细胞构成","layout":null},"children":[]},{"data":{"id":"dmgxbgayztk0","created":1793236589062,"text":"形成：在纤维蛋白坏死灶的基础上，\n附近的组织细胞增生、聚集，\n吞噬纤维蛋白样坏死物，使胞体变形转变为风湿细胞","layout":null},"children":[]}]}]}]},{"data":{"id":"dmgjt568jts0","created":1793198479847,"text":"纤维化期或硬化期","layout":null},"children":[{"data":{"id":"dmgxcrfezag0","created":1793236691639,"text":"风湿细胞转变为成纤维细胞，\n风湿小体纤维化，最后形成瘢痕","layout":null},"children":[]}]}]},{"data":{"id":"dmgxd8k4uio0","created":1793236728930,"text":"各脏器病变：\n常累及心脏及关节","layout":null},"children":[{"data":{"id":"dmgxdd9qe280","created":1793236739185,"text":"             风湿性心脏病\nRheumatic heart disease, RHD","layout":null},"children":[{"data":{"id":"dmgxe8lvuqg0","created":1793236807400,"text":"心内膜炎","layout":null},"children":[{"data":{"id":"dmgxej35pv40","created":1793236830212,"text":"是风湿病最重要的病变","layout":null},"children":[]},{"data":{"id":"dmgxenskikw0","created":1793236840456,"text":"主要累及心瓣膜，瓣膜闭锁缘的赘生物\n（血小板+纤维蛋白—白色血栓）","layout":null},"children":[]},{"data":{"id":"dmgxexlq2ds0","created":1793236861810,"text":"MacCallum斑（左房心内膜局部增厚）","layout":null},"children":[{"data":{"id":"dmgxg4an3m00","created":1793236954741,"text":"MacCallum斑：左房后壁因病变瓣膜关闭不全，\n受血液反流冲击较重，此处病变较重，\n常形成纤维性增厚的斑块","layout":null},"children":[]}]},{"data":{"id":"dmgxjttevdk0","created":1793237245388,"text":"风湿病是引起二尖瓣狭窄的主要原因","layout":null},"children":[{"data":{"id":"dmh3y4okn0o0","created":1793255292798,"text":"二尖瓣狭窄呈“鱼口状”","layout":null},"children":[]},{"data":{"id":"dmh3ybtr25s0","created":1793255308349,"text":"双颧绀红：二尖瓣面容","layout":null},"children":[]}]}]},{"data":{"id":"dmgxecbi5kw0","created":1793236815479,"text":"风湿性心肌炎","layout":null},"children":[{"data":{"id":"dmh3zilagxk0","created":1793255401439,"text":"特征","layout":null},"children":[{"data":{"id":"dmh3zkf5qk80","created":1793255405421,"text":"心肌间质内小血管附近出现风湿小体","layout":null},"children":[]},{"data":{"id":"dmh3zsd7m3s0","created":1793255422718,"text":"常见于室间隔和左心室后壁上部","layout":null},"children":[]}]}]},{"data":{"id":"dmgxede1yww0","created":1793236817810,"text":"心外膜炎","layout":null},"children":[{"data":{"id":"dmh40euoqqg0","created":1793255471664,"text":"纤维素性心外膜炎，形成绒毛心\n绒毛心：渗出以纤维蛋白为主时，\n覆盖于心包表面的纤维蛋白可因心\n脏搏动牵拉而呈现绒毛状，称为绒毛心","layout":null},"children":[]},{"data":{"id":"dmh41uu1lyo0","created":1793255584818,"text":"当渗出以浆液为主，则形成心包积液","layout":null},"children":[]}]}]},{"data":{"id":"dmh42v100880","created":1793255663602,"text":"风湿性关节炎","layout":null},"children":[{"data":{"id":"dmh431oj4zc0","created":1793255678086,"text":"最常侵犯膝、踝、肩、腕、肘等大关节，呈游走性、反复发作。","layout":null},"children":[]},{"data":{"id":"dmh431ojrbc0","created":1793255678087,"text":"关节局部出现红、肿、热、痛和功能障碍。","layout":null},"children":[]},{"data":{"id":"dmh431ojl1k0","created":1793255678087,"text":"关节腔内有浆液及纤维蛋白渗出，邻近软组织内可见Aschoff小体。","layout":null},"children":[]},{"data":{"id":"dmh431ojw7s0","created":1793255678087,"text":"急性期后，渗出物易被完全吸收，一般不留后遗症。","layout":null},"children":[]},{"data":{"id":"dmh43rs8f0w0","created":1793255734906,"text":"这里与类风湿性关节炎区分一下","layout":null},"children":[{"data":{"id":"dmh44dacj0w0","created":1793255781714,"text":"风湿性关节炎是 A 组乙型溶血性链球菌咽部感染后\n诱发的风湿热，以游走性大关节炎为表现，\n关节病变不留畸形，但可合并心脏炎，\n造成永久性瓣膜损伤；","layout":null},"children":[]},{"data":{"id":"dmh44ltq8w80","created":1793255800300,"text":"类风湿关节炎是慢性自身免疫性滑膜炎，\n对称性累及双手小关节，晨僵＞1h，\n持续侵蚀骨与软骨，晚期出现关节畸形，\n可有关节外多系统损害","layout":null},"children":[]}]}]},{"data":{"id":"dmh44yc7kio0","created":1793255827539,"text":"皮肤病变","layout":null},"children":[{"data":{"id":"dmh450s95b40","created":1793255832863,"text":"环形红斑：渗出性病变","layout":null},"children":[]},{"data":{"id":"dmh455ajh600","created":1793255842675,"text":"皮下结节：增生性病变，Aschoff小体","layout":null},"children":[]}]},{"data":{"id":"dmh45fj51lc0","created":1793255864963,"text":"风湿性动脉炎","layout":null},"children":[]},{"data":{"id":"dmh45j4kti80","created":1793255872790,"text":"风湿性脑病：小舞蹈症","layout":null},"children":[]}]}]},{"data":{"id":"dmg3tskjn3c0","created":1793153393020,"text":"     感染性心内膜炎IE\nInfective endocarditis","layout":null},"children":[]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}