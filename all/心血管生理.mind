ildren":[{"data":{"id":"dm6ojbe2sag0","created":1792196215723,"text":"窦房结\n房室结\n浦肯野纤维","layout":null},"children":[{"data":{"id":"dm6ojjq7nfs0","created":1792196233871,"text":"产生/传导节律","layout":null},"children":[]},{"data":{"id":"dm6ojq5hkh40","created":1792196247855,"text":"静息状态不稳定，可自动去极化","layout":null},"children":[]}]}]},{"data":{"id":"dm6oe1thwbk0","created":1792195803067,"text":"非肌细胞","layout":null},"children":[{"data":{"id":"dm6ok15j5e00","created":1792196271803,"text":"内皮细胞\n成纤维细胞","layout":null},"children":[{"data":{"id":"dm6ok7itihs0","created":1792196285667,"text":"支持/代谢/纤维化/电耦联环境","layout":null},"children":[]},{"data":{"id":"dm6oki7nmfs0","created":1792196308936,"text":"不直接产生典型的心肌AP","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dm6ol1d3wbk0","created":1792196350625,"text":"心肌细胞的生物电现象","layout":null},"children":[{"data":{"id":"dm6ol9gjivs0","created":1792196368247,"text":"心室肌细胞","layout":null},"children":[{"data":{"id":"dm6olf14ns00","created":1792196380376,"text":"静息电位","layout":null},"children":[{"data":{"id":"dm6ols48mbs0","created":1792196408862,"text":"是细胞膜内外两侧的电位差","layout":null},"children":[]},{"data":{"id":"dm6om0320ag0","created":1792196426205,"text":"形成基础：离子分布不均，膜对K⁺的选择性通透","layout":null},"children":[]},{"data":{"id":"dm6omtoe9rk0","created":1792196490622,"text":"k+外流为主因，\n心室肌静息电位约 -90 mV，\n接近K⁺平衡电位","font-weight":"bold","layout":null},"children":[]},{"data":{"id":"dm6onorntuo0","created":1792196558299,"text":"注意：内向整流钾离子通道IK1","resource":["！"],"progress":9,"color":"#ff0000","font-weight":"bold","background":"#ffff00"},"children":[{"data":{"id":"dm6op12dzzc0","created":1792196663433,"text":"作用：稳定心室肌静息电位的重要k+电流","font-weight":"bold"},"children":[]},{"data":{"id":"dm6opfwvh9k0","created":1792196695752,"text":"内向整流并非k+内流，\n而是强调在去极化时减少k+外流\n（当膜电位去极化（膜电位正值）时，\n胞内镁离子与多胺堵塞通道孔道，\n抑制K⁺外向外流）","font-weight":"bold","color":"#ff0000","background":"#c6d9f1"},"children":[]}]}]},{"data":{"id":"dm6oqlqkghs0","created":1792196786795,"text":"动作电位"},"children":[{"data":{"id":"dm6oqs6xno00","created":1792196800846,"text":"分支主题"},"children":[]}]}]}]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}