{"root":{"data":{"id":"dm6d5kxzhmw0","created":1792164107211,"text":"心血管生理"},"children":[{"data":{"id":"dm6o6ynbb1k0","created":1792195247613,"text":"心肌细胞的生物电现象\n和生理特性","layout":null},"children":[{"data":{"id":"dm6o8doez5k0","created":1792195358696,"text":"细胞分类","layout":null},"children":[{"data":{"id":"dm6o8j5nwtc0","created":1792195370623,"text":"按快慢反应、\n是否自律","layout":null},"children":[{"data":{"id":"dm6o8rj7a280","created":1792195388856,"text":"快反应细胞：\n0期Na⁺内流","layout":null},"children":[{"data":{"id":"dm6o9pk9fk00","created":1792195462930,"text":"非自律","layout":null},"children":[{"data":{"id":"dm6obdqqj2o0","created":1792195593929,"text":"心房肌、心室肌\n(也称工作细胞)","layout":null},"children":[]}]},{"data":{"id":"dm6obsba2u00","created":1792195625646,"text":"自律","layout":null},"children":[{"data":{"id":"dm6obu7vf2o0","created":1792195629793,"text":"浦肯野纤维\n（潜在起搏细胞）","layout":null},"children":[]}]}]},{"data":{"id":"dm6o9azi0tk0","created":1792195431200,"text":"慢反应细胞：\n0期Ca²⁺内流","layout":null},"children":[{"data":{"id":"dm6oc6q7uv40","created":1792195657024,"text":"非自律","layout":null},"children":[{"data":{"id":"dm6ocecevuo0","created":1792195673604,"text":"房室结部分细胞\n（慢传导）","layout":null},"children":[]}]},{"data":{"id":"dm6ocq1oivk0","created":1792195699076,"text":"自律","layout":null},"children":[{"data":{"id":"dm6ocvalchk0","created":1792195710499,"text":"窦房结细胞\n（主导起搏）","layout":null},"children":[]}]}]}]},{"data":{"id":"dm6odrfu7ww0","created":1792195780473,"text":"按功能分类","layout":null},"children":[{"data":{"id":"dm6odvub1ts0","created":1792195790055,"text":"工作心肌细胞","layout":null},"children":[{"data":{"id":"dm6oit93khc0","created":1792196176240,"text":"心房肌\n心室肌","layout":null},"children":[{"data":{"id":"dm6oiy8hkwg0","created":1792196187087,"text":"发生收缩","layout":null},"children":[]},{"data":{"id":"dm6oj2alvs80","created":1792196195922,"text":"有稳定的静息电位，不自律","layout":null},"children":[]}]}]},{"data":{"id":"dm6odyuaars0","created":1792195796584,"text":"自律心肌细胞","layout":null},"children":[{"data":{"id":"dm6ojbe2sag0","created":1792196215723,"text":"窦房结\n房室结\n浦肯野纤维","layout":null},"children":[{"data":{"id":"dm6ojjq7nfs0","created":1792196233871,"text":"产生/传导节律","layout":null},"children":[]},{"data":{"id":"dm6ojq5hkh40","created":1792196247855,"text":"静息状态不稳定，可自动去极化","layout":null},"children":[]}]}]},{"data":{"id":"dm6oe1thwbk0","created":1792195803067,"text":"非肌细胞","layout":null},"children":[{"data":{"id":"dm6ok15j5e00","created":1792196271803,"text":"内皮细胞\n成纤维细胞","layout":null},"children":[{"data":{"id":"dm6ok7itihs0","created":1792196285667,"text":"支持/代谢/纤维化/电耦联环境","layout":null},"children":[]},{"data":{"id":"dm6oki7nmfs0","created":1792196308936,"text":"不直接产生典型的心肌AP","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dm6ol1d3wbk0","created":1792196350625,"text":"心肌细胞的生物电现象","layout":null},"children":[{"data":{"id":"dm6ol9gjivs0","created":1792196368247,"text":"心室肌细胞","layout":null},"children":[{"data":{"id":"dm6olf14ns00","created":1792196380376,"text":"静息电位","layout":null},"children":[{"data":{"id":"dm6ols48mbs0","created":1792196408862,"text":"是细胞膜内外两侧的电位差","layout":null},"children":[]},{"data":{"id":"dm6om0320ag0","created":1792196426205,"text":"形成基础：离子分布不均，膜对K⁺的选择性通透","layout":null},"children":[]},{"data":{"id":"dm6omtoe9rk0","created":1792196490622,"text":"k+外流为主因，\n心室肌静息电位约 -90 mV，\n接近K⁺平衡电位","font-weight":"bold","layout":null},"children":[]},{"data":{"id":"dm6onorntuo0","created":1792196558299,"text":"注意：内向整流钾离子通道IK1","resource":["！"],"progress":9,"color":"#ff0000","font-weight":"bold","background":"#ffff00","layout":null},"children":[{"data":{"id":"dm6op12dzzc0","created":1792196663433,"text":"作用：稳定心室肌静息电位的重要k+电流","font-weight":"bold","layout":null},"children":[]},{"data":{"id":"dm6opfwvh9k0","created":1792196695752,"text":"内向整流并非k+内流，\n而是强调在去极化时减少k+外流\n（当膜电位去极化（膜电位正值）时，\n胞内镁离子与多胺堵塞通道孔道，\n抑制K⁺外向外流）","font-weight":"bold","color":"#ff0000","background":"#c6d9f1","layout":null},"children":[]}]}]},{"data":{"id":"dm6oqlqkghs0","created":1792196786795,"text":"动作电位","layout":null,"image":"https://p.cldisk.com/star4/6ab729c0e3d9f8e20cb344e75b00101b/origin.png","imageTitle":"","imageSize":{"width":200,"height":171}},"children":[{"data":{"id":"dm6oqs6xno00","created":1792196800846,"text":"0期：快速去极化","layout":null},"children":[{"data":{"id":"dm6or1k4xao0","created":1792196821235,"text":"关键词：快Na⁺内流","layout":null},"children":[]},{"data":{"id":"dm6ouasssmg0","created":1792197076442,"text":"主要事件：快Na+通道开放，形成快速去极化","font-weight":"bold","layout":null},"children":[]},{"data":{"id":"dm6ouppe6ig0","created":1792197108888,"text":"特点：时间短、幅度大、速度快","layout":null},"children":[]},{"data":{"id":"dm6ov29de9c0","created":1792197136217,"text":"过程：\n刺激\n→阈电位（约-70mV）\n→快Na⁺通道激活\n→ Na⁺再生性内流\n→ 膜电位快速上升","layout":null},"children":[]},{"data":{"id":"dm6ow67nvdc0","created":1792197223185,"text":"0期上升速度与幅度决定了局部电流的强度","font-weight":"bold","note":"（可兴奋细胞达到阈电位后形成的正反馈式Na⁺内流：去极化本身打开更多电压门控钠通道，钠内流进一步加强去极化，形成自我放大的正反馈过程，也就是再生机制，最终爆发动作电位上升支）","layout":null},"children":[]},{"data":{"id":"dm6owpxtwog0","created":1792197266127,"text":"钠通道的特征","layout":null},"children":[{"data":{"id":"dm6owwisacg0","created":1792197280454,"text":"①激活、失活、复活快\n②对钠离子有高度的选择性\n③电压和时间依赖性，阈电位TP：-70mV\n④阻断剂：河豚毒素TTX","layout":null},"children":[]}]}]},{"data":{"id":"dm6oqu14nn40","created":1792196804848,"text":"1期:快速复极初期","layout":null},"children":[{"data":{"id":"dm6ortn4zn40","created":1792196882366,"text":"关键词：Ito介导K⁺短暂外流","layout":null},"children":[]},{"data":{"id":"dm6oz37ws680","created":1792197451763,"text":"过程：\n--快Na⁺通道迅速失活，内向电流减少\n—Ito（瞬时外向钾电流）开放，K⁺短暂外流\n--膜电位出现早期快速复极，即动作电位“切迹”","font-weight":"bold","layout":null},"children":[]}]},{"data":{"id":"dm6oqvgs2g00","created":1792196807971,"text":"2期：平台期","layout":null},"children":[{"data":{"id":"dm6osdjtwyo0","created":1792196925702,"text":"Ca²⁺内流 VS K⁺外流","layout":null},"children":[]},{"data":{"id":"dm6oxtxevjc0","created":1792197353173,"text":"过程：\nL（long-casting）型Ca²⁺通道开放，Ca²⁺缓慢进入细胞\n--K⁺外流（Ik和Ik1）同时存在，二者一段时间内相互对抗\n--平台期延长AP时程，也延长有效不应期\n--Ca²⁺内流同时是兴奋-收缩耦联的重要触发","font-weight":"bold","layout":null},"children":[]},{"data":{"id":"dm6ph4ljkyw0","created":1792198865319,"text":"关于K的两个通道","layout":null},"children":[{"data":{"id":"dm6phf9h74o0","created":1792198888534,"text":"(Ik1的开放程度仅有静息时的1/5~1/6，\n去极化其开放程度降低，越极化开放程度越高)","layout":null},"children":[]},{"data":{"id":"dm6phf9hpzs0","created":1792198888535,"text":"Ik是延迟整流，平台期快结束时，Ik才打开","layout":null},"children":[]}]},{"data":{"id":"dm6pi05v22o0","created":1792198934028,"text":"分支主题"},"children":[]}]},{"data":{"id":"dm6ot68gfiw0","created":1792196988141,"text":"3期：快速复极末期","layout":null},"children":[{"data":{"id":"dm6otk0z8nc0","created":1792197018164,"text":"K⁺外流增强","layout":null},"children":[]}]},{"data":{"id":"dm6otqwoa7k0","created":1792197033141,"text":"4期：静息期","layout":null},"children":[{"data":{"id":"dm6ottzed9c0","created":1792197039836,"text":"离子梯度恢复，电位稳定","layout":null},"children":[]}]}]}]}]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}