{"root":{"data":{"id":"dmd2g10iwow0","created":1792844813322,"text":"缺血-再灌注损伤"},"children":[{"data":{"id":"dmd2h5460fs0","created":1792844900614,"text":"1.概念IR/I","layout":null},"children":[{"data":{"id":"dmd2mvbvfa80","created":1792845349497,"text":"组织缺血一段时间，当血流重新恢复后，\n组织器官的结构损伤和功能障碍不但不能恢复，\n反而进一步加重的现象","layout":null},"children":[]},{"data":{"id":"dmd2vaopnq80","created":1792846009838,"text":"发生的场景","layout":null},"children":[{"data":{"id":"dmd2viagsw80","created":1792846026391,"text":"缺血的场景","layout":null},"children":[{"data":{"id":"dmd2vljpnlk0","created":1792846033480,"text":"组织/器官局部缺血：脑梗，心梗，胃肠道、肝、肾等其他器官缺血","layout":null},"children":[]},{"data":{"id":"dmd2wiwklw80","created":1792846106092,"text":"组织/器官整体缺血：器官移植、断指、断肢","layout":null},"children":[]},{"data":{"id":"dmd2x1j995c0","created":1792846146645,"text":"全身缺血：心衰、休克、心跳骤停","layout":null},"children":[]}]},{"data":{"id":"dmd2xeti2e00","created":1792846175563,"text":"再灌注的手段","layout":null},"children":[{"data":{"id":"dmd2xnpl8bk0","created":1792846194918,"text":"溶栓、支架、搭桥","layout":null},"children":[]},{"data":{"id":"dmd2xsbhuwg0","created":1792846204949,"text":"电除颤、心肺复苏","layout":null},"children":[]},{"data":{"id":"dmd2xvwrq2o0","created":1792846212766,"text":"器官植入、断指断肢再植","layout":null},"children":[]}]}]},{"data":{"id":"dmd2y4hhtm00","created":1792846231433,"text":"影响因素","layout":null},"children":[{"data":{"id":"dmd2y7atidc0","created":1792846237560,"text":"组织器官结构和代谢特点","layout":null},"children":[{"data":{"id":"dmd2ybb0t480","created":1792846246280,"text":"（1）缺血时间和程度","layout":null},"children":[]},{"data":{"id":"dmd2yfflvzc0","created":1792846255265,"text":"（2）侧支循环","layout":null},"children":[]},{"data":{"id":"dmd2yl7wveg0","created":1792846267859,"text":"（3）对氧的需求程度","layout":null},"children":[]},{"data":{"id":"dmd2ytkv1uw0","created":1792846286057,"text":"（4）再灌注条件","layout":null},"children":[{"data":{"id":"dmd33062ycg0","created":1792846613857,"text":"降低压力/温度/pH值\n/Ca2+、Na+浓度可缓解IR/I","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dmd2h931g800","created":1792844909253,"text":"2.发生机制","layout":null},"children":[{"data":{"id":"dmd34d4j1lk0","created":1792846720425,"text":"(一）活性氧增多","layout":null},"children":[{"data":{"id":"dmd35205mps0","created":1792846774581,"text":"什么是活性氧？","layout":null},"children":[{"data":{"id":"dmd35ebgd5k0","created":1792846801385,"text":"ROS：指化学性质活泼的含氧代谢物，有氧化作用","layout":null},"children":[]},{"data":{"id":"dmd3766b7080","created":1792846940388,"text":"如：氧自由基、过氧化氢、脂质过氧化物及其裂解产物、单线态氧","layout":null},"children":[]}]},{"data":{"id":"dmd37th3g480","created":1792846991106,"text":"增多的机制","layout":null},"children":[{"data":{"id":"dmd37ydbzzc0","created":1792847001763,"text":"线粒体生成ROS增加","layout":null},"children":[{"data":{"id":"dmd3d3bnctc0","created":1792847404367,"text":"Ca2+ 超载 → 线粒体呼吸链受损\n → 电子漏↑ → O₂单电子还原 \n→ O2-（ROS）↑ \n→ 氧化应激、细胞损伤（凋亡 / 坏死）","layout":null},"children":[]}]},{"data":{"id":"dmd382ewos00","created":1792847010565,"text":"血管内皮细胞内黄嘌呤氧化酶XO增加","layout":null,"image":"https://p.cldisk.com/star4/504468fe4da4c4d1944ac543a8a96238/origin.png","imageTitle":"","imageSize":{"width":200,"height":95}},"children":[]},{"data":{"id":"dmd38f9lbso0","created":1792847038542,"text":"儿茶酚胺自身氧化","layout":null},"children":[{"data":{"id":"dmd3fo484540","created":1792847606358,"text":"缺血缺氧\n→交感-肾上腺髓质系统兴奋\n→儿茶酚胺分泌增多\n→再灌注时氧化产生活性氧","layout":null},"children":[]}]},{"data":{"id":"dmd38iarr680","created":1792847045143,"text":"体内活性氧的清除能力下降","layout":null},"children":[{"data":{"id":"dmd3gxfffy00","created":1792847704990,"text":"体内两大抗氧化防御系统","layout":null},"children":[{"data":{"id":"dmd3h36iecw0","created":1792847717512,"text":"酶性抗氧化剂：\nSOD、过氧化氢酶、谷胱甘肽过氧化物酶\nGSH硫转移酶","layout":null},"children":[]},{"data":{"id":"dmd3h98xj6o0","created":1792847730719,"text":"非酶性抗氧化剂：\n维生素A/E/C、谷胱甘肽、\n白蛋白、铜蓝蛋白","layout":null},"children":[]}]}]}]},{"data":{"id":"dmd3iw7whjk0","created":1792847859087,"text":"活性氧如何导致细胞损伤？","layout":null},"children":[{"data":{"id":"dmd3j2ktj8o0","created":1792847872928,"text":"①膜脂质过氧化","layout":null},"children":[]},{"data":{"id":"dmd3j8eivjs0","created":1792847885608,"text":"②蛋白质功能抑制","layout":null},"children":[]},{"data":{"id":"dmd3qx70kcw0","created":1792848488123,"text":"③核酸及染色体破坏","layout":null},"children":[]}]}]},{"data":{"id":"dmd34jmyknc0","created":1792846734601,"text":"（二）钙超载","layout":null},"children":[{"data":{"id":"dmd3r8o25aw0","created":1792848513098,"text":"什么是钙超载？","layout":null},"children":[{"data":{"id":"dmd3rbrib2o0","created":1792848519837,"text":"各种原因引起细胞内钙含量异常增多，\n导致细胞结构损伤和功能代谢障碍，\n甚至细胞死亡的现象","layout":null},"children":[]}]},{"data":{"id":"dmd3scfxctk0","created":1792848599678,"text":"钙超载如何发生？","layout":null},"children":[{"data":{"id":"dmd435bek8w0","created":1792849446173,"text":"摄取增加","layout":null},"children":[{"data":{"id":"dmd3shf65nc0","created":1792848610516,"text":"①细胞膜通透性增加","layout":null},"children":[]},{"data":{"id":"dmd43f42ga80","created":1792849467497,"text":"②肌浆网钙释放增加","layout":null},"children":[]},{"data":{"id":"dmd43mh9s140","created":1792849483533,"text":"③Na⁺-Ca²⁺交换体反向激活","layout":null},"children":[{"data":{"id":"dmd4452irdk0","created":1792849524000,"text":"生理状态下，1个Ca2+排出至胞外,\n3个Na+转移至胞内","layout":null},"children":[]},{"data":{"id":"dmd44mubfq80","created":1792849562686,"text":"缺血再灌注时：\n缺血时 ATP 不足，Na⁺-K⁺-ATP 酶失活\n→ 胞内 Na⁺蓄积；\n再灌注时，Na⁺-Ca²⁺交换载体反转方向，\n不再是 Ca²⁺出、Na⁺进，而是Na⁺外流、Ca²⁺大量内流","layout":null},"children":[]}]}]},{"data":{"id":"dmd45lw43280","created":1792849638982,"text":"排出减少","layout":null},"children":[{"data":{"id":"dmd3sna207k0","created":1792848623267,"text":"①ATP依赖性离子泵功能障碍","layout":null},"children":[]},{"data":{"id":"dmdgzebnr4w0","created":1792885826751,"text":"②肌浆网摄取障碍","layout":null},"children":[]}]},{"data":{"id":"dmdh0we87co0","created":1792885944453,"text":"儿茶酚胺增多","layout":null},"children":[{"data":{"id":"dmdh1szk5ts0","created":1792886015400,"text":"①激动α₁受体：激活 PLC，PIP₂水解产生 IP₃和 DG；\nIP₃促使肌浆网释放 Ca²⁺；\nDG 激活 PKC，促进 Na⁺-H⁺交换，\n胞内 Na⁺升高，Na⁺-Ca²⁺交换反向转运，Ca²⁺内流增多；","layout":null},"children":[]},{"data":{"id":"dmdh2coz9ds0","created":1792886058296,"text":"②激动β 受体：开放电压门控钙通道，胞外 Ca²⁺内流增加；","layout":null},"children":[]},{"data":{"id":"dmdh2p13r0g0","created":1792886085151,"text":"③同时ATP 生成不足，钙泵功能障碍，胞质 Ca²⁺排出、回收减少，最终导致钙超载","layout":null},"children":[]}]}]},{"data":{"id":"dmdh3fs9ww00","created":1792886143389,"text":"钙超载损伤细胞的机制‘","layout":null},"children":[{"data":{"id":"dmdh3lmss7k0","created":1792886156119,"text":"损伤线粒体功能及结构","layout":null},"children":[{"data":{"id":"dmdh3r0i2rs0","created":1792886167831,"text":"ATP产生减少（通过形成磷酸钙）","layout":null},"children":[]},{"data":{"id":"dmdh41n6k3k0","created":1792886190971,"text":"线粒体通透性转运孔mPTP开放","layout":null},"children":[]}]},{"data":{"id":"dmdh4e1l0og0","created":1792886217963,"text":"激活钙依赖蛋白酶","layout":null},"children":[{"data":{"id":"dmdh4likh9c0","created":1792886234227,"text":"磷脂酶、钙蛋白酶等","layout":null},"children":[]}]},{"data":{"id":"dmdh4rpk30g0","created":1792886247711,"text":"促进ROS生成","layout":null},"children":[{"data":{"id":"dmdh4w48o3s0","created":1792886257306,"text":"通过增加黄嘌呤氧化酶活性","layout":null},"children":[]}]},{"data":{"id":"dmdh54gei0o0","created":1792886275455,"text":"心肌钙超载诱发心律失常","layout":null},"children":[]}]}]},{"data":{"id":"dmd34n0hm4g0","created":1792846741949,"text":"（三）白细胞聚集","layout":null},"children":[{"data":{"id":"dmdh5cjhzdc0","created":1792886293057,"text":"什么是白细胞聚集？","layout":null},"children":[{"data":{"id":"dmdh5hnyuqg0","created":1792886304211,"text":"缺血组织代谢物与组织碎片触发炎症反应，\n趋化白细胞浸润至缺血组织或粘附于血管内皮细胞的现象","layout":null},"children":[]},{"data":{"id":"dmdh7nc3kbc0","created":1792886473282,"text":"以中性粒细胞为代表的免疫细胞大量粘附、浸润、聚集","layout":null},"children":[]}]},{"data":{"id":"dmdh6dg7qbs0","created":1792886373399,"text":"发生机制","layout":null},"children":[{"data":{"id":"dmdh6f8kmqw0","created":1792886377291,"text":"缺血导致的代谢产物蓄积和组织碎片引起急性炎症反应","layout":null},"children":[]},{"data":{"id":"dmdh6wfjrzc0","created":1792886414718,"text":"再灌注时，氧供和营养恢复，白细胞进入组织，\n从而加重炎症","layout":null},"children":[]}]},{"data":{"id":"dmdh7jeqrxs0","created":1792886464735,"text":"引起损伤的机制","layout":null},"children":[{"data":{"id":"dmdh88a13nc0","created":1792886518870,"text":"产生大量ROS(呼吸爆发)","layout":null},"children":[]},{"data":{"id":"dmdh8ejpddk0","created":1792886532515,"text":"加剧血管内皮损伤（炎性因子）","layout":null},"children":[]},{"data":{"id":"dmdh8nubuqo0","created":1792886552749,"text":"诱发微循环障碍（无复流现象）","layout":null},"children":[{"data":{"id":"dmdh93qqcvs0","created":1792886587360,"text":"无复流现象恢复血液灌注后，缺血区\n依然得不到充分血流灌注的现象","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dmd2hcjo8mw0","created":1792844916789,"text":"3.机体的功能、代谢变化","layout":null},"children":[{"data":{"id":"dmdha9vofmo0","created":1792886679084,"text":"心肌的缺血-再灌注损伤"},"children":[{"data":{"id":"dmdhah6is1k0","created":1792886694977,"text":"（1）心肌舒/缩功能下降"},"children":[]},{"data":{"id":"dmdhar1vsdc0","created":1792886716464,"text":"（2）心律失常"},"children":[]},{"data":{"id":"dmdhaub92hk0","created":1792886723561,"text":"（3）心肌细胞线粒体肿胀、\n肌丝断裂、甚至凋亡","layout":null},"children":[]},{"data":{"id":"dmdhbm230kg0","created":1792886783956,"text":"心肌顿抑"},"children":[{"data":{"id":"dmdhbsa94u00","created":1792886797511,"text":"心肌经短暂缺血并恢复供血后，在较长一段时间内处于\n“低功能状态”，常需要数小时或数天才可恢复正常功能","layout":null},"children":[]}]}]},{"data":{"id":"dmdhcufhvhc0","created":1792886880546,"text":"脑的缺血-再灌注损伤"},"children":[{"data":{"id":"dmdhd1mclvk0","created":1792886896198,"text":"脑水肿、神经元坏死"},"children":[]},{"data":{"id":"dmdhd7dl2f40","created":1792886908729,"text":"ROS诱发脂质过氧化"},"children":[]}]},{"data":{"id":"dmdhdzkv11c0","created":1792886970118,"text":"肠的缺血-再灌注损伤 "},"children":[{"data":{"id":"dmdhe8nqp400","created":1792886989884,"text":"黄嘌呤酶活性高\n→缺血时产生大量自由基\n→粘膜上皮细胞损伤、\n\t炎性细胞浸润"},"children":[]}]},{"data":{"id":"dmdhfmyzv4g0","created":1792887099403,"text":"肾、肺、肝"},"children":[{"data":{"id":"dmdhgz2gmu80","created":1792887204098,"text":"肾损伤主要表现：肾小管上皮细胞线粒体\n的损伤，导致急性肾小管坏死。"},"children":[]},{"data":{"id":"dmdhgz2g8rk0","created":1792887204098,"text":"肺损伤主要表现：肺毛细血管内皮细胞\n线粒体肿胀、嵴消失，肺水肿。"},"children":[]},{"data":{"id":"dmdhgz2gasg0","created":1792887204098,"text":"肝损伤主要表现：肝细胞线粒体\n肿胀、嵴消失，肝功能不全。","layout":null},"children":[]}]}]},{"data":{"id":"dmd2hk5l18o0","created":1792844933351,"text":"4.防治","layout":null},"children":[{"data":{"id":"dmdhhfitgb40","created":1792887239916,"text":"病理生理基础"},"children":[{"data":{"id":"dmdhhiqjgds0","created":1792887246913,"text":"①首要：消除缺血原因，尽早恢复血流"},"children":[]},{"data":{"id":"dmdhhrqrfio0","created":1792887266518,"text":"②控制再灌流条件：低P/T/pH/Na+/钙灌流液"},"children":[]},{"data":{"id":"dmdhikk5ufc0","created":1792887329245,"text":"③补充能量、抗氧化剂、钙拮抗剂、抗炎"},"children":[]}]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}