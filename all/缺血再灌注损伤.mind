{"root":{"data":{"id":"dmd2g10iwow0","created":1792844813322,"text":"缺血-再灌注损伤"},"children":[{"data":{"id":"dmd2h5460fs0","created":1792844900614,"text":"1.概念IR/I","layout":null},"children":[{"data":{"id":"dmd2mvbvfa80","created":1792845349497,"text":"组织缺血一段时间，当血流重新恢复后，\n组织器官的结构损伤和功能障碍不但不能恢复，\n反而进一步加重的现象","layout":null},"children":[]},{"data":{"id":"dmd2vaopnq80","created":1792846009838,"text":"发生的场景"},"children":[{"data":{"id":"dmd2viagsw80","created":1792846026391,"text":"缺血的场景"},"children":[{"data":{"id":"dmd2vljpnlk0","created":1792846033480,"text":"分支主题"},"children":[]}]}]}]},{"data":{"id":"dmd2h931g800","created":1792844909253,"text":"2.发生机制","layout":null},"children":[]},{"data":{"id":"dmd2hcjo8mw0","created":1792844916789,"text":"3.机体的功能、代谢变化","layout":null},"children":[]},{"data":{"id":"dmd2hk5l18o0","created":1792844933351,"text":"4.防治","layout":null},"children":[]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}