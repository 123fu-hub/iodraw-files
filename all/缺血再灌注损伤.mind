{"root":{"data":{"id":"dmd2g10iwow0","created":1792844813322,"text":"缺血-再灌注损伤"},"children":[{"data":{"id":"dmd2h5460fs0","created":1792844900614,"text":"1.概念IR/I","layout":null},"children":[{"data":{"id":"dmd2mvbvfa80","created":1792845349497,"text":"组织缺血一段时间，当血流重新恢复后，\n组织器官的结构损伤和功能障碍不但不能恢复，\n反而进一步加重的现象","layout":null},"children":[]},{"data":{"id":"dmd2vaopnq80","created":1792846009838,"text":"发生的场景","layout":null},"children":[{"data":{"id":"dmd2viagsw80","created":1792846026391,"text":"缺血的场景","layout":null},"children":[{"data":{"id":"dmd2vljpnlk0","created":1792846033480,"text":"组织/器官局部缺血：脑梗，心梗，胃肠道、肝、肾等其他器官缺血","layout":null},"children":[]},{"data":{"id":"dmd2wiwklw80","created":1792846106092,"text":"组织/器官整体缺血：器官移植、断指、断肢","layout":null},"children":[]},{"data":{"id":"dmd2x1j995c0","created":1792846146645,"text":"全身缺血：心衰、休克、心跳骤停","layout":null},"children":[]}]},{"data":{"id":"dmd2xeti2e00","created":1792846175563,"text":"再灌注的手段","layout":null},"children":[{"data":{"id":"dmd2xnpl8bk0","created":1792846194918,"text":"溶栓、支架、搭桥","layout":null},"children":[]},{"data":{"id":"dmd2xsbhuwg0","created":1792846204949,"text":"电除颤、心肺复苏","layout":null},"children":[]},{"data":{"id":"dmd2xvwrq2o0","created":1792846212766,"text":"器官植入、断指断肢再植","layout":null},"children":[]}]}]},{"data":{"id":"dmd2y4hhtm00","created":1792846231433,"text":"影响因素","layout":null},"children":[{"data":{"id":"dmd2y7atidc0","created":1792846237560,"text":"组织器官结构和代谢特点","layout":null},"children":[{"data":{"id":"dmd2ybb0t480","created":1792846246280,"text":"（1）缺血时间和程度","layout":null},"children":[]},{"data":{"id":"dmd2yfflvzc0","created":1792846255265,"text":"（2）侧支循环","layout":null},"children":[]},{"data":{"id":"dmd2yl7wveg0","created":1792846267859,"text":"（3）对氧的需求程度","layout":null},"children":[]},{"data":{"id":"dmd2ytkv1uw0","created":1792846286057,"text":"（4）再灌注条件","layout":null},"children":[{"data":{"id":"dmd33062ycg0","created":1792846613857,"text":"降低压力/温度/pH值\n/Ca2+、Na+浓度可缓解IR/I","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dmd2h931g800","created":1792844909253,"text":"2.发生机制","layout":null},"children":[{"data":{"id":"dmd34d4j1lk0","created":1792846720425,"text":"(一）活性氧增多"},"children":[{"data":{"id":"dmd35205mps0","created":1792846774581,"text":"分支主题"},"children":[]}]},{"data":{"id":"dmd34jmyknc0","created":1792846734601,"text":"（二）钙超载"},"children":[]},{"data":{"id":"dmd34n0hm4g0","created":1792846741949,"text":"（三）白细胞聚集"},"children":[]}]},{"data":{"id":"dmd2hcjo8mw0","created":1792844916789,"text":"3.机体的功能、代谢变化","layout":null},"children":[]},{"data":{"id":"dmd2hk5l18o0","created":1792844933351,"text":"4.防治","layout":null},"children":[]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}