{"root":{"data":{"id":"dmdii1yjqbk0","created":1792890109866,"text":"心功能不全"},"children":[{"data":{"id":"dmdinz37me80","created":1792890573803,"text":"1.病因及分类","layout":null},"children":[{"data":{"id":"dmdiop34ulc0","created":1792890630394,"text":"什么是心功能不全/心衰？","layout":null},"children":[{"data":{"id":"dmdip7180hk0","created":1792890669461,"text":"心功能不全","layout":null},"children":[{"data":{"id":"dmdipi60sa80","created":1792890693696,"text":"由于心脏舒缩功能降低或心室充盈受限\n导致的心脏泵血功能降低。\n包括代偿期和失代偿期","layout":null,"color":"#ff0000","background":"#daeef3","font-weight":"bold"},"children":[]}]},{"data":{"id":"dmdiqkp89co0","created":1792890777575,"text":"心力衰竭","layout":null},"children":[{"data":{"id":"dmdiqn4lk4g0","created":1792890782858,"text":"在有足够循环血量的情况下，由于心脏舒缩功能障碍，\n导致心排血量绝对/相对不足，不能满足机体代谢需要\n而导致的以循环功能为主的综合征。\n是心功能不全的失代偿期","layout":null,"font-weight":"bold","color":"#ff0000","background":"#daeef3"},"children":[]}]}]},{"data":{"id":"dmdisgew7s00","created":1792890924971,"text":"心力衰竭如何分类？","layout":null},"children":[{"data":{"id":"dmdisrqrvf40","created":1792890949634,"text":"按部位","layout":null},"children":[{"data":{"id":"dmdisthhy200","created":1792890953427,"text":"左心衰","layout":null},"children":[]},{"data":{"id":"dmdisv5hl6g0","created":1792890957054,"text":"右心衰","layout":null},"children":[]},{"data":{"id":"dmdiswl8ye80","created":1792890960184,"text":"全心衰","layout":null},"children":[]}]},{"data":{"id":"dmdit7i3qag0","created":1792890983938,"text":"按心输出量","layout":null},"children":[{"data":{"id":"dmdita0yet40","created":1792890989432,"text":"低输出量型心衰","layout":null},"children":[]},{"data":{"id":"dmditfdusew0","created":1792891001096,"text":"高输出量型心衰","layout":null},"children":[]}]},{"data":{"id":"dmditnb53o80","created":1792891018346,"text":"按速度","layout":null},"children":[{"data":{"id":"dmditoef2bc0","created":1792891020721,"text":"急性心衰","layout":null},"children":[]},{"data":{"id":"dmditq2cys80","created":1792891024345,"text":"慢性心衰","layout":null},"children":[]}]},{"data":{"id":"dmditsq7fo80","created":1792891030141,"text":"按发生机制\n（收缩/舒张障碍）","layout":null},"children":[{"data":{"id":"dmdiu2pb8480","created":1792891051854,"text":"收缩功能障碍型心衰","layout":null},"children":[]},{"data":{"id":"dmdiu7305n40","created":1792891061389,"text":"舒张功能障碍性心衰","layout":null},"children":[]},{"data":{"id":"dmdiuaubrk00","created":1792891069572,"text":"混合型心衰","layout":null},"children":[]}]},{"data":{"id":"dmdiufu6mk00","created":1792891080447,"text":"按左室射血分数LVEF\n（每搏输出量占心室舒张末期容积量的百分比）\n（安静状态下约55~65%）","color":"#ff0000","font-weight":"bold","background":"#ffff00","layout":null},"children":[{"data":{"id":"dmdivg2dt800","created":1792891159307,"text":"（1）射血分数降低型心衰HFrEF","layout":null},"children":[{"data":{"id":"dmdj6ifvf6o0","created":1792892026482,"text":"EF＜40%","layout":null},"children":[]},{"data":{"id":"dmdj6n08oi00","created":1792892036421,"text":"收缩性HF，有效治疗已得到证实","layout":null},"children":[]}]},{"data":{"id":"dmdivrofhds0","created":1792891184585,"text":"（2）射血分数保留型心衰HFpEF","layout":null},"children":[{"data":{"id":"dmdj70x9hls0","created":1792892066716,"text":"EF≥50%","layout":null},"children":[]},{"data":{"id":"dmdj90tk4ew0","created":1792892223220,"text":"舒张性HF，有效治疗尚不明确","layout":null},"children":[]}]},{"data":{"id":"dmdj3j0hyls0","created":1792891792637,"text":"a.HFmrEF（射血分数轻度降低）","layout":null},"children":[{"data":{"id":"dmdj70x9hls0","created":1792892066716,"text":"EF：41~49%","layout":null},"children":[]},{"data":{"id":"dmdja4bd9tc0","created":1792892309191,"text":"患者特征、治疗方式与预后有HFpEF相似","layout":null},"children":[]}]},{"data":{"id":"dmdj44k0enk0","created":1792891839529,"text":"b.HFimpEF（射血分数改善）","layout":null},"children":[{"data":{"id":"dmdjauvu59c0","created":1792892367025,"text":"EF＞40%","layout":null},"children":[]},{"data":{"id":"dmdjazm875k0","created":1792892377328,"text":"HFpEF患者亚组过去曾有HFrEF","layout":null},"children":[]},{"data":{"id":"dmdjbgf0b9s0","created":1792892413897,"text":"这些EF改善或恢复的患者临床上\n与持续保留或EF降低的患者不同","layout":null},"children":[]}]}]},{"data":{"id":"dmdjd98kquw0","created":1792892554999,"text":"发展","layout":null},"children":[{"data":{"id":"dmdjddrehnk0","created":1792892564845,"text":"急性心衰缓解，到慢性心衰","layout":null},"children":[]},{"data":{"id":"dmdjdnj4h1s0","created":1792892586112,"text":"稳定性心衰恶化，发展为急性失代偿性“新发心衰”","layout":null},"children":[]}]},{"data":{"id":"dmdjeiw0b1s0","created":1792892654371,"text":"分期","layout":null},"children":[{"data":{"id":"dmdjek62t680","created":1792892657157,"text":"NYHA心功能分级：\n进行风险评估","layout":null},"children":[{"data":{"id":"dmdjhkbilgw0","created":1792892892578,"text":"- Ⅰ 级：日常活动不受限","layout":null},"children":[]},{"data":{"id":"dmdjhkbiqso0","created":1792892892578,"text":"- Ⅱ 级：日常活动出现症状","layout":null},"children":[]},{"data":{"id":"dmdjhkbiyoo0","created":1792892892579,"text":"- Ⅲ 级：低于日常活动就有症状","layout":null},"children":[]},{"data":{"id":"dmdjhkbiwm80","created":1792892892579,"text":"- Ⅳ 级：静息状态也有症状","layout":null},"children":[]}]},{"data":{"id":"dmdjh9b8ktc0","created":1792892868617,"text":"ACC/AHA心衰分期：","layout":null},"children":[{"data":{"id":"dmdji2xlwio0","created":1792892933097,"text":"- A 期：有因无果——有心衰危险因素（高血压、糖尿病等），\n但心脏结构正常、无任何心脏病变","layout":null},"children":[]},{"data":{"id":"dmdji2xmhyw0","created":1792892933097,"text":"- B 期：有因有果无症状——已经出现心脏结构损伤（心梗、左室肥厚等），\n但从来没有心衰症状","layout":null},"children":[]},{"data":{"id":"dmdji2xmmbk0","created":1792892933097,"text":"- C 期：有因有果有症状——有心脏结构改变，既往 / 现在存在心衰症状\n（这一期的患者，同时可以用 NYHA Ⅰ~Ⅳ 去评估活动能力）","layout":null},"children":[]},{"data":{"id":"dmdji2xmbv40","created":1792892933097,"text":"- D 期：有因有果有症状，难治、需要特殊治疗\n——终末期顽固性心衰，休息时也有症状，反复住院","layout":null},"children":[]}]}]}]},{"data":{"id":"dmdjjqyp6i00","created":1792893063769,"text":"心功能不全的病因与\n心力衰竭的诱因","layout":null},"children":[{"data":{"id":"dmdjk731fds0","created":1792893098860,"text":"病因：影响心室射血和/或充盈的\n任何结构性及功能性病变","layout":null},"children":[{"data":{"id":"dmdjkpnwlo80","created":1792893139304,"text":"（1）心肌受损","layout":null},"children":[{"data":{"id":"dmdjkta7q740","created":1792893147183,"text":"原发性：心肌炎、心肌病、心肌梗死","layout":null},"children":[]},{"data":{"id":"dmdjkv7tswg0","created":1792893151392,"text":"继发性：缺血、缺氧；冠心病；糖尿病","layout":null},"children":[]}]},{"data":{"id":"dmdjlj10cco0","created":1792893203223,"text":"（2）心脏负荷过重","layout":null},"children":[{"data":{"id":"dmdjluxcpb40","created":1792893229123,"text":"容量负荷过重：动脉瓣关闭不全（血倒流回心室）；\n甲亢（代谢旺盛，回心血量增加）；\n慢性贫血（血液携氧低，机体代偿性增加血量）","layout":null},"children":[]},{"data":{"id":"dmdjmaxy9mo0","created":1792893263988,"text":"压力负荷过重：高血压、肺动脉高压、肺栓塞","layout":null},"children":[]}]},{"data":{"id":"dmdjo7d4cm00","created":1792893412926,"text":"（3）心脏舒张充盈障碍","layout":null},"children":[{"data":{"id":"dmdjodghilc0","created":1792893426190,"text":"心包疾患（心包积液、缩窄性心包炎）","layout":null},"children":[]},{"data":{"id":"dmdjomjgxc80","created":1792893445962,"text":"限制性心肌病","layout":null},"children":[]},{"data":{"id":"dmdjor3ydcg0","created":1792893455907,"text":"房室瓣（二/三尖瓣）狭窄","layout":null},"children":[]},{"data":{"id":"dmdjozlqt1s0","created":1792893474397,"text":"心肌顺应性降低","layout":null},"children":[]}]},{"data":{"id":"dmdjqwa3nwg0","created":1792893623891,"text":"（4）心律失常","layout":null},"children":[{"data":{"id":"dmdjr294oi00","created":1792893636893,"text":"降低心脏冲动的形成和传导异常","layout":null},"children":[]},{"data":{"id":"dmdjrgrv9fk0","created":1792893668501,"text":"如：心动过速/缓，频发性期前收缩，传导阻滞，室颤","layout":null},"children":[]}]}]},{"data":{"id":"dmdjs7oq1680","created":1792893727084,"text":"心衰的诱因","layout":null},"children":[{"data":{"id":"dmdjsa7piu80","created":1792893732586,"text":"（1）感染","layout":null},"children":[{"data":{"id":"dmdjsd1rw880","created":1792893738757,"text":"发热时代谢增高","layout":null},"children":[]},{"data":{"id":"dmdjsh715a80","created":1792893747782,"text":"心率加快，冠脉供血减少","layout":null},"children":[]},{"data":{"id":"dmdjsq5hbw00","created":1792893767280,"text":"内毒素直接损伤心肌","layout":null},"children":[]},{"data":{"id":"dmdjsxtsm340","created":1792893783987,"text":"呼吸道感染加重右心负荷","layout":null},"children":[]}]},{"data":{"id":"dmdjtecs4q00","created":1792893819964,"text":"（2）酸碱平衡及电解质代谢紊乱","layout":null},"children":[{"data":{"id":"dmdjtnrjr8g0","created":1792893840448,"text":"过快和过量输液","layout":null},"children":[]},{"data":{"id":"dmdjtsxf2so0","created":1792893851687,"text":"高钾血症/低钾血症","layout":null},"children":[]},{"data":{"id":"dmdjtwlqank0","created":1792893859687,"text":"酸中毒","layout":null},"children":[]}]},{"data":{"id":"dmdju0fiurs0","created":1792893868019,"text":"（3）心律失常、快速型心律失常","layout":null},"children":[{"data":{"id":"dmdju8ife6g0","created":1792893885609,"text":"冠脉灌流减少；心肌耗氧增加","layout":null},"children":[]}]},{"data":{"id":"dmdk5veb8y80","created":1792894797432,"text":"（4）妊娠与分娩","layout":null},"children":[]},{"data":{"id":"dmdk600f1g00","created":1792894807475,"text":"（5）其他因素","layout":null},"children":[{"data":{"id":"dmdk62in8js0","created":1792894812931,"text":"衰老、过劳、情绪激动","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dmdio652fs00","created":1792890589152,"text":"2.发生机制","layout":null},"children":[{"data":{"id":"dmdk6d5xt6o0","created":1792894836107,"text":"心功能不全时机体如何进行代偿","layout":null},"children":[{"data":{"id":"dmdk6kmyuog0","created":1792894852375,"text":"心泵功能障碍\n→心输出量⬇\n→组织供血⬇\n→神经-体液调节；心脏本身的代偿；心外反应","layout":null},"children":[]},{"data":{"id":"dmdk7g7iwj40","created":1792894921099,"text":"（1）神经-体液调节机制","layout":null,"image":"https://p.cldisk.com/star4/fea54d68c0d12e5783b678f1dcbf7fa7/origin.png","imageTitle":"","imageSize":{"width":200,"height":127}},"children":[{"data":{"id":"dmdk7lwkduo0","created":1792894933496,"text":"①交感神经系统激活","layout":null},"children":[{"data":{"id":"dmdk7t5s43s0","created":1792894949291,"text":"原理：\n压力、容量、化学感受器","layout":null},"children":[]},{"data":{"id":"dmdk840dm9c0","created":1792894972909,"text":"意义","layout":null},"children":[{"data":{"id":"dmdk86ni13s0","created":1792894978660,"text":"心排血量增加，维持血压","layout":null},"children":[]},{"data":{"id":"dmdk8duyzeg0","created":1792894994349,"text":"血流重新分布，保证心脑等重要器官的需要","layout":null},"children":[]}]},{"data":{"id":"dmdk8m1skgo0","created":1792895012176,"text":"不利影响","layout":null},"children":[{"data":{"id":"dmdk8o9x1fk0","created":1792895017021,"text":"耗氧量增加，心律失常","layout":null},"children":[]},{"data":{"id":"dmdk8v0c1nk0","created":1792895031679,"text":"骨骼肌疲劳，促进心肌重塑","layout":null},"children":[]}]}]},{"data":{"id":"dmdk95p7w4w0","created":1792895054951,"text":"②肾素-血管紧张素-醛固酮系统激活","layout":null},"children":[{"data":{"id":"dmdpccpth8o0","created":1792909410867,"text":"RAAS vs 利钠肽系统","layout":null},"children":[{"data":{"id":"dmdpgc4wj480","created":1792909723059,"text":"RAAS系统的激活","layout":null},"children":[{"data":{"id":"dmdpd93yk1c0","created":1792909481379,"text":"触发因素：由于心排血量下降，\n导致肾脏灌注压降低，交感神经兴奋（激活β1受体）","layout":null},"children":[]},{"data":{"id":"dmdpd93yuow0","created":1792909481380,"text":"级联反应：肾脏球旁细胞释放肾素（Renin）。\n肾素Renin将血管紧张素原转化为Ang I，在ACE酶作\n用下生成血管紧张素II（Ang II），\n进而刺激醛固酮（Aldosterone）分泌 ","layout":null},"children":[]},{"data":{"id":"dmdpezazm9s0","created":1792909616765,"text":"病理生理效应","layout":null},"children":[{"data":{"id":"dmdpezb0bm00","created":1792909616766,"text":"Ang II：强烈收缩血管（增加心脏后负荷），\n促进心肌纤维化（引发心室重构）。","layout":null},"children":[]},{"data":{"id":"dmdpezb04ug0","created":1792909616766,"text":"醛固酮：促进肾脏远曲小管和集合管重吸收钠和水\n（增加心脏前负荷，即容量负荷）。","layout":null},"children":[]}]}]},{"data":{"id":"dmdpggrzbcw0","created":1792909733162,"text":"利钠肽系统（NP）的代偿","layout":null},"children":[{"data":{"id":"dmdpgmova2g0","created":1792909746034,"text":"触发因素：心衰导致心房/心室压力升高、室壁张力增大","layout":null},"children":[]},{"data":{"id":"dmdpgs5jmww0","created":1792909757927,"text":"核心成员：心房分泌ANP（心钠肽），心室分泌BNP（脑钠肽）","layout":null},"children":[]},{"data":{"id":"dmdpgw0iofk0","created":1792909766330,"text":"生理效应：机体的“防御系统”。\n它们促进肾脏排钠、排尿（降低容量负荷），\n扩张血管，并能抑制RAAS系统。","layout":null},"children":[]},{"data":{"id":"dmdphaca2g00","created":1792909797516,"text":"临床上，抽血查NT-proBNP/BNP是诊断心衰极其重要的指标，\n因为心室被“撑大”了才会大量释放","layout":null},"children":[]}]}]},{"data":{"id":"dmdphxoteiw0","created":1792909848340,"text":"RAAS系统与临床药物靶点","layout":null},"children":[{"data":{"id":"dmdpixorz2g0","created":1792909926702,"text":"病理生理路径","layout":null},"children":[{"data":{"id":"dmdpj16mn4g0","created":1792909934311,"text":"源头：肾脏缺血→ 球旁细胞分泌肾素。","layout":null},"children":[]},{"data":{"id":"dmdpj16n7kg0","created":1792909934312,"text":"转化：肝（产生底物）→ 肺（含大量ACE酶，是转化中心）→ 生成强效的Ang II。","layout":null},"children":[]},{"data":{"id":"dmdpj16mvhs0","created":1792909934312,"text":"效应器：Ang II 作用于血管（收缩）和肾上腺皮质（分泌醛固酮）","layout":null},"children":[]}]},{"data":{"id":"dmdpk3zhtb40","created":1792910018775,"text":"临床干预靶点","layout":null},"children":[{"data":{"id":"dmdpkbczq340","created":1792910034828,"text":"阻断RAAS（ACEI/ARB）：使用ACEI（普利类）或ARB（沙坦类）药物，精准切断RAAS这条通路。\n目的是扩张血管（降后负荷）、抑制心肌重构（改善预后）。","layout":null},"children":[]},{"data":{"id":"dmdpkbczoj40","created":1792910034828,"text":"利尿剂，目的是直接排出体内多余的钠和水，减轻心脏前负荷。","layout":null},"children":[]}]}]},{"data":{"id":"dmdpldcsgwo0","created":1792910117534,"text":"简要介绍RAAS系统\n（Renin-Angiotensin-Aldosterone System）","layout":null},"children":[{"data":{"id":"dmdpmaj5ps80","created":1792910189753,"text":"调节血压、水盐平衡和血管张力的核心机制","layout":null},"children":[]},{"data":{"id":"dmdpmea96ow0","created":1792910197921,"text":"组成与生理作用","layout":null},"children":[{"data":{"id":"dmdpmhfwlo80","created":1792910204793,"text":"肾素（Renin）：限速酶，由肾脏球旁细胞分泌。\n受肾灌注压下降、交感神经兴奋、致密斑（远曲小管钠浓度降低）\n三大因素刺激而释放。\n启动整个系统的激活过程","layout":null},"children":[]},{"data":{"id":"dmdpmhfwpy80","created":1792910204794,"text":"血管紧张素II（Ang II）：系统中最核心的活性物质。\n它是已知最强的内源性缩血管物质之一，升压作用极强；\n同时能促进血管平滑肌增生、心肌肥厚。","layout":null},"children":[]},{"data":{"id":"dmdpmhfx4kw0","created":1792910204794,"text":"醛固酮（Aldosterone）：由肾上腺皮质球状带分泌，\n作用于肾脏，起到“保钠保水排钾”的作用，维持血容量","layout":null},"children":[]}]},{"data":{"id":"dmdpnghu4fk0","created":1792910281098,"text":"病理生理中的“双刃剑”效应","layout":null},"children":[{"data":{"id":"dmdpnkzjork0","created":1792910290876,"text":"短期代偿（保命）：在失血、脱水等急性状态下，\nRAAS激活维持血压，保证心脑灌注","layout":null},"children":[]},{"data":{"id":"dmdpnrnne940","created":1792910305394,"text":"长期过度激活（致病）：在慢性心衰、高血压等病理状态下，RAAS持续激活。\n血管收缩导致后负荷增加，水钠潴留导致前负荷增加，\nAng II和醛固酮还直接参与心肌重构（细胞肥大、凋亡、纤维化）。\n这就是心衰患者必须长期服用阻断RAAS的药物（如沙库巴曲缬沙坦、普利类、沙坦类）的原因","layout":null},"children":[]}]}]}]},{"data":{"id":"dmdpodzfcu80","created":1792910353995,"text":"③心肌局部肾素-血管紧张素系统激活","layout":null},"children":[{"data":{"id":"dmdppv0arq00","created":1792910469417,"text":"心肌内糜蛋白酶（Kymase）可将 AngⅠ 转化为 AngⅡ","layout":null},"children":[]},{"data":{"id":"dmdppz02pe00","created":1792910478111,"text":"效应：","layout":null},"children":[{"data":{"id":"dmdppz02l8o0","created":1792910478111,"text":"1. 促进交感末梢释放去甲肾上腺素（NE）","layout":null},"children":[]},{"data":{"id":"dmdppz02qa80","created":1792910478111,"text":"2. 冠脉收缩、血管壁增生纤维化","layout":null},"children":[]},{"data":{"id":"dmdppz02xgw0","created":1792910478111,"text":"3. 心肌细胞肥大、心肌间质纤维化","layout":null},"children":[]},{"data":{"id":"dmdppz02rt40","created":1792910478111,"text":"靶向药物：ACEI、醛固酮受体拮抗剂（螺内酯）","layout":null},"children":[]}]},{"data":{"id":"dmdpqrw5sx40","created":1792910541001,"text":"糜蛋白酶通路不受 ACEI 抑制，这也是部分患者单用 ACEI 效果有限的原因。","layout":null},"children":[]}]},{"data":{"id":"dmdpop7dxls0","created":1792910378421,"text":"④其他体液物质","layout":null},"children":[{"data":{"id":"dmdprnn1g7c0","created":1792910610106,"text":"a）缩血管物质增多：NE，AngII, ET（内皮素）等\nb）扩血管物质反馈性增多：ANP（心钠肽）, PGE2 , NO等\nc）肿瘤坏死因子及白细胞介素：参与心肌损伤、心肌重塑","layout":null},"children":[]}]}]},{"data":{"id":"dmdptlmlu940","created":1792910762455,"text":"（2）心脏本身的代偿反应","layout":null},"children":[{"data":{"id":"dmdpvduhmqg0","created":1792910902246,"text":"①心率加快","layout":null},"children":[{"data":{"id":"dmdpu457hpk0","created":1792910802762,"text":"代偿意义","layout":null},"children":[{"data":{"id":"dmdpu8oouco0","created":1792910812647,"text":"提高心输出量","layout":null},"children":[]},{"data":{"id":"dmdpubz2mrs0","created":1792910819805,"text":"增加冠脉血流量","layout":null},"children":[]}]},{"data":{"id":"dmdpugjvwdk0","created":1792910829771,"text":"不利影响","layout":null},"children":[{"data":{"id":"dmdpuj785cw0","created":1792910835535,"text":"耗氧量增加","layout":null},"children":[]},{"data":{"id":"dmdpumlc6eo0","created":1792910842919,"text":"舒张期缩短","layout":null},"children":[]},{"data":{"id":"dmdpuqj01y80","created":1792910851485,"text":"心室充盈不足","layout":null},"children":[]}]}]},{"data":{"id":"dmdpvkg5xio0","created":1792910916617,"text":"②心脏紧张源性扩张\n（动用舒张期贮备）","layout":null,"image":"https://p.cldisk.com/star4/45947c25988aab0c43c486ceaf892184/origin.png","imageTitle":"","imageSize":{"width":200,"height":108}},"children":[{"data":{"id":"dmdq1wgvz680","created":1792911412967,"text":"容量负荷（前负荷）↑ → 心腔扩张 → Starling 效应","layout":null},"children":[]},{"data":{"id":"dmdq1xrywbc0","created":1792911415814,"text":"starling效应：一定范围内，心肌收缩力、心搏出量与\n心肌纤维初长或心舒张末期容积（前负荷）成正比","layout":null},"children":[]},{"data":{"id":"dmdq3wk7ayo0","created":1792911569896,"text":"“收缩力-肌节初长”曲线图","layout":null},"children":[{"data":{"id":"dmdq4ihrshs0","created":1792911617638,"text":"紧张源性扩张，\n肌节初长在1.7~2.2μm","layout":null},"children":[{"data":{"id":"dmdq53iok880","created":1792911663405,"text":"病理性容量负荷过重","layout":null},"children":[]},{"data":{"id":"dmdq59eikdc0","created":1792911676214,"text":"静脉回流血量增多","layout":null},"children":[]},{"data":{"id":"dmdq5k7co9c0","created":1792911699726,"text":"钠水潴留使血容量增加","layout":null},"children":[]}]},{"data":{"id":"dmdq5xqkd9c0","created":1792911729186,"text":"肌源性扩张，失代偿\n肌节初长＞2.2μm","layout":null},"children":[{"data":{"id":"dmdq6hq9j2w0","created":1792911772703,"text":"心肌被过度拉长；\n粗、细肌丝重叠变少，\n收缩力反而下降，失去代偿作用，心衰加重","layout":null},"children":[]}]}]}]},{"data":{"id":"dmdq7lgmgds0","created":1792911859191,"text":"③心肌收缩性增强（动用收缩期贮备）","layout":null},"children":[{"data":{"id":"dmdq8131w600","created":1792911893199,"text":"交感兴奋→NE→β1α→AMP→cAMP→Ca2+→收缩增强","layout":null},"children":[]},{"data":{"id":"dmdq91hrr280","created":1792911972453,"text":"心肌收缩性不依赖于前负荷和后负荷而能改变\n收缩强度及速度的内在特性","layout":null},"children":[]},{"data":{"id":"dmdq9zveyhk0","created":1792912047289,"text":"受神经和体液因素及药物影响","layout":null},"children":[]}]},{"data":{"id":"dmdqa9wtocg0","created":1792912069142,"text":"④心室重塑","layout":null},"children":[{"data":{"id":"dmdqby5tf0o0","created":1792912200293,"text":"心脏组成：心肌细胞占细胞总数的33%（心肌体积70%）\n非心肌细胞67%、细胞外间质","layout":null},"children":[{"data":{"id":"dmdqae7pxpc0","created":1792912078508,"text":"a）心室结构、代谢、功能改变的慢性代偿适应性机制","layout":null},"children":[]},{"data":{"id":"dmdqbhoxop40","created":1792912164444,"text":"b）心肌细胞肥大、细胞表型改变","layout":null},"children":[]},{"data":{"id":"dmdqcrwb6800","created":1792912265021,"text":"c）非心肌细胞和ECM重塑","layout":null},"children":[]}]},{"data":{"id":"dmdqd144rm80","created":1792912285085,"text":"结果：心脏重量增加、心壁增厚、心室容积扩大、心室形态改变","layout":null},"children":[]},{"data":{"id":"dmdqdypd8co0","created":1792912358203,"text":"表现","layout":null},"children":[{"data":{"id":"dmdqecvv97k0","created":1792912389071,"text":"心肌肥大","layout":null},"children":[{"data":{"id":"dmdqn5v01b40","created":1792913079059,"text":"类型","layout":null},"children":[{"data":{"id":"dmdqeiiu8sg0","created":1792912401344,"text":"向心性肥大","layout":null},"children":[{"data":{"id":"dmdqey5x48w0","created":1792912435391,"text":"长期过度的后负荷\n→收缩期室壁应力增加\n→心肌肌节并联增生\n→细胞增粗，室壁增厚","layout":null},"children":[]},{"data":{"id":"dmdqoxnbtlk0","created":1792913217909,"text":"原因：后负荷增加；\n肌节：并联增生；\n形态变化：心壁增厚；\n室壁厚度：明显增大\n意义：降低室壁应力，对抗升高的后负荷；\n！！！！注意不是降低后负荷","layout":null,"priority":1},"children":[]}]},{"data":{"id":"dmdqenaizwg0","created":1792912411726,"text":"离心性肥大","layout":null},"children":[{"data":{"id":"dmdqg4afv5s0","created":1792912527090,"text":"长期过度的前负荷\n→收缩期室壁应力增加\n→心肌肌节串联增生\n→细胞变长、心腔增大","layout":null},"children":[]},{"data":{"id":"dmdqpnrrn0w0","created":1792913274774,"text":"原因：前负荷；\n肌节复制：串联；\n形态变化：心腔扩大；\n室壁厚度：增大或基本正常；\n意义：减轻了单位心肌的舒张期张力，\n对前负荷增加的代偿","layout":null},"children":[]}]}]},{"data":{"id":"dmdqn9x50200","created":1792913087895,"text":"代偿意义","layout":null},"children":[{"data":{"id":"dmdqnbw72g00","created":1792913092192,"text":"心肌总体收缩功能增强","layout":null},"children":[]},{"data":{"id":"dmdqnhn4qtk0","created":1792913104704,"text":"心壁增厚可降低室壁应力，降低心肌耗氧量","layout":null},"children":[]}]}]},{"data":{"id":"dmdqxqoggao0","created":1792913908017,"text":"心肌细胞表型改变"},"children":[{"data":{"id":"dmdqxxlkvj40","created":1792913923081,"text":"基因表达的胚胎化"},"children":[{"data":{"id":"dmdqy44afsw0","created":1792913937273,"text":"肌球蛋白重链、轻链，肌钙蛋白，磷酸肌酸激酶\n向胚胎型转变"},"children":[]}]},{"data":{"id":"dmdqytsac7k0","created":1792913993143,"text":"基因表达异常"},"children":[{"data":{"id":"dmdqz2seank0","created":1792914012741,"text":"β受体、L型钙通道、肌浆网钙释放通道、钙泵"},"children":[]}]},{"data":{"id":"dmdqzn4e04o0","created":1792914057002,"text":"非心肌细胞及细胞外基质的变化"},"children":[{"data":{"id":"dmdr00hkctk0","created":1792914086097,"text":"维持心肌舒缩协调和顺应性"},"children":[]}]}]}]},{"data":{"id":"dmdr0b1qnlk0","created":1792914109084,"text":"分支主题"},"children":[]}]}]},{"data":{"id":"dmdq79lpge80","created":1792911833377,"text":" ","layout":null},"children":[]}]}]},{"data":{"id":"dmdio9drp3k0","created":1792890596209,"text":"3.对机体的影响","layout":null},"children":[]},{"data":{"id":"dmdiogfdhiw0","created":1792890611543,"text":"4.防止原则","layout":null},"children":[]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}