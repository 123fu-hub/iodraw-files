{"root":{"data":{"id":"dmdii1yjqbk0","created":1792890109866,"text":"心功能不全"},"children":[{"data":{"id":"dmdinz37me80","created":1792890573803,"text":"1.病因及分类","layout":null},"children":[{"data":{"id":"dmdiop34ulc0","created":1792890630394,"text":"什么是心功能不全/心衰？","layout":null},"children":[{"data":{"id":"dmdip7180hk0","created":1792890669461,"text":"心功能不全","layout":null},"children":[{"data":{"id":"dmdipi60sa80","created":1792890693696,"text":"由于心脏舒缩功能降低或心室充盈受限\n导致的心脏泵血功能降低。\n包括代偿期和失代偿期","layout":null,"color":"#ff0000","background":"#daeef3","font-weight":"bold"},"children":[]}]},{"data":{"id":"dmdiqkp89co0","created":1792890777575,"text":"心力衰竭","layout":null},"children":[{"data":{"id":"dmdiqn4lk4g0","created":1792890782858,"text":"在有足够循环血量的情况下，由于心脏舒缩功能障碍，\n导致心排血量绝对/相对不足，不能满足机体代谢需要\n而导致的以循环功能为主的综合征。\n是心功能不全的失代偿期","layout":null,"font-weight":"bold","color":"#ff0000","background":"#daeef3"},"children":[]}]}]},{"data":{"id":"dmdisgew7s00","created":1792890924971,"text":"心力衰竭如何分类？","layout":null},"children":[{"data":{"id":"dmdisrqrvf40","created":1792890949634,"text":"按部位","layout":null},"children":[{"data":{"id":"dmdisthhy200","created":1792890953427,"text":"左心衰","layout":null},"children":[]},{"data":{"id":"dmdisv5hl6g0","created":1792890957054,"text":"右心衰","layout":null},"children":[]},{"data":{"id":"dmdiswl8ye80","created":1792890960184,"text":"全心衰","layout":null},"children":[]}]},{"data":{"id":"dmdit7i3qag0","created":1792890983938,"text":"按心输出量","layout":null},"children":[{"data":{"id":"dmdita0yet40","created":1792890989432,"text":"低输出量型心衰","layout":null},"children":[]},{"data":{"id":"dmditfdusew0","created":1792891001096,"text":"高输出量型心衰","layout":null},"children":[]}]},{"data":{"id":"dmditnb53o80","created":1792891018346,"text":"按速度","layout":null},"children":[{"data":{"id":"dmditoef2bc0","created":1792891020721,"text":"急性心衰","layout":null},"children":[]},{"data":{"id":"dmditq2cys80","created":1792891024345,"text":"慢性心衰","layout":null},"children":[]}]},{"data":{"id":"dmditsq7fo80","created":1792891030141,"text":"按发生机制\n（收缩/舒张障碍）","layout":null},"children":[{"data":{"id":"dmdiu2pb8480","created":1792891051854,"text":"收缩功能障碍型心衰","layout":null},"children":[]},{"data":{"id":"dmdiu7305n40","created":1792891061389,"text":"舒张功能障碍性心衰","layout":null},"children":[]},{"data":{"id":"dmdiuaubrk00","created":1792891069572,"text":"混合型心衰","layout":null},"children":[]}]},{"data":{"id":"dmdiufu6mk00","created":1792891080447,"text":"按左室射血分数LVEF\n（每搏输出量占心室舒张末期容积量的百分比）\n（安静状态下约55~65%）","color":"#ff0000","font-weight":"bold","background":"#ffff00","layout":null},"children":[{"data":{"id":"dmdivg2dt800","created":1792891159307,"text":"（1）射血分数降低型心衰HFrEF","layout":null},"children":[{"data":{"id":"dmdj6ifvf6o0","created":1792892026482,"text":"EF＜40%","layout":null},"children":[]},{"data":{"id":"dmdj6n08oi00","created":1792892036421,"text":"收缩性HF，有效治疗已得到证实","layout":null},"children":[]}]},{"data":{"id":"dmdivrofhds0","created":1792891184585,"text":"（2）射血分数保留型心衰HFpEF","layout":null},"children":[{"data":{"id":"dmdj70x9hls0","created":1792892066716,"text":"EF≥50%","layout":null},"children":[]},{"data":{"id":"dmdj90tk4ew0","created":1792892223220,"text":"舒张性HF，有效治疗尚不明确","layout":null},"children":[]}]},{"data":{"id":"dmdj3j0hyls0","created":1792891792637,"text":"a.HFmrEF（射血分数轻度降低）","layout":null},"children":[{"data":{"id":"dmdj70x9hls0","created":1792892066716,"text":"EF：41~49%","layout":null},"children":[]},{"data":{"id":"dmdja4bd9tc0","created":1792892309191,"text":"患者特征、治疗方式与预后有HFpEF相似","layout":null},"children":[]}]},{"data":{"id":"dmdj44k0enk0","created":1792891839529,"text":"b.HFimpEF（射血分数改善）","layout":null},"children":[{"data":{"id":"dmdjauvu59c0","created":1792892367025,"text":"EF＞40%","layout":null},"children":[]},{"data":{"id":"dmdjazm875k0","created":1792892377328,"text":"HFpEF患者亚组过去曾有HFrEF","layout":null},"children":[]},{"data":{"id":"dmdjbgf0b9s0","created":1792892413897,"text":"这些EF改善或恢复的患者临床上\n与持续保留或EF降低的患者不同","layout":null},"children":[]}]}]},{"data":{"id":"dmdjd98kquw0","created":1792892554999,"text":"发展","layout":null},"children":[{"data":{"id":"dmdjddrehnk0","created":1792892564845,"text":"急性心衰缓解，到慢性心衰","layout":null},"children":[]},{"data":{"id":"dmdjdnj4h1s0","created":1792892586112,"text":"稳定性心衰恶化，发展为急性失代偿性“新发心衰”","layout":null},"children":[]}]},{"data":{"id":"dmdjeiw0b1s0","created":1792892654371,"text":"分期","layout":null},"children":[{"data":{"id":"dmdjek62t680","created":1792892657157,"text":"NYHA心功能分级：\n进行风险评估","layout":null},"children":[{"data":{"id":"dmdjhkbilgw0","created":1792892892578,"text":"- Ⅰ 级：日常活动不受限","layout":null},"children":[]},{"data":{"id":"dmdjhkbiqso0","created":1792892892578,"text":"- Ⅱ 级：日常活动出现症状","layout":null},"children":[]},{"data":{"id":"dmdjhkbiyoo0","created":1792892892579,"text":"- Ⅲ 级：低于日常活动就有症状","layout":null},"children":[]},{"data":{"id":"dmdjhkbiwm80","created":1792892892579,"text":"- Ⅳ 级：静息状态也有症状","layout":null},"children":[]}]},{"data":{"id":"dmdjh9b8ktc0","created":1792892868617,"text":"ACC/AHA心衰分期：","layout":null},"children":[{"data":{"id":"dmdji2xlwio0","created":1792892933097,"text":"- A 期：有因无果——有心衰危险因素（高血压、糖尿病等），\n但心脏结构正常、无任何心脏病变","layout":null},"children":[]},{"data":{"id":"dmdji2xmhyw0","created":1792892933097,"text":"- B 期：有因有果无症状——已经出现心脏结构损伤（心梗、左室肥厚等），\n但从来没有心衰症状","layout":null},"children":[]},{"data":{"id":"dmdji2xmmbk0","created":1792892933097,"text":"- C 期：有因有果有症状——有心脏结构改变，既往 / 现在存在心衰症状\n（这一期的患者，同时可以用 NYHA Ⅰ~Ⅳ 去评估活动能力）","layout":null},"children":[]},{"data":{"id":"dmdji2xmbv40","created":1792892933097,"text":"- D 期：有因有果有症状，难治、需要特殊治疗\n——终末期顽固性心衰，休息时也有症状，反复住院","layout":null},"children":[]}]}]}]},{"data":{"id":"dmdjjqyp6i00","created":1792893063769,"text":"心功能不全的病因与\n心力衰竭的诱因","layout":null},"children":[{"data":{"id":"dmdjk731fds0","created":1792893098860,"text":"病因：影响心室射血和/或充盈的\n任何结构性及功能性病变","layout":null},"children":[{"data":{"id":"dmdjkpnwlo80","created":1792893139304,"text":"（1）心肌受损","layout":null},"children":[{"data":{"id":"dmdjkta7q740","created":1792893147183,"text":"原发性：心肌炎、心肌病、心肌梗死","layout":null},"children":[]},{"data":{"id":"dmdjkv7tswg0","created":1792893151392,"text":"继发性：缺血、缺氧；冠心病；糖尿病","layout":null},"children":[]}]},{"data":{"id":"dmdjlj10cco0","created":1792893203223,"text":"（2）心脏负荷过重","layout":null},"children":[{"data":{"id":"dmdjluxcpb40","created":1792893229123,"text":"容量负荷过重：动脉瓣关闭不全（血倒流回心室）；\n甲亢（代谢旺盛，回心血量增加）；\n慢性贫血（血液携氧低，机体代偿性增加血量）","layout":null},"children":[]},{"data":{"id":"dmdjmaxy9mo0","created":1792893263988,"text":"压力负荷过重：高血压、肺动脉高压、肺栓塞","layout":null},"children":[]}]},{"data":{"id":"dmdjo7d4cm00","created":1792893412926,"text":"（3）心脏舒张充盈障碍","layout":null},"children":[{"data":{"id":"dmdjodghilc0","created":1792893426190,"text":"心包疾患（心包积液、缩窄性心包炎）","layout":null},"children":[]},{"data":{"id":"dmdjomjgxc80","created":1792893445962,"text":"限制性心肌病","layout":null},"children":[]},{"data":{"id":"dmdjor3ydcg0","created":1792893455907,"text":"房室瓣（二/三尖瓣）狭窄","layout":null},"children":[]},{"data":{"id":"dmdjozlqt1s0","created":1792893474397,"text":"心肌顺应性降低","layout":null},"children":[]}]},{"data":{"id":"dmdjqwa3nwg0","created":1792893623891,"text":"（4）心律失常","layout":null},"children":[{"data":{"id":"dmdjr294oi00","created":1792893636893,"text":"降低心脏冲动的形成和传导异常","layout":null},"children":[]},{"data":{"id":"dmdjrgrv9fk0","created":1792893668501,"text":"如：心动过速/缓，频发性期前收缩，传导阻滞，室颤","layout":null},"children":[]}]}]},{"data":{"id":"dmdjs7oq1680","created":1792893727084,"text":"心衰的诱因","layout":null},"children":[{"data":{"id":"dmdjsa7piu80","created":1792893732586,"text":"（1）感染","layout":null},"children":[{"data":{"id":"dmdjsd1rw880","created":1792893738757,"text":"发热时代谢增高","layout":null},"children":[]},{"data":{"id":"dmdjsh715a80","created":1792893747782,"text":"心率加快，冠脉供血减少","layout":null},"children":[]},{"data":{"id":"dmdjsq5hbw00","created":1792893767280,"text":"内毒素直接损伤心肌","layout":null},"children":[]},{"data":{"id":"dmdjsxtsm340","created":1792893783987,"text":"呼吸道感染加重右心负荷","layout":null},"children":[]}]},{"data":{"id":"dmdjtecs4q00","created":1792893819964,"text":"（2）酸碱平衡及电解质代谢紊乱","layout":null},"children":[{"data":{"id":"dmdjtnrjr8g0","created":1792893840448,"text":"过快和过量输液","layout":null},"children":[]},{"data":{"id":"dmdjtsxf2so0","created":1792893851687,"text":"高钾血症/低钾血症","layout":null},"children":[]},{"data":{"id":"dmdjtwlqank0","created":1792893859687,"text":"酸中毒","layout":null},"children":[]}]},{"data":{"id":"dmdju0fiurs0","created":1792893868019,"text":"（3）心律失常、快速型心律失常","layout":null},"children":[{"data":{"id":"dmdju8ife6g0","created":1792893885609,"text":"冠脉灌流减少；心肌耗氧增加","layout":null},"children":[]}]},{"data":{"id":"dmdk5veb8y80","created":1792894797432,"text":"（4）妊娠与分娩","layout":null},"children":[]},{"data":{"id":"dmdk600f1g00","created":1792894807475,"text":"（5）其他因素","layout":null},"children":[{"data":{"id":"dmdk62in8js0","created":1792894812931,"text":"衰老、过劳、情绪激动","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dmdio652fs00","created":1792890589152,"text":"2.发生机制","layout":null},"children":[{"data":{"id":"dmdk6d5xt6o0","created":1792894836107,"text":"心功能不全时机体如何进行代偿","layout":null},"children":[{"data":{"id":"dmdk6kmyuog0","created":1792894852375,"text":"心泵功能障碍\n→心输出量⬇\n→组织供血⬇\n→神经-体液调节；心脏本身的代偿；心外反应","layout":null},"children":[]},{"data":{"id":"dmdk7g7iwj40","created":1792894921099,"text":"（1）神经-体液调节机制","layout":null},"children":[{"data":{"id":"dmdk7lwkduo0","created":1792894933496,"text":"①交感神经系统激活","layout":null},"children":[{"data":{"id":"dmdk7t5s43s0","created":1792894949291,"text":"原理：\n压力、容量、化学感受器","layout":null},"children":[]},{"data":{"id":"dmdk840dm9c0","created":1792894972909,"text":"意义","layout":null},"children":[{"data":{"id":"dmdk86ni13s0","created":1792894978660,"text":"心排血量增加，维持血压","layout":null},"children":[]},{"data":{"id":"dmdk8duyzeg0","created":1792894994349,"text":"血流重新分布，保证心脑等重要器官的需要","layout":null},"children":[]}]},{"data":{"id":"dmdk8m1skgo0","created":1792895012176,"text":"不利影响","layout":null},"children":[{"data":{"id":"dmdk8o9x1fk0","created":1792895017021,"text":"耗氧量增加，心律失常","layout":null},"children":[]},{"data":{"id":"dmdk8v0c1nk0","created":1792895031679,"text":"骨骼肌疲劳，促进心肌重塑","layout":null},"children":[]}]}]},{"data":{"id":"dmdk95p7w4w0","created":1792895054951,"text":"②肾素-血管紧张素-醛固酮系统激活","layout":null},"children":[{"data":{"id":"dmdpccpth8o0","created":1792909410867,"text":"RAAS vs 利钠肽系统","layout":null},"children":[{"data":{"id":"dmdpgc4wj480","created":1792909723059,"text":"RAAS系统的激活","layout":null},"children":[{"data":{"id":"dmdpd93yk1c0","created":1792909481379,"text":"触发因素：由于心排血量下降，\n导致肾脏灌注压降低，交感神经兴奋（激活β1受体）","layout":null},"children":[]},{"data":{"id":"dmdpd93yuow0","created":1792909481380,"text":"级联反应：肾脏球旁细胞释放肾素（Renin）。\n肾素Renin将血管紧张素原转化为Ang I，在ACE酶作\n用下生成血管紧张素II（Ang II），\n进而刺激醛固酮（Aldosterone）分泌 ","layout":null},"children":[]},{"data":{"id":"dmdpezazm9s0","created":1792909616765,"text":"病理生理效应","layout":null},"children":[{"data":{"id":"dmdpezb0bm00","created":1792909616766,"text":"Ang II：强烈收缩血管（增加心脏后负荷），\n促进心肌纤维化（引发心室重构）。","layout":null},"children":[]},{"data":{"id":"dmdpezb04ug0","created":1792909616766,"text":"醛固酮：促进肾脏远曲小管和集合管重吸收钠和水\n（增加心脏前负荷，即容量负荷）。","layout":null},"children":[]}]}]},{"data":{"id":"dmdpggrzbcw0","created":1792909733162,"text":"利钠肽系统（NP）的代偿","layout":null},"children":[{"data":{"id":"dmdpgmova2g0","created":1792909746034,"text":"触发因素：心衰导致心房/心室压力升高、室壁张力增大","layout":null},"children":[]},{"data":{"id":"dmdpgs5jmww0","created":1792909757927,"text":"核心成员：心房分泌ANP（心钠肽），心室分泌BNP（脑钠肽）","layout":null},"children":[]},{"data":{"id":"dmdpgw0iofk0","created":1792909766330,"text":"生理效应：机体的“防御系统”。\n它们促进肾脏排钠、排尿（降低容量负荷），\n扩张血管，并能抑制RAAS系统。","layout":null},"children":[]},{"data":{"id":"dmdphaca2g00","created":1792909797516,"text":"临床上，抽血查NT-proBNP/BNP是诊断心衰极其重要的指标，\n因为心室被“撑大”了才会大量释放","layout":null},"children":[]}]}]},{"data":{"id":"dmdphxoteiw0","created":1792909848340,"text":"RAAS系统与临床药物靶点","layout":null},"children":[{"data":{"id":"dmdpixorz2g0","created":1792909926702,"text":"病理生理路径","layout":null},"children":[{"data":{"id":"dmdpj16mn4g0","created":1792909934311,"text":"源头：肾脏缺血→ 球旁细胞分泌肾素。","layout":null},"children":[]},{"data":{"id":"dmdpj16n7kg0","created":1792909934312,"text":"转化：肝（产生底物）→ 肺（含大量ACE酶，是转化中心）→ 生成强效的Ang II。","layout":null},"children":[]},{"data":{"id":"dmdpj16mvhs0","created":1792909934312,"text":"效应器：Ang II 作用于血管（收缩）和肾上腺皮质（分泌醛固酮）","layout":null},"children":[]}]},{"data":{"id":"dmdpk3zhtb40","created":1792910018775,"text":"临床干预靶点","layout":null},"children":[{"data":{"id":"dmdpkbczq340","created":1792910034828,"text":"阻断RAAS（ACEI/ARB）：使用ACEI（普利类）或ARB（沙坦类）药物，精准切断RAAS这条通路。\n目的是扩张血管（降后负荷）、抑制心肌重构（改善预后）。","layout":null},"children":[]},{"data":{"id":"dmdpkbczoj40","created":1792910034828,"text":"利尿剂，目的是直接排出体内多余的钠和水，减轻心脏前负荷。","layout":null},"children":[]}]}]}]}]}]}]},{"data":{"id":"dmdio9drp3k0","created":1792890596209,"text":"3.对机体的影响","layout":null},"children":[]},{"data":{"id":"dmdiogfdhiw0","created":1792890611543,"text":"4.防止原则","layout":null},"children":[]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}