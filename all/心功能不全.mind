{"root":{"data":{"id":"dmdii1yjqbk0","created":1792890109866,"text":"心功能不全"},"children":[{"data":{"id":"dmdinz37me80","created":1792890573803,"text":"1.病因及分类","layout":null},"children":[{"data":{"id":"dmdiop34ulc0","created":1792890630394,"text":"什么是心功能不全/心衰？","layout":null},"children":[{"data":{"id":"dmdip7180hk0","created":1792890669461,"text":"心功能不全","layout":null},"children":[{"data":{"id":"dmdipi60sa80","created":1792890693696,"text":"由于心脏舒缩功能降低或心室充盈受限\n导致的心脏泵血功能降低。\n包括代偿期和失代偿期","layout":null,"color":"#ff0000","background":"#daeef3","font-weight":"bold"},"children":[]}]},{"data":{"id":"dmdiqkp89co0","created":1792890777575,"text":"心力衰竭","layout":null},"children":[{"data":{"id":"dmdiqn4lk4g0","created":1792890782858,"text":"在有足够循环血量的情况下，由于心脏舒缩功能障碍，\n导致心排血量绝对/相对不足，不能满足机体代谢需要\n而导致的以循环功能为主的综合征。\n是心功能不全的失代偿期","layout":null,"font-weight":"bold","color":"#ff0000","background":"#daeef3"},"children":[]}]}]},{"data":{"id":"dmdisgew7s00","created":1792890924971,"text":"心力衰竭如何分类？","layout":null},"children":[{"data":{"id":"dmdisrqrvf40","created":1792890949634,"text":"按部位","layout":null},"children":[{"data":{"id":"dmdisthhy200","created":1792890953427,"text":"左心衰","layout":null},"children":[]},{"data":{"id":"dmdisv5hl6g0","created":1792890957054,"text":"右心衰","layout":null},"children":[]},{"data":{"id":"dmdiswl8ye80","created":1792890960184,"text":"全心衰","layout":null},"children":[]}]},{"data":{"id":"dmdit7i3qag0","created":1792890983938,"text":"按心输出量","layout":null},"children":[{"data":{"id":"dmdita0yet40","created":1792890989432,"text":"低输出量型心衰","layout":null},"children":[]},{"data":{"id":"dmditfdusew0","created":1792891001096,"text":"高输出量型心衰","layout":null},"children":[]}]},{"data":{"id":"dmditnb53o80","created":1792891018346,"text":"按速度","layout":null},"children":[{"data":{"id":"dmditoef2bc0","created":1792891020721,"text":"急性心衰","layout":null},"children":[]},{"data":{"id":"dmditq2cys80","created":1792891024345,"text":"慢性心衰","layout":null},"children":[]}]},{"data":{"id":"dmditsq7fo80","created":1792891030141,"text":"按发生机制\n（收缩/舒张障碍）","layout":null},"children":[{"data":{"id":"dmdiu2pb8480","created":1792891051854,"text":"收缩功能障碍型心衰","layout":null},"children":[]},{"data":{"id":"dmdiu7305n40","created":1792891061389,"text":"舒张功能障碍性心衰","layout":null},"children":[]},{"data":{"id":"dmdiuaubrk00","created":1792891069572,"text":"混合型心衰","layout":null},"children":[]}]},{"data":{"id":"dmdiufu6mk00","created":1792891080447,"text":"按左室射血分数LVEF\n（每搏输出量占心室舒张末期容积量的百分比）\n（安静状态下约55~65%）","color":"#ff0000","font-weight":"bold","background":"#ffff00","layout":null},"children":[{"data":{"id":"dmdivg2dt800","created":1792891159307,"text":"（1）射血分数降低型心衰HFrEF","layout":null},"children":[{"data":{"id":"dmdj6ifvf6o0","created":1792892026482,"text":"EF＜40%","layout":null},"children":[]},{"data":{"id":"dmdj6n08oi00","created":1792892036421,"text":"收缩性HF，有效治疗已得到证实","layout":null},"children":[]}]},{"data":{"id":"dmdivrofhds0","created":1792891184585,"text":"（2）射血分数保留型心衰HFpEF","layout":null},"children":[{"data":{"id":"dmdj70x9hls0","created":1792892066716,"text":"EF≥50%","layout":null},"children":[]},{"data":{"id":"dmdj90tk4ew0","created":1792892223220,"text":"舒张性HF，有效治疗尚不明确","layout":null},"children":[]}]},{"data":{"id":"dmdj3j0hyls0","created":1792891792637,"text":"a.HFmrEF（射血分数轻度降低）","layout":null},"children":[{"data":{"id":"dmdj70x9hls0","created":1792892066716,"text":"EF：41~49%","layout":null},"children":[]},{"data":{"id":"dmdja4bd9tc0","created":1792892309191,"text":"患者特征、治疗方式与预后有HFpEF相似","layout":null},"children":[]}]},{"data":{"id":"dmdj44k0enk0","created":1792891839529,"text":"b.HFimpEF（射血分数改善）","layout":null},"children":[{"data":{"id":"dmdjauvu59c0","created":1792892367025,"text":"EF＞40%","layout":null},"children":[]},{"data":{"id":"dmdjazm875k0","created":1792892377328,"text":"HFpEF患者亚组过去曾有HFrEF","layout":null},"children":[]},{"data":{"id":"dmdjbgf0b9s0","created":1792892413897,"text":"这些EF改善或恢复的患者临床上\n与持续保留或EF降低的患者不同","layout":null},"children":[]}]}]},{"data":{"id":"dmdjd98kquw0","created":1792892554999,"text":"发展","layout":null},"children":[{"data":{"id":"dmdjddrehnk0","created":1792892564845,"text":"急性心衰缓解，到慢性心衰","layout":null},"children":[]},{"data":{"id":"dmdjdnj4h1s0","created":1792892586112,"text":"稳定性心衰恶化，发展为急性失代偿性“新发心衰”","layout":null},"children":[]}]},{"data":{"id":"dmdjeiw0b1s0","created":1792892654371,"text":"分期","layout":null},"children":[{"data":{"id":"dmdjek62t680","created":1792892657157,"text":"NYHA心功能分级：\n进行风险评估","layout":null},"children":[{"data":{"id":"dmdjhkbilgw0","created":1792892892578,"text":"- Ⅰ 级：日常活动不受限","layout":null},"children":[]},{"data":{"id":"dmdjhkbiqso0","created":1792892892578,"text":"- Ⅱ 级：日常活动出现症状","layout":null},"children":[]},{"data":{"id":"dmdjhkbiyoo0","created":1792892892579,"text":"- Ⅲ 级：低于日常活动就有症状","layout":null},"children":[]},{"data":{"id":"dmdjhkbiwm80","created":1792892892579,"text":"- Ⅳ 级：静息状态也有症状","layout":null},"children":[]}]},{"data":{"id":"dmdjh9b8ktc0","created":1792892868617,"text":"ACC/AHA心衰分期：","layout":null},"children":[{"data":{"id":"dmdji2xlwio0","created":1792892933097,"text":"- A 期：有因无果——有心衰危险因素（高血压、糖尿病等），\n但心脏结构正常、无任何心脏病变","layout":null},"children":[]},{"data":{"id":"dmdji2xmhyw0","created":1792892933097,"text":"- B 期：有因有果无症状——已经出现心脏结构损伤（心梗、左室肥厚等），\n但从来没有心衰症状","layout":null},"children":[]},{"data":{"id":"dmdji2xmmbk0","created":1792892933097,"text":"- C 期：有因有果有症状——有心脏结构改变，既往 / 现在存在心衰症状\n（这一期的患者，同时可以用 NYHA Ⅰ~Ⅳ 去评估活动能力）","layout":null},"children":[]},{"data":{"id":"dmdji2xmbv40","created":1792892933097,"text":"- D 期：有因有果有症状，难治、需要特殊治疗\n——终末期顽固性心衰，休息时也有症状，反复住院","layout":null},"children":[]}]}]}]},{"data":{"id":"dmdjjqyp6i00","created":1792893063769,"text":"心功能不全的病因与\n心力衰竭的诱因"},"children":[{"data":{"id":"dmdjk731fds0","created":1792893098860,"text":"病因：影响心室射血和/或充盈的\n任何结构性及功能性病变"},"children":[{"data":{"id":"dmdjkpnwlo80","created":1792893139304,"text":"（1）心肌受损"},"children":[{"data":{"id":"dmdjkta7q740","created":1792893147183,"text":"原发性：心肌炎、心肌病、心肌梗死"},"children":[]},{"data":{"id":"dmdjkv7tswg0","created":1792893151392,"text":"继发性：缺血、缺氧；冠心病；糖尿病"},"children":[]}]},{"data":{"id":"dmdjlj10cco0","created":1792893203223,"text":"（2）心脏负荷过重"},"children":[{"data":{"id":"dmdjluxcpb40","created":1792893229123,"text":"容量负荷过重：动脉瓣关闭不全（血倒流回心室）；\n甲亢；慢性贫血"},"children":[]},{"data":{"id":"dmdjmaxy9mo0","created":1792893263988,"text":"压力负荷过重：高血压、肺动脉高压、肺栓塞"},"children":[]}]},{"data":{"id":"dmdjo7d4cm00","created":1792893412926,"text":"（3）心脏舒张充盈障碍"},"children":[{"data":{"id":"dmdjodghilc0","created":1792893426190,"text":"心包疾患（心包积液、缩窄性心包炎）"},"children":[]},{"data":{"id":"dmdjomjgxc80","created":1792893445962,"text":"限制性心肌病"},"children":[]},{"data":{"id":"dmdjor3ydcg0","created":1792893455907,"text":"房室瓣（二/三尖瓣）狭窄"},"children":[]},{"data":{"id":"dmdjozlqt1s0","created":1792893474397,"text":"心肌顺应性降低"},"children":[]}]}]}]}]},{"data":{"id":"dmdio652fs00","created":1792890589152,"text":"2.发生机制","layout":null},"children":[]},{"data":{"id":"dmdio9drp3k0","created":1792890596209,"text":"3.对机体的影响","layout":null},"children":[]},{"data":{"id":"dmdiogfdhiw0","created":1792890611543,"text":"4.防止原则","layout":null},"children":[]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}