","created":1789287180825,"text":"外形为圆形或梨形成云雾状，\nWright-Giemsa染色呈现天蓝色或蓝黑色","layout":null},"children":[]}]},{"data":{"id":"dle1e3bgi800","created":1789287242015,"text":"核变性"},"children":[{"data":{"id":"dle1e58oips0","created":1789287246201,"text":"中性粒细胞细胞核出现固缩、溶解及碎裂的现象"},"children":[]}]}]}]},{"data":{"id":"dle1etxlx280","created":1789287299951,"text":"巨多分叶核中性粒细胞"},"children":[{"data":{"id":"dle1f093idc0","created":1789287313706,"text":"巨幼细胞性贫血"},"children":[]}]}]}]}]}]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}