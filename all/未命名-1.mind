{"root":{"data":{"id":"dlppwa6rdiw0","created":1790473533685,"text":"心血管药理"},"children":[{"data":{"id":"dlptv9z0z8o0","created":1790484739292,"text":"抗心律失常药\nAntiarrhythmic Drugs"},"children":[{"data":{"id":"dlptvezb00g0","created":1790484750193,"text":"心律失常发生的电生理机制"},"children":[{"data":{"id":"dlptvjnfwqw0","created":1790484760360,"text":"心律失常：心脏冲动、传导或者激动次序发生异常，\n引起心跳频率或节律发生紊乱"},"children":[]},{"data":{"id":"dlptvuwdfyo0","created":1790484784844,"text":"心肌细胞电生理学基础"},"children":[{"data":{"id":"dlptw33jyp40","created":1790484802693,"text":"心脏电活动的离子基础：\nNa+、K+、Ca2+的跨膜转运"},"children":[]},{"data":{"id":"dlptwa14uwo0","created":1790484817784,"text":"兴奋期与不应期"},"children":[{"data":{"id":"dlptwbxyme80","created":1790484821946,"text":"动作电位时程APD"},"children":[{"data":{"id":"dlptwjsypwg0","created":1790484839058,"text":"从动作电位去极化起始，到复极化回到静息电位水平的总时间"},"children":[]}]}]}]}]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}