{"root":{"data":{"id":"dm1nak25q880","created":1791684908423,"text":"呼吸系统生理学"},"children":[{"data":{"id":"dm1nap30kgo0","created":1791684919358,"text":"肺通气\npulmonary ventilation","layout":null},"children":[{"data":{"id":"dm1ndgu4be00","created":1791685136499,"text":"呼吸道的功能","layout":null},"children":[{"data":{"id":"dm1ndjrhfi00","created":1791685142870,"text":"加温加湿","layout":null},"children":[]},{"data":{"id":"dm1ndm7mlb40","created":1791685148199,"text":"清洁过滤","layout":null},"children":[]},{"data":{"id":"dm1ne5nhc8g0","created":1791685190517,"text":"调节气道阻力","layout":null},"children":[{"data":{"id":"dm1nejxirkw0","created":1791685221599,"text":"副交感神经—ACh⬆—M受体—收缩","layout":null},"children":[]},{"data":{"id":"dm1nex2hss80","created":1791685250198,"text":"交感—去甲肾上腺素⬆—β2受体—舒张","layout":null},"children":[]}]}]},{"data":{"id":"dm1nfej6luo0","created":1791685288212,"text":"肺通气原理","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dm1nfoyzqu00","created":1791685310936,"text":"高压流向低压","layout":null},"children":[]},{"data":{"id":"dm1nfwety5c0","created":1791685327131,"text":"动力与阻力相平衡","layout":null},"children":[]},{"data":{"id":"dm1ng4sov0o0","created":1791685345384,"text":"具体是：","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dm1ng85futk0","created":1791685352685,"text":"1.呼吸运动（原动力）：\n呼吸肌的收缩和舒张➡胸廓的扩大和缩小","layout":null,"expandState":"expand"},"children":[]},{"data":{"id":"dm1ngsr7t280","created":1791685397537,"text":"2.肺的扩张和缩小","layout":null},"children":[]},{"data":{"id":"dm1nh0zznrc0","created":1791685415482,"text":"3.直接动力：肺泡与外界环境间的压力差","layout":null},"children":[]}]},{"data":{"id":"dm1vpurubhk0","created":1791708676085,"text":"肺通气的动力","layout":null},"children":[{"data":{"id":"dm1nj8ftm5s0","created":1791685588405,"text":"涉及的肌肉","layout":null},"children":[{"data":{"id":"dm1ni90vpeg0","created":1791685511314,"text":"吸气肌：肋间外肌、膈肌","layout":null},"children":[]},{"data":{"id":"dm1niivh26g0","created":1791685532755,"text":"呼气肌：肋间内肌、腹壁肌","layout":null},"children":[]}]},{"data":{"id":"dm1njfoyqaw0","created":1791685604195,"text":"横膈的上下运动：膈肌","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dm1njs9lwhk0","created":1791685631565,"text":"膈肌：总面积270cm²，\n因膈肌收缩增加的胸廓容积占总吸入气量的80%，\n最重要的吸气肌","layout":null},"children":[]},{"data":{"id":"dm1nm0ye7v40","created":1791685807206,"text":"腹式呼吸：主要依靠膈肌运动","layout":null},"children":[]},{"data":{"id":"dm1nmey6h480","created":1791685837669,"text":"呼吸时的膈肌下降范围","layout":null},"children":[{"data":{"id":"dm1nmrkpgyg0","created":1791685865152,"text":"平静吸气时：","layout":null},"children":[{"data":{"id":"dm1nmyafxo00","created":1791685879769,"text":"膈肌下降1-2 cm\n平均容量↑400ml","layout":null},"children":[]}]},{"data":{"id":"dm1nn0a1q000","created":1791685884098,"text":"深吸气时：","layout":null},"children":[{"data":{"id":"dm1nn39q9vc0","created":1791685890609,"text":"膈肌下降7-10 cm\n最大容量↑2500ml","layout":null},"children":[]}]}]}]},{"data":{"id":"dm1nnmput280","created":1791685932943,"text":"肋骨的升降运动：肋间外肌","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dm1nocfd7l40","created":1791685988905,"text":"胸式呼吸：主要依靠肋间外肌、肋间内肌收缩舒张","layout":null},"children":[]},{"data":{"id":"dm1nosuzy340","created":1791686024679,"text":"呼吸时的肋间外肌变化","layout":null},"children":[{"data":{"id":"dm1tq7r5q000","created":1791703062122,"text":"吸气inspiration（主动）","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dm1tqami1iw0","created":1791703068371,"text":"1.膈肌收缩（上下径）\n肋间外肌收缩（前后左右径）","layout":null},"children":[]},{"data":{"id":"dm1tre9bpuo0","created":1791703154646,"text":"2.胸廓容积⬆","layout":null},"children":[]},{"data":{"id":"dm1trjmjmwo0","created":1791703166329,"text":"3.肺扩大","layout":null},"children":[]},{"data":{"id":"dm1trrbosag0","created":1791703183087,"text":"4.肺内压⬇","layout":null},"children":[]},{"data":{"id":"dm1trwtvrfk0","created":1791703195071,"text":"5.吸气","layout":null},"children":[]}]},{"data":{"id":"dm1ts029jzc0","created":1791703202108,"text":"呼气expiration（被动）","expandState":"collapse","layout":null},"children":[{"data":{"id":"dm1ts3i0slk0","created":1791703209591,"text":"1.吸气肌放松","layout":null},"children":[]},{"data":{"id":"dm1ts8rllgw0","created":1791703221054,"text":"2.膈肌回位、肋骨下降、肺弹性回缩力","layout":null},"children":[]},{"data":{"id":"dm1tuiuexls0","created":1791703399720,"text":"3.胸廓容积⬇","layout":null},"children":[]},{"data":{"id":"dm1tutnym2w0","created":1791703423275,"text":"4.肺缩小","layout":null},"children":[]},{"data":{"id":"dm1tuzfubtk0","created":1791703435845,"text":"5.肺内压⬆","layout":null},"children":[]},{"data":{"id":"dm1tv670v600","created":1791703450549,"text":"6.呼气","layout":null},"children":[]}]}]},{"data":{"id":"dm1tz5cfdoo0","created":1791703762155,"text":"为什么胸廓扩大和缩小会引起肺的扩大和缩小","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dm1tzij0yfk0","created":1791703790853,"text":"胸膜腔密闭，两层胸膜依靠浆液相互吸附，\n胸廓运动通过胸膜的牵拉作用带动肺扩张和回缩","layout":null},"children":[]},{"data":{"id":"dm1tztjdiu80","created":1791703814818,"text":"肺本身没有肌肉，肺的扩张缩小不是肺自己主动收缩，\n是被胸廓牵拉引起的","layout":null},"children":[]},{"data":{"id":"dm1v2fa2cts0","created":1791706839983,"text":"内聚力和肺泡弹性使肺随胸廓的扩大缩小而扩大缩小","layout":null},"children":[]},{"data":{"id":"dm1v3sb4bfc0","created":1791706946709,"text":"气胸时肺萎缩","layout":null},"children":[{"data":{"id":"dm1v41hu4480","created":1791706966706,"text":"气胸破坏胸膜腔密闭性，负压消失，\n肺失去胸膜牵拉，凭借自身弹性回缩而萎陷。","layout":null},"children":[]}]}]},{"data":{"id":"dm1v4it0khc0","created":1791707004387,"text":"胸膜腔内压","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dm1v4uffwlc0","created":1791707029688,"text":"正常值","layout":null},"children":[{"data":{"id":"dm1v4xf4cu80","created":1791707036199,"text":"吸气末","layout":null},"children":[{"data":{"id":"dm1v51sj91k0","created":1791707045717,"text":"-10~-5mmHg","layout":null},"children":[]}]},{"data":{"id":"dm1v58jilo80","created":1791707060409,"text":"呼气末","layout":null},"children":[{"data":{"id":"dm1v5ak7sts0","created":1791707064805,"text":"-5~-3mmHg","layout":null},"children":[]}]}]},{"data":{"id":"dm1v5kpowz40","created":1791707086904,"text":"胸膜腔负压形成的原理","layout":null},"children":[{"data":{"id":"dm1v5vz3yg80","created":1791707111418,"text":"作用于胸膜腔的力","layout":null},"children":[{"data":{"id":"dm1v612ttfs0","created":1791707122527,"text":"肺内压、肺弹性回缩力","layout":null},"children":[]},{"data":{"id":"dm1v66p5hpc0","created":1791707134761,"text":"胸膜腔内压=肺内压-肺弹性回缩力","font-weight":"bold","color":"#ff0000","layout":null},"children":[]},{"data":{"id":"dm1v6pnse9c0","created":1791707176037,"text":"吸气末或者呼气末，肺内压约为0\n胸膜腔内压≈-肺回缩力","layout":null},"children":[]}]},{"data":{"id":"dm1v7cieeso0","created":1791707225777,"text":"负压的成因","layout":null},"children":[{"data":{"id":"dm1v7f16yps0","created":1791707231267,"text":"前提：胸膜腔是一密闭的潜在腔隙","layout":null},"children":[]},{"data":{"id":"dm1v7rd1f600","created":1791707258105,"text":"肺处于被牵张状态：胸廓固有容积＞肺固有容积","layout":null},"children":[]},{"data":{"id":"dm1v8epwo9s0","created":1791707308949,"text":"负压形成的直接动因：肺的弹性回缩力","layout":null},"children":[]}]},{"data":{"id":"dm1vl333lrk0","created":1791708302359,"text":"负压的意义","layout":null},"children":[{"data":{"id":"dm1vl8bt2so0","created":1791708313770,"text":"使肺保持在扩张状态","layout":null},"children":[]},{"data":{"id":"dm1vld3smj40","created":1791708324169,"text":"促使静脉及淋巴回流","layout":null},"children":[]}]}]},{"data":{"id":"dm1vmxu3rqw0","created":1791708447660,"text":"关于气胸","layout":null},"children":[{"data":{"id":"dm1vn4oyi0g0","created":1791708462586,"text":"闭合性气胸","layout":null},"children":[{"data":{"id":"dm1vneec91c0","created":1791708483712,"text":"裂口小，漏气停止，\n胸膜腔部分负压，症状较轻","layout":null},"children":[]}]},{"data":{"id":"dm1vn7l21k00","created":1791708468881,"text":"开放性气胸","layout":null},"children":[{"data":{"id":"dm1vnj4ii480","created":1791708494002,"text":"伤口持续开放，胸膜腔和大气相通，\n纵隔随呼吸摆动（纵隔扑动）","layout":null},"children":[]}]},{"data":{"id":"dm1vn9mcb6w0","created":1791708473312,"text":"张力性气胸","layout":null},"children":[{"data":{"id":"dm1vns21wtc0","created":1791708513444,"text":"单向活瓣，只进不出，\n胸腔压力持续升高，最凶险，需要立刻穿刺减压","layout":null},"children":[]},{"data":{"id":"dm1vnyjsoqg0","created":1791708527578,"text":"ARS 套管针胸膜腔穿刺减压术","layout":null},"children":[{"data":{"id":"dm1vo7oyss00","created":1791708547481,"text":"锁骨中线，第 2 肋间隙","layout":null},"children":[]},{"data":{"id":"dm1vob5i1a00","created":1791708555011,"text":"原理：紧急穿刺，把胸膜腔内高压气体释放出来，\n快速降低胸腔压力，挽救生命。\n套管留置可以持续排气。","layout":null},"children":[]}]}]}]}]}]}]},{"data":{"id":"dm1vqg40dbk0","created":1791708722533,"text":"肺通气的阻力","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dm1vqikopps0","created":1791708727895,"text":"弹性阻力70%","layout":null},"children":[{"data":{"id":"dm1vqtkr83c0","created":1791708751844,"text":"肺的弹性阻力","layout":null,"color":"#ff0000","font-weight":"bold","expandState":"collapse"},"children":[{"data":{"id":"dm1vtq7evyg0","created":1791708979600,"text":"组成","layout":null},"children":[{"data":{"id":"dm1vrrxtylk0","created":1791708826645,"text":"肺有丰富的弹性纤维\n有被动的伸展性及持续的回缩力","layout":null},"children":[{"data":{"id":"dm1vsff7ccg0","created":1791708877762,"text":"肺气肿→肺弹性受损→张缩能力⬇→肺通气量⬇","layout":null},"children":[]}]},{"data":{"id":"dm1vt9fkpb40","created":1791708943088,"text":"肺泡表面张力导致的回缩力（主要来源）","layout":null},"children":[]}]},{"data":{"id":"dm1vtv1lhhc0","created":1791708990132,"text":"表示方法：肺顺应性","layout":null,"image":"","imageTitle":"","imageSize":""},"children":[{"data":{"id":"dm1zez30jl40","created":1791719107902,"text":"顺应性 (compliance, C) 指外力作用下弹性组织的可扩张性，\n即单位跨壁压 (△P) 所引起的容积变化 (△V)。\nC= △V/ △P","layout":null},"children":[]},{"data":{"id":"dm1zfkwotag0","created":1791719155408,"text":"肺顺应性大，肺易扩张","layout":null},"children":[]},{"data":{"id":"dm1zfqrgg800","created":1791719168153,"text":"反映肺扩张的难易程度","layout":null},"children":[]},{"data":{"id":"dm1zftadkds0","created":1791719173650,"text":"病理：肺充血、肺不张、肺纤维化，\n肺顺应性↓","layout":null},"children":[]},{"data":{"id":"dm1zmvsg5e00","created":1791719727646,"text":"肺容积-跨肺压曲线","image":"https://p.cldisk.com/star4/cf65a03c86ae1bc0ca3c8917848dd931/origin.png","imageTitle":"","imageSize":{"width":200,"height":118},"layout":null},"children":[{"data":{"id":"dm1zo190pnk0","created":1791719817896,"text":"斜率代表顺应性","layout":null},"children":[]},{"data":{"id":"dm1zpanrqio0","created":1791719916743,"text":"跨肺压=肺内压-胸膜腔内压\n =-胸膜腔内压","layout":null},"children":[]},{"data":{"id":"dm1zofes9hc0","created":1791719848719,"text":"1.吸气初的时候斜率小：肺顺应性小，\n吸气阻力大，不易扩张","layout":null},"children":[]},{"data":{"id":"dm1zofh37xs0","created":1791719848859,"text":"2.肺总弹性阻力 = 肺组织弹性阻力 + 肺泡表面张力","layout":null},"children":[]},{"data":{"id":"dm1zrgd96u80","created":1791720085896,"text":"3.充盐水实验曲线去除表面张力，仅有肺本身的弹性回缩力\n两条曲线的差值就代表肺泡表面张力带来的弹性阻力","layout":null},"children":[]},{"data":{"id":"dm1zsmfne600","created":1791720177466,"text":"空气填充肺存在明显滞后（磁滞），盐水填充肺无滞后。\n证明肺泡表面张力是肺弹性阻力的重要来源，也是肺 PV 曲线滞后现象的成因。","layout":null},"children":[]}]}]},{"data":{"id":"dm1ztgw3cs00","created":1791720243764,"text":"主要来源：肺泡表面张力","layout":null},"children":[{"data":{"id":"dm1ztmukqns0","created":1791720256733,"text":"肺泡内的液体层与气体之间（液 - 气界面）\n↓\n肺表面积力图缩小的张力\n↓\n肺具有回缩倾向\n使肺泡回缩的力","layout":null},"children":[]},{"data":{"id":"dm1zv3t97x40","created":1791720372022,"text":"肺回缩力=弹性回缩力1/3+表面张力2/3","layout":null},"children":[]}]},{"data":{"id":"dm1zvqimrfk0","created":1791720421446,"text":"肺泡表面活性物质surfactant","layout":null},"children":[{"data":{"id":"dm1zw1jci3c0","created":1791720445434,"text":"以单分子层覆于肺泡液体分子表面","layout":null},"children":[]},{"data":{"id":"dm1zwcqfs7s0","created":1791720469807,"text":"分泌：肺泡壁Ⅱ型上皮细胞","layout":null},"children":[]},{"data":{"id":"dm1zwjj1e8w0","created":1791720484597,"text":"成分：二棕榈酰卵磷脂DPPC","layout":null},"children":[]},{"data":{"id":"dm1zyzo3ctc0","created":1791720676460,"text":"作用：降低肺泡表面张力","layout":null},"children":[]},{"data":{"id":"dm1zzidxieo0","created":1791720717204,"text":"生理功能：\n 减小阻力\n 稳定溶剂\n 保持干燥","layout":null},"children":[{"data":{"id":"dm1zzprw6sw0","created":1791720733286,"text":"增加肺的顺应性，减少吸气阻力，有利于吸气","layout":null},"children":[{"data":{"id":"dm20033yyxk0","created":1791720762314,"text":"吸气时肺扩大\n→表面活性物质分散\n→降低表面张力的作用⬇\n→肺泡回缩力⬆","layout":null},"children":[]}]},{"data":{"id":"dm201nls0rk0","created":1791720885291,"text":"维持大小肺泡容积的相对稳定","layout":null},"children":[]},{"data":{"id":"dm2022qd58o0","created":1791720918220,"text":"防止液体渗入肺泡","layout":null},"children":[]}]},{"data":{"id":"dm203n0tu740","created":1791721040752,"text":"临床意义","layout":null},"children":[{"data":{"id":"dm203p2pcmg0","created":1791721045219,"text":"肺炎、肺栓塞导致肺不张","layout":null},"children":[{"data":{"id":"dm204hdafds0","created":1791721106809,"text":"病变损伤 Ⅱ 型肺泡上皮，肺泡表面活性物质减少，\n肺泡表面张力升高，肺泡回缩塌陷，造成肺不张","layout":null},"children":[]}]},{"data":{"id":"dm203xhaxw00","created":1791721063516,"text":"早产儿—呼吸窘迫综合征NRDS","layout":null},"children":[{"data":{"id":"dm204xx7ljk0","created":1791721142842,"text":"早产儿肺泡 Ⅱ 型细胞不成熟，肺泡表面活性物质缺乏，\n肺泡表面张力过高，肺泡萎陷","layout":null},"children":[]}]},{"data":{"id":"dm20527kyg80","created":1791721152177,"text":"体外膜肺融合ECMO","layout":null},"children":[{"data":{"id":"dm206dv9bfk0","created":1791721255917,"text":"把体内静脉血引出体外，经离心泵（人工心脏）驱动，\n送入膜式氧合器（人工肺）","layout":null},"children":[]}]}]}]}]},{"data":{"id":"dm1vqxxm9xc0","created":1791708761329,"text":"胸廓的弹性阻力","layout":null},"children":[{"data":{"id":"dm206rds5g00","created":1791721285335,"text":"是否构成吸气阻力取决于胸廓的位置","layout":null},"children":[{"data":{"id":"dm2093jm41s0","created":1791721468538,"text":"肺容量67%，自然位置","layout":null},"children":[]},{"data":{"id":"dm209c34umg0","created":1791721487132,"text":"肺容量＜67%，胸廓缩小\n作用：吸气动力、呼气阻力","layout":null},"children":[]},{"data":{"id":"dm209qq1uj40","created":1791721518993,"text":"肺容量＞67%，胸廓扩大\n作用：吸气阻力、呼气动力","layout":null},"children":[]}]},{"data":{"id":"dm20aclvtw00","created":1791721566630,"text":"临床意义","layout":null},"children":[{"data":{"id":"dm20aghsxlc0","created":1791721575090,"text":"肺不张、肺充血、肺纤维化、表面活性物质减少或感染等原因\n➡肺弹性阻力⬆→吸气困难","layout":null},"children":[]},{"data":{"id":"dm20bgn1wi00","created":1791721653772,"text":"肺气肿\n➡肺弹性成分破坏\n→肺回缩力⬇\n→肺弹性阻力⬇（顺应性⬆）\n→呼气困难","layout":null},"children":[{"data":{"id":"dm20d4jbdug0","created":1791721784153,"text":"肺顺应性增大不一定表示肺通气功能好"},"children":[]}]},{"data":{"id":"dm20dgae7q00","created":1791721809735,"text":"胸廓畸形、胸膜增厚、腹内占位病变、肥胖等原因\n➡弹性阻力⬆（顺应性⬇）\n➡吸气困难"},"children":[]}]}]}]},{"data":{"id":"dm1vqlllr200","created":1791708734481,"text":"非弹性阻力30%","layout":null},"children":[{"data":{"id":"dm1vr1c9fmg0","created":1791708768745,"text":"气道阻力90%","layout":null,"color":"#ff0000","font-weight":"bold"},"children":[]},{"data":{"id":"dm1vr3pxkns0","created":1791708773925,"text":"惯性阻力","layout":null},"children":[]},{"data":{"id":"dm1vr5iu5cw0","created":1791708777850,"text":"组织粘滞阻力","layout":null},"children":[]}]}]}]},{"data":{"id":"dm20fblgdso0","created":1791721956248,"text":"肺通气功能的评价"},"children":[{"data":{"id":"dm20fil1um00","created":1791721971461,"text":"肺容积和肺容量"},"children":[{"data":{"id":"dm20fqlawp40","created":1791721988891,"text":"肺容积：不同状态下肺所容纳的气体量"},"children":[{"data":{"id":"dm20fyngk2o0","created":1791722006435,"text":"潮气量tidal volume：每次呼吸时吸入或呼出的气量"},"children":[]},{"data":{"id":"dm20gr9ufhc0","created":1791722068739,"text":"补吸气量inspiratory reserve volume：1500ul~2000ul"},"children":[]},{"data":{"id":"dm20hbnlx280","created":1791722113107,"text":"补呼气量expiratory reserve volume：900~1200ul"},"children":[]},{"data":{"id":"dm20hwn9dhs0","created":1791722158798,"text":"残气量residual volume：1000~1500ul"},"children":[]}]},{"data":{"id":"dm20ihnp9sg0","created":1791722204537,"text":"肺容量lung capacity","image":"https://p.cldisk.com/star4/0f519f2e9da25801cc6f7b91c2b734d6/origin.png","imageTitle":"","imageSize":{"width":200,"height":97}},"children":[{"data":{"id":"dm20iwvz8l40","created":1791722237689,"text":"深吸气量inspiratory capacity，IC"},"children":[{"data":{"id":"dm20jlkoev40","created":1791722291427,"text":"补吸气量+潮气量"},"children":[]},{"data":{"id":"dm20jrb1tjk0","created":1791722303904,"text":"是衡量最大通气潜力的重要指标"},"children":[]}]},{"data":{"id":"dm20k53qz480","created":1791722333938,"text":"功能残气量functional residual capacity，FRC","layout_right_offset":{"x":-33,"y":0}},"children":[{"data":{"id":"dm20kfe77nc0","created":1791722356337,"text":"补呼气量+余气量，2500ml"},"children":[]},{"data":{"id":"dm20kr704880","created":1791722382024,"text":"缓冲肺泡O₂和CO₂分压的变化幅度"},"children":[]}]},{"data":{"id":"dm20n3f5cv40","created":1791722565366,"text":"肺活量vital capacity，VC"},"children":[{"data":{"id":"dm2foslbqc00","created":1791765015172,"text":"深吸气量inspiration capacity，IC"},"children":[]}]}]}]}]}]},{"data":{"id":"dm1nckxz7ts0","created":1791685067075,"text":"气体交换","layout":null},"children":[]},{"data":{"id":"dm1ncn4h7ao0","created":1791685071822,"text":"气体运输","layout":null},"children":[]},{"data":{"id":"dm1ncp487z40","created":1791685076160,"text":"呼吸调节","layout":null},"children":[]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}