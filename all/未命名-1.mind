{"root":{"data":{"id":"dm1nak25q880","created":1791684908423,"text":"呼吸系统生理学"},"children":[{"data":{"id":"dm1nap30kgo0","created":1791684919358,"text":"肺通气\npulmonary ventilation","layout":null},"children":[{"data":{"id":"dm1ndgu4be00","created":1791685136499,"text":"呼吸道的功能","layout":null},"children":[{"data":{"id":"dm1ndjrhfi00","created":1791685142870,"text":"加温加湿","layout":null},"children":[]},{"data":{"id":"dm1ndm7mlb40","created":1791685148199,"text":"清洁过滤","layout":null},"children":[]},{"data":{"id":"dm1ne5nhc8g0","created":1791685190517,"text":"调节气道阻力","layout":null},"children":[{"data":{"id":"dm1nejxirkw0","created":1791685221599,"text":"副交感神经—ACh⬆—M受体—收缩","layout":null},"children":[]},{"data":{"id":"dm1nex2hss80","created":1791685250198,"text":"交感—去甲肾上腺素⬆—β2受体—舒张","layout":null},"children":[]}]}]},{"data":{"id":"dm1nfej6luo0","created":1791685288212,"text":"肺通气原理","layout":null},"children":[{"data":{"id":"dm1nfoyzqu00","created":1791685310936,"text":"高压流向低压","layout":null},"children":[]},{"data":{"id":"dm1nfwety5c0","created":1791685327131,"text":"动力与阻力相平衡","layout":null},"children":[]},{"data":{"id":"dm1ng4sov0o0","created":1791685345384,"text":"具体是：","layout":null},"children":[{"data":{"id":"dm1ng85futk0","created":1791685352685,"text":"1.呼吸运动（原动力）：\n呼吸肌的收缩和舒张➡胸廓的扩大和缩小","layout":null},"children":[{"data":{"id":"dm1nj8ftm5s0","created":1791685588405,"text":"涉及的肌肉","layout":null},"children":[{"data":{"id":"dm1ni90vpeg0","created":1791685511314,"text":"吸气肌：肋间外肌、膈肌","layout":null},"children":[]},{"data":{"id":"dm1niivh26g0","created":1791685532755,"text":"呼气肌：肋间内肌、腹壁肌","layout":null},"children":[]}]},{"data":{"id":"dm1njfoyqaw0","created":1791685604195,"text":"横膈的上下运动：膈肌","layout":null},"children":[{"data":{"id":"dm1njs9lwhk0","created":1791685631565,"text":"膈肌：总面积270cm²，\n因膈肌收缩增加的胸廓容积占总吸入气量的80%，\n最重要的吸气肌","layout":null},"children":[]},{"data":{"id":"dm1nm0ye7v40","created":1791685807206,"text":"腹式呼吸：主要依靠膈肌运动","layout":null},"children":[]},{"data":{"id":"dm1nmey6h480","created":1791685837669,"text":"呼吸时的膈肌下降范围","layout":null},"children":[{"data":{"id":"dm1nmrkpgyg0","created":1791685865152,"text":"平静吸气时：","layout":null},"children":[{"data":{"id":"dm1nmyafxo00","created":1791685879769,"text":"膈肌下降1-2 cm\n平均容量↑400ml","layout":null},"children":[]}]},{"data":{"id":"dm1nn0a1q000","created":1791685884098,"text":"深吸气时：","layout":null},"children":[{"data":{"id":"dm1nn39q9vc0","created":1791685890609,"text":"膈肌下降7-10 cm\n最大容量↑2500ml","layout":null},"children":[]}]}]}]},{"data":{"id":"dm1nnmput280","created":1791685932943,"text":"肋骨的升降运动：肋间外肌"},"children":[{"data":{"id":"dm1nocfd7l40","created":1791685988905,"text":"胸式呼吸：主要依靠肋间外肌、肋间内肌收缩舒张"},"children":[]}]}]},{"data":{"id":"dm1ngsr7t280","created":1791685397537,"text":"2.肺的扩张和缩小","layout":null},"children":[]},{"data":{"id":"dm1nh0zznrc0","created":1791685415482,"text":"3.直接动力：肺泡与外界环境间的压力差","layout":null},"children":[]}]}]}]},{"data":{"id":"dm1nckxz7ts0","created":1791685067075,"text":"气体交换","layout":null},"children":[]},{"data":{"id":"dm1ncn4h7ao0","created":1791685071822,"text":"气体运输","layout":null},"children":[]},{"data":{"id":"dm1ncp487z40","created":1791685076160,"text":"呼吸调节","layout":null},"children":[]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}