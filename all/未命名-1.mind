{"root":{"data":{"id":"dlppwa6rdiw0","created":1790473533685,"text":"心血管药理"},"children":[{"data":{"id":"dlptv9z0z8o0","created":1790484739292,"text":"抗心律失常药\nAntiarrhythmic Drugs","layout":null},"children":[{"data":{"id":"dlptvezb00g0","created":1790484750193,"text":"心律失常发生的电生理机制","layout":null},"children":[{"data":{"id":"dlptvjnfwqw0","created":1790484760360,"text":"心律失常：心脏冲动、传导或者激动次序发生异常，\n引起心跳频率或节律发生紊乱","layout":null},"children":[]},{"data":{"id":"dlptvuwdfyo0","created":1790484784844,"text":"心肌细胞电生理学基础","layout":null},"children":[{"data":{"id":"dlptw33jyp40","created":1790484802693,"text":"心脏电活动的离子基础：\nNa+、K+、Ca2+的跨膜转运","layout":null,"hyperlink":"https://p.cldisk.com/star4/193fb34150a67c669455f3cd07b8654f/origin.png","hyperlinkTitle":"","note":"https://p.cldisk.com/star4/ff98416e79649d70d4c1b3c5593ad807/origin.png"},"children":[]},{"data":{"id":"dlptwa14uwo0","created":1790484817784,"text":"兴奋期与不应期","layout":null},"children":[{"data":{"id":"dlptwbxyme80","created":1790484821946,"text":"动作电位时程APD","layout":null},"children":[{"data":{"id":"dlptwjsypwg0","created":1790484839058,"text":"从动作电位去极化起始，\n到复极化回到静息电位水平的总时间","layout":null},"children":[]}]},{"data":{"id":"dlptwqd6c3s0","created":1790484853341,"text":"绝对不应期ARP","layout":null},"children":[{"data":{"id":"dlptwt1d16o0","created":1790484859157,"text":"钠通道完全处于失活状态，\n无法再次开放","layout":null},"children":[]}]},{"data":{"id":"dlptwwlztuo0","created":1790484866935,"text":"有效不应期ERP","layout":null},"children":[{"data":{"id":"dlptx1jgjlc0","created":1790484877665,"text":"足够强刺激也只能产生局部电位，\n不能产生可传导的动作电位","layout":null},"children":[]},{"data":{"id":"dlptxbpmdpc0","created":1790484899806,"text":"大部分 Na⁺通道仍处于失活状态，仅少量恢复，\n不足以形成再生性去极化。","layout":null},"children":[]}]},{"data":{"id":"dlptxkfxqko0","created":1790484918811,"text":"相对不应期RRP","layout":null},"children":[{"data":{"id":"dlptxn7914w0","created":1790484924816,"text":"ERP 结束后，膜电位从 - 60mV 恢复至静息电位\n（约 - 80 ~ -90mV）的阶段","layout":null},"children":[]},{"data":{"id":"dlptxv0uwl40","created":1790484941844,"text":"部分钠通道已经复活，\n但还没有全部回到备用状态","layout":null},"children":[]}]}]}]},{"data":{"id":"dlpty7cvr7k0","created":1790484968692,"text":"发生机制","layout":null},"children":[{"data":{"id":"dlptyew9c2g0","created":1790484985101,"text":"自律性升高","layout":null},"children":[{"data":{"id":"dlptyhehk5s0","created":1790484990557,"text":"自律细胞自律性升高","layout":null},"children":[{"data":{"id":"dlptyk63tgg0","created":1790484996581,"text":"交感活性增加","layout":null},"children":[]},{"data":{"id":"dlptylseh940","created":1790485000106,"text":"低血钾","layout":null},"children":[]},{"data":{"id":"dlptysa2zug0","created":1790485014236,"text":"心肌细胞受到机械牵张","layout":null},"children":[]}]},{"data":{"id":"dlptyxsfdzc0","created":1790485026229,"text":"非自律细胞异常自律性","layout":null},"children":[{"data":{"id":"dlptz3k809s0","created":1790485038793,"text":"缺血缺氧可使非自律心肌细胞出现异常自律性，这种异常兴奋向周围组织扩布可引起心律失常","layout":null},"children":[]}]}]},{"data":{"id":"dlptz7twk4g0","created":1790485048086,"text":"后除极：动作电位复极时\n产生的一个提前除极","layout":null},"children":[{"data":{"id":"dlptzf9g2cg0","created":1790485064263,"text":"早后除极EAD","layout":null},"children":[{"data":{"id":"dlpueng9b8o0","created":1790486257552,"text":"由APD过度延长引起","hyperlink":"https://p.cldisk.com/star4/0f8a7e68b3c87a54e57a213d3f0e27cb/origin.png","hyperlinkTitle":""},"children":[]},{"data":{"id":"dlpuesptcds0","created":1790486269013,"text":"所致心律失常以尖端扭转型室性心动过速常见"},"children":[]}]},{"data":{"id":"dlptzgjwviw0","created":1790485067073,"text":"迟后除极DAD","layout":null},"children":[{"data":{"id":"dlpwmthayco0","created":1790492539809,"text":"细胞内Ca2+超载引起","hyperlink":"https://p.cldisk.com/star4/5cf856243c617f9377c44bc1544708b4/origin.png","hyperlinkTitle":""},"children":[]},{"data":{"id":"dlpwnbz02k00","created":1790492580061,"text":"强心苷中毒，心肌缺氧，细胞外高钙是诱发因素"},"children":[]}]}]},{"data":{"id":"dlpwnjhain40","created":1790492596404,"text":"折返reentry:\n引发快速型心律失常的重要机制"},"children":[]}]}]},{"data":{"id":"dlptzo79dc80","created":1790485083722,"text":"抗心律失常药的基本作用和分类","layout":null},"children":[]},{"data":{"id":"dlptzwoel400","created":1790485102173,"text":"代表药物","layout":null},"children":[]},{"data":{"id":"dlptzyydwbs0","created":1790485107130,"text":"致心律失常作用","layout":null},"children":[]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}