s00","created":1789284980650,"text":"共同作用","layout":null},"children":[]}]},{"data":{"id":"dle0n4yd4o00","created":1789285129744,"text":"急性感染 ","layout":null},"children":[{"data":{"id":"dle0ns6jhls0","created":1789285180305,"text":"细菌 — 革兰阴性杆菌：伤寒、副伤寒 \n病毒 — 流感、病毒性肝炎","layout":null},"children":[]}]},{"data":{"id":"dle0o09stb40","created":1789285197916,"text":"血液系统疾病","layout":null},"children":[{"data":{"id":"dle0o4y3c1c0","created":1789285208092,"text":"再障、巨贫等，全血减少","layout":null},"children":[]}]},{"data":{"id":"dle0o9kq2n40","created":1789285218168,"text":"物理化学因素","layout":null},"children":[{"data":{"id":"dle0objpjc00","created":1789285222460,"text":"射线、核素损伤、药物等","layout":null},"children":[]}]},{"data":{"id":"dle0odsxv6o0","created":1789285227372,"text":"单核 - 吞噬细胞系统亢进","layout":null},"children":[{"data":{"id":"dle0oiuoy140","created":1789285238362,"text":"各种原因的脾功能亢进","layout":null},"children":[]}]},{"data":{"id":"dle0oq8co680","created":1789285254425,"text":"自身免疫疾病","layout":null},"children":[{"data":{"id":"dle0osgwm5s0","created":1789285259296,"text":"系统性红斑狼疮，抗体介导破坏","layout":null},"children":[]}]}]},{"data":{"id":"dle0p290h7k0","created":1789285280586,"text":"中性粒细胞核象变化\n核象：指粒细胞的分叶状况，反映了粒细胞的成熟程度。\n核象变化可反映某些疾病的病情和预后","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dle0q7298800","created":1789285369426,"text":"核左移","layout":null},"children":[{"data":{"id":"dle0qj657940","created":1789285395782,"text":"概念：外周血中不分叶核（杆状核及以前的更幼稚细胞）超过5%","layout":null},"children":[]},{"data":{"id":"dle0rcnwrr40","created":1789285459983,"text":"见于：","layout":null},"children":[{"data":{"id":"dle0ri8pvao0","created":1789285472125,"text":"化脓性感染","layout":null},"children":[]},{"data":{"id":"dle0rld8kyg0","created":1789285478929,"text":"急性中毒","layout":null},"children":[]},{"data":{"id":"dle0rmyn9qg0","created":1789285482400,"text":"类白血病反应","layout":null},"children":[{"data":{"id":"dle0rttuca00","created":1789285497347,"text":"概念：是指机体对某些刺激因素所产生的类似白血病反应的血象反应，极度核左移","font-weight":"b