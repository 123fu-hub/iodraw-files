{"root":{"data":{"id":"dm1nak25q880","created":1791684908423,"text":"呼吸系统生理学"},"children":[{"data":{"id":"dm1nap30kgo0","created":1791684919358,"text":"肺通气\npulmonary ventilation","layout":null},"children":[{"data":{"id":"dm1ndgu4be00","created":1791685136499,"text":"呼吸道的功能","layout":null},"children":[{"data":{"id":"dm1ndjrhfi00","created":1791685142870,"text":"加温加湿","layout":null},"children":[]},{"data":{"id":"dm1ndm7mlb40","created":1791685148199,"text":"清洁过滤","layout":null},"children":[]},{"data":{"id":"dm1ne5nhc8g0","created":1791685190517,"text":"调节气道阻力","layout":null},"children":[{"data":{"id":"dm1nejxirkw0","created":1791685221599,"text":"副交感神经—ACh⬆—M受体—收缩","layout":null},"children":[]},{"data":{"id":"dm1nex2hss80","created":1791685250198,"text":"交感—去甲肾上腺素⬆—β2受体—舒张","layout":null},"children":[]}]}]},{"data":{"id":"dm1nfej6luo0","created":1791685288212,"text":"肺通气原理","layout":null},"children":[{"data":{"id":"dm1nfoyzqu00","created":1791685310936,"text":"高压流向低压","layout":null},"children":[]},{"data":{"id":"dm1nfwety5c0","created":1791685327131,"text":"动力与阻力相平衡","layout":null},"children":[]},{"data":{"id":"dm1ng4sov0o0","created":1791685345384,"text":"具体是：","layout":null},"children":[{"data":{"id":"dm1ng85futk0","created":1791685352685,"text":"1.呼吸运动（原动力）：\n呼吸肌的收缩和舒张➡胸廓的扩大和缩小","layout":null},"children":[{"data":{"id":"dm1nj8ftm5s0","created":1791685588405,"text":"涉及的肌肉","layout":null},"children":[{"data":{"id":"dm1ni90vpeg0","created":1791685511314,"text":"吸气肌：肋间外肌、膈肌","layout":null},"children":[]},{"data":{"id":"dm1niivh26g0","created":1791685532755,"text":"呼气肌：肋间内肌、腹壁肌","layout":null},"children":[]}]},{"data":{"id":"dm1njfoyqaw0","created":1791685604195,"text":"横膈的上下运动：膈肌","layout":null},"children":[{"data":{"id":"dm1njs9lwhk0","created":1791685631565,"text":"膈肌：总面积270cm²，\n因膈肌收缩增加的胸廓容积占总吸入气量的80%，\n最重要的吸气肌","layout":null},"children":[]},{"data":{"id":"dm1nm0ye7v40","created":1791685807206,"text":"腹式呼吸：主要依靠膈肌运动","layout":null},"children":[]},{"data":{"id":"dm1nmey6h480","created":1791685837669,"text":"呼吸时的膈肌下降范围","layout":null},"children":[{"data":{"id":"dm1nmrkpgyg0","created":1791685865152,"text":"平静吸气时：","layout":null},"children":[{"data":{"id":"dm1nmyafxo00","created":1791685879769,"text":"膈肌下降1-2 cm\n平均容量↑400ml","layout":null},"children":[]}]},{"data":{"id":"dm1nn0a1q000","created":1791685884098,"text":"深吸气时：","layout":null},"children":[{"data":{"id":"dm1nn39q9vc0","created":1791685890609,"text":"膈肌下降7-10 cm\n最大容量↑2500ml","layout":null},"children":[]}]}]}]},{"data":{"id":"dm1nnmput280","created":1791685932943,"text":"肋骨的升降运动：肋间外肌","layout":null},"children":[{"data":{"id":"dm1nocfd7l40","created":1791685988905,"text":"胸式呼吸：主要依靠肋间外肌、肋间内肌收缩舒张","layout":null},"children":[]},{"data":{"id":"dm1nosuzy340","created":1791686024679,"text":"呼吸时的肋间外肌变化","layout":null},"children":[{"data":{"id":"dm1tq7r5q000","created":1791703062122,"text":"吸气inspiration（主动）","layout":null,"expandState":"collapse"},"children":[{"data":{"id":"dm1tqami1iw0","created":1791703068371,"text":"1.膈肌收缩（上下径）\n肋间外肌收缩（前后左右径）","layout":null},"children":[]},{"data":{"id":"dm1tre9bpuo0","created":1791703154646,"text":"2.胸廓容积⬆","layout":null},"children":[]},{"data":{"id":"dm1trjmjmwo0","created":1791703166329,"text":"3.肺扩大","layout":null},"children":[]},{"data":{"id":"dm1trrbosag0","created":1791703183087,"text":"4.肺内压⬇","layout":null},"children":[]},{"data":{"id":"dm1trwtvrfk0","created":1791703195071,"text":"5.吸气","layout":null},"children":[]}]},{"data":{"id":"dm1ts029jzc0","created":1791703202108,"text":"呼气expiration（被动）","expandState":"collapse","layout":null},"children":[{"data":{"id":"dm1ts3i0slk0","created":1791703209591,"text":"1.吸气肌放松","layout":null},"children":[]},{"data":{"id":"dm1ts8rllgw0","created":1791703221054,"text":"2.膈肌回位、肋骨下降、肺弹性回缩力","layout":null},"children":[]},{"data":{"id":"dm1tuiuexls0","created":1791703399720,"text":"3.胸廓容积⬇","layout":null},"children":[]},{"data":{"id":"dm1tutnym2w0","created":1791703423275,"text":"4.肺缩小","layout":null},"children":[]},{"data":{"id":"dm1tuzfubtk0","created":1791703435845,"text":"5.肺内压⬆","layout":null},"children":[]},{"data":{"id":"dm1tv670v600","created":1791703450549,"text":"6.呼气","layout":null},"children":[]}]}]},{"data":{"id":"dm1tz5cfdoo0","created":1791703762155,"text":"为什么胸廓扩大和缩小会引起肺的扩大和缩小","layout":null},"children":[{"data":{"id":"dm1tzij0yfk0","created":1791703790853,"text":"胸膜腔密闭，两层胸膜依靠浆液相互吸附，\n胸廓运动通过胸膜的牵拉作用带动肺扩张和回缩","layout":null},"children":[]},{"data":{"id":"dm1tztjdiu80","created":1791703814818,"text":"肺本身没有肌肉，肺的扩张缩小不是肺自己主动收缩，\n是被胸廓牵拉引起的","layout":null},"children":[]},{"data":{"id":"dm1v2fa2cts0","created":1791706839983,"text":"内聚力和肺泡弹性使肺随胸廓的扩大缩小而扩大缩小","layout":null},"children":[]},{"data":{"id":"dm1v3sb4bfc0","created":1791706946709,"text":"气胸时肺萎缩","layout":null},"children":[{"data":{"id":"dm1v41hu4480","created":1791706966706,"text":"气胸破坏胸膜腔密闭性，负压消失，\n肺失去胸膜牵拉，凭借自身弹性回缩而萎陷。","layout":null},"children":[]}]}]},{"data":{"id":"dm1v4it0khc0","created":1791707004387,"text":"胸膜腔内压"},"children":[{"data":{"id":"dm1v4uffwlc0","created":1791707029688,"text":"正常值"},"children":[{"data":{"id":"dm1v4xf4cu80","created":1791707036199,"text":"吸气末"},"children":[{"data":{"id":"dm1v51sj91k0","created":1791707045717,"text":"-10~-5mmHg"},"children":[]}]},{"data":{"id":"dm1v58jilo80","created":1791707060409,"text":"呼气末"},"children":[{"data":{"id":"dm1v5ak7sts0","created":1791707064805,"text":"-5~-3mmHg"},"children":[]}]}]},{"data":{"id":"dm1v5kpowz40","created":1791707086904,"text":"胸膜腔负压形成的原理"},"children":[{"data":{"id":"dm1v5vz3yg80","created":1791707111418,"text":"作用于胸膜腔的力"},"children":[{"data":{"id":"dm1v612ttfs0","created":1791707122527,"text":"肺内压、肺弹性回缩力"},"children":[]},{"data":{"id":"dm1v66p5hpc0","created":1791707134761,"text":"胸膜腔内压=肺内压-肺弹性回缩力","font-weight":"bold"},"children":[]}]}]}]}]}]},{"data":{"id":"dm1ngsr7t280","created":1791685397537,"text":"2.肺的扩张和缩小","layout":null},"children":[]},{"data":{"id":"dm1nh0zznrc0","created":1791685415482,"text":"3.直接动力：肺泡与外界环境间的压力差","layout":null},"children":[]}]}]}]},{"data":{"id":"dm1nckxz7ts0","created":1791685067075,"text":"气体交换","layout":null},"children":[]},{"data":{"id":"dm1ncn4h7ao0","created":1791685071822,"text":"气体运输","layout":null},"children":[]},{"data":{"id":"dm1ncp487z40","created":1791685076160,"text":"呼吸调节","layout":null},"children":[]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}