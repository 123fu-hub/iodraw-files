{"root":{"data":{"id":"dldte2wisxk0","created":1789264672233,"text":"血液的一般检查"},"children":[{"data":{"id":"dldtf2310f40","created":1789264748813,"text":"血常规检测概况"},"children":[{"data":{"id":"dldtkzw0nzc0","created":1789265214221,"text":"血常规检测标本"},"children":[{"data":{"id":"dldtl4atytc0","created":1789265223824,"text":"采血方法：静脉采血法，毛细血管采血"},"children":[]},{"data":{"id":"dldtnxhjk4g0","created":1789265444085,"text":"采样体积：2ml/≥200ul"},"children":[]},{"data":{"id":"dldto0mg5hs0","created":1789265450912,"text":"紫管抗凝：常用EDTA K2（终浓度为1.5~2.2mg/ml），一般不用枸橼酸钠或肝素"},"children":[]},{"data":{"id":"dldto32c9340","created":1789265456226,"text":"样本保存：室温下18℃~25℃，2~3h（不超过24h）"},"children":[]}]}]},{"data":{"id":"dldtlvkn4n40","created":1789265283190,"text":"RBC的检测"},"children":[{"data":{"id":"dldtm23u3ow0","created":1789265297411,"text":"量的检测","layout":null},"children":[{"data":{"id":"dldtmbiecxk0","created":1789265317883,"text":"个数——红细胞数量RBC：测定单位体积血液中红细胞的数量（10^{12}/L）","layout":null},"children":[{"data":{"id":"dldtnd8v7ns0","created":1789265400024,"text":"方法：：自动血细胞计数仪、显微镜计数法","layout":null},"children":[]},{"data":{"id":"dldtnho9otk0","created":1789265409663,"text":"参考值","layout":null},"children":[{"data":{"id":"dldtnl47gt40","created":1789265417157,"text":"成年女性：3.5~5.0x10^{12}/L","layout":null},"children":[]},{"data":{"id":"dldtnot1p480","created":1789265425189,"text":"成年男性：4~5.5x10^{12}/L","layout":null},"children":[]},{"data":{"id":"dldtnru7jj40","created":1789265431790,"text":"新生儿：6.0~7.0x10^{12}/L","layout":null},"children":[]}]}]},{"data":{"id":"dldtpedlh7c0","created":1789265559215,"text":"有效分子含量——血红蛋白浓度HGB：血液中各种血红蛋白的综合浓度单位以g/L表示","layout_left_offset":{"x":52,"y":-1}},"children":[{"data":{"id":"dldtpvhz88o0","created":1789265596486,"text":"  方法：比色法、比重法、血氧法、测铁法，常用氧化高铁血红蛋白测定法"},"children":[]},{"data":{"id":"dldtq2jtx600","created":1789265611835,"text":"参考值"},"children":[{"data":{"id":"dldtq8pvsp40","created":1789265625262,"text":"成年女性： 110 ～ 150 g /L"},"children":[]},{"data":{"id":"dldtqdw42xk0","created":1789265636523,"text":"  成年男性： 120 ～ 160 g /L"},"children":[]},{"data":{"id":"dldtqgt6cug0","created":1789265642875,"text":"     新 生 儿： 170 ～ 200 g /L"},"children":[]}]},{"data":{"id":"dldtqp2mfk00","created":1789265660861,"text":"临床意义"},"children":[{"data":{"id":"dldtqu6ardk0","created":1789265671967,"text":"分支主题"},"children":[]}]}]}]}]}]},"template":"default","theme":"fresh-blue","version":"1.4.43"}